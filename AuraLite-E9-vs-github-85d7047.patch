++//! ```
++//!
++//! Run: `cargo run --quiet --locked -p aura-storage --example e8_nft_example`
++
++use std::collections::BTreeMap;
++use std::fs;
++
++use aura_storage::dao_ui::{run_e8_scenario, scenario_digest};
++use aura_storage::nft::{E8Error, NftWorld};
