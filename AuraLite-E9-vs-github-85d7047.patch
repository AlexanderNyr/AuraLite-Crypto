diff --git a/crates/aura-storage/src/nft.rs b/crates/aura-storage/src/nft.rs
new file mode 100644
index 0000000..cf7df38
--- /dev/null
+++ b/crates/aura-storage/src/nft.rs
@@ -0,0 +1,897 @@
+//! E8 NFT + names + identity: ARC-721 single tokens, ARC-1155 multi
+//! tokens, the `.aura` name service and on-chain identity records
+//! (ECOSYSTEM_PLAN E8).
+//!
+//! The model mirrors the pinned golden suite
+//! `tests/fixtures/e8-standards.txt` (50 vectors, generated by
+//! `tools/gen_e8_vectors.py`) and is cross-run against the independent
+//! Python model `tools/e8_nft_check.py`.
+//!
+//! # ARC-721 (per `standards/arc721`, X5)
+//!
+//! A token exists exactly when its owner slot is present — a burned id
+//! may be minted again. Every transfer (owner or approved spender)
+//! deletes the approval slot: keeping it would let a spender move the
+//! token after the owner handed it to someone else (the classic
+//! stale-approval bug). Balances are per-account counters.
+//!
+//! # ARC-1155
+//!
+//! One contract, many ids; each id has its own supply (supply 1 = NFT
+//! semantics, supply > 1 = fungible). A holder may grant an **operator**
+//! (`set_operator`) the right to move any of their ids; batch transfers
+//! are all-or-nothing and check every leg before applying any.
+//!
+//! # `.aura` names (ENS-shaped)
+//!
+//! Registry records: owner, target (resolution address) and expiry.
+//! A registration lasts [`TERM_DAYS`]; after expiry the name stays
+//! resolvable for [`GRACE_DAYS`] (anyone may renew), then resolution
+//! fails with `E8: name expired` and the name can be registered again.
+//! Transfer clears the old owner's primary name. Identity records bind
+//! a metadata digest to a live name; only the name owner may set them.
+
+use std::collections::BTreeMap;
+use std::fmt;
+
+/// Registration / renewal term in days.
+pub const TERM_DAYS: u64 = 365;
+
+/// Grace period after expiry during which the name still resolves.
+pub const GRACE_DAYS: u64 = 90;
+
+/// Errors carry the exact `E8: …` named messages pinned by the suite.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum E8Error {
+    /// Only the collection owner may mint or set URIs.
+    NotCollectionOwner {
+        /// Offending actor.
+        actor: String,
+    },
+    /// Mint over an existing token id.
+    TokenExists {
+        /// Duplicate token id.
+        id: u64,
+    },
+    /// Operation on a token that does not exist.
+    TokenMissing {
+        /// Unknown token id.
+        id: u64,
+    },
+    /// Caller is not the token owner.
+    NotTokenOwner {
+        /// Offending actor.
+        actor: String,
+        /// Token id.
+        id: u64,
+    },
+    /// Caller is neither owner nor approved operator.
+    NotApproved {
+        /// Offending actor.
+        actor: String,
+        /// Token id.
+        id: u64,
+    },
+    /// The zero address is never a valid party.
+    ZeroAddress,
+    /// Amounts must be positive.
+    ZeroAmount,
+    /// Balance below the requested amount.
+    Insufficient {
+        /// Holding account.
+        actor: String,
+        /// Token id.
+        id: u64,
+        /// Actual balance.
+        have: u128,
+        /// Requested amount.
+        need: u128,
+    },
+    /// Batch ids and amounts must line up.
+    BatchLen {
+        /// Number of ids.
+        ids: usize,
+        /// Number of amounts.
+        amounts: usize,
+    },
+    /// Name taken while live (or in grace).
+    NameTaken {
+        /// Contested name.
+        name: String,
+    },
+    /// Unknown name.
+    NameMissing {
+        /// Unknown name.
+        name: String,
+    },
+    /// Name failed validation.
+    InvalidName {
+        /// Rejected name.
+        name: String,
+    },
+    /// Name past expiry + grace.
+    NameExpired {
+        /// Expired name.
+        name: String,
+    },
+    /// Caller does not own the name.
+    NotNameOwner {
+        /// Offending actor.
+        actor: String,
+        /// Name in question.
+        name: String,
+    },
+    /// No identity record for the name.
+    NoIdentity {
+        /// Name without an identity record.
+        name: String,
+    },
+    /// Unknown proposal id.
+    ProposalMissing {
+        /// Unknown proposal id.
+        id: u32,
+    },
+    /// Proposer stake below the threshold.
+    BelowProposalThreshold {
+        /// Proposer voter id.
+        proposer: u32,
+    },
+    /// The UI rejects a second vote by the same voter.
+    VoteCast {
+        /// Proposal in question.
+        proposal: u32,
+        /// Voter in question.
+        voter: u32,
+    },
+    /// Snapshot voting power is zero.
+    NoVotingPower {
+        /// Voter with zero snapshot power.
+        voter: u32,
+    },
+    /// Vote after the voting period closed.
+    VotingClosed {
+        /// Proposal in question.
+        proposal: u32,
+    },
+    /// Finalize before the voting period closed.
+    VotingStillOpen {
+        /// Proposal in question.
+        proposal: u32,
+    },
+    /// Finalize on an already final proposal.
+    AlreadyFinalized {
+        /// Proposal in question.
+        proposal: u32,
+    },
+    /// Execute or veto a proposal that did not pass.
+    NotPassed {
+        /// Proposal in question.
+        proposal: u32,
+    },
+    /// Execute before the timelock elapsed.
+    TimelockNotReached {
+        /// Proposal in question.
+        proposal: u32,
+    },
+    /// Execute twice.
+    AlreadyExecuted {
+        /// Proposal in question.
+        proposal: u32,
+    },
+    /// Veto after the sunset block.
+    VetoSunset,
+}
+
+impl fmt::Display for E8Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::NotCollectionOwner { actor } => {
+                write!(f, "E8: not collection owner ({actor})")
+            }
+            Self::TokenExists { id } => write!(f, "E8: token already exists ({id})"),
+            Self::TokenMissing { id } => write!(f, "E8: token does not exist ({id})"),
+            Self::NotTokenOwner { actor, id } => {
+                write!(f, "E8: not token owner ({actor}/{id})")
+            }
+            Self::NotApproved { actor, id } => {
+                write!(f, "E8: not approved ({actor}/{id})")
+            }
+            Self::ZeroAddress => write!(f, "E8: zero address"),
+            Self::ZeroAmount => write!(f, "E8: amount must be positive"),
+            Self::Insufficient {
+                actor,
+                id,
+                have,
+                need,
+            } => write!(f, "E8: insufficient balance ({actor}/{id}/{have}/{need})"),
+            Self::BatchLen { ids, amounts } => {
+                write!(f, "E8: batch length mismatch ({ids}/{amounts})")
+            }
+            Self::NameTaken { name } => {
+                write!(f, "E8: name already registered ({name})")
+            }
+            Self::NameMissing { name } => {
+                write!(f, "E8: name not registered ({name})")
+            }
+            Self::InvalidName { name } => write!(f, "E8: invalid name ({name})"),
+            Self::NameExpired { name } => write!(f, "E8: name expired ({name})"),
+            Self::NotNameOwner { actor, name } => {
+                write!(f, "E8: not name owner ({actor}/{name})")
+            }
+            Self::NoIdentity { name } => {
+                write!(f, "E8: no identity record ({name})")
+            }
+            Self::ProposalMissing { id } => {
+                write!(f, "E8: proposal not found ({id})")
+            }
+            Self::BelowProposalThreshold { proposer } => {
+                write!(f, "E8: below proposal threshold ({proposer})")
+            }
+            Self::VoteCast { proposal, voter } => {
+                write!(f, "E8: vote already cast ({proposal}/{voter})")
+            }
+            Self::NoVotingPower { voter } => {
+                write!(f, "E8: no voting power ({voter})")
+            }
+            Self::VotingClosed { proposal } => {
+                write!(f, "E8: voting closed ({proposal})")
+            }
+            Self::VotingStillOpen { proposal } => {
+                write!(f, "E8: voting still open ({proposal})")
+            }
+            Self::AlreadyFinalized { proposal } => {
+                write!(f, "E8: proposal already finalized ({proposal})")
+            }
+            Self::NotPassed { proposal } => write!(f, "E8: not passed ({proposal})"),
+            Self::TimelockNotReached { proposal } => {
+                write!(f, "E8: timelock not reached ({proposal})")
+            }
+            Self::AlreadyExecuted { proposal } => {
+                write!(f, "E8: already executed ({proposal})")
+            }
+            Self::VetoSunset => write!(f, "E8: veto power has sunset"),
+        }
+    }
+}
+
+impl std::error::Error for E8Error {}
+
+/// One `.aura` name record.
+#[derive(Debug, Clone)]
+struct NameRecord {
+    owner: String,
+    target: String,
+    expiry: u64,
+}
+
+/// The deterministic E8 model: ARC-721 + ARC-1155 + names + identity.
+#[derive(Debug, Clone, Default)]
+pub struct NftWorld {
+    owner721: BTreeMap<u64, String>,
+    approved: BTreeMap<u64, String>,
+    bal721: BTreeMap<String, u128>,
+    supply721: u128,
+    bal1155: BTreeMap<(String, u64), u128>,
+    supply1155: BTreeMap<u64, u128>,
+    uri1155: BTreeMap<u64, String>,
+    operator: BTreeMap<(String, String), bool>,
+    names: BTreeMap<String, NameRecord>,
+    primary: BTreeMap<String, String>,
+    identity: BTreeMap<String, String>,
+    day: u64,
+}
+
+impl NftWorld {
+    /// Fresh empty world.
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    fn bal721_of(&self, who: &str) -> u128 {
+        self.bal721.get(who).copied().unwrap_or(0)
+    }
+
+    fn bal1155_of(&self, who: &str, id: u64) -> u128 {
+        self.bal1155
+            .get(&(String::from(who), id))
+            .copied()
+            .unwrap_or(0)
+    }
+
+    // ------------------------------------------------------------ 721
+
+    /// Mint a fresh token id to `to`; collection owner only.
+    pub fn mint721(&mut self, by: &str, to: &str, id: u64) -> Result<(), E8Error> {
+        if by != "root" {
+            return Err(E8Error::NotCollectionOwner {
+                actor: String::from(by),
+            });
+        }
+        if to == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        if self.owner721.contains_key(&id) {
+            return Err(E8Error::TokenExists { id });
+        }
+        self.owner721.insert(id, String::from(to));
+        *self.bal721.entry(String::from(to)).or_insert(0) += 1;
+        self.supply721 += 1;
+        Ok(())
+    }
+
+    /// Transfer a token the caller owns; clears the approval slot.
+    pub fn transfer721(&mut self, by: &str, id: u64, to: &str) -> Result<(), E8Error> {
+        match self.owner721.get(&id) {
+            None => return Err(E8Error::TokenMissing { id }),
+            Some(owner) if owner != by => {
+                return Err(E8Error::NotTokenOwner {
+                    actor: String::from(by),
+                    id,
+                });
+            }
+            Some(_) => {}
+        }
+        if to == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        *self.bal721.entry(String::from(by)).or_insert(0) -= 1;
+        *self.bal721.entry(String::from(to)).or_insert(0) += 1;
+        self.owner721.insert(id, String::from(to));
+        self.approved.remove(&id);
+        Ok(())
+    }
+
+    /// Approve a spender for one token (owner only).
+    pub fn approve721(&mut self, by: &str, id: u64, spender: &str) -> Result<(), E8Error> {
+        match self.owner721.get(&id) {
+            None => return Err(E8Error::TokenMissing { id }),
+            Some(owner) if owner != by => {
+                return Err(E8Error::NotTokenOwner {
+                    actor: String::from(by),
+                    id,
+                });
+            }
+            Some(_) => {}
+        }
+        if spender == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        self.approved.insert(id, String::from(spender));
+        Ok(())
+    }
+
+    /// Move a token on behalf of its owner (approved spender only);
+    /// clears the approval slot exactly like an owner transfer.
+    pub fn transfer_from721(&mut self, by: &str, id: u64, to: &str) -> Result<(), E8Error> {
+        if !self.owner721.contains_key(&id) {
+            return Err(E8Error::TokenMissing { id });
+        }
+        if to == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        if self.approved.get(&id).map(String::as_str) != Some(by) {
+            return Err(E8Error::NotApproved {
+                actor: String::from(by),
+                id,
+            });
+        }
+        let from = self.owner721.get(&id).cloned().expect("checked");
+        *self.bal721.entry(from).or_insert(0) -= 1;
+        *self.bal721.entry(String::from(to)).or_insert(0) += 1;
+        self.owner721.insert(id, String::from(to));
+        self.approved.remove(&id);
+        Ok(())
+    }
+
+    /// Destroy a token the caller owns; the id may be minted again.
+    pub fn burn721(&mut self, by: &str, id: u64) -> Result<(), E8Error> {
+        match self.owner721.get(&id) {
+            None => return Err(E8Error::TokenMissing { id }),
+            Some(owner) if owner != by => {
+                return Err(E8Error::NotTokenOwner {
+                    actor: String::from(by),
+                    id,
+                });
+            }
+            Some(_) => {}
+        }
+        self.owner721.remove(&id);
+        self.approved.remove(&id);
+        *self.bal721.entry(String::from(by)).or_insert(0) -= 1;
+        self.supply721 -= 1;
+        Ok(())
+    }
+
+    /// Owner of a token (fails if absent).
+    pub fn owner_of(&self, id: u64) -> Result<&str, E8Error> {
+        self.owner721
+            .get(&id)
+            .map(String::as_str)
+            .ok_or(E8Error::TokenMissing { id })
+    }
+
+    /// Approved spender of a token (`"none"` when unset).
+    pub fn get_approved(&self, id: u64) -> &str {
+        self.approved.get(&id).map(String::as_str).unwrap_or("none")
+    }
+
+    /// How many 721 tokens `who` holds.
+    pub fn balance721(&self, who: &str) -> u128 {
+        self.bal721_of(who)
+    }
+
+    /// How many 721 tokens exist.
+    pub fn supply721(&self) -> u128 {
+        self.supply721
+    }
+
+    /// Resolve one fixture read key (`owner_of:1`, `balance721:alice`,
+    /// `supply721`, `approved:1`, `balance1155:alice:100`,
+    /// `supply1155:100`, `uri:100`, `resolve:alice.aura`,
+    /// `name_owner:alice.aura`, `expiry:alice.aura`, `reverse:bob`,
+    /// `identity:alice.aura`) to its exact value string. Absent values
+    /// read `"none"`.
+    pub fn query(&self, key: &str) -> String {
+        let (head, rest) = key.split_once(':').unwrap_or((key, ""));
+        match head {
+            "owner_of" => {
+                let id: u64 = rest.parse().expect("owner_of id");
+                self.owner721
+                    .get(&id)
+                    .cloned()
+                    .unwrap_or_else(|| String::from("none"))
+            }
+            "approved" => {
+                let id: u64 = rest.parse().expect("approved id");
+                String::from(self.get_approved(id))
+            }
+            "supply721" => self.supply721.to_string(),
+            "balance721" => self.bal721_of(rest).to_string(),
+            "balance1155" => {
+                let (who, id) = rest.rsplit_once(':').expect("balance1155 who:id");
+                let id: u64 = id.parse().expect("balance1155 id");
+                self.bal1155_of(who, id).to_string()
+            }
+            "supply1155" => {
+                let id: u64 = rest.parse().expect("supply1155 id");
+                self.supply1155(id).to_string()
+            }
+            "uri" => {
+                let id: u64 = rest.parse().expect("uri id");
+                String::from(self.uri(id))
+            }
+            "resolve" => self.resolve(rest, self.day).unwrap_or("none").to_string(),
+            "name_owner" => self.name_owner(rest).unwrap_or("none").to_string(),
+            "expiry" => self
+                .name_expiry(rest)
+                .map(|d| d.to_string())
+                .unwrap_or_else(|_| String::from("none")),
+            "reverse" => String::from(self.reverse(rest)),
+            "identity" => self.identity(rest).unwrap_or("none").to_string(),
+            "day" => self.day.to_string(),
+            "operator" => {
+                let (holder, op) = rest.rsplit_once(':').expect("operator holder:op");
+                let on = self
+                    .operator
+                    .get(&(String::from(holder), String::from(op)))
+                    .copied()
+                    .unwrap_or(false);
+                String::from(if on { "true" } else { "false" })
+            }
+            other => panic!("unknown read key: {other}"),
+        }
+    }
+
+    // ----------------------------------------------------------- 1155
+
+    /// Mint `amount` of id `to`; collection owner only.
+    pub fn mint1155(&mut self, by: &str, to: &str, id: u64, amount: u128) -> Result<(), E8Error> {
+        if by != "root" {
+            return Err(E8Error::NotCollectionOwner {
+                actor: String::from(by),
+            });
+        }
+        if to == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        if amount == 0 {
+            return Err(E8Error::ZeroAmount);
+        }
+        *self.bal1155.entry((String::from(to), id)).or_insert(0) += amount;
+        *self.supply1155.entry(id).or_insert(0) += amount;
+        Ok(())
+    }
+
+    /// Move `amount` of id from `frm` to `to`; `by` must be `frm` or its
+    /// operator.
+    pub fn transfer1155(
+        &mut self,
+        frm: &str,
+        by: &str,
+        id: u64,
+        to: &str,
+        amount: u128,
+    ) -> Result<(), E8Error> {
+        if to == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        if amount == 0 {
+            return Err(E8Error::ZeroAmount);
+        }
+        let approved = by == frm
+            || self
+                .operator
+                .get(&(String::from(frm), String::from(by)))
+                .copied()
+                .unwrap_or(false);
+        if !approved {
+            return Err(E8Error::NotApproved {
+                actor: String::from(by),
+                id,
+            });
+        }
+        let have = self.bal1155_of(frm, id);
+        if have < amount {
+            return Err(E8Error::Insufficient {
+                actor: String::from(frm),
+                id,
+                have,
+                need: amount,
+            });
+        }
+        self.bal1155.insert((String::from(frm), id), have - amount);
+        *self.bal1155.entry((String::from(to), id)).or_insert(0) += amount;
+        Ok(())
+    }
+
+    /// Grant or revoke `operator` over the caller's 1155 balances.
+    pub fn set_operator(
+        &mut self,
+        by: &str,
+        operator: &str,
+        approved: bool,
+    ) -> Result<(), E8Error> {
+        if operator == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        self.operator
+            .insert((String::from(by), String::from(operator)), approved);
+        Ok(())
+    }
+
+    /// All-or-nothing batch move; every leg is checked before any is
+    /// applied.
+    pub fn transfer_batch1155(
+        &mut self,
+        frm: &str,
+        by: &str,
+        to: &str,
+        ids: &[u64],
+        amounts: &[u128],
+    ) -> Result<(), E8Error> {
+        if ids.len() != amounts.len() {
+            return Err(E8Error::BatchLen {
+                ids: ids.len(),
+                amounts: amounts.len(),
+            });
+        }
+        if to == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        let approved = by == frm
+            || self
+                .operator
+                .get(&(String::from(frm), String::from(by)))
+                .copied()
+                .unwrap_or(false);
+        if !approved {
+            return Err(E8Error::NotApproved {
+                actor: String::from(by),
+                id: ids[0],
+            });
+        }
+        for (id, amount) in ids.iter().zip(amounts) {
+            if *amount == 0 {
+                return Err(E8Error::ZeroAmount);
+            }
+            let have = self.bal1155_of(frm, *id);
+            if have < *amount {
+                return Err(E8Error::Insufficient {
+                    actor: String::from(frm),
+                    id: *id,
+                    have,
+                    need: *amount,
+                });
+            }
+        }
+        for (id, amount) in ids.iter().zip(amounts) {
+            let have = self.bal1155_of(frm, *id);
+            self.bal1155.insert((String::from(frm), *id), have - amount);
+            *self.bal1155.entry((String::from(to), *id)).or_insert(0) += amount;
+        }
+        Ok(())
+    }
+
+    /// Set the metadata URI of an id; collection owner only.
+    pub fn set_uri(&mut self, by: &str, id: u64, uri: &str) -> Result<(), E8Error> {
+        if by != "root" {
+            return Err(E8Error::NotCollectionOwner {
+                actor: String::from(by),
+            });
+        }
+        self.uri1155.insert(id, String::from(uri));
+        Ok(())
+    }
+
+    /// URI of an id (`"none"` when unset).
+    pub fn uri(&self, id: u64) -> &str {
+        self.uri1155.get(&id).map(String::as_str).unwrap_or("none")
+    }
+
+    /// How much of id `who` holds.
+    pub fn balance1155(&self, who: &str, id: u64) -> u128 {
+        self.bal1155_of(who, id)
+    }
+
+    /// Circulating supply of id.
+    pub fn supply1155(&self, id: u64) -> u128 {
+        self.supply1155.get(&id).copied().unwrap_or(0)
+    }
+
+    // ----------------------------------------------------------- names
+
+    /// A `.aura` name: lowercase label 1..=32 of `a-z0-9-`, alphanumeric
+    /// at both ends, plus the `.aura` suffix.
+    pub fn valid_name(name: &str) -> bool {
+        let Some(label) = name.strip_suffix(".aura") else {
+            return false;
+        };
+        if label.is_empty() || label.len() > 32 {
+            return false;
+        }
+        let alnum = |c: char| c.is_ascii_lowercase() || c.is_ascii_digit();
+        if !label.chars().all(|c| alnum(c) || c == '-') {
+            return false;
+        }
+        alnum(label.chars().next().expect("non-empty"))
+            && alnum(label.chars().last().expect("non-empty"))
+    }
+
+    /// Register `name` to `by` at `day`; fails while the name is live or
+    /// in grace.
+    pub fn register_name(&mut self, by: &str, name: &str, day: u64) -> Result<(), E8Error> {
+        self.day = day;
+        if !Self::valid_name(name) {
+            return Err(E8Error::InvalidName {
+                name: String::from(name),
+            });
+        }
+        if self
+            .names
+            .get(name)
+            .is_some_and(|rec| day <= rec.expiry + GRACE_DAYS)
+        {
+            return Err(E8Error::NameTaken {
+                name: String::from(name),
+            });
+        }
+        self.names.insert(
+            String::from(name),
+            NameRecord {
+                owner: String::from(by),
+                target: String::from(by),
+                expiry: day + TERM_DAYS,
+            },
+        );
+        Ok(())
+    }
+
+    /// Extend a registration by [`TERM_DAYS`] (anyone may renew).
+    pub fn renew_name(&mut self, name: &str, day: u64) -> Result<(), E8Error> {
+        self.day = day;
+        let rec = self
+            .names
+            .get_mut(name)
+            .ok_or_else(|| E8Error::NameMissing {
+                name: String::from(name),
+            })?;
+        let base = day.max(rec.expiry);
+        rec.expiry = base + TERM_DAYS;
+        Ok(())
+    }
+
+    /// Transfer name ownership; clears the old owner's primary name.
+    pub fn transfer_name(
+        &mut self,
+        by: &str,
+        name: &str,
+        to: &str,
+        day: u64,
+    ) -> Result<(), E8Error> {
+        self.day = day;
+        let rec = self.names.get(name).ok_or_else(|| E8Error::NameMissing {
+            name: String::from(name),
+        })?;
+        if day > rec.expiry + GRACE_DAYS {
+            return Err(E8Error::NameExpired {
+                name: String::from(name),
+            });
+        }
+        if rec.owner != by {
+            return Err(E8Error::NotNameOwner {
+                actor: String::from(by),
+                name: String::from(name),
+            });
+        }
+        if to == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        if self.primary.get(by).map(String::as_str) == Some(name) {
+            self.primary.remove(by);
+        }
+        let rec = self.names.get_mut(name).expect("checked");
+        rec.owner = String::from(to);
+        Ok(())
+    }
+
+    /// Set the resolution target of a name (owner only, name live).
+    pub fn set_target(
+        &mut self,
+        by: &str,
+        name: &str,
+        target: &str,
+        day: u64,
+    ) -> Result<(), E8Error> {
+        self.day = day;
+        let rec = self.names.get(name).ok_or_else(|| E8Error::NameMissing {
+            name: String::from(name),
+        })?;
+        if day > rec.expiry + GRACE_DAYS {
+            return Err(E8Error::NameExpired {
+                name: String::from(name),
+            });
+        }
+        if rec.owner != by {
+            return Err(E8Error::NotNameOwner {
+                actor: String::from(by),
+                name: String::from(name),
+            });
+        }
+        if target == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        let rec = self.names.get_mut(name).expect("checked");
+        rec.target = String::from(target);
+        Ok(())
+    }
+
+    /// Resolve a name to its target; fails when unknown or past expiry +
+    /// grace.
+    pub fn resolve(&self, name: &str, day: u64) -> Result<&str, E8Error> {
+        let rec = self.names.get(name).ok_or_else(|| E8Error::NameMissing {
+            name: String::from(name),
+        })?;
+        if day > rec.expiry + GRACE_DAYS {
+            return Err(E8Error::NameExpired {
+                name: String::from(name),
+            });
+        }
+        Ok(&rec.target)
+    }
+
+    /// Set the caller's primary (reverse) name.
+    pub fn set_primary(&mut self, by: &str, name: &str, day: u64) -> Result<(), E8Error> {
+        self.day = day;
+        let rec = self.names.get(name).ok_or_else(|| E8Error::NameMissing {
+            name: String::from(name),
+        })?;
+        if day > rec.expiry + GRACE_DAYS {
+            return Err(E8Error::NameExpired {
+                name: String::from(name),
+            });
+        }
+        if rec.owner != by {
+            return Err(E8Error::NotNameOwner {
+                actor: String::from(by),
+                name: String::from(name),
+            });
+        }
+        self.primary.insert(String::from(by), String::from(name));
+        Ok(())
+    }
+
+    /// Reverse resolution: the primary name of `who` (`"none"`).
+    pub fn reverse(&self, who: &str) -> &str {
+        self.primary.get(who).map(String::as_str).unwrap_or("none")
+    }
+
+    /// Jump the clock (days are explicit in every name op).
+    pub fn advance_day(&mut self, day: u64) {
+        self.day = day;
+    }
+
+    /// Current day.
+    pub fn day(&self) -> u64 {
+        self.day
+    }
+
+    /// Owner of a registered name.
+    pub fn name_owner(&self, name: &str) -> Result<&str, E8Error> {
+        self.names
+            .get(name)
+            .map(|rec| rec.owner.as_str())
+            .ok_or_else(|| E8Error::NameMissing {
+                name: String::from(name),
+            })
+    }
+
+    /// Expiry day of a registered name.
+    pub fn name_expiry(&self, name: &str) -> Result<u64, E8Error> {
+        self.names
+            .get(name)
+            .map(|rec| rec.expiry)
+            .ok_or_else(|| E8Error::NameMissing {
+                name: String::from(name),
+            })
+    }
+
+    // -------------------------------------------------------- identity
+
+    /// Bind a metadata digest to a live name (owner only).
+    pub fn set_identity(
+        &mut self,
+        by: &str,
+        name: &str,
+        digest: &str,
+        day: u64,
+    ) -> Result<(), E8Error> {
+        self.day = day;
+        let rec = self.names.get(name).ok_or_else(|| E8Error::NameMissing {
+            name: String::from(name),
+        })?;
+        if day > rec.expiry + GRACE_DAYS {
+            return Err(E8Error::NameExpired {
+                name: String::from(name),
+            });
+        }
+        if rec.owner != by {
+            return Err(E8Error::NotNameOwner {
+                actor: String::from(by),
+                name: String::from(name),
+            });
+        }
+        self.identity
+            .insert(String::from(name), String::from(digest));
+        Ok(())
+    }
+
+    /// Remove the identity record (owner only).
+    pub fn clear_identity(&mut self, by: &str, name: &str) -> Result<(), E8Error> {
+        let rec = self.names.get(name).ok_or_else(|| E8Error::NameMissing {
+            name: String::from(name),
+        })?;
+        if rec.owner != by {
+            return Err(E8Error::NotNameOwner {
+                actor: String::from(by),
+                name: String::from(name),
+            });
+        }
+        self.identity.remove(name);
+        Ok(())
+    }
+
+    /// Read the identity digest of a name.
+    pub fn identity(&self, name: &str) -> Result<&str, E8Error> {
+        if !self.names.contains_key(name) {
+            return Err(E8Error::NameMissing {
+                name: String::from(name),
+            });
+        }
+        self.identity
+            .get(name)
+            .map(String::as_str)
+            .ok_or_else(|| E8Error::NoIdentity {
+                name: String::from(name),
+            })
+    }
+}
diff --git a/crates/aura-storage/src/oracle.rs b/crates/aura-storage/src/oracle.rs
new file mode 100644
index 0000000..293e745
--- /dev/null
+++ b/crates/aura-storage/src/oracle.rs
@@ -0,0 +1,413 @@
+//! E5 — Oracle: decentralized price feed network.
+//!
+//! A feed network of registered providers publishes signed price reports.
+//! A round aggregates them deterministically:
+//!
+//! 1. **admission** — every report must carry a valid ed25519 signature from a
+//!    registered provider, target this feed, be fresh (within
+//!    [`E5_MAX_STALENESS_SECS`] of `now`, never from the future) and appear at
+//!    most once per provider per round;
+//! 2. **quorum** — at least [`E5_MIN_QUORUM`] (N/2+1) admitted reports;
+//! 3. **aggregation** — median of admitted prices, then an outlier band
+//!    (±[`E5_DEVIATION_BPS`] bps around that median) drops manipulation
+//!    attempts, and the median of the survivors is published.
+//!
+//! The design follows the decentralized oracle network (DON) shape used by
+//! Chainlink-style feeds: N independent providers, median aggregation, a
+//! quorum floor, a heartbeat/staleness bound and outlier rejection. With
+//! fewer than half of the providers malicious the published median is the
+//! honest price: two liars among five cannot move it (the E5 property gate).
+//!
+//! Determinism: `submit` is a pure function of `(now, reports)` given the
+//! network configuration; the lower median (element `n/2` of the sorted
+//! slice) is used everywhere, including for the aggregate timestamp.
+//!
+//! Strict admission: any invalid report aborts the whole round with a typed
+//! error (named gate message). Production systems would quarantine bad
+//! reports and continue; the strict policy is chosen here so that every
+//! failure mode maps to exactly one red gate message under mutation testing.
+
+use aura_crypto::{sign_raw, verify_raw};
+
+/// Fixed-point price, 18 decimals (same scale as [`crate::econ::Amount`]).
+pub type Price = u128;
+
+/// Heartbeat / staleness bound in seconds (Chainlink-like 1-hour heartbeat).
+pub const E5_MAX_STALENESS_SECS: u64 = 3600;
+
+/// Minimum number of admitted reports per round (N/2+1 for the 5-provider
+/// reference network; a round cannot finalize below this).
+pub const E5_MIN_QUORUM: usize = 3;
+
+/// Outlier band around the provisional median, in basis points (5%).
+pub const E5_DEVIATION_BPS: u64 = 500;
+
+/// Fixed-point multiplier matching the 18-decimal price scale.
+pub const E5_ONE: Price = 1_000_000_000_000_000_000;
+
+/// Every way a round can fail. Each variant maps to exactly one named gate
+/// message, used verbatim by the negative controls in `tools/nc_e5.py`.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum E5Error {
+    /// The round received no reports at all.
+    NoReports,
+    /// A report came from a provider that is not registered.
+    UnknownProvider {
+        /// Offending provider id.
+        provider: u32,
+    },
+    /// A provider submitted more than one report in the same round.
+    DuplicateProvider {
+        /// Offending provider id.
+        provider: u32,
+    },
+    /// A report targets a different feed than the network serves.
+    FeedMismatch {
+        /// Offending provider id.
+        provider: u32,
+    },
+    /// A report's ed25519 signature does not verify against the provider key.
+    BadSignature {
+        /// Offending provider id.
+        provider: u32,
+    },
+    /// A report is older than the staleness bound or comes from the future.
+    Stale {
+        /// Offending provider id.
+        provider: u32,
+        /// Report timestamp.
+        timestamp: u64,
+        /// Round logical time.
+        now: u64,
+    },
+    /// Fewer than `quorum` reports were admitted.
+    Quorum {
+        /// Admitted report count.
+        valid: usize,
+        /// Quorum floor in force.
+        required: usize,
+    },
+}
+
+impl std::fmt::Display for E5Error {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::NoReports => write!(f, "E5: round requires at least one report"),
+            Self::UnknownProvider { provider } => {
+                write!(f, "E5: report from unregistered provider {provider}")
+            }
+            Self::DuplicateProvider { provider } => {
+                write!(
+                    f,
+                    "E5: one report per provider per round (provider {provider})"
+                )
+            }
+            Self::FeedMismatch { provider } => {
+                write!(
+                    f,
+                    "E5: all reports must target this feed (provider {provider})"
+                )
+            }
+            Self::BadSignature { provider } => {
+                write!(
+                    f,
+                    "E5: provider report signature must verify (provider {provider})"
+                )
+            }
+            Self::Stale {
+                provider,
+                timestamp,
+                now,
+            } => write!(
+                f,
+                "E5: provider report must be fresh (provider {provider}, ts {timestamp}, now {now})"
+            ),
+            Self::Quorum { valid, required } => write!(
+                f,
+                "E5: oracle requires a quorum of provider reports ({valid}/{required})"
+            ),
+        }
+    }
+}
+
+/// A registered feed provider with an ed25519 verification key.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Provider {
+    /// Stable provider identifier used in reports.
+    pub id: u32,
+    /// Ed25519 verification key of the provider.
+    pub pubkey: [u8; 32],
+}
+
+/// One signed price observation from a provider.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PriceReport {
+    /// Authoring provider id.
+    pub provider: u32,
+    /// Feed identifier (e.g. `b"ALCRY/USD......."`).
+    pub feed: [u8; 16],
+    /// Quoted price, 18 decimals.
+    pub price: Price,
+    /// Observation time (logical seconds).
+    pub timestamp: u64,
+    /// Ed25519 signature over the canonical signing message.
+    pub signature: [u8; 64],
+}
+
+impl PriceReport {
+    /// Canonical signing message: `feed (16) || price (16, BE) || timestamp (8, BE)`.
+    pub fn signing_message(feed: &[u8; 16], price: Price, timestamp: u64) -> Vec<u8> {
+        let mut out = Vec::with_capacity(40);
+        out.extend_from_slice(feed);
+        out.extend_from_slice(&price.to_be_bytes());
+        out.extend_from_slice(&timestamp.to_be_bytes());
+        out
+    }
+
+    /// Build a report signed with the provider's ed25519 seed.
+    pub fn sign(
+        seed: &[u8; 32],
+        provider: u32,
+        feed: [u8; 16],
+        price: Price,
+        timestamp: u64,
+    ) -> Self {
+        let message = Self::signing_message(&feed, price, timestamp);
+        let signature = sign_raw(seed, &message);
+        Self {
+            provider,
+            feed,
+            price,
+            timestamp,
+            signature,
+        }
+    }
+
+    /// Verify the report signature against a provider public key.
+    pub fn verify(&self, pubkey: &[u8; 32]) -> bool {
+        let message = Self::signing_message(&self.feed, self.price, self.timestamp);
+        verify_raw(pubkey, &message, &self.signature).is_ok()
+    }
+}
+
+/// The published result of one round.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct AggregatedPrice {
+    /// Feed this aggregate belongs to.
+    pub feed: [u8; 16],
+    /// Final price: median of the reports that survived the outlier band.
+    pub price: Price,
+    /// Median timestamp of the surviving reports (lower median).
+    pub timestamp: u64,
+    /// Reports admitted by the admission stage.
+    pub admitted: usize,
+    /// Reports dropped by the outlier band.
+    pub rejected_outliers: usize,
+}
+
+/// A price feed network: registered providers + aggregation policy.
+#[derive(Debug, Clone)]
+pub struct OracleNetwork {
+    feed: [u8; 16],
+    providers: Vec<Provider>,
+    quorum: usize,
+    max_staleness: u64,
+    deviation_bps: u64,
+    latest: Option<AggregatedPrice>,
+}
+
+impl OracleNetwork {
+    /// Build a network with the default policy: quorum = N/2+1 (never below
+    /// [`E5_MIN_QUORUM`]), staleness [`E5_MAX_STALENESS_SECS`], outlier band
+    /// [`E5_DEVIATION_BPS`].
+    pub fn new(feed: [u8; 16], providers: Vec<Provider>) -> Self {
+        let n = providers.len();
+        let quorum = std::cmp::max(n / 2 + 1, E5_MIN_QUORUM.min(n.max(1)));
+        Self {
+            feed,
+            providers,
+            quorum,
+            max_staleness: E5_MAX_STALENESS_SECS,
+            deviation_bps: E5_DEVIATION_BPS,
+            latest: None,
+        }
+    }
+
+    /// Override the quorum floor (used by tests and negative controls).
+    pub fn with_quorum(mut self, quorum: usize) -> Self {
+        self.quorum = quorum;
+        self
+    }
+
+    /// Override the staleness bound in seconds.
+    pub fn with_staleness(mut self, secs: u64) -> Self {
+        self.max_staleness = secs;
+        self
+    }
+
+    /// Override the outlier band in basis points.
+    pub fn with_deviation(mut self, bps: u64) -> Self {
+        self.deviation_bps = bps;
+        self
+    }
+
+    /// Quorum floor currently in force.
+    pub fn quorum(&self) -> usize {
+        self.quorum
+    }
+
+    /// The feed this network serves.
+    pub fn feed(&self) -> [u8; 16] {
+        self.feed
+    }
+
+    /// Registered provider count.
+    pub fn provider_count(&self) -> usize {
+        self.providers.len()
+    }
+
+    /// Latest published aggregate, if any round finalized.
+    pub fn latest(&self) -> Option<&AggregatedPrice> {
+        self.latest.as_ref()
+    }
+
+    /// Aggregate one round of reports at logical time `now`.
+    ///
+    /// Admission is strict: any single invalid report aborts the round with
+    /// its own error variant so that negative controls can pin exactly one
+    /// named message per mutation.
+    pub fn submit(
+        &mut self,
+        now: u64,
+        reports: Vec<PriceReport>,
+    ) -> Result<AggregatedPrice, E5Error> {
+        if reports.is_empty() {
+            return Err(E5Error::NoReports);
+        }
+
+        let mut seen = Vec::with_capacity(reports.len());
+        let mut admitted: Vec<PriceReport> = Vec::with_capacity(reports.len());
+
+        for report in &reports {
+            let provider = self
+                .providers
+                .iter()
+                .find(|p| p.id == report.provider)
+                .ok_or(E5Error::UnknownProvider {
+                    provider: report.provider,
+                })?;
+
+            if seen.contains(&report.provider) {
+                return Err(E5Error::DuplicateProvider {
+                    provider: report.provider,
+                });
+            }
+            seen.push(report.provider);
+
+            if report.feed != self.feed {
+                return Err(E5Error::FeedMismatch {
+                    provider: report.provider,
+                });
+            }
+
+            if !report.verify(&provider.pubkey) {
+                return Err(E5Error::BadSignature {
+                    provider: report.provider,
+                });
+            }
+
+            let fresh = report.timestamp <= now
+                && now.saturating_sub(report.timestamp) <= self.max_staleness;
+            if !fresh {
+                return Err(E5Error::Stale {
+                    provider: report.provider,
+                    timestamp: report.timestamp,
+                    now,
+                });
+            }
+
+            admitted.push(report.clone());
+        }
+
+        if admitted.len() < self.quorum {
+            return Err(E5Error::Quorum {
+                valid: admitted.len(),
+                required: self.quorum,
+            });
+        }
+
+        // Provisional median over all admitted prices.
+        let provisional = lower_median(admitted.iter().map(|r| r.price));
+
+        // Outlier band around the provisional median.
+        let admitted_count = admitted.len();
+        let (survivors, rejected_outliers): (Vec<PriceReport>, Vec<PriceReport>) = admitted
+            .into_iter()
+            .partition(|r| within_band(r.price, provisional, self.deviation_bps));
+
+        // The survivors are never empty: the provisional median is always
+        // within a zero-width band of itself.
+        let final_price = lower_median(survivors.iter().map(|r| r.price));
+        let final_ts = lower_median(survivors.iter().map(|r| r.timestamp));
+
+        let agg = AggregatedPrice {
+            feed: self.feed,
+            price: final_price,
+            timestamp: final_ts,
+            admitted: admitted_count,
+            rejected_outliers: rejected_outliers.len(),
+        };
+        self.latest = Some(agg.clone());
+        Ok(agg)
+    }
+}
+
+/// Lower median: element `n/2` of the ascending slice (deterministic for
+/// both odd and even lengths).
+fn lower_median<T: Ord + Copy>(values: impl Iterator<Item = T>) -> T {
+    let mut v: Vec<T> = values.collect();
+    v.sort_unstable();
+    v[v.len() / 2]
+}
+
+/// `true` when `price` is within `±band_bps` of `center` (0 bps = exact).
+fn within_band(price: Price, center: Price, band_bps: u64) -> bool {
+    let diff = price.abs_diff(center);
+    // diff * 10_000 <= band_bps * center, computed without overflow for the
+    // 18-decimal scale by dividing the right side first when needed.
+    diff.saturating_mul(10_000) <= (band_bps as u128).saturating_mul(center)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn seed_for(id: u32) -> [u8; 32] {
+        let mut seed = [0u8; 32];
+        seed[0] = id as u8;
+        seed[31] = 0xE5;
+        seed
+    }
+
+    fn provider(id: u32) -> Provider {
+        Provider {
+            id,
+            pubkey: aura_crypto::ed25519_public_key(&seed_for(id)),
+        }
+    }
+
+    #[test]
+    fn signing_message_round_trip() {
+        let feed = *b"ALCRY/USD.......";
+        let msg = PriceReport::signing_message(&feed, 3 * E5_ONE, 1_000);
+        assert_eq!(msg.len(), 40);
+    }
+
+    #[test]
+    fn report_verifies() {
+        let feed = *b"ALCRY/USD.......";
+        let p = provider(1);
+        let report = PriceReport::sign(&seed_for(1), 1, feed, E5_ONE, 500);
+        assert!(report.verify(&p.pubkey));
+    }
+}
diff --git a/crates/aura-storage/tests/e4_amm.rs b/crates/aura-storage/tests/e4_amm.rs
new file mode 100644
index 0000000..41ccae7
--- /dev/null
+++ b/crates/aura-storage/tests/e4_amm.rs
@@ -0,0 +1,321 @@
+//! E4 AMM gate suite (ECOSYSTEM_PLAN E4).
+//!
+//! Gate (literal): the constant-product invariant `k` never decreases
+//! across any swap; NC (literal): the slippage guard must hold —
+//! `min_out` above the quote goes red. Mutation controls live in
+//! `tools/nc_e4.py` (including "slippage guard off" -> red).
+
+use aura_storage::amm::{Amount, E4_ONE, E4Error, Pool, Token, swap_route, wide_ge};
+
+fn token_a() -> Token {
+    *b"ALCRY..........."
+}
+
+fn token_b() -> Token {
+    *b"AUSD............"
+}
+
+fn token_c() -> Token {
+    *b"ABTC............"
+}
+
+/// Pool AB seeded with 100 A / 200 B.
+fn pool_ab() -> Pool {
+    let mut pool = Pool::new(token_a(), token_b());
+    pool.add_liquidity(100 * E4_ONE, 200 * E4_ONE).unwrap();
+    pool
+}
+
+/// Pool BC seeded with 100 B / 300 C.
+fn pool_bc() -> Pool {
+    let mut pool = Pool::new(token_b(), token_c());
+    pool.add_liquidity(100 * E4_ONE, 300 * E4_ONE).unwrap();
+    pool
+}
+
+/// Gate (literal): across a deterministic swap sequence (both
+/// directions, wildly varying sizes, plus routes) the invariant
+/// `k = reserve_a * reserve_b` never decreases on any pool.
+#[test]
+fn e4_gate_k_never_decreases() {
+    let mut pools = [pool_ab(), pool_bc()];
+    let steps: Vec<(Token, Amount)> = vec![
+        (token_a(), E4_ONE),
+        (token_b(), E4_ONE),
+        (token_a(), 3 * E4_ONE),
+        (token_b(), 7 * E4_ONE / 10),
+        (token_a(), E4_ONE / 1000),
+        (token_b(), 50 * E4_ONE),
+        (token_a(), 25 * E4_ONE),
+        (token_b(), 1),
+        (token_a(), 1),
+        (token_b(), 3 * E4_ONE),
+    ];
+    for (token_in, amount_in) in steps {
+        let k0 = pools[0].invariant_k();
+        let out = pools[0].swap_exact_in(token_in, amount_in, 0).unwrap();
+        assert!(out > 0 || amount_in == 1, "swap must move value");
+        assert!(
+            wide_ge(&pools[0].invariant_k(), &k0),
+            "E4: k decreased on a swap ({token_in:?}, {amount_in})"
+        );
+    }
+    // Routes keep each hop's k non-decreasing too.
+    for amount in [E4_ONE, 5 * E4_ONE, E4_ONE / 3] {
+        let k_ab = pools[0].invariant_k();
+        let k_bc = pools[1].invariant_k();
+        let out = swap_route(&mut pools, &[token_a(), token_b(), token_c()], amount, 0).unwrap();
+        assert!(out > 0);
+        assert!(wide_ge(&pools[0].invariant_k(), &k_ab));
+        assert!(wide_ge(&pools[1].invariant_k(), &k_bc));
+    }
+}
+
+/// NC (literal): the slippage guard holds — a `min_out` above the
+/// quote is rejected with the named message.
+#[test]
+fn e4_nc_slippage_guard() {
+    let mut pool = pool_ab();
+    let quote = pool.get_amount_out(token_a(), E4_ONE).unwrap();
+    let err = pool
+        .swap_exact_in(token_a(), E4_ONE, quote + 1)
+        .expect_err("slippage guard must trip");
+    assert_eq!(
+        err.to_string(),
+        format!(
+            "E4: slippage guard: output {quote} below minimum {}",
+            quote + 1
+        )
+    );
+    assert!(matches!(
+        err,
+        E4Error::Slippage { out, min_out } if out == quote && min_out == quote + 1
+    ));
+}
+
+/// Golden quote: 1 A into (100 A, 200 B) at 30 bps.
+#[test]
+fn e4_swap_golden() {
+    let mut pool = pool_ab();
+    let out = pool.swap_exact_in(token_a(), E4_ONE, 0).unwrap();
+    assert_eq!(out, 1_974_316_068_794_122_597);
+    assert_eq!(pool.reserve_a(), 101 * E4_ONE);
+    assert_eq!(pool.reserve_b(), 198_025_683_931_205_877_403u128);
+}
+
+/// Any fee-bearing swap grows `k` strictly.
+#[test]
+fn e4_swap_fee_grows_k_strictly() {
+    let mut pool = pool_ab();
+    let k0 = pool.invariant_k();
+    pool.swap_exact_in(token_a(), E4_ONE, 0).unwrap();
+    let k1 = pool.invariant_k();
+    assert!(wide_ge(&k1, &k0));
+    assert_ne!(k1, k0, "E4: fee must grow k strictly");
+}
+
+/// Initial mint: LP supply = amount_a + amount_b (explained deviation).
+#[test]
+fn e4_mint_initial() {
+    let mut pool = Pool::new(token_a(), token_b());
+    let lp = pool.add_liquidity(100 * E4_ONE, 200 * E4_ONE).unwrap();
+    assert_eq!(lp, 300 * E4_ONE);
+    assert_eq!(pool.lp_supply(), 300 * E4_ONE);
+}
+
+/// Proportional mint mints `a * S / ra` shares and keeps price.
+#[test]
+fn e4_mint_proportional() {
+    let mut pool = pool_ab();
+    let lp = pool.add_liquidity(50 * E4_ONE, 100 * E4_ONE).unwrap();
+    assert_eq!(lp, 150 * E4_ONE);
+    assert_eq!(pool.lp_supply(), 450 * E4_ONE);
+    assert_eq!(pool.reserve_a(), 150 * E4_ONE);
+    assert_eq!(pool.reserve_b(), 300 * E4_ONE);
+}
+
+#[test]
+fn e4_mint_ratio_rejected() {
+    let mut pool = pool_ab();
+    let err = pool
+        .add_liquidity(50 * E4_ONE, 90 * E4_ONE)
+        .expect_err("unbalanced mint must abort");
+    assert_eq!(
+        err.to_string(),
+        "E4: mint amounts must be proportional to reserves"
+    );
+}
+
+#[test]
+fn e4_mint_zero_rejected() {
+    let mut pool = Pool::new(token_a(), token_b());
+    let err = pool
+        .add_liquidity(0, E4_ONE)
+        .expect_err("zero initial mint must abort");
+    assert_eq!(
+        err.to_string(),
+        "E4: initial mint amounts must both be positive"
+    );
+}
+
+/// Add then burn all: pro-rata amounts come back (exact here).
+#[test]
+fn e4_burn_round_trip() {
+    let mut pool = pool_ab();
+    let lp = pool.add_liquidity(50 * E4_ONE, 100 * E4_ONE).unwrap();
+    let (back_a, back_b) = pool.remove_liquidity(lp).unwrap();
+    assert_eq!((back_a, back_b), (50 * E4_ONE, 100 * E4_ONE));
+    assert_eq!(pool.lp_supply(), 300 * E4_ONE);
+    let (rest_a, rest_b) = pool.remove_liquidity(pool.lp_supply()).unwrap();
+    assert_eq!((rest_a, rest_b), (100 * E4_ONE, 200 * E4_ONE));
+}
+
+#[test]
+fn e4_burn_exceeds_rejected() {
+    let mut pool = pool_ab();
+    let err = pool
+        .remove_liquidity(300 * E4_ONE + 1)
+        .expect_err("over-burn must abort");
+    assert_eq!(
+        err.to_string(),
+        "E4: burn exceeds LP supply (300000000000000000001/300000000000000000000)"
+    );
+}
+
+#[test]
+fn e4_swap_zero_input_rejected() {
+    let mut pool = pool_ab();
+    let err = pool
+        .swap_exact_in(token_a(), 0, 0)
+        .expect_err("zero input must abort");
+    assert_eq!(err.to_string(), "E4: swap input must be positive");
+}
+
+#[test]
+fn e4_swap_empty_pool_rejected() {
+    let mut pool = Pool::new(token_a(), token_b());
+    let err = pool
+        .swap_exact_in(token_a(), E4_ONE, 0)
+        .expect_err("empty pool must abort");
+    assert_eq!(err.to_string(), "E4: pool has no liquidity");
+}
+
+#[test]
+fn e4_swap_unknown_token_rejected() {
+    let mut pool = pool_ab();
+    let err = pool
+        .swap_exact_in(token_c(), E4_ONE, 0)
+        .expect_err("foreign token must abort");
+    assert!(matches!(err, E4Error::TokenNotInPool { .. }));
+    assert_eq!(
+        err.to_string(),
+        format!("E4: swap token not in pool ({:?})", token_c())
+    );
+}
+
+/// Golden route: 1 A -> B -> C through (100/200) and (100/300).
+#[test]
+fn e4_route_two_hops_golden() {
+    let ab = pool_ab();
+    let bc = pool_bc();
+    let out = swap_route(
+        &mut [ab.clone(), bc.clone()],
+        &[token_a(), token_b(), token_c()],
+        E4_ONE,
+        0,
+    )
+    .unwrap();
+    assert_eq!(out, 5_791_186_053_878_244_695);
+}
+
+#[test]
+fn e4_route_slippage_guard() {
+    let ab = pool_ab();
+    let bc = pool_bc();
+    let out = swap_route(
+        &mut [ab.clone(), bc.clone()],
+        &[token_a(), token_b(), token_c()],
+        E4_ONE,
+        5_791_186_053_878_244_695 + 1,
+    )
+    .expect_err("route slippage guard must trip");
+    assert!(matches!(out, E4Error::Slippage { .. }));
+}
+
+#[test]
+fn e4_route_short_rejected() {
+    let ab = pool_ab();
+    let err =
+        swap_route(&mut [ab], &[token_a()], E4_ONE, 0).expect_err("one-token path must abort");
+    assert_eq!(err.to_string(), "E4: route must contain at least one hop");
+    let ab = pool_ab();
+    let err = swap_route(&mut [ab], &[token_a(), token_b(), token_c()], E4_ONE, 0)
+        .expect_err("undersized pools must abort");
+    assert_eq!(err.to_string(), "E4: route must contain at least one hop");
+}
+
+#[test]
+fn e4_route_token_mismatch_rejected() {
+    let ab = pool_ab();
+    let bc = pool_bc();
+    let err = swap_route(&mut [ab, bc], &[token_a(), token_c(), token_b()], E4_ONE, 0)
+        .expect_err("mismatched hop must abort");
+    assert!(matches!(err, E4Error::TokenNotInPool { .. }));
+}
+
+/// Metamorphic: splitting an order in two never beats one piece
+/// (double fee, convex curve).
+#[test]
+fn e4_metamorphic_split_swap() {
+    let mut single = pool_ab();
+    let one_piece = single.swap_exact_in(token_a(), 2 * E4_ONE, 0).unwrap();
+    assert_eq!(one_piece, 3_910_033_923_564_131_223);
+
+    let mut split = pool_ab();
+    let first = split.swap_exact_in(token_a(), E4_ONE, 0).unwrap();
+    let second = split.swap_exact_in(token_a(), E4_ONE, 0).unwrap();
+    assert_eq!(first + second, 3_909_976_989_011_504_086);
+    assert!(
+        first + second <= one_piece,
+        "E4: split must not beat single"
+    );
+}
+
+/// Determinism: the same round of operations twice -> identical state.
+#[test]
+fn e4_deterministic_repeat() {
+    let run = || -> (Amount, Amount, Amount) {
+        let mut pool = pool_ab();
+        let lp = pool.add_liquidity(5 * E4_ONE, 10 * E4_ONE).unwrap();
+        let out1 = pool.swap_exact_in(token_a(), E4_ONE, 0).unwrap();
+        let (ra, _rb) = pool.remove_liquidity(lp / 2).unwrap();
+        (out1, lp, ra)
+    };
+    assert_eq!(run(), run(), "E4: pool math must be deterministic");
+}
+
+/// Zero-fee swaps keep `k` exactly constant (pure curve, floor rounding
+/// still cannot decrease it).
+#[test]
+fn e4_zero_fee_keeps_k() {
+    let mut pool = pool_ab().with_fee(0);
+    let k0 = pool.invariant_k();
+    pool.swap_exact_in(token_a(), E4_ONE, 0).unwrap();
+    let k1 = pool.invariant_k();
+    assert!(wide_ge(&k1, &k0), "E4: floor rounding must not decrease k");
+}
+
+/// Final-rescue: the route helper returns the last hop output even on
+/// a two-pool path when the middle quote rounds down.
+#[test]
+fn e4_route_result_is_last_output() {
+    let ab = pool_ab();
+    let bc = pool_bc();
+    // Manual hops on pristine clones must equal the route run on the
+    // same pristine pools.
+    let mid = ab.clone().swap_exact_in(token_a(), E4_ONE, 0).unwrap();
+    let manual = bc.clone().swap_exact_in(token_b(), mid, 0).unwrap();
+    let route_out =
+        swap_route(&mut [ab, bc], &[token_a(), token_b(), token_c()], E4_ONE, 0).unwrap();
+    assert_eq!(route_out, manual);
+}
diff --git a/crates/aura-storage/tests/e5_oracle.rs b/crates/aura-storage/tests/e5_oracle.rs
new file mode 100644
index 0000000..209802d
--- /dev/null
+++ b/crates/aura-storage/tests/e5_oracle.rs
@@ -0,0 +1,298 @@
+//! E5 oracle gate suite (ECOSYSTEM_PLAN E5).
+//!
+//! Gate: 5 providers, 2 malicious -> price unchanged (the two liars cannot
+//! move the median); NC: one provider -> red (`E5: oracle requires a quorum
+//! of provider reports`). Mutation controls live in `tools/nc_e5.py`.
+
+use aura_crypto::ed25519_public_key;
+use aura_storage::oracle::{
+    AggregatedPrice, E5_ONE, E5Error, OracleNetwork, Price, PriceReport, Provider,
+};
+
+const FEED: [u8; 16] = *b"ALCRY/USD.......";
+
+fn seed_for(id: u32) -> [u8; 32] {
+    let mut seed = [0u8; 32];
+    seed[0] = id as u8;
+    seed[31] = 0xE5;
+    seed
+}
+
+fn provider(id: u32) -> Provider {
+    Provider {
+        id,
+        pubkey: ed25519_public_key(&seed_for(id)),
+    }
+}
+
+fn five_provider_network() -> OracleNetwork {
+    OracleNetwork::new(FEED, (1..=5).map(provider).collect())
+}
+
+fn report(id: u32, price: Price, timestamp: u64) -> PriceReport {
+    PriceReport::sign(&seed_for(id), id, FEED, price, timestamp)
+}
+
+/// Gate (literal): 5 providers, 2 malicious -> price unchanged.
+///
+/// The three honest providers quote 100.00, 100.10 and 99.90 (18 decimals);
+/// the two liars quote x100 manipulation values. The published price must be
+/// the honest median.
+#[test]
+fn e5_property_two_malicious_do_not_move_price() {
+    let mut net = five_provider_network();
+    let now: u64 = 1_000_000;
+
+    let honest: Vec<Price> = vec![
+        100 * E5_ONE,
+        100 * E5_ONE + E5_ONE / 10,
+        99 * E5_ONE + 9 * E5_ONE / 10,
+    ];
+    let mut reports = vec![
+        report(1, honest[0], now - 10),
+        report(2, honest[1], now - 12),
+        report(3, honest[2], now - 11),
+    ];
+    // Liars try to drag the price up by 100x and down to near zero.
+    reports.push(report(4, 10_000 * E5_ONE, now - 10));
+    reports.push(report(5, E5_ONE / 10_000, now - 10));
+
+    let agg = net.submit(now, reports).expect("round must finalize");
+    let mut sorted_honest = honest.clone();
+    sorted_honest.sort_unstable();
+    assert_eq!(
+        agg.price, sorted_honest[1],
+        "E5: two malicious providers must not move the median"
+    );
+    assert_eq!(agg.admitted, 5);
+    assert!(
+        agg.rejected_outliers >= 2,
+        "liars must land outside the band"
+    );
+    assert_eq!(net.latest().map(|a| a.price), Some(sorted_honest[1]));
+}
+
+/// Gate (literal): NC — one provider -> red.
+#[test]
+fn e5_quorum_required() {
+    let mut net = five_provider_network();
+    let now: u64 = 1_000_000;
+    let err = net
+        .submit(now, vec![report(1, E5_ONE, now - 5)])
+        .expect_err("one provider must not finalize a round");
+    assert!(
+        matches!(
+            err,
+            E5Error::Quorum {
+                valid: 1,
+                required: 3
+            }
+        ),
+        "unexpected error: {err:?}"
+    );
+    assert_eq!(
+        err.to_string(),
+        "E5: oracle requires a quorum of provider reports (1/3)"
+    );
+}
+
+#[test]
+fn e5_bad_signature_rejected() {
+    let mut net = five_provider_network();
+    let now: u64 = 1_000_000;
+    let mut evil = report(1, E5_ONE, now - 5);
+    evil.signature[0] ^= 0x5A;
+    let err = net
+        .submit(now, vec![evil])
+        .expect_err("forged signature must abort the round");
+    assert!(matches!(err, E5Error::BadSignature { provider: 1 }));
+    assert_eq!(
+        err.to_string(),
+        "E5: provider report signature must verify (provider 1)"
+    );
+}
+
+#[test]
+fn e5_stale_report_rejected() {
+    let mut net = five_provider_network().with_staleness(100);
+    let now: u64 = 1_000_000;
+    let err = net
+        .submit(now, vec![report(1, E5_ONE, now - 101)])
+        .expect_err("stale report must abort the round");
+    assert!(matches!(err, E5Error::Stale { provider: 1, .. }));
+    assert!(
+        err.to_string()
+            .starts_with("E5: provider report must be fresh")
+    );
+}
+
+#[test]
+fn e5_future_report_rejected() {
+    let mut net = five_provider_network();
+    let now: u64 = 1_000_000;
+    let err = net
+        .submit(now, vec![report(1, E5_ONE, now + 1)])
+        .expect_err("future report must abort the round");
+    assert!(matches!(err, E5Error::Stale { provider: 1, .. }));
+}
+
+#[test]
+fn e5_duplicate_provider_rejected() {
+    let mut net = five_provider_network();
+    let now: u64 = 1_000_000;
+    let err = net
+        .submit(
+            now,
+            vec![report(1, E5_ONE, now - 5), report(1, 2 * E5_ONE, now - 5)],
+        )
+        .expect_err("second report from one provider must abort the round");
+    assert!(matches!(err, E5Error::DuplicateProvider { provider: 1 }));
+    assert_eq!(
+        err.to_string(),
+        "E5: one report per provider per round (provider 1)"
+    );
+}
+
+#[test]
+fn e5_feed_mismatch_rejected() {
+    let mut net = five_provider_network();
+    let now: u64 = 1_000_000;
+    // Sign for a foreign feed so the signature check cannot mask the feed check.
+    let off = PriceReport::sign(&seed_for(1), 1, *b"BTC/USD.........", E5_ONE, now - 5);
+    let err = net
+        .submit(now, vec![off])
+        .expect_err("wrong feed must abort the round");
+    assert!(matches!(err, E5Error::FeedMismatch { provider: 1 }));
+    assert_eq!(
+        err.to_string(),
+        "E5: all reports must target this feed (provider 1)"
+    );
+}
+
+#[test]
+fn e5_unknown_provider_rejected() {
+    let mut net = five_provider_network();
+    let now: u64 = 1_000_000;
+    let err = net
+        .submit(now, vec![report(9, E5_ONE, now - 5)])
+        .expect_err("unregistered provider must abort the round");
+    assert!(matches!(err, E5Error::UnknownProvider { provider: 9 }));
+    assert_eq!(err.to_string(), "E5: report from unregistered provider 9");
+}
+
+#[test]
+fn e5_no_reports_rejected() {
+    let mut net = five_provider_network();
+    let err = net
+        .submit(1_000_000, vec![])
+        .expect_err("empty round must abort");
+    assert!(matches!(err, E5Error::NoReports));
+    assert_eq!(err.to_string(), "E5: round requires at least one report");
+}
+
+#[test]
+fn e5_outlier_rejected() {
+    let mut net = five_provider_network();
+    let now: u64 = 1_000_000;
+    let agg = net
+        .submit(
+            now,
+            vec![
+                report(1, 100 * E5_ONE, now - 5),
+                report(2, 101 * E5_ONE, now - 5),
+                report(3, 99 * E5_ONE, now - 5),
+                report(4, 102 * E5_ONE, now - 5),
+                report(5, 10_000 * E5_ONE, now - 5),
+            ],
+        )
+        .expect("round must finalize");
+    assert_eq!(agg.rejected_outliers, 1);
+    assert_eq!(agg.admitted, 5);
+    assert_eq!(agg.price, 101 * E5_ONE);
+}
+
+/// Metamorphic: report order must not change the aggregate.
+#[test]
+fn e5_metamorphic_permutation() {
+    let now: u64 = 1_000_000;
+    let mk = || {
+        vec![
+            report(1, 100 * E5_ONE, now - 5),
+            report(2, 101 * E5_ONE, now - 6),
+            report(3, 99 * E5_ONE, now - 7),
+            report(4, 102 * E5_ONE, now - 8),
+            report(5, 10_000 * E5_ONE, now - 9),
+        ]
+    };
+    let mut net_a = five_provider_network();
+    let a = net_a.submit(now, mk()).unwrap();
+    let mut flipped = mk();
+    flipped.swap(0, 4);
+    flipped.swap(1, 3);
+    let mut net_b = five_provider_network();
+    let b = net_b.submit(now, flipped).unwrap();
+    assert_eq!(a, b, "E5: aggregation must be permutation invariant");
+}
+
+/// Metamorphic: scaling every price by 2 scales the median by 2.
+#[test]
+fn e5_metamorphic_scale() {
+    let now: u64 = 1_000_000;
+    let base_prices: Vec<Price> = vec![
+        100 * E5_ONE,
+        101 * E5_ONE,
+        99 * E5_ONE,
+        102 * E5_ONE,
+        103 * E5_ONE,
+    ];
+    let base: Vec<PriceReport> = (1..=5)
+        .map(|i| report(i, base_prices[i as usize - 1], now - 5))
+        .collect();
+    let mut net_a = five_provider_network();
+    let a = net_a.submit(now, base).unwrap();
+
+    let scaled: Vec<PriceReport> = (1..=5)
+        .map(|i| report(i, 2 * base_prices[i as usize - 1], now - 5))
+        .collect();
+    let mut net_b = five_provider_network();
+    let b = net_b.submit(now, scaled).unwrap();
+    assert_eq!(b.price, a.price * 2, "E5: median must scale linearly");
+}
+
+/// Determinism: the same input round yields the same aggregate twice.
+#[test]
+fn e5_deterministic_repeat() {
+    let now: u64 = 1_000_000;
+    let mk = || {
+        vec![
+            report(1, 100 * E5_ONE, now - 5),
+            report(2, 101 * E5_ONE, now - 6),
+            report(3, 99 * E5_ONE, now - 7),
+        ]
+    };
+    let mut net = five_provider_network();
+    let a = net.submit(now, mk()).unwrap();
+    let b = net.submit(now, mk()).unwrap();
+    assert_eq!(a, b, "E5: aggregation must be deterministic");
+}
+
+#[test]
+fn e5_aggregate_fields_sane() {
+    let mut net = five_provider_network();
+    let now: u64 = 1_000_000;
+    let agg: AggregatedPrice = net
+        .submit(
+            now,
+            vec![
+                report(1, 100 * E5_ONE, now - 5),
+                report(2, 101 * E5_ONE, now - 15),
+                report(3, 99 * E5_ONE, now - 25),
+            ],
+        )
+        .unwrap();
+    assert_eq!(agg.feed, FEED);
+    assert_eq!(agg.price, 100 * E5_ONE);
+    assert_eq!(agg.timestamp, now - 15);
+    assert_eq!(agg.admitted, 3);
+    assert_eq!(agg.rejected_outliers, 0);
+}
diff --git a/crates/aura-storage/tests/e6_cdp.rs b/crates/aura-storage/tests/e6_cdp.rs
