diff --git a/crates/aura-storage/examples/e4_amm_example.rs b/crates/aura-storage/examples/e4_amm_example.rs
new file mode 100644
index 0000000..b0748d2
--- /dev/null
+++ b/crates/aura-storage/examples/e4_amm_example.rs
@@ -0,0 +1,133 @@
+//! E4 AMM simulation driver (ECOSYSTEM_PLAN E4).
+//!
+//! Deterministic driver mirroring `tools/e4_amm_check.py`: plays the fixed
+//! `sim/e4-amm.json` scenario (constant-product pool, 30bps fee, floor
+//! rounding) — single swap, two-hop route, split-vs-single metamorphic run,
+//! LP mint/burn round trip — checks that the invariant `k` never decreases,
+//! and prints a one-line JSON summary. The expected values are checked at
+//! the end, so a divergent curve fails the run.
+
+use std::process::exit;
+
+use aura_storage::amm::{Amount, Pool, Token, swap_route, wide_ge};
+
+const E4_ONE_LOCAL: Amount = 1_000_000_000_000_000_000;
+
+fn token_a() -> Token {
+    *b"ALCRY..........."
+}
+
+fn token_b() -> Token {
+    *b"AUSD............"
+}
+
+fn token_c() -> Token {
+    *b"ABTC............"
+}
+
+/// Fixture identical to `sim/e4-amm.json`: (reserve_a, reserve_b) per pool.
+fn fixture() -> [(Amount, Amount); 2] {
+    [
+        (100 * E4_ONE_LOCAL, 200 * E4_ONE_LOCAL),
+        (100 * E4_ONE_LOCAL, 300 * E4_ONE_LOCAL),
+    ]
+}
+
+fn main() {
+    // Optional: confirm the human-readable fixture is in place.
+    if let Some(path) = std::env::args().nth(1)
+        && !std::path::Path::new(&path).exists()
+    {
+        eprintln!("E4-SIM-ERR fixture file missing: {path}");
+        exit(1);
+    }
+
+    let [(ab_a, ab_b), (bc_a, bc_b)] = fixture();
+    let mut k_ok = true;
+
+    // 1. Single swap: 1 A -> B on (100/200).
+    let mut ab = Pool::new(token_a(), token_b());
+    ab.add_liquidity(ab_a, ab_b).expect("seed AB");
+    let k0 = ab.invariant_k();
+    let swap_out = ab.swap_exact_in(token_a(), E4_ONE_LOCAL, 0).expect("swap");
+    k_ok &= wide_ge(&ab.invariant_k(), &k0);
+
+    // 2. Route: 1 A -> B -> C through (100/200) and (100/300).
+    let mut pools = [
+        Pool::new(token_a(), token_b()),
+        Pool::new(token_b(), token_c()),
+    ];
+    pools[0].add_liquidity(ab_a, ab_b).expect("seed AB");
+    pools[1].add_liquidity(bc_a, bc_b).expect("seed BC");
+    let k_ab = pools[0].invariant_k();
+    let k_bc = pools[1].invariant_k();
+    let route_out = swap_route(
+        &mut pools,
+        &[token_a(), token_b(), token_c()],
+        E4_ONE_LOCAL,
+        0,
+    )
+    .expect("route");
+    k_ok &= wide_ge(&pools[0].invariant_k(), &k_ab);
+    k_ok &= wide_ge(&pools[1].invariant_k(), &k_bc);
+
+    // 3. Metamorphic: one 2A swap vs two 1A swaps (split must not win).
+    let mut single = Pool::new(token_a(), token_b());
+    single.add_liquidity(ab_a, ab_b).expect("seed single");
+    let single_out = single
+        .swap_exact_in(token_a(), 2 * E4_ONE_LOCAL, 0)
+        .expect("single");
+    let mut split = Pool::new(token_a(), token_b());
+    split.add_liquidity(ab_a, ab_b).expect("seed split");
+    let first = split.swap_exact_in(token_a(), E4_ONE_LOCAL, 0).expect("s1");
+    let second = split.swap_exact_in(token_a(), E4_ONE_LOCAL, 0).expect("s2");
+    let split_out = first + second;
+    let split_le_single = split_out <= single_out;
+    k_ok &= split_le_single;
+
+    // 4. LP: initial mint, proportional mint, burn round trip.
+    let mut lp_pool = Pool::new(token_a(), token_b());
+    let lp_initial = lp_pool.add_liquidity(ab_a, ab_b).expect("mint");
+    let lp_proportional = lp_pool
+        .add_liquidity(50 * E4_ONE_LOCAL, 100 * E4_ONE_LOCAL)
+        .expect("mint prop");
+    let (burn_a, burn_b) = lp_pool.remove_liquidity(lp_proportional).expect("burn");
+
+    println!(
+        "E4-SIM-OK {{\"pools\": [[{},{}],[{},{}]], \"swap_out\": {}, \"route_out\": {}, \"single_out\": {}, \"split_out\": {}, \"split_le_single\": {}, \"lp_initial\": {}, \"lp_proportional\": {}, \"burn_out\": [{},{}], \"k_never_decreased\": {}}}",
+        ab_a,
+        ab_b,
+        bc_a,
+        bc_b,
+        swap_out,
+        route_out,
+        single_out,
+        split_out,
+        split_le_single,
+        lp_initial,
+        lp_proportional,
+        burn_a,
+        burn_b,
+        k_ok,
+    );
+
+    // Expected aggregate (sim/e4-amm.json "expected").
+    let want = (
+        1_974_316_068_794_122_597u128,
+        5_791_186_053_878_244_695u128,
+        3_910_033_923_564_131_223u128,
+        3_909_976_989_011_504_086u128,
+    );
+    if (swap_out, route_out, single_out, split_out) != want
+        || !split_le_single
+        || !k_ok
+        || lp_initial != 300 * E4_ONE_LOCAL
+        || lp_proportional != 150 * E4_ONE_LOCAL
+        || (burn_a, burn_b) != (50 * E4_ONE_LOCAL, 100 * E4_ONE_LOCAL)
+    {
+        eprintln!(
+            "E4-SIM-ERR scenario diverged from expected: swap {swap_out} route {route_out} single {single_out} split {split_out} k_ok {k_ok}"
+        );
+        exit(1);
+    }
+}
diff --git a/crates/aura-storage/examples/e5_oracle_example.rs b/crates/aura-storage/examples/e5_oracle_example.rs
new file mode 100644
index 0000000..df65c7a
--- /dev/null
+++ b/crates/aura-storage/examples/e5_oracle_example.rs
@@ -0,0 +1,98 @@
+//! E5 oracle simulation driver (ECOSYSTEM_PLAN E5).
+//!
+//! Deterministic driver mirroring the T8 whitepaper scenario driver: plays
+//! the fixed `sim/e5-oracle.json` fixture (five signed provider reports, two
+//! of them malicious), aggregates the price and prints a one-line JSON
+//! summary. The expected aggregate is checked at the end, so a divergent
+//! aggregation fails the run.
+
+use std::process::exit;
+
+use aura_crypto::ed25519_public_key;
+use aura_storage::oracle::{OracleNetwork, Price, PriceReport, Provider};
+
+const FEED: [u8; 16] = *b"ALCRY/USD.......";
+const NOW: u64 = 1_000_000;
+const STALENESS_SECS: u64 = 3600;
+const DEVIATION_BPS: u64 = 500;
+
+/// Fixture identical to `sim/e5-oracle.json`: (provider, price, timestamp).
+fn fixture() -> Vec<(u32, Price, u64)> {
+    vec![
+        (1, 100 * E5_ONE_LOCAL, NOW - 10),
+        (2, 100 * E5_ONE_LOCAL + E5_ONE_LOCAL / 10, NOW - 12),
+        (3, 99 * E5_ONE_LOCAL + 9 * E5_ONE_LOCAL / 10, NOW - 11),
+        (4, 10_000 * E5_ONE_LOCAL, NOW - 10),
+        (5, E5_ONE_LOCAL / 10_000, NOW - 10),
+    ]
+}
+
+const E5_ONE_LOCAL: Price = 1_000_000_000_000_000_000;
+
+fn seed_for(id: u32) -> [u8; 32] {
+    let mut seed = [0u8; 32];
+    seed[0] = id as u8;
+    seed[31] = 0xE5;
+    seed
+}
+
+fn main() {
+    // Optional: confirm the human-readable fixture is in place.
+    if let Some(path) = std::env::args().nth(1)
+        && !std::path::Path::new(&path).exists()
+    {
+        eprintln!("E5-SIM-ERR fixture file missing: {path}");
+        exit(1);
+    }
+
+    let rows = fixture();
+    let mut providers = Vec::new();
+    let mut signed = Vec::new();
+    for &(id, price, ts) in &rows {
+        providers.push(Provider {
+            id,
+            pubkey: ed25519_public_key(&seed_for(id)),
+        });
+        signed.push(PriceReport::sign(&seed_for(id), id, FEED, price, ts));
+    }
+
+    let mut net = OracleNetwork::new(FEED, providers)
+        .with_staleness(STALENESS_SECS)
+        .with_deviation(DEVIATION_BPS);
+
+    match net.submit(NOW, signed) {
+        Ok(agg) => {
+            println!(
+                "E5-SIM-OK {{\"providers\": {}, \"admitted\": {}, \"rejected_outliers\": {}, \"price\": \"{}\", \"timestamp\": {}, \"quorum\": {}, \"staleness_secs\": {}}}",
+                rows.len(),
+                agg.admitted,
+                agg.rejected_outliers,
+                agg.price,
+                agg.timestamp,
+                net.quorum(),
+                STALENESS_SECS,
+            );
+            // Expected aggregate (sim/e5-oracle.json "expected").
+            let want_price: Price = 100 * E5_ONE_LOCAL;
+            if agg.price != want_price
+                || agg.admitted != 5
+                || agg.rejected_outliers != 2
+                || net.quorum() != 3
+            {
+                eprintln!(
+                    "E5-SIM-ERR aggregate diverged from expected: price {}/{} admitted {}/5 rejected {}/2 quorum {}/3",
+                    agg.price,
+                    want_price,
+                    agg.admitted,
+                    agg.rejected_outliers,
+                    net.quorum(),
+                );
+                exit(1);
+            }
+        }
+        Err(e) => {
+            eprintln!("E5-SIM-ERR {e}");
+            exit(1);
+        }
+    }
+}
diff --git a/crates/aura-storage/examples/e6_cdp_example.rs b/crates/aura-storage/examples/e6_cdp_example.rs
new file mode 100644
index 0000000..bee8765
--- /dev/null
+++ b/crates/aura-storage/examples/e6_cdp_example.rs
@@ -0,0 +1,88 @@
+//! E6 stablecoin CDP simulation driver (ECOSYSTEM_PLAN E6).
+//!
+//! Deterministic driver mirroring `tools/e6_cdp_check.py`: plays the
+//! fixed `sim/e6-cdp.json` scenario — the literal gate (200% collateral
+//! at −40% price → liquidation with no bad debt) plus the peg stress
+//! sequence (three vaults, two shock waves, three liquidations) — and
+//! prints a one-line JSON summary. Expected values are checked at the
+//! end, so a divergent engine fails the run.
+
+use std::process::exit;
+
+use aura_storage::cdp::{CdpEngine, E6_ONE};
+
+fn main() {
+    // Optional: confirm the human-readable fixture is in place.
+    if let Some(path) = std::env::args().nth(1)
+        && !std::path::Path::new(&path).exists()
+    {
+        eprintln!("E6-SIM-ERR fixture file missing: {path}");
+        exit(1);
+    }
+
+    // 1. Literal gate: 200% collateral, -40% price, liquidation.
+    let mut gate = CdpEngine::new();
+    let g = gate.open_vault();
+    gate.deposit(g, 200 * E6_ONE).expect("deposit");
+    gate.mint(g, 100 * E6_ONE).expect("mint");
+    gate.set_price(6 * E6_ONE / 10).expect("shock");
+    let ratio_after = gate.ratio_bps(g).expect("ratio");
+    let liq = gate.liquidate(g).expect("liquidation");
+
+    // 2. Peg stress: three vaults (200/220/300), shocks 0.9/0.6/0.45.
+    let mut stress = CdpEngine::new();
+    let mut ids = Vec::new();
+    for col in [200 * E6_ONE, 220 * E6_ONE, 300 * E6_ONE] {
+        let id = stress.open_vault();
+        stress.deposit(id, col).expect("deposit");
+        stress.mint(id, 100 * E6_ONE).expect("mint");
+        ids.push(id);
+    }
+    let mut backed = stress.peg_holds();
+    stress.set_price(9 * E6_ONE / 10).expect("shock 1");
+    backed &= stress.peg_holds();
+    stress.set_price(6 * E6_ONE / 10).expect("shock 2");
+    backed &= stress.peg_holds();
+    let la = stress.liquidate(ids[0]).expect("liq a");
+    let lb = stress.liquidate(ids[1]).expect("liq b");
+    backed &= stress.peg_holds();
+    stress.set_price(45 * E6_ONE / 100).expect("shock 3");
+    backed &= stress.peg_holds();
+    let lc = stress.liquidate(ids[2]).expect("liq c");
+    backed &= stress.peg_holds();
+
+    println!(
+        "E6-SIM-OK {{\"gate\": {{\"ratio_after_shock_bps\": {}, \"seized\": {}, \"repaid\": {}, \"shortfall\": {}, \"returned\": {}}}, \"stress\": {{\"liquidations\": {}, \"bad_debt\": {}, \"backed\": {}, \"final_supply\": {}}}, \"min_ratio_bps\": 15000, \"penalty_bps\": 500}}",
+        ratio_after,
+        liq.seized,
+        liq.repaid,
+        liq.shortfall,
+        liq.returned,
+        stress.liquidations(),
+        stress.bad_debt(),
+        backed,
+        stress.stable_supply(),
+    );
+
+    // Expected scenario values (sim/e6-cdp.json "expected").
+    let ok = ratio_after == 12_000
+        && (liq.seized, liq.repaid, liq.shortfall, liq.returned)
+            == (175 * E6_ONE, 100 * E6_ONE, 0, 25 * E6_ONE)
+        && (la.seized, la.returned) == (175 * E6_ONE, 25 * E6_ONE)
+        && (lb.seized, lb.returned) == (175 * E6_ONE, 45 * E6_ONE)
+        && lc.seized == 233_333_333_333_333_333_333
+        && lc.returned == 66_666_666_666_666_666_667
+        && la.shortfall + lb.shortfall + lc.shortfall == 0
+        && stress.bad_debt() == 0
+        && stress.stable_supply() == 0
+        && backed;
+    if !ok {
+        eprintln!(
+            "E6-SIM-ERR scenario diverged: ratio {ratio_after} seized {} shortfall {} bad_debt {} backed {backed}",
+            liq.seized,
+            liq.shortfall,
+            stress.bad_debt(),
+        );
+        exit(1);
+    }
+}
diff --git a/crates/aura-storage/examples/e7_lending_example.rs b/crates/aura-storage/examples/e7_lending_example.rs
new file mode 100644
index 0000000..4e501b6
--- /dev/null
+++ b/crates/aura-storage/examples/e7_lending_example.rs
@@ -0,0 +1,116 @@
+//! E7 lending simulation driver (ECOSYSTEM_PLAN E7).
+//!
+//! Deterministic driver mirroring `tools/e7_lending_check.py`: plays the
+//! fixed `sim/e7-lending.json` scenario — the 30-day gate simulation
+//! (two accounts, five price shocks, interest accrual, liquidations)
+//! plus the no-liquidation control run — and prints a one-line JSON
+//! summary. Expected values are checked at the end, so a divergent
+//! market fails the run.
+
+use std::process::exit;
+
+use aura_storage::lending::{E7_ONE, LendingMarket};
+
+const LIQ_HEALTH: u64 = 12_500;
+
+const PRICES: [(u64, u128); 5] = [
+    (6, 85 * E7_ONE / 100),
+    (12, 72 * E7_ONE / 100),
+    (18, 61 * E7_ONE / 100),
+    (24, 52 * E7_ONE / 100),
+    (30, 44 * E7_ONE / 100),
+];
+
+fn run(do_liquidations: bool) -> (u128, u128, Vec<u64>, u128, u64, Option<u64>, bool) {
+    let mut m = LendingMarket::new();
+    let a = m.open_account();
+    m.supply(a, 1_000 * E7_ONE).expect("supply a");
+    m.borrow(a, 700 * E7_ONE).expect("borrow a");
+    let b = m.open_account();
+    m.supply(b, 500 * E7_ONE).expect("supply b");
+    m.borrow(b, 300 * E7_ONE).expect("borrow b");
+
+    let mut liq_days = Vec::new();
+    let mut min_health = u64::MAX;
+    let mut breach_day = None;
+    let mut invariant_held = true;
+    let mut day30 = (0, 0);
+
+    for day in 1..=30u64 {
+        if let Some((_, price)) = PRICES.iter().find(|(d, _)| *d == day) {
+            m.set_price(*price).expect("price");
+        }
+        m.advance_day().expect("accrue");
+        if do_liquidations {
+            for id in [a, b] {
+                while m.health_bps(id).unwrap_or(u64::MAX) < LIQ_HEALTH {
+                    m.liquidate(id).expect("liquidation");
+                    liq_days.push(day);
+                }
+            }
+        }
+        for id in [a, b] {
+            min_health = min_health.min(m.health_bps(id).unwrap_or(u64::MAX));
+            if m.value_of(id).unwrap() < m.account(id).unwrap().debt {
+                invariant_held = false;
+                if breach_day.is_none() {
+                    breach_day = Some(day);
+                }
+            }
+        }
+        if day == 30 {
+            day30 = (m.account(a).unwrap().debt, m.account(b).unwrap().debt);
+        }
+    }
+    (
+        day30.0,
+        day30.1,
+        liq_days,
+        m.total_interest(),
+        min_health,
+        breach_day,
+        invariant_held,
+    )
+}
+
+fn main() {
+    // Optional: confirm the human-readable fixture is in place.
+    if let Some(path) = std::env::args().nth(1)
+        && !std::path::Path::new(&path).exists()
+    {
+        eprintln!("E7-SIM-ERR fixture file missing: {path}");
+        exit(1);
+    }
+
+    let (debt_a, debt_b, liq_days, interest, min_health, breach, held) = run(true);
+    let (_, _, _, _, _, no_liq_breach, _) = run(false);
+    let no_liq_day = no_liq_breach.unwrap_or(0);
+
+    println!(
+        "E7-SIM-OK {{\"days\": 30, \"liq_count\": {}, \"day30_debt_a\": {}, \"day30_debt_b\": {}, \"total_interest\": {}, \"min_health_bps\": {}, \"invariant_held\": {}, \"no_liq_breach_day\": {}}}",
+        liq_days.len(),
+        debt_a,
+        debt_b,
+        interest,
+        min_health,
+        held,
+        no_liq_day,
+    );
+
+    // Expected scenario values (sim/e7-lending.json "expected").
+    let ok = liq_days.len() == 16
+        && debt_a == 690_912_489_586_789_599
+        && debt_b == 4_737_685_642_880_842_971
+        && interest == 4_011_969_083_602_784_267
+        && min_health == 12_530
+        && held
+        && breach.is_none()
+        && no_liq_day == 18;
+    if !ok {
+        eprintln!(
+            "E7-SIM-ERR scenario diverged: liqs {} debt_a {debt_a} interest {interest} min_health {min_health} breach {breach:?} no_liq {no_liq_day}",
+            liq_days.len(),
+        );
+        exit(1);
+    }
+}
diff --git a/crates/aura-storage/examples/e8_nft_example.rs b/crates/aura-storage/examples/e8_nft_example.rs
new file mode 100644
index 0000000..9cb0e1d
--- /dev/null
+++ b/crates/aura-storage/examples/e8_nft_example.rs
@@ -0,0 +1,198 @@
+//! E8 example: replays the 50 standard vectors and the DAO scenario,
+//! renders the governance UI page and prints the pinned output that
+//! `tools/e8_nft_check.py` must reproduce byte for byte:
+//!
+//! ```text
+//! E8-VECTORS-OK 50
+//! E8-UI-OK <sha256 of governance-ui.html>
+//! E8-SIM-OK {"vectors": 50, ...}
+//! ```
+//!
+//! Run: `cargo run --quiet --locked -p aura-storage --example e8_nft_example`
+
+use std::collections::BTreeMap;
+use std::fs;
+
+use aura_storage::dao_ui::{run_e8_scenario, scenario_digest};
+use aura_storage::nft::{E8Error, NftWorld};
+
+const FIXTURE: &str = include_str!("../tests/fixtures/e8-standards.txt");
+const VECTORS_DIGEST: &str = "8cb9da945b0eed8f4432d31b71d20fffb72a6317fc90204d1890bd480c062bd3";
+
+struct Vector {
+    id: String,
+    op: String,
+    args: BTreeMap<String, String>,
+    status: String,
+    err: String,
+    reads: BTreeMap<String, String>,
+}
+
+fn parse() -> (String, Vec<Vector>) {
+    let mut digest = String::new();
+    let mut vectors: Vec<Vector> = Vec::new();
+    let mut cur: Option<Vector> = None;
+    for line in FIXTURE.lines() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let (k, v) = line.split_once('=').expect("key=value");
+        match k {
+            "digest" if cur.is_none() => digest = String::from(v),
+            "vector" => {
+                if let Some(done) = cur.take() {
+                    vectors.push(done);
+                }
+                cur = Some(Vector {
+                    id: String::from(v),
+                    op: String::new(),
+                    args: BTreeMap::new(),
+                    status: String::new(),
+                    err: String::new(),
+                    reads: BTreeMap::new(),
+                });
+            }
+            "op" => cur.as_mut().unwrap().op = String::from(v),
+            "status" => cur.as_mut().unwrap().status = String::from(v),
+            "err" => cur.as_mut().unwrap().err = String::from(v),
+            other => {
+                let block = cur.as_mut().unwrap();
+                if let Some(read) = other.strip_prefix("read.") {
+                    block.reads.insert(String::from(read), String::from(v));
+                } else {
+                    block.args.insert(String::from(other), String::from(v));
+                }
+            }
+        }
+    }
+    if let Some(done) = cur.take() {
+        vectors.push(done);
+    }
+    (digest, vectors)
+}
+
+fn run_vector(w: &mut NftWorld, v: &Vector) -> Result<(), E8Error> {
+    let a = |key: &str| -> &str { v.args.get(key).map(String::as_str).unwrap() };
+    match v.op.as_str() {
+        "mint721" => w.mint721(a("by"), a("to"), a("id").parse().unwrap()),
+        "transfer721" => w.transfer721(a("by"), a("id").parse().unwrap(), a("to")),
+        "approve721" => w.approve721(a("by"), a("id").parse().unwrap(), a("spender")),
+        "transfer_from721" => w.transfer_from721(a("by"), a("id").parse().unwrap(), a("to")),
+        "burn721" => w.burn721(a("by"), a("id").parse().unwrap()),
+        "read_owner_of" => w.owner_of(a("id").parse().unwrap()).map(|_| ()),
+        "mint1155" => w.mint1155(
+            a("by"),
+            a("to"),
+            a("id").parse().unwrap(),
+            a("amount").parse().unwrap(),
+        ),
+        "transfer1155" => w.transfer1155(
+            a("frm"),
+            a("by"),
+            a("id").parse().unwrap(),
+            a("to"),
+            a("amount").parse().unwrap(),
+        ),
+        "set_operator" => w.set_operator(a("by"), a("operator"), a("approved") == "true"),
+        "transfer_batch1155" => {
+            let ids: Vec<u64> = a("ids").split(',').map(|s| s.parse().unwrap()).collect();
+            let amounts: Vec<u128> = a("amounts")
+                .split(',')
+                .map(|s| s.parse().unwrap())
+                .collect();
+            w.transfer_batch1155(a("frm"), a("by"), a("to"), &ids, &amounts)
+        }
+        "register_name" => w.register_name(a("by"), a("name"), a("day").parse().unwrap()),
+        "renew_name" => w.renew_name(a("name"), a("day").parse().unwrap()),
+        "transfer_name" => w.transfer_name(a("by"), a("name"), a("to"), a("day").parse().unwrap()),
+        "set_target" => w.set_target(a("by"), a("name"), a("target"), a("day").parse().unwrap()),
+        "resolve" => w.resolve(a("name"), a("day").parse().unwrap()).map(|_| ()),
+        "set_primary" => w.set_primary(a("by"), a("name"), a("day").parse().unwrap()),
+        "advance_day" => {
+            w.advance_day(a("day").parse().unwrap());
+            Ok(())
+        }
+        "set_identity" => {
+            w.set_identity(a("by"), a("name"), a("digest"), a("day").parse().unwrap())
+        }
+        "clear_identity" => w.clear_identity(a("by"), a("name")),
+        "read_identity" => w.identity(a("name")).map(|_| ()),
+        other => panic!("unknown op {other}"),
+    }
+}
+
+fn main() {
+    // 1. The 50 standard vectors, exactly as the suite pins them.
+    let (fixture_digest, vectors) = parse();
+    assert_eq!(fixture_digest, VECTORS_DIGEST);
+    let mut world = NftWorld::new();
+    for v in &vectors {
+        let result = run_vector(&mut world, v);
+        match v.status.as_str() {
+            "ok" => assert!(result.is_ok(), "{}: {:?}", v.id, result.err()),
+            "err" => assert_eq!(result.unwrap_err().to_string(), v.err, "{}", v.id),
+            other => panic!("bad status {other}"),
+        }
+        for (key, want) in &v.reads {
+            assert_eq!(&world.query(key), want, "{}: {key}", v.id);
+        }
+    }
+    println!("E8-VECTORS-OK {}", vectors.len());
+
+    // 2. The DAO scenario: the first vote through the UI.
+    let run = run_e8_scenario();
+    assert_eq!(
+        scenario_digest(&run.steps),
+        "17fd44850375c54c9cf9826b8ed55da0faf1855da72514184c83501f07409d71"
+    );
+    assert_eq!(run.ui_votes, 4);
+    assert_eq!(run.state, "executed");
+
+    // 3. The governance UI page, written into the evidence tier.
+    let mut ui = aura_storage::dao_ui::DaoUi::new(
+        vec![
+            250_000 * aura_storage::issuance::ALCRY,
+            150_000 * aura_storage::issuance::ALCRY,
+            100_000 * aura_storage::issuance::ALCRY,
+            75_000 * aura_storage::issuance::ALCRY,
+            25_000 * aura_storage::issuance::ALCRY,
+        ],
+        ["alice", "bob", "carol", "dave", "eve"]
+            .iter()
+            .map(|s| String::from(*s))
+            .collect(),
+    );
+    let id = ui.propose(0, 1000).unwrap();
+    ui.vote(id, 1, aura_storage::governance::Support::Yes, 2000)
+        .unwrap();
+    ui.vote(id, 2, aura_storage::governance::Support::Yes, 3000)
+        .unwrap();
+    ui.vote(id, 3, aura_storage::governance::Support::No, 4000)
+        .unwrap();
+    ui.vote(id, 4, aura_storage::governance::Support::Abstain, 5000)
+        .unwrap();
+    ui.finalize(id, 121_960).unwrap();
+    ui.execute(id, 156_520).unwrap();
+    let html = ui.render_html();
+    let out = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../docs/evidence/e8/governance-ui.html");
+    fs::create_dir_all(out.parent().expect("parent")).expect("mkdir");
+    fs::write(&out, html.as_bytes()).expect("write html");
+    let sha = aura_state::sha256_bytes(html.as_bytes()).to_hex();
+    println!("E8-UI-OK {sha}");
+
+    // 4. The pinned JSON (mirrored by tools/e8_nft_check.py).
+    println!(
+        "E8-SIM-OK {{\"vectors\": {}, \"vectors_ok\": true, \
+         \"first_vote\": [1, 1, \"yes\"], \"ui_votes\": {}, \
+         \"tally_yes\": {}, \"tally_no\": {}, \"tally_abstain\": {}, \
+         \"state\": \"{}\"}}",
+        vectors.len(),
+        run.ui_votes,
+        run.tally.0 / aura_storage::issuance::ALCRY,
+        run.tally.1 / aura_storage::issuance::ALCRY,
+        run.tally.2 / aura_storage::issuance::ALCRY,
+        run.state
+    );
+}
diff --git a/crates/aura-storage/examples/e9_bridge_example.rs b/crates/aura-storage/examples/e9_bridge_example.rs
