++++        seed[31] = 0xE5;
++++        seed
++++    }
++++
++++    fn provider(id: u32) -> Provider {
++++        Provider {
++++            id,
++++            pubkey: aura_crypto::ed25519_public_key(&seed_for(id)),
++++        }
++++    }
++++
