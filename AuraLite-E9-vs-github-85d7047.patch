++                    amount: msg.amount,
++                    locked: self.locked,
++                });
++            }
++            self.locked -= msg.amount;
++            self.minted -= msg.amount;
++        } else {
++            self.locked += msg.amount;
++            self.minted += msg.amount;
++        }
++        self.processed.insert(msg.id);
++        self.spent += msg.amount;
++        Ok(())
++    }
