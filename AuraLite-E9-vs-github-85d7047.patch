++                if let Some(read) = other.strip_prefix("read.") {
++                    block.reads.insert(String::from(read), String::from(v));
++                } else {
++                    block.args.insert(String::from(other), String::from(v));
++                }
++            }
++        }
++    }
++    if let Some(done) = cur.take() {
++        vectors.push(done);
++    }
++    (digest, vectors)
++}
