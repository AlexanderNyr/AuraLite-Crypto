++        kind: Kind::Deposit,
++        amount: 400 * one,
++    };
++    bridge.submit(&d2, 4, root4).expect("deposit 2");
++    steps.push(format!("deposit|2|{}|ok", d2.amount));
++
++    let w3 = Msg {
