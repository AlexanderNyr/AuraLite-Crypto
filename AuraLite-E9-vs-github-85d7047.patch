++        kind: Kind::Withdraw,
++        amount: 100 * one,
++    };
++    bridge.submit(&w3, 5, root5).expect("withdraw 3");
++    steps.push(format!("withdraw|3|{}|ok", w3.amount));
++
++    // Replay of message 1.
