+    open(TIER + "/e4-amm.log", "w").write(outputs["e4-amm"])
+    open(TIER + "/campaign/e4-amm.log", "w").write(outputs["e4-amm"])
+    open(TIER + "/nc-suite.log", "w").write(outputs["nc-suite"])
+    open(TIER + "/nc.log", "w").write("\n".join(NC_LINES) + "\n")
+
+    result = {
