+        "nc-suite: python3 tools/nc_e4.py -> 6/6 pass\n"
+        "example: cargo run --quiet --locked -p aura-storage --example e4_amm_example "
+        "sim/e4-amm.json -> E4-SIM-OK\n"
+    )
+    open(TIER + "/inventory.txt", "w").write(
