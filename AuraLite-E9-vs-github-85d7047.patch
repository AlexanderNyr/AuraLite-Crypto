++impl fmt::Display for Support {
++    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
++        match self {
++            Support::Yes => write!(f, "yes"),
++            Support::No => write!(f, "no"),
++            Support::Abstain => write!(f, "abstain"),
++        }
++    }
++}
