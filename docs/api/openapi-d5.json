{
  "components": {
    "schemas": {
      "ResponseV1": {
        "additionalProperties": false,
        "properties": {
          "result": {}
        },
        "required": [
          "result"
        ],
        "type": "object"
      },
      "ResponseV11": {
        "additionalProperties": false,
        "properties": {
          "apiVersion": {
            "const": "1.1",
            "type": "string"
          },
          "result": {}
        },
        "required": [
          "result",
          "apiVersion"
        ],
        "type": "object"
      },
      "SubmitTransactionRequest": {
        "additionalProperties": false,
        "properties": {
          "tx": {
            "pattern": "^0x[0-9a-fA-F]+$",
            "type": "string"
          }
        },
        "required": [
          "tx"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Versioned HTTP gateway over the validated D4 JSON-RPC service. v1.1 adds apiVersion to the stable v1 response envelope; existing v1 fields remain.",
    "title": "AuraLite Node REST Gateway",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1.1/balances/{address}": {
      "get": {
        "operationId": "getBalanceV11",
        "parameters": [
          {
            "in": "path",
            "name": "address",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseV11"
                }
              }
            },
            "description": "v1-compatible result with additive API version metadata."
          }
        }
      }
    },
    "/api/v1.1/blocks/{height}": {
      "get": {
        "operationId": "getBlockV11",
        "parameters": [
          {
            "in": "path",
            "name": "height",
            "required": true,
            "schema": {
              "pattern": "^(latest|[0-9]+)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "v1-compatible block result plus version metadata."
          }
        }
      }
    },
    "/api/v1.1/gas-estimate": {
      "post": {
        "operationId": "estimateGasV11",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "transfer"
                    ],
                    "type": "string"
                  },
                  "tx": {
                    "pattern": "^0x[0-9a-fA-F]+$",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "v1-compatible estimate plus version metadata."
          }
        }
      }
    },
    "/api/v1.1/transactions": {
      "post": {
        "operationId": "submitTransactionV11",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitTransactionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "v1-compatible transaction result plus version metadata."
          }
        }
      }
    },
    "/api/v1.1/transactions/{transactionHash}": {
      "get": {
        "operationId": "getTransactionV11",
        "parameters": [
          {
            "in": "path",
            "name": "transactionHash",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "v1-compatible result with additive version metadata."
          }
        }
      }
    },
    "/api/v1/balances/{address}": {
      "get": {
        "operationId": "getBalanceV1",
        "parameters": [
          {
            "in": "path",
            "name": "address",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseV1"
                }
              }
            },
            "description": "Account balance and nonce."
          },
          "400": {
            "description": "Invalid request or unknown field."
          }
        }
      }
    },
    "/api/v1/blocks/{height}": {
      "get": {
        "operationId": "getBlockV1",
        "parameters": [
          {
            "in": "path",
            "name": "height",
            "required": true,
            "schema": {
              "pattern": "^(latest|[0-9]+)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Committed block summary",
            "or null outside the retention window.": null
          }
        }
      }
    },
    "/api/v1/gas-estimate": {
      "post": {
        "operationId": "estimateGasV1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "transfer"
                    ],
                    "type": "string"
                  },
                  "tx": {
                    "pattern": "^0x[0-9a-fA-F]+$",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Estimated gas for the supported transfer kind."
          },
          "400": {
            "description": "Invalid request",
            "or unsupported input.": null,
            "unknown field": null
          }
        }
      }
    },
    "/api/v1/transactions": {
      "post": {
        "operationId": "submitTransactionV1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitTransactionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Transaction accepted by the D4 pipeline."
          },
          "400": {
            "description": "Invalid request or unknown field."
          }
        }
      }
    },
    "/api/v1/transactions/{transactionHash}": {
      "get": {
        "operationId": "getTransactionV1",
        "parameters": [
          {
            "in": "path",
            "name": "transactionHash",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "committed": null,
            "description": "Pending",
            "or not-found transaction result.": null
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "responses": {
          "200": {
            "description": "This API document as JSON."
          }
        }
      }
    },
    "/openapi.yaml": {
      "get": {
        "operationId": "getOpenApiYaml",
        "responses": {
          "200": {
            "description": "This OpenAPI document as YAML."
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ]
}
