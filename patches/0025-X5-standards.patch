@@ -0,0 +1,363 @@
+//! X5 gate (ARC-20): the fungible token standard, method by method.
+//!
+//! The bytecode under test is the shipped artifact
+//! (`standards/arc20/wasm/arc20.wasm`), deployed through the real
+//! `Lifecycle::deploy` and called through `Lifecycle::call_data` — no mocks, no
+//! direct host calls. Every assertion is about observable behaviour: a status
+//! code, a committed diff, a balance, an event, or 16 bytes of return data.
+
+mod x5_support;
+
+use aura_exec::lifecycle::Lifecycle;
+use aura_exec::{ContractReceipt, ExecStatus};
+use aura_state::{MerkleTree, StateView};
+use x5_support::*;
+
+const ARC20: &[u8] = include_bytes!("../../../standards/arc20/wasm/arc20.wasm");
+
+const TOKEN: [u8; 20] = [0x11; 20];
+const OWNER: [u8; 20] = [0x22; 20];
+const ALICE: [u8; 20] = [0x33; 20];
+const BOB: [u8; 20] = [0x44; 20];
+const ZERO: [u8; 20] = [0x00; 20];
+
+// The published selector table. A change here is a different standard.
+const SEL_TRANSFER: u32 = 0x01;
+const SEL_APPROVE: u32 = 0x02;
+const SEL_TRANSFER_FROM: u32 = 0x03;
+const SEL_BALANCE_OF: u32 = 0x04;
+const SEL_ALLOWANCE: u32 = 0x05;
+const SEL_TOTAL_SUPPLY: u32 = 0x06;
+const SEL_MINT: u32 = 0x07;
+const SEL_BURN: u32 = 0x08;
+const SEL_OWNER: u32 = 0x09;
+const SEL_TRANSFER_OWNERSHIP: u32 = 0x0a;
+
+// The published failure codes.
+const ERR_INSUFFICIENT_BALANCE: i32 = -6;
+const ERR_OVERFLOW: i32 = -7;
+const ERR_BAD_SELECTOR: i32 = -20;
+const ERR_BAD_ARGS: i32 = -21;
+const ERR_NOT_OWNER: i32 = -22;
+const ERR_ZERO_ADDRESS: i32 = -23;
+const ERR_ALLOWANCE: i32 = -24;
+
+fn deploy_token() -> (Lifecycle, MerkleTree) {
+    deploy(ARC20, TOKEN, OWNER, &[OWNER, ALICE, BOB])
+}
+
+fn invoke(
+    lifecycle: &Lifecycle,
+    tree: &MerkleTree,
+    who: [u8; 20],
+    calldata: Vec<u8>,
+) -> ContractReceipt {
+    x5_support::invoke(lifecycle, tree, TOKEN, who, calldata)
+}
+
+fn read_u128(lifecycle: &Lifecycle, tree: &MerkleTree, calldata: Vec<u8>) -> u128 {
+    x5_support::read_u128(lifecycle, tree, TOKEN, calldata)
+}
+
+fn read_storage(tree: &MerkleTree, key: &[u8]) -> Option<Vec<u8>> {
+    storage(tree, TOKEN, key)
+}
+
+fn transfer(to: [u8; 20], amount: u128) -> Vec<u8> {
+    data(SEL_TRANSFER, &[addr_arg(to), u128_arg(amount)].concat())
+}
+
+fn balance_method(who: [u8; 20]) -> Vec<u8> {
+    data(SEL_BALANCE_OF, &addr_arg(who))
+}
+
+fn allowance_method(owner: [u8; 20], spender: [u8; 20]) -> Vec<u8> {
+    data(
+        SEL_ALLOWANCE,
+        &[addr_arg(owner), addr_arg(spender)].concat(),
+    )
+}
+
+fn balance_of(lifecycle: &Lifecycle, tree: &MerkleTree, who: [u8; 20]) -> u128 {
+    read_u128(lifecycle, tree, balance_method(who))
+}
+
+fn mint_to(lifecycle: &Lifecycle, tree: &MerkleTree, who: [u8; 20], amount: u128) -> MerkleTree {
+    let receipt = invoke(
+        lifecycle,
+        tree,
+        OWNER,
+        data(SEL_MINT, &[addr_arg(who), u128_arg(amount)].concat()),
+    );
+    assert_eq!(receipt.status, ExecStatus::Returned(0), "mint must succeed");
+    commit(tree, &receipt)
+}
+
+#[test]
+fn arc20_deploys_and_records_its_owner() {
+    let (lifecycle, tree) = deploy_token();
+    assert_eq!(
+        read_storage(&tree, b"o").expect("owner key"),
+        OWNER.to_vec()
+    );
+    assert_eq!(
+        read_storage(&tree, b"t").expect("supply key"),
+        0u128.to_le_bytes()
+    );
+    let receipt = invoke(&lifecycle, &tree, ALICE, data(SEL_OWNER, &[]));
+    assert_eq!(receipt.status, ExecStatus::Returned(0));
+    assert_eq!(receipt.return_data, OWNER.to_vec());
+}
+
+#[test]
+fn mint_is_owner_only_and_moves_the_total() {
+    let (lifecycle, tree) = deploy_token();
+    let denied = invoke(
+        &lifecycle,
+        &tree,
+        ALICE,
+        data(SEL_MINT, &[addr_arg(ALICE), u128_arg(100)].concat()),
+    );
+    assert_eq!(denied.status, returned(ERR_NOT_OWNER));
+    assert_no_effect(&denied, &tree);
+
+    let minted = invoke(
+        &lifecycle,
+        &tree,
+        OWNER,
+        data(SEL_MINT, &[addr_arg(ALICE), u128_arg(1_000)].concat()),
+    );
+    assert_eq!(minted.status, ExecStatus::Returned(0));
+    let tree = commit(&tree, &minted);
+    assert_eq!(
+        read_u128(&lifecycle, &tree, data(SEL_TOTAL_SUPPLY, &[])),
+        1_000
+    );
+    assert_eq!(balance_of(&lifecycle, &tree, ALICE), 1_000);
+
+    let (topic, payload) = split_event(&minted.events[0]);
+    assert_eq!(topic, b"mint");
+    assert_eq!(&payload[20..], &1_000u128.to_le_bytes());
+}
+
+#[test]
+fn transfer_moves_balance_and_refuses_what_it_must() {
+    let (lifecycle, tree) = deploy_token();
+    let tree = mint_to(&lifecycle, &tree, ALICE, 1_000);
+
+    let moved = invoke(&lifecycle, &tree, ALICE, transfer(BOB, 400));
+    assert_eq!(moved.status, ExecStatus::Returned(0));
+    let tree = commit(&tree, &moved);
+    assert_eq!(balance_of(&lifecycle, &tree, ALICE), 600);
+    assert_eq!(balance_of(&lifecycle, &tree, BOB), 400);
+
+    let too_much = invoke(&lifecycle, &tree, ALICE, transfer(BOB, 601));
+    assert_eq!(too_much.status, returned(ERR_INSUFFICIENT_BALANCE));
+    assert_no_effect(&too_much, &tree);
+
+    let to_zero = invoke(&lifecycle, &tree, ALICE, transfer(ZERO, 1));
+    assert_eq!(to_zero.status, returned(ERR_ZERO_ADDRESS));
+
+    let zero = invoke(&lifecycle, &tree, ALICE, transfer(BOB, 0));
+    assert_eq!(zero.status, ExecStatus::Returned(0));
+    assert_eq!(
+        zero.diff
+            .expect("a no-op yields an empty diff")
+            .changes
+            .len(),
+        0,
+        "a zero transfer must not touch storage"
+    );
+}
+
+#[test]
+fn approve_and_transfer_from_spend_exactly_the_allowance() {
+    let (lifecycle, tree) = deploy_token();
+    let tree = mint_to(&lifecycle, &tree, ALICE, 1_000);
+
+    let approved = invoke(
+        &lifecycle,
+        &tree,
+        ALICE,
+        data(SEL_APPROVE, &[addr_arg(BOB), u128_arg(250)].concat()),
+    );
+    assert_eq!(approved.status, ExecStatus::Returned(0));
+    let tree = commit(&tree, &approved);
+    assert_eq!(
+        read_u128(&lifecycle, &tree, allowance_method(ALICE, BOB)),
+        250
+    );
+
+    let spent = invoke(
+        &lifecycle,
+        &tree,
+        BOB,
+        data(
+            SEL_TRANSFER_FROM,
+            &[addr_arg(ALICE), addr_arg(BOB), u128_arg(100)].concat(),
+        ),
+    );
+    assert_eq!(spent.status, ExecStatus::Returned(0));
+    let tree = commit(&tree, &spent);
+    assert_eq!(
+        read_u128(&lifecycle, &tree, allowance_method(ALICE, BOB)),
+        150,
+        "the allowance decreases by exactly the amount"
+    );
+    assert_eq!(balance_of(&lifecycle, &tree, BOB), 100);
+
+    let over = invoke(
+        &lifecycle,
+        &tree,
+        BOB,
+        data(
+            SEL_TRANSFER_FROM,
+            &[addr_arg(ALICE), addr_arg(BOB), u128_arg(151)].concat(),
+        ),
+    );
+    assert_eq!(over.status, returned(ERR_ALLOWANCE));
+    assert_no_effect(&over, &tree);
+    assert_eq!(
+        read_u128(&lifecycle, &tree, allowance_method(ALICE, BOB)),
+        150
+    );
+}
+
+#[test]
+fn burn_reduces_balance_and_supply() {
+    let (lifecycle, tree) = deploy_token();
+    let tree = mint_to(&lifecycle, &tree, ALICE, 1_000);
+    let burned = invoke(&lifecycle, &tree, ALICE, data(SEL_BURN, &u128_arg(400)));
+    assert_eq!(burned.status, ExecStatus::Returned(0));
+    let tree = commit(&tree, &burned);
+    assert_eq!(balance_of(&lifecycle, &tree, ALICE), 600);
+    assert_eq!(
+        read_u128(&lifecycle, &tree, data(SEL_TOTAL_SUPPLY, &[])),
+        600
+    );
+
+    let too_much = invoke(&lifecycle, &tree, ALICE, data(SEL_BURN, &u128_arg(601)));
+    assert_eq!(too_much.status, returned(ERR_INSUFFICIENT_BALANCE));
+}
+
+#[test]
+fn arithmetic_overflow_is_refused_not_wrapped() {
+    let (lifecycle, tree) = deploy_token();
+    let tree = mint_to(&lifecycle, &tree, ALICE, u128::MAX - 10);
+    let receipt = invoke(
+        &lifecycle,
+        &tree,
+        OWNER,
+        data(SEL_MINT, &[addr_arg(ALICE), u128_arg(11)].concat()),
+    );
+    assert_eq!(receipt.status, returned(ERR_OVERFLOW));
+    assert_no_effect(&receipt, &tree);
+}
+
+#[test]
+fn ownership_hands_over_and_the_old_owner_loses_the_right() {
+    let (lifecycle, tree) = deploy_token();
+    let handover = invoke(
+        &lifecycle,
+        &tree,
+        OWNER,
+        data(SEL_TRANSFER_OWNERSHIP, &addr_arg(ALICE)),
+    );
+    assert_eq!(handover.status, ExecStatus::Returned(0));
+    let tree = commit(&tree, &handover);
+
+    let denied = invoke(
+        &lifecycle,
+        &tree,
+        OWNER,
+        data(SEL_MINT, &[addr_arg(OWNER), u128_arg(1)].concat()),
+    );
+    assert_eq!(denied.status, returned(ERR_NOT_OWNER));
+
+    let allowed = invoke(
+        &lifecycle,
+        &tree,
+        ALICE,
+        data(SEL_MINT, &[addr_arg(ALICE), u128_arg(1)].concat()),
+    );
+    assert_eq!(allowed.status, ExecStatus::Returned(0));
+}
+
+#[test]
+fn calldata_that_does_not_decode_is_refused() {
+    let (lifecycle, tree) = deploy_token();
+    let cases: Vec<(Vec<u8>, i32, &str)> = vec![
+        (vec![], ERR_BAD_SELECTOR, "no calldata at all"),
+        (vec![0x01, 0x00], ERR_BAD_SELECTOR, "half a selector"),
+        (data(0xffff, &[]), ERR_BAD_SELECTOR, "unknown selector"),
+        (
+            data(SEL_TRANSFER, &addr_arg(BOB)),
+            ERR_BAD_ARGS,
+            "missing amount",
+        ),
+        (
+            data(
+                SEL_TRANSFER,
+                &[addr_arg(BOB), u128_arg(1), vec![0]].concat(),
+            ),
+            ERR_BAD_ARGS,
+            "one trailing byte",
+        ),
+        (
+            data(SEL_TOTAL_SUPPLY, &[0]),
+            ERR_BAD_ARGS,
+            "an argument for a nullary method",
+        ),
+    ];
+    for (calldata, expected, what) in cases {
+        let receipt = invoke(&lifecycle, &tree, ALICE, calldata);
+        assert_eq!(
+            receipt.status,
+            returned(expected),
+            "{what} must be refused with {expected}"
+        );
+        assert_no_effect(&receipt, &tree);
+    }
+}
+
+#[test]
+fn a_refused_call_commits_nothing() {
+    let (lifecycle, tree) = deploy_token();
+    let tree = mint_to(&lifecycle, &tree, ALICE, 1_000);
+    let before = tree.entries();
+    let receipt = invoke(&lifecycle, &tree, ALICE, transfer(BOB, 5_000));
+    assert_eq!(receipt.status, returned(ERR_INSUFFICIENT_BALANCE));
+    assert_no_effect(&receipt, &tree);
+    assert_eq!(before, tree.entries());
+}
+
+#[test]
+fn the_same_calldata_twice_produces_the_same_root() {
+    let run = || {
+        let (lifecycle, tree) = deploy_token();
+        let tree = mint_to(&lifecycle, &tree, ALICE, 1_000);
+        let receipt = invoke(&lifecycle, &tree, ALICE, transfer(BOB, 123));
+        let committed = commit(&tree, &receipt);
+        format!(
+            "{:?}{:?}",
+            committed.root_at(committed.version()).expect("root"),
+            committed.entries()
+        )
+    };
+    assert_eq!(run(), run());
+}
+
+#[test]
+fn a_token_holds_no_native_balance() {
+    // The token is not ALCRY: minting 1 000 tokens must not create 1 000 base
+    // units of native currency.
+    let (lifecycle, tree) = deploy_token();
+    let tree = mint_to(&lifecycle, &tree, ALICE, 1_000);
+    let view = StateView::new(tree, 0);
+    assert_eq!(
+        aura_exec::lifecycle::account_of(&view, &address(TOKEN))
+            .balance
+            .units(),
+        0
+    );
+}
diff --git a/crates/aura-exec/tests/x5_arc721.rs b/crates/aura-exec/tests/x5_arc721.rs
new file mode 100644
index 0000000..005d198
--- /dev/null
+++ b/crates/aura-exec/tests/x5_arc721.rs
@@ -0,0 +1,320 @@
+//! X5 gate (ARC-721): the non-fungible token standard, method by method.
+//!
+//! Same harness as the ARC-20 gate: the shipped artifact, the real `Lifecycle`,
+//! observable behaviour only. What is specific to a non-fungible standard is that
+//! ownership is per token id, so the tests concentrate on the three ways a
+//! per-token contract goes wrong: a token existing twice, a transfer that does not
+//! clear the approval, and a counter that disagrees with the ownership map.
+
+mod x5_support;
+
+use aura_exec::lifecycle::Lifecycle;
+use aura_exec::{ContractReceipt, ExecStatus};
+use aura_state::MerkleTree;
+use x5_support::*;
+
+const ARC721: &[u8] = include_bytes!("../../../standards/arc721/wasm/arc721.wasm");
+
+const NFT: [u8; 20] = [0x55; 20];
+const OWNER: [u8; 20] = [0x22; 20];
+const ALICE: [u8; 20] = [0x33; 20];
+const BOB: [u8; 20] = [0x44; 20];
+const CAROL: [u8; 20] = [0x66; 20];
+const ZERO: [u8; 20] = [0x00; 20];
+
+const SEL_MINT: u32 = 0x01;
+const SEL_TRANSFER: u32 = 0x02;
+const SEL_APPROVE: u32 = 0x03;
+const SEL_TRANSFER_FROM: u32 = 0x04;
+const SEL_OWNER_OF: u32 = 0x05;
+const SEL_GET_APPROVED: u32 = 0x06;
+const SEL_BALANCE_OF: u32 = 0x07;
+const SEL_TOTAL_SUPPLY: u32 = 0x08;
+const SEL_BURN: u32 = 0x09;
+const SEL_OWNER: u32 = 0x0a;
+
+const ERR_NOT_TOKEN_OWNER: i32 = -6;
+const ERR_NOT_OWNER: i32 = -22;
+const ERR_ZERO_ADDRESS: i32 = -23;
+const ERR_NO_TOKEN: i32 = -25;
+const ERR_TOKEN_EXISTS: i32 = -26;
+const ERR_NOT_APPROVED: i32 = -27;
+
+fn deploy_nft() -> (Lifecycle, MerkleTree) {
+    deploy(ARC721, NFT, OWNER, &[OWNER, ALICE, BOB, CAROL])
+}
+
+fn invoke(
+    lifecycle: &Lifecycle,
+    tree: &MerkleTree,
+    who: [u8; 20],
+    calldata: Vec<u8>,
+) -> ContractReceipt {
+    x5_support::invoke(lifecycle, tree, NFT, who, calldata)
+}
+
+fn read_u128(lifecycle: &Lifecycle, tree: &MerkleTree, calldata: Vec<u8>) -> u128 {
+    x5_support::read_u128(lifecycle, tree, NFT, calldata)
+}
+
+fn read_addr(lifecycle: &Lifecycle, tree: &MerkleTree, calldata: Vec<u8>) -> [u8; 20] {
+    x5_support::read_addr(lifecycle, tree, NFT, calldata)
+}
+
+fn mint_token(lifecycle: &Lifecycle, tree: &MerkleTree, to: [u8; 20], id: u128) -> MerkleTree {
+    let receipt = invoke(
+        lifecycle,
+        tree,
+        OWNER,
+        data(SEL_MINT, &[addr_arg(to), u128_arg(id)].concat()),
+    );
+    assert_eq!(receipt.status, ExecStatus::Returned(0), "mint must succeed");
+    commit(tree, &receipt)
+}
+
+fn holder_of(lifecycle: &Lifecycle, tree: &MerkleTree, id: u128) -> [u8; 20] {
+    read_addr(lifecycle, tree, data(SEL_OWNER_OF, &u128_arg(id)))
+}
+
+fn balance_of(lifecycle: &Lifecycle, tree: &MerkleTree, who: [u8; 20]) -> u128 {
+    read_u128(lifecycle, tree, data(SEL_BALANCE_OF, &addr_arg(who)))
+}
+
+#[test]
+fn arc721_deploys_empty_and_records_its_owner() {
+    let (lifecycle, tree) = deploy_nft();
+    assert_eq!(read_u128(&lifecycle, &tree, data(SEL_TOTAL_SUPPLY, &[])), 0);
+    assert_eq!(
+        read_addr(&lifecycle, &tree, data(SEL_OWNER, &[])),
+        OWNER,
+        "the deployer owns the collection"
+    );
+}
+
+#[test]
+fn a_token_can_only_be_minted_once() {
+    let (lifecycle, tree) = deploy_nft();
+    let tree = mint_token(&lifecycle, &tree, ALICE, 7);
+    assert_eq!(holder_of(&lifecycle, &tree, 7), ALICE);
+
+    let again = invoke(
+        &lifecycle,
+        &tree,
+        OWNER,
+        data(SEL_MINT, &[addr_arg(BOB), u128_arg(7)].concat()),
+    );
+    assert_eq!(again.status, returned(ERR_TOKEN_EXISTS));
+    assert_no_effect(&again, &tree);
+    assert_eq!(
+        holder_of(&lifecycle, &tree, 7),
+        ALICE,
+        "a refused mint must not move the token"
+    );
+}
+
+#[test]
+fn only_the_contract_owner_mints() {
+    let (lifecycle, tree) = deploy_nft();
+    let denied = invoke(
+        &lifecycle,
+        &tree,
+        ALICE,
+        data(SEL_MINT, &[addr_arg(ALICE), u128_arg(1)].concat()),
+    );
+    assert_eq!(denied.status, returned(ERR_NOT_OWNER));
+    assert_no_effect(&denied, &tree);
+}
+
+#[test]
+fn transferring_moves_ownership_and_the_counter() {
+    let (lifecycle, tree) = deploy_nft();
+    let tree = mint_token(&lifecycle, &tree, ALICE, 1);
+    assert_eq!(balance_of(&lifecycle, &tree, ALICE), 1);
+
+    let moved = invoke(
+        &lifecycle,
+        &tree,
+        ALICE,
+        data(SEL_TRANSFER, &[addr_arg(BOB), u128_arg(1)].concat()),
+    );
+    assert_eq!(moved.status, ExecStatus::Returned(0));
+    let tree = commit(&tree, &moved);
+    assert_eq!(holder_of(&lifecycle, &tree, 1), BOB);
+    assert_eq!(balance_of(&lifecycle, &tree, ALICE), 0);
+    assert_eq!(balance_of(&lifecycle, &tree, BOB), 1);
+
+    // Only the holder may transfer, and only to a non-zero address.
+    let not_holder = invoke(
+        &lifecycle,
+        &tree,
+        ALICE,
+        data(SEL_TRANSFER, &[addr_arg(ALICE), u128_arg(1)].concat()),
+    );
+    assert_eq!(not_holder.status, returned(ERR_NOT_TOKEN_OWNER));
+    let to_zero = invoke(
+        &lifecycle,
+        &tree,
+        BOB,
+        data(SEL_TRANSFER, &[addr_arg(ZERO), u128_arg(1)].concat()),
+    );
+    assert_eq!(to_zero.status, returned(ERR_ZERO_ADDRESS));
+}
+
+#[test]
+fn a_transfer_clears_the_approval() {
+    // The classic NFT bug: a stale approval lets the old spender move the token
+    // again after it changed hands.
+    let (lifecycle, tree) = deploy_nft();
+    let tree = mint_token(&lifecycle, &tree, ALICE, 3);
+
+    let approved = invoke(
+        &lifecycle,
+        &tree,
+        ALICE,
+        data(SEL_APPROVE, &[addr_arg(CAROL), u128_arg(3)].concat()),
+    );
+    assert_eq!(approved.status, ExecStatus::Returned(0));
+    let tree = commit(&tree, &approved);
+    assert_eq!(
+        read_addr(&lifecycle, &tree, data(SEL_GET_APPROVED, &u128_arg(3))),
+        CAROL
+    );
+
+    // Carol moves it to herself; the approval must be gone afterwards.
+    let moved = invoke(
+        &lifecycle,
+        &tree,
+        CAROL,
+        data(
+            SEL_TRANSFER_FROM,
+            &[addr_arg(ALICE), addr_arg(CAROL), u128_arg(3)].concat(),
+        ),
+    );
+    assert_eq!(moved.status, ExecStatus::Returned(0));
+    let tree = commit(&tree, &moved);
+    assert_eq!(
+        read_addr(&lifecycle, &tree, data(SEL_GET_APPROVED, &u128_arg(3))),
+        ZERO,
+        "a transfer must clear the approval"
+    );
+}
+
+#[test]
+fn transfer_from_needs_the_approval() {
+    let (lifecycle, tree) = deploy_nft();
+    let tree = mint_token(&lifecycle, &tree, ALICE, 4);
+
+    let unapproved = invoke(
+        &lifecycle,
+        &tree,
+        BOB,
+        data(
+            SEL_TRANSFER_FROM,
+            &[addr_arg(ALICE), addr_arg(BOB), u128_arg(4)].concat(),
+        ),
+    );
+    assert_eq!(unapproved.status, returned(ERR_NOT_APPROVED));
+    assert_no_effect(&unapproved, &tree);
+
+    // The owner does not need one.
+    let by_owner = invoke(
+        &lifecycle,
+        &tree,
+        ALICE,
+        data(
+            SEL_TRANSFER_FROM,
+            &[addr_arg(ALICE), addr_arg(BOB), u128_arg(4)].concat(),
+        ),
+    );
+    assert_eq!(by_owner.status, ExecStatus::Returned(0));
+}
+
+#[test]
+fn reading_a_missing_token_is_an_error_not_a_zero_address() {
+    let (lifecycle, tree) = deploy_nft();
+    for selector in [SEL_OWNER_OF, SEL_GET_APPROVED] {
+        let receipt = invoke(&lifecycle, &tree, ALICE, data(selector, &u128_arg(99)));
+        assert_eq!(
+            receipt.status,
+            returned(ERR_NO_TOKEN),
+            "selector {selector}"
+        );
+        assert!(
+            receipt.return_data.is_empty(),
+            "no answer for a missing token"
+        );
+    }
+    // And a transfer of a missing token is refused the same way.
+    let receipt = invoke(
+        &lifecycle,
+        &tree,
+        ALICE,
+        data(SEL_TRANSFER, &[addr_arg(BOB), u128_arg(99)].concat()),
+    );
+    assert_eq!(receipt.status, returned(ERR_NO_TOKEN));
+}
+
+#[test]
+fn burn_destroys_the_token_and_decrements_both_counters() {
+    let (lifecycle, tree) = deploy_nft();
+    let tree = mint_token(&lifecycle, &tree, ALICE, 5);
+    let burned = invoke(&lifecycle, &tree, ALICE, data(SEL_BURN, &u128_arg(5)));
+    assert_eq!(burned.status, ExecStatus::Returned(0));
+    let tree = commit(&tree, &burned);
+
+    assert_eq!(read_u128(&lifecycle, &tree, data(SEL_TOTAL_SUPPLY, &[])), 0);
+    assert_eq!(balance_of(&lifecycle, &tree, ALICE), 0);
+    let gone = invoke(&lifecycle, &tree, ALICE, data(SEL_OWNER_OF, &u128_arg(5)));
+    assert_eq!(gone.status, returned(ERR_NO_TOKEN));
+
+    // A burned id can be minted again — the id is an identifier, not a counter.
+    let tree = mint_token(&lifecycle, &tree, BOB, 5);
+    assert_eq!(holder_of(&lifecycle, &tree, 5), BOB);
+}
+
+#[test]
+fn the_supply_and_the_ownership_map_never_disagree() {
+    // The invariant a per-token contract must keep: total supply equals the sum of
+    // the holdings, after every kind of operation.
+    let (lifecycle, tree) = deploy_nft();
+    let mut tree = tree;
+    for (id, to) in [(1u128, ALICE), (2, ALICE), (3, BOB)] {
+        tree = mint_token(&lifecycle, &tree, to, id);
+    }
+    let moved = invoke(
+        &lifecycle,
+        &tree,
+        ALICE,
+        data(SEL_TRANSFER, &[addr_arg(CAROL), u128_arg(1)].concat()),
+    );
+    tree = commit(&tree, &moved);
+    let burned = invoke(&lifecycle, &tree, BOB, data(SEL_BURN, &u128_arg(3)));
+    tree = commit(&tree, &burned);
+
+    let supply = read_u128(&lifecycle, &tree, data(SEL_TOTAL_SUPPLY, &[]));
+    let sum = balance_of(&lifecycle, &tree, ALICE)
+        + balance_of(&lifecycle, &tree, BOB)
+        + balance_of(&lifecycle, &tree, CAROL);
+    assert_eq!(supply, sum, "supply must equal the sum of holdings");
+    assert_eq!(supply, 2);
+}
+
+#[test]
+fn calldata_that_does_not_decode_is_refused() {
+    let (lifecycle, tree) = deploy_nft();
+    let cases: Vec<(Vec<u8>, i32, &str)> = vec![
+        (vec![], -20, "no calldata"),
+        (data(0xffff, &[]), -20, "unknown selector"),
+        (data(SEL_MINT, &addr_arg(ALICE)), -21, "missing token id"),
+        (
+            data(SEL_OWNER_OF, &[u128_arg(1), vec![0]].concat()),
+            -21,
+            "trailing byte",
+        ),
+    ];
+    for (calldata, expected, what) in cases {
+        let receipt = invoke(&lifecycle, &tree, OWNER, calldata);
+        assert_eq!(receipt.status, returned(expected), "{what}");
+        assert_no_effect(&receipt, &tree);
+    }
+}
diff --git a/crates/aura-exec/tests/x5_artifacts.rs b/crates/aura-exec/tests/x5_artifacts.rs
new file mode 100644
index 0000000..dadbcf1
--- /dev/null
+++ b/crates/aura-exec/tests/x5_artifacts.rs
@@ -0,0 +1,150 @@
+//! X5 gate (artifacts): what is on disk is what the fixture pins.
+//!
+//! A gate that deploys "the artifact in the repository" is only meaningful if the
+//! artifact is the one the build produced. This test is the link: measured size and
+//! hash from `tools/build_standards.py`, an import set that is a subset of ABI v1
+//! and v2, and the two exports the lifecycle requires.
+//!
+//! It is also the test that would fail if someone committed a `.wasm` built from a
+//! different source tree, which is the quietest possible way to ship a lie.
+
+use std::collections::BTreeMap;
+
+const FIXTURE: &str = include_str!("fixtures/x5_standards.txt");
+
+const ARC20: &[u8] = include_bytes!("../../../standards/arc20/wasm/arc20.wasm");
+const ARC721: &[u8] = include_bytes!("../../../standards/arc721/wasm/arc721.wasm");
+const MULTISIG: &[u8] = include_bytes!("../../../standards/multisig/wasm/multisig.wasm");
+
+fn field(key: &str) -> String {
+    FIXTURE
+        .lines()
+        .find_map(|line| line.strip_prefix(&format!("{key}=")))
+        .unwrap_or_else(|| panic!("missing {key} in the X5 fixture"))
+        .to_string()
+}
+
+fn artifacts() -> BTreeMap<&'static str, &'static [u8]> {
+    BTreeMap::from([("arc20", ARC20), ("arc721", ARC721), ("multisig", MULTISIG)])
+}
+
+#[test]
+fn every_standard_matches_its_pinned_size_and_hash() {
+    for (name, wasm) in artifacts() {
+        let size: usize = field(&format!("standard_{name}_size"))
+            .parse()
+            .expect("pinned size");
+        assert_eq!(
+            wasm.len(),
+            size,
+            "{name}: the artifact is not the pinned one"
+        );
+        // The digest the node can compute: BLAKE3, recorded by `x5-record` when the
+        // fixture was written. A `.wasm` swapped for another one fails here.
+        let pinned_blake3 = field(&format!("standard_{name}_blake3"));
+        assert_eq!(
+            aura_crypto::blake3_hash(wasm).to_string(),
+            pinned_blake3,
+            "{name}: the shipped artifact is not the one the fixture pins"
+        );
+        // SHA-256 comes from the build tool; it is pinned as a build receipt, so the
+        // check here is only that it is a well-formed digest.
+        let pinned_sha256 = field(&format!("standard_{name}_sha256"));
+        assert_eq!(
+            pinned_sha256.len(),
+            64,
+            "{name}: pinned sha256 has the wrong length"
+        );
+        assert!(
+            pinned_sha256.chars().all(|c| c.is_ascii_hexdigit()),
+            "{name}: pinned sha256 is not hex"
+        );
+    }
+}
+
+#[test]
+fn every_standard_imports_only_abi_functions() {
+    let v1 = [
+        "storage_read",
+        "storage_write",
+        "balance",
+        "transfer",
+        "emit",
+        "hash",
+        "block_ctx",
+    ];
+    let v2 = [
+        "calldata_len",
+        "calldata_read",
+        "return_write",
+        "caller",
+        "self_address",
+        "abi_version",
+    ];
+    for (name, _wasm) in artifacts() {
+        let imports = field(&format!("standard_{name}_imports"));
+        assert!(
+            !imports.is_empty(),
+            "{name}: a standard must import the ABI"
+        );
+        for import in imports.split(',') {
+            let (module, function) = import.split_once('.').expect("module.name");
+            let allowed = match module {
+                "env" => v1.contains(&function),
+                "env2" => v2.contains(&function),
+                _ => false,
+            };
+            assert!(allowed, "{name} imports {import}, which is not in the ABI");
+        }
+    }
+}
+
+#[test]
+fn every_standard_exports_the_entry_points_the_lifecycle_calls() {
+    for (name, _) in artifacts() {
+        let exports = field(&format!("standard_{name}_exports"));
+        for required in ["run", "init", "memory"] {
+            assert!(
+                exports.split(',').any(|export| export == required),
+                "{name} does not export {required}"
+            );
+        }
+    }
+}
+
+#[test]
+fn the_measured_gas_of_every_standard_is_pinned() {
+    // A gas number in a report must be one the gate can recompute, so the fixture
+    // carries the measured values and this test refuses a zero or a missing row.
+    for key in [
+        "measured_arc20_deploy_gas",
+        "measured_arc20_mint_gas",
+        "measured_arc20_transfer_gas",
+        "measured_arc20_balance_of_gas",
+        "measured_arc721_deploy_gas",
+        "measured_arc721_mint_gas",
+        "measured_arc721_transfer_gas",
+        "measured_multisig_deploy_gas",
+        "measured_multisig_policy_gas",
+        "measured_multisig_propose_gas",
+        "measured_multisig_approve_gas",
+    ] {
+        let value: u64 = field(key)
+            .parse()
+            .unwrap_or_else(|_| panic!("{key} is not a number"));
+        assert!(value > 0, "{key} must be a measured, non-zero number");
+    }
+}
+
+#[test]
+fn the_fixture_publishes_the_surface_the_standards_use() {
+    assert_eq!(field("abi_version"), "2");
+    assert_eq!(field("abi_modules"), "env,env2");
+    assert_eq!(field("target"), "wasm32-unknown-unknown");
+    for name in artifacts().keys() {
+        assert_eq!(
+            field(&format!("standard_{name}_crate")),
+            format!("aura-standard-{name}")
+        );
+    }
+}
diff --git a/crates/aura-exec/tests/x5_multisig.rs b/crates/aura-exec/tests/x5_multisig.rs
new file mode 100644
index 0000000..faac9da
--- /dev/null
+++ b/crates/aura-exec/tests/x5_multisig.rs
@@ -0,0 +1,445 @@
+//! X5 gate (ARC-M1): the minimal multisig, including the cases that lose money.
+//!
+//! A multisig is small enough to review completely, so the tests aim at the three
+//! ways it fails in the field: a foreign key voting, the same key voting twice, and
+//! a proposal executing twice. The contract holds native ALCRY, so the balances
+//! asserted here are real account balances in the state tree, not contract storage.
+
+mod x5_support;
+
+use aura_exec::lifecycle::{Lifecycle, account_of};
+use aura_exec::{ContractReceipt, ExecStatus};
+use aura_state::{Account, MerkleTree, StateView};
+use aura_types::{Amount, Hash, Nonce};
+use x5_support::*;
+
+const MULTISIG: &[u8] = include_bytes!("../../../standards/multisig/wasm/multisig.wasm");
+
+const WALLET: [u8; 20] = [0x77; 20];
+const CREATOR: [u8; 20] = [0x22; 20];
+const S1: [u8; 20] = [0x81; 20];
+const S2: [u8; 20] = [0x82; 20];
+const S3: [u8; 20] = [0x83; 20];
+const PAYEE: [u8; 20] = [0x99; 20];
+const STRANGER: [u8; 20] = [0xaa; 20];
+const ZERO: [u8; 20] = [0x00; 20];
+
+const SEL_SET_POLICY: u32 = 0x01;
+const SEL_PROPOSE: u32 = 0x02;
+const SEL_APPROVE: u32 = 0x03;
+const SEL_REVOKE: u32 = 0x04;
+const SEL_PROPOSAL: u32 = 0x05;
+const SEL_SIGNERS: u32 = 0x06;
+const SEL_THRESHOLD: u32 = 0x07;
+const SEL_CREATOR: u32 = 0x08;
+
+const ERR_INSUFFICIENT_BALANCE: i32 = -6;
+const ERR_NOT_CREATOR: i32 = -22;
+const ERR_ZERO_ADDRESS: i32 = -23;
+const ERR_NOT_SIGNER: i32 = -28;
+const ERR_POLICY: i32 = -29;
+const ERR_NO_PROPOSAL: i32 = -30;
+const ERR_ALREADY_EXECUTED: i32 = -31;
+
+fn invoke(
+    lifecycle: &Lifecycle,
+    tree: &MerkleTree,
+    who: [u8; 20],
+    calldata: Vec<u8>,
+) -> ContractReceipt {
+    x5_support::invoke(lifecycle, tree, WALLET, who, calldata)
+}
+
+/// Deploy the wallet, fund it with `funds` base units and install a 2-of-3 policy.
+fn deploy_wallet(funds: u128) -> (Lifecycle, MerkleTree) {
+    let lifecycle = Lifecycle::new();
+    let accounts = [CREATOR, S1, S2, S3, PAYEE, STRANGER];
+    let mut entries: Vec<(Hash, Vec<u8>)> = accounts
+        .iter()
+        .map(|who| {
+            let account =
+                Account::new(Nonce::new(0), Amount::from_units(0), Hash::ZERO, Hash::ZERO);
+            (
+                aura_state::StateKey::account(&address(*who)).digest(),
+                account.to_bytes(),
+            )
+        })
+        .collect();
+    // The wallet starts funded so a proposal has something to send.
+    let wallet = Account::new(
+        Nonce::new(0),
+        Amount::from_units(funds),
+        Hash::ZERO,
+        Hash::ZERO,
+    );
+    entries.push((
+        aura_state::StateKey::account(&address(WALLET)).digest(),
+        wallet.to_bytes(),
+    ));
+    let start = MerkleTree::from_entries(1, &entries);
+
+    let deployed = lifecycle
+        .deploy(
+            &start,
+            call_from(WALLET, CREATOR, 1_000_000),
+            MULTISIG.to_vec(),
+            Amount::from_units(0),
+            None,
+        )
+        .expect("deploy runs");
+    assert!(deployed.committed(), "{:?}", deployed.status);
+    let mut tree = commit(&start, &lifecycle_receipt(&deployed));
+
+    let policy = invoke(
+        &lifecycle,
+        &tree,
+        CREATOR,
+        data(
+            SEL_SET_POLICY,
+            &[u8_arg(2), addr_arg(S1), addr_arg(S2), addr_arg(S3)].concat(),
+        ),
+    );
+    assert_eq!(policy.status, ExecStatus::Returned(0), "policy installs");
+    tree = commit(&tree, &policy);
+    (lifecycle, tree)
+}
+
+/// The lifecycle receipt and the contract receipt carry the same diff; this keeps
+/// the helper above readable.
+fn lifecycle_receipt(receipt: &aura_exec::lifecycle::LifecycleReceipt) -> ContractReceipt {
+    ContractReceipt {
+        status: receipt.status,
+        gas_used: receipt.gas_used,
+        host_gas: receipt.host_gas,
+        events: receipt.events.clone(),
+        writes: receipt.writes,
+        diff: receipt.diff.clone(),
+        result_root: receipt.result_root,
+        return_data: receipt.ret.clone(),
+    }
+}
+
+fn proposal_id(receipt: &ContractReceipt) -> u128 {
+    assert_eq!(
+        receipt.status,
+        ExecStatus::Returned(0),
+        "{:?}",
+        receipt.status
+    );
+    u128::from_le_bytes(receipt.return_data.clone().try_into().expect("16 bytes"))
+}
+
+/// Open a proposal and commit it — a proposal that is not committed is invisible,
+/// which is exactly the bug this helper exists to prevent in the tests.
+fn propose(lifecycle: &Lifecycle, tree: &mut MerkleTree, who: [u8; 20], amount: u128) -> u128 {
+    let receipt = invoke(
+        lifecycle,
+        tree,
+        who,
+        data(
+            SEL_PROPOSE,
+            &[u8_arg(1), addr_arg(PAYEE), u128_arg(amount)].concat(),
+        ),
+    );
+    let pid = proposal_id(&receipt);
+    *tree = commit(tree, &receipt);
+    pid
+}
+
+fn wallet_balance(tree: &MerkleTree) -> u128 {
+    account_of(&StateView::new(tree.clone(), 0), &address(WALLET))
+        .balance
+        .units()
+}
+
+#[test]
+fn the_policy_is_installed_once_by_the_creator() {
+    let (lifecycle, tree) = deploy_wallet(0);
+    let signers = x5_support::invoke(
+        &lifecycle,
+        &tree,
+        WALLET,
+        x5_support::ASKER,
+        data(SEL_SIGNERS, &[]),
+    );
+    assert_eq!(signers.return_data.len(), 60);
+    assert_eq!(&signers.return_data[..20], &S1);
+    assert_eq!(&signers.return_data[20..40], &S2);
+    assert_eq!(&signers.return_data[40..], &S3);
+
+    let threshold = x5_support::invoke(
+        &lifecycle,
+        &tree,
+        WALLET,
+        x5_support::ASKER,
+        data(SEL_THRESHOLD, &[]),
+    );
+    assert_eq!(threshold.return_data, vec![2]);
+
+    let creator = x5_support::invoke(
+        &lifecycle,
+        &tree,
+        WALLET,
+        x5_support::ASKER,
+        data(SEL_CREATOR, &[]),
+    );
+    assert_eq!(creator.return_data, CREATOR.to_vec());
+
+    // A second install — even by the creator — is refused: a reconfigurable
+    // multisig is a single key with extra steps.
+    let again = invoke(
+        &lifecycle,
+        &tree,
+        CREATOR,
+        data(
+            SEL_SET_POLICY,
+            &[u8_arg(1), addr_arg(PAYEE), addr_arg(PAYEE), addr_arg(PAYEE)].concat(),
+        ),
+    );
+    assert_eq!(again.status, returned(ERR_POLICY));
+    assert_no_effect(&again, &tree);
+}
+
+#[test]
+fn a_bad_policy_is_refused() {
+    let lifecycle = Lifecycle::new();
+    let start = base(&[CREATOR]);
+    let deployed = lifecycle
+        .deploy(
+            &start,
+            call_from(WALLET, CREATOR, 1_000_000),
+            MULTISIG.to_vec(),
+            Amount::from_units(0),
+            None,
+        )
+        .expect("deploy runs");
+    let tree = commit(&start, &lifecycle_receipt(&deployed));
+
+    // threshold, three signers, expected status, what the case is
+    type PolicyCase = (u8, [u8; 20], [u8; 20], [u8; 20], i32, &'static str);
+    let cases: Vec<PolicyCase> = vec![
+        (0, S1, S2, S3, ERR_POLICY, "a zero threshold"),
+        (
+            4,
+            S1,
+            S2,
+            S3,
+            ERR_POLICY,
+            "a threshold above the signer count",
+        ),
+        (2, S1, S1, S3, ERR_POLICY, "a duplicated signer"),
+        (2, S1, ZERO, S3, ERR_ZERO_ADDRESS, "a zero address"),
+    ];
+    for (threshold, a, b, c, expected, what) in cases {
+        let receipt = invoke(
+            &lifecycle,
+            &tree,
+            CREATOR,
+            data(
+                SEL_SET_POLICY,
+                &[u8_arg(threshold), addr_arg(a), addr_arg(b), addr_arg(c)].concat(),
+            ),
+        );
+        assert_eq!(receipt.status, returned(expected), "{what}");
+        assert_no_effect(&receipt, &tree);
+    }
+
+    // A stranger cannot install a policy at all.
+    let stranger = invoke(
+        &lifecycle,
+        &tree,
+        STRANGER,
+        data(
+            SEL_SET_POLICY,
+            &[
+                u8_arg(1),
+                addr_arg(STRANGER),
+                addr_arg(STRANGER),
+                addr_arg(STRANGER),
+            ]
+            .concat(),
+        ),
+    );
+    assert_eq!(stranger.status, returned(ERR_NOT_CREATOR));
+}
+
+#[test]
+fn two_of_three_moves_the_money_and_only_once() {
+    let (lifecycle, mut tree) = deploy_wallet(1_000);
+    let pid = propose(&lifecycle, &mut tree, S1, 400);
+
+    // One vote is not enough.
+    let first = invoke(&lifecycle, &tree, S1, data(SEL_APPROVE, &u128_arg(pid)));
+    assert_eq!(first.status, ExecStatus::Returned(0));
+    let tree = commit(&tree, &first);
+    assert_eq!(
+        wallet_balance(&tree),
+        1_000,
+        "one of two votes moves nothing"
+    );
+
+    // The second reaches the threshold and pays.
+    let second = invoke(&lifecycle, &tree, S2, data(SEL_APPROVE, &u128_arg(pid)));
+    assert_eq!(second.status, ExecStatus::Returned(0));
+    let tree = commit(&tree, &second);
+    assert_eq!(wallet_balance(&tree), 600);
+    assert_eq!(
+        account_of(&StateView::new(tree.clone(), 0), &address(PAYEE))
+            .balance
+            .units(),
+        400
+    );
+
+    // A third vote cannot re-execute it.
+    let third = invoke(&lifecycle, &tree, S3, data(SEL_APPROVE, &u128_arg(pid)));
+    assert_eq!(third.status, returned(ERR_ALREADY_EXECUTED));
+    assert_no_effect(&third, &tree);
+    assert_eq!(wallet_balance(&tree), 600, "the wallet pays exactly once");
+
+    let state = x5_support::invoke(
+        &lifecycle,
+        &tree,
+        WALLET,
+        x5_support::ASKER,
+        data(SEL_PROPOSAL, &u128_arg(pid)),
+    );
+    assert_eq!(state.return_data.len(), 33);
+    assert_eq!(state.return_data[0], 1, "executed");
+    assert_eq!(
+        u128::from_le_bytes(state.return_data[1..17].try_into().expect("16")),
+        2
+    );
+    assert_eq!(
+        u128::from_le_bytes(state.return_data[17..].try_into().expect("16")),
+        400
+    );
+}
+
+#[test]
+fn a_signer_cannot_vote_twice() {
+    let (lifecycle, mut tree) = deploy_wallet(1_000);
+    let pid = propose(&lifecycle, &mut tree, S1, 100);
+    let first = invoke(&lifecycle, &tree, S1, data(SEL_APPROVE, &u128_arg(pid)));
+    assert_eq!(first.status, ExecStatus::Returned(0));
+    let tree = commit(&tree, &first);
+
+    let again = invoke(&lifecycle, &tree, S1, data(SEL_APPROVE, &u128_arg(pid)));
+    assert_eq!(again.status, returned(-32), "already voted");
+    assert_no_effect(&again, &tree);
+    assert_eq!(
+        wallet_balance(&tree),
+        1_000,
+        "one key counted twice is impossible"
+    );
+}
+
+#[test]
+fn a_stranger_can_neither_propose_nor_vote() {
+    let (lifecycle, mut tree) = deploy_wallet(1_000);
+    let proposal = invoke(
+        &lifecycle,
+        &tree,
+        STRANGER,
+        data(
+            SEL_PROPOSE,
+            &[u8_arg(1), addr_arg(STRANGER), u128_arg(1)].concat(),
+        ),
+    );
+    assert_eq!(proposal.status, returned(ERR_NOT_SIGNER));
+    assert_no_effect(&proposal, &tree);
+
+    let pid = propose(&lifecycle, &mut tree, S1, 1);
+    let vote = invoke(
+        &lifecycle,
+        &tree,
+        STRANGER,
+        data(SEL_APPROVE, &u128_arg(pid)),
+    );
+    assert_eq!(vote.status, returned(ERR_NOT_SIGNER));
+    assert_no_effect(&vote, &tree);
+}
+
+#[test]
+fn a_vote_can_be_taken_back() {
+    let (lifecycle, mut tree) = deploy_wallet(1_000);
+    let pid = propose(&lifecycle, &mut tree, S1, 300);
+    let vote = invoke(&lifecycle, &tree, S1, data(SEL_APPROVE, &u128_arg(pid)));
+    let tree = commit(&tree, &vote);
+
+    let revoked = invoke(&lifecycle, &tree, S1, data(SEL_REVOKE, &u128_arg(pid)));
+    assert_eq!(revoked.status, ExecStatus::Returned(0));
+    let tree = commit(&tree, &revoked);
+    assert_eq!(wallet_balance(&tree), 1_000);
+
+    // With the vote withdrawn, one remaining vote is not the threshold.
+    let second = invoke(&lifecycle, &tree, S2, data(SEL_APPROVE, &u128_arg(pid)));
+    assert_eq!(second.status, ExecStatus::Returned(0));
+    let tree = commit(&tree, &second);
+    assert_eq!(
+        wallet_balance(&tree),
+        1_000,
+        "a revoked vote does not count"
+    );
+}
+
+#[test]
+fn a_proposal_the_wallet_cannot_fund_stays_retryable() {
+    let (lifecycle, mut tree) = deploy_wallet(100);
+    let pid = propose(&lifecycle, &mut tree, S1, 1_000);
+
+    let first = invoke(&lifecycle, &tree, S1, data(SEL_APPROVE, &u128_arg(pid)));
+    let tree = commit(&tree, &first);
+    let second = invoke(&lifecycle, &tree, S2, data(SEL_APPROVE, &u128_arg(pid)));
+    assert_eq!(second.status, returned(ERR_INSUFFICIENT_BALANCE));
+    let tree = commit(&tree, &second);
+    assert_eq!(wallet_balance(&tree), 100, "nothing moved");
+
+    // The approval that tipped it over still stands, the proposal is *not* marked
+    // executed, and the vote can be tried again once the wallet is funded.
+    let state = x5_support::invoke(
+        &lifecycle,
+        &tree,
+        WALLET,
+        x5_support::ASKER,
+        data(SEL_PROPOSAL, &u128_arg(pid)),
+    );
+    assert_eq!(state.return_data[0], 0, "not executed");
+}
+
+#[test]
+fn unknown_proposals_and_kinds_are_refused() {
+    let (lifecycle, tree) = deploy_wallet(1_000);
+    let missing = invoke(&lifecycle, &tree, S1, data(SEL_APPROVE, &u128_arg(7)));
+    assert_eq!(missing.status, returned(ERR_NO_PROPOSAL));
+
+    let bad_kind = invoke(
+        &lifecycle,
+        &tree,
+        S1,
+        data(
+            SEL_PROPOSE,
+            &[u8_arg(9), addr_arg(PAYEE), u128_arg(1)].concat(),
+        ),
+    );
+    assert_eq!(bad_kind.status, returned(ERR_POLICY));
+
+    let zero_payee = invoke(
+        &lifecycle,
+        &tree,
+        S1,
+        data(
+            SEL_PROPOSE,
+            &[u8_arg(1), addr_arg(ZERO), u128_arg(1)].concat(),
+        ),
+    );
+    assert_eq!(zero_payee.status, returned(ERR_ZERO_ADDRESS));
+}
+
+#[test]
+fn proposal_ids_are_unique_and_monotonic() {
+    let (lifecycle, mut tree) = deploy_wallet(1_000);
+    let first = propose(&lifecycle, &mut tree, S1, 1);
+    let second = propose(&lifecycle, &mut tree, S2, 2);
+    assert_eq!(first, 1);
+    assert_eq!(second, 2, "two proposals never share an id");
+}
diff --git a/crates/aura-exec/tests/x5_support/mod.rs b/crates/aura-exec/tests/x5_support/mod.rs
new file mode 100644
index 0000000..d6eccef
--- /dev/null
+++ b/crates/aura-exec/tests/x5_support/mod.rs
@@ -0,0 +1,206 @@
+//! Shared harness for the X5 standard gates.
+//!
+//! Three contracts, one way of driving them: deploy through the real
+//! `Lifecycle`, call through `Lifecycle::call_data`, commit the diff into a real
+//! `MerkleTree`. Only the selector tables differ, and those live in each test
+//! file because they are part of the standard being asserted.
+//!
+//! The support module is `mod`-included, not a test target, so Cargo does not try
+//! to run it.
+
+#![allow(dead_code)]
+
+use aura_exec::lifecycle::Lifecycle;
+use aura_exec::{BlockContext, ContractCall, ContractReceipt, ExecStatus};
+use aura_state::{Account, MerkleTree, StateKey, apply_diff};
+use aura_types::{Address, Amount, Hash, Nonce};
+
+/// A call's status as a contract reports it: a returned `i32`, sign-extended.
+pub fn returned(code: i32) -> ExecStatus {
+    ExecStatus::Returned(i64::from(code))
+}
+
+pub fn address(bytes: [u8; 20]) -> Address {
+    Address::from_slice(&bytes).expect("20-byte address")
+}
+
+pub fn call_from(contract: [u8; 20], who: [u8; 20], gas: u64) -> ContractCall {
+    ContractCall {
+        contract: address(contract),
+        caller: address(who),
+        block: BlockContext {
+            height: 9,
+            timestamp_ms: 1_700_000_000_000,
+        },
+        gas_limit: gas,
+    }
+}
+
+/// A tree with empty accounts for every address that will transact.
+pub fn base(who: &[[u8; 20]]) -> MerkleTree {
+    let entries: Vec<(Hash, Vec<u8>)> = who
+        .iter()
+        .map(|address| {
+            let account =
+                Account::new(Nonce::new(0), Amount::from_units(0), Hash::ZERO, Hash::ZERO);
+            (
+                StateKey::account(&self::address(*address)).digest(),
+                account.to_bytes(),
+            )
+        })
+        .collect();
+    MerkleTree::from_entries(1, &entries)
+}
+
+/// Deploy `code` at `contract` from `deployer` and return the committed tree.
+pub fn deploy(
+    code: &[u8],
+    contract: [u8; 20],
+    deployer: [u8; 20],
+    accounts: &[[u8; 20]],
+) -> (Lifecycle, MerkleTree) {
+    let lifecycle = Lifecycle::new();
+    let start = base(accounts);
+    let receipt = lifecycle
+        .deploy(
+            &start,
+            call_from(contract, deployer, 1_000_000),
+            code.to_vec(),
+            Amount::from_units(0),
+            None,
+        )
+        .expect("deploy runs");
+    assert!(
+        receipt.committed(),
+        "init must commit: {:?}",
+        receipt.status
+    );
+    let tree = commit_diff(&start, receipt.diff.as_ref().expect("deploy diff"));
+    (lifecycle, tree)
+}
+
+/// Apply a receipt's diff to `tree`, or return it unchanged when nothing committed.
+pub fn commit(tree: &MerkleTree, receipt: &ContractReceipt) -> MerkleTree {
+    match &receipt.diff {
+        Some(diff) => commit_diff(tree, diff),
+        None => tree.clone(),
+    }
+}
+
+fn commit_diff(tree: &MerkleTree, diff: &aura_state::StateDiff) -> MerkleTree {
+    apply_diff(tree, diff).expect("diff applies")
+}
+
+/// Calldata: 4-byte little-endian selector, then the arguments.
+pub fn data(selector: u32, args: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(4 + args.len());
+    out.extend_from_slice(&selector.to_le_bytes());
+    out.extend_from_slice(args);
+    out
+}
+
+pub fn addr_arg(who: [u8; 20]) -> Vec<u8> {
+    who.to_vec()
+}
+
+pub fn u128_arg(value: u128) -> Vec<u8> {
+    value.to_le_bytes().to_vec()
+}
+
+pub fn u8_arg(value: u8) -> Vec<u8> {
+    vec![value]
+}
+
+/// One call, returning the receipt.
+pub fn invoke(
+    lifecycle: &Lifecycle,
+    tree: &MerkleTree,
+    contract: [u8; 20],
+    who: [u8; 20],
+    calldata: Vec<u8>,
+) -> ContractReceipt {
+    lifecycle
+        .call_data(tree, call_from(contract, who, 1_000_000), calldata)
+        .expect("call runs")
+}
+
+/// One call whose answer is a `u128`.
+pub fn read_u128(
+    lifecycle: &Lifecycle,
+    tree: &MerkleTree,
+    contract: [u8; 20],
+    calldata: Vec<u8>,
+) -> u128 {
+    let receipt = invoke(lifecycle, tree, contract, ASKER, calldata);
+    assert_eq!(
+        receipt.status,
+        ExecStatus::Returned(0),
+        "{:?}",
+        receipt.status
+    );
+    assert_eq!(receipt.return_data.len(), 16, "an answer must be 16 bytes");
+    u128::from_le_bytes(receipt.return_data.clone().try_into().expect("16 bytes"))
+}
+
+/// One call whose answer is an address (20 bytes).
+pub fn read_addr(
+    lifecycle: &Lifecycle,
+    tree: &MerkleTree,
+    contract: [u8; 20],
+    calldata: Vec<u8>,
+) -> [u8; 20] {
+    let receipt = invoke(lifecycle, tree, contract, ASKER, calldata);
+    assert_eq!(
+        receipt.status,
+        ExecStatus::Returned(0),
+        "{:?}",
+        receipt.status
+    );
+    assert_eq!(receipt.return_data.len(), 20, "an answer must be 20 bytes");
+    receipt.return_data.clone().try_into().expect("20 bytes")
+}
+
+/// The account a read-only helper call comes from. It never matters: a read
+/// cannot write, and the standards require no ownership to read.
+pub const ASKER: [u8; 20] = [0xee; 20];
+
+/// A raw storage value of `contract`, keyed exactly (zero-padded to 32 bytes).
+pub fn storage(tree: &MerkleTree, contract: [u8; 20], key: &[u8]) -> Option<Vec<u8>> {
+    let mut slot = [0u8; 32];
+    assert!(key.len() <= 32, "a slot key is at most 32 bytes");
+    slot[..key.len()].copy_from_slice(key);
+    tree.get_digest(&StateKey::storage(&address(contract), &slot).digest())
+        .map(<[u8]>::to_vec)
+}
+
+/// Assert that a call changed nothing in the tree's content.
+///
+/// X2's rule is that `Returned(_)` — any value, negative included — is a
+/// *successful* call and gets a diff. A standard that answers "not enough
+/// balance" with `-6` is therefore still a committed call; what makes that honest
+/// is that it writes nothing, so the change set is empty and the entries of the
+/// tree are unchanged. A trap would give `diff: None` and throw the reason away,
+/// which is why the standards do not use one for a business-level refusal.
+pub fn assert_no_effect(receipt: &ContractReceipt, before: &MerkleTree) {
+    let diff = receipt
+        .diff
+        .as_ref()
+        .expect("a returned status carries a diff");
+    assert!(
+        diff.changes.is_empty(),
+        "a refusal must not write: {} entries",
+        diff.changes.len()
+    );
+    let after = commit(before, receipt);
+    assert_eq!(
+        after.entries(),
+        before.entries(),
+        "the content of the tree must be unchanged"
+    );
+}
+
+/// Events are encoded by the host as `len(topic) u32 LE || topic || data`.
+pub fn split_event(event: &[u8]) -> (Vec<u8>, Vec<u8>) {
+    let len = u32::from_le_bytes(event[..4].try_into().expect("4-byte length")) as usize;
+    (event[4..4 + len].to_vec(), event[4 + len..].to_vec())
+}
