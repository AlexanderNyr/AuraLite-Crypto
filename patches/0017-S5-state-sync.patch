@@ -0,0 +1,427 @@
+//! S5: state sync — a fresh node catches up via S4 snapshot + compact delta,
+//! without downloading the full event history. Three independent heads must
+//! agree (quorum), the snapshot's chunk hashes and `chunk_root` must verify,
+//! and the recomputed S1 `state_root` after applying the delta must equal the
+//! heads' root. All blobs are SHA-256 checked with domain separation.
+//!
+//! Wire format is documented in `docs/evidence/s5/report.md` and generated by
+//! `tools/gen_s5_vectors.py` (independent Python). No `serde`, no `HashMap`,
+//! no wall clock in the protocol; timing is measured by the caller. Constants
+//! marked below are tamper targets checked by `tools/nc_s5.py`.
+
+use std::collections::BTreeMap;
+
+use aura_codec::{Decode, Encode, Reader, Writer, read_varint, write_varint};
+use aura_types::{ChainId, Hash, Height};
+
+use crate::error::SyncError;
+use crate::snapshot::{
+    MAX_KEY_BYTES, MAX_VALUE_BYTES, SnapshotManifest, import_snapshot, sha256, state_root,
+};
+
+/// Magic prefix of a [`SyncHead`].
+///
+/// NC target: `tools/nc_s5.py` changes this constant and requires the S5
+/// golden vectors to go red.
+pub const HEAD_MAGIC: &[u8] = b"ALH5";
+/// Magic prefix of a [`SyncDelta`].
+///
+/// NC target: `tools/nc_s5.py` changes this constant and requires the S5
+/// golden vectors to go red.
+pub const DELTA_MAGIC: &[u8] = b"ALD5";
+/// Magic prefix of a [`SyncPackage`].
+///
+/// NC target: `tools/nc_s5.py` changes this constant and requires the S5
+/// golden vectors to go red.
+pub const PACKAGE_MAGIC: &[u8] = b"ALS5";
+/// Domain tag for head checksums. (NC target: `tools/nc_s5.py`.)
+pub const S5_HEAD_CONTEXT: &[u8] = b"AuraLite-Crypto/s5-head-v1\x00";
+/// Domain tag for delta checksums. (NC target: `tools/nc_s5.py`.)
+pub const S5_DELTA_CONTEXT: &[u8] = b"AuraLite-Crypto/s5-delta-v1\x00";
+/// Domain tag for package checksums. (NC target: `tools/nc_s5.py`.)
+pub const S5_PACKAGE_CONTEXT: &[u8] = b"AuraLite-Crypto/s5-package-v1\x00";
+
+/// Wire version of the sync protocol.
+pub const SYNC_VERSION: u32 = 1;
+/// Number of independent heads required to agree.
+pub const SYNC_QUORUM: usize = 3;
+/// Maximum number of delta changes.
+pub const MAX_DELTA_CHANGES: u32 = 1_000_000;
+/// Maximum byte length of any embedded blob.
+pub const MAX_BLOB_BYTES: u64 = 64 * 1024 * 1024;
+
+/// A head advertised by one node at a given height.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SyncHead {
+    /// Wire version.
+    pub version: u32,
+    /// Chain this head belongs to.
+    pub chain_id: ChainId,
+    /// Current height of the node.
+    pub height: Height,
+    /// Versioned S1 state root at `height`.
+    pub state_root: Hash,
+    /// Height the bundled snapshot was taken at.
+    pub snapshot_height: Height,
+    /// S4 `chunk_root` of that snapshot.
+    pub snapshot_root: Hash,
+}
+
+/// A compact set of net state changes between two heights.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SyncDelta {
+    /// Wire version.
+    pub version: u32,
+    /// Height the delta starts from (snapshot height).
+    pub from_height: u64,
+    /// Height the delta ends at.
+    pub to_height: u64,
+    /// Strictly ascending `(key, value)` changes; `None` deletes.
+    pub changes: Vec<(Vec<u8>, Option<Vec<u8>>)>,
+}
+
+/// Everything a new node downloads: three heads, an S4 snapshot and a delta.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SyncPackage {
+    /// Wire version.
+    pub version: u32,
+    /// Quorum of independent heads.
+    pub heads: Vec<SyncHead>,
+    /// Canonical S4 manifest bytes.
+    pub manifest: Vec<u8>,
+    /// Concatenated S4 chunk payloads.
+    pub data: Vec<u8>,
+    /// Canonical [`SyncDelta`] bytes.
+    pub delta: Vec<u8>,
+}
+
+/// Result of a successful sync.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SyncResult {
+    /// Height reached.
+    pub height: Height,
+    /// Verified versioned state root.
+    pub state_root: Hash,
+    /// Final ordered entries.
+    pub entries: crate::snapshot::StateEntries,
+    /// Bytes downloaded (the package size).
+    pub downloaded_bytes: u64,
+    /// Bytes the node did NOT download (full history minus package).
+    pub history_bytes_saved: u64,
+}
+
+fn framed(payload: Vec<u8>, context: &[u8]) -> Vec<u8> {
+    let mut out = payload.clone();
+    let checksum = sha256(&[context, &payload].concat());
+    out.extend_from_slice(checksum.as_bytes());
+    out
+}
+
+fn split_framed<'a>(bytes: &'a [u8], context: &[u8]) -> Result<&'a [u8], SyncError> {
+    if bytes.len() < 32 {
+        return Err(SyncError::ChecksumMismatch);
+    }
+    let split = bytes.len() - 32;
+    let (payload, checksum) = bytes.split_at(split);
+    let expected = sha256(&[context, payload].concat());
+    if expected.as_bytes() != checksum {
+        return Err(SyncError::ChecksumMismatch);
+    }
+    Ok(payload)
+}
+
+fn read_blob(reader: &mut Reader<'_>) -> Result<Vec<u8>, SyncError> {
+    let len = read_varint(reader).map_err(SyncError::Decode)?;
+    if len > MAX_BLOB_BYTES {
+        return Err(SyncError::BlobTooLarge(len as usize));
+    }
+    Ok(reader
+        .read_exact(len as usize)
+        .map_err(SyncError::Decode)?
+        .to_vec())
+}
+
+impl SyncHead {
+    /// Canonical wire bytes: `payload || sha256(S5_HEAD_CONTEXT || payload)`.
+    pub fn to_bytes(&self) -> Vec<u8> {
+        framed(self.payload(), S5_HEAD_CONTEXT)
+    }
+
+    /// Strict canonical decode: checksum, magic, version, minimal varints,
+    /// no trailing bytes, byte-identical re-encoding.
+    pub fn from_canonical_bytes(bytes: &[u8]) -> Result<Self, SyncError> {
+        let payload = split_framed(bytes, S5_HEAD_CONTEXT)?;
+        let mut reader = Reader::new(payload);
+        let magic = reader.read_exact(4).map_err(SyncError::Decode)?;
+        if magic != HEAD_MAGIC {
+            return Err(SyncError::BadMagic);
+        }
+        let version = u32::decode(&mut reader).map_err(SyncError::Decode)?;
+        if version != SYNC_VERSION {
+            return Err(SyncError::UnsupportedVersion(SYNC_VERSION, version));
+        }
+        let chain_id = ChainId::decode(&mut reader).map_err(SyncError::Decode)?;
+        let height = Height::decode(&mut reader).map_err(SyncError::Decode)?;
+        let state_root = Hash::decode(&mut reader).map_err(SyncError::Decode)?;
+        let snapshot_height = u64::decode(&mut reader).map_err(SyncError::Decode)?;
+        let snapshot_root = Hash::decode(&mut reader).map_err(SyncError::Decode)?;
+        reader.finish().map_err(SyncError::Decode)?;
+        let head = SyncHead {
+            version,
+            chain_id,
+            height,
+            state_root,
+            snapshot_height: Height::new(snapshot_height),
+            snapshot_root,
+        };
+        if head.to_bytes() != bytes {
+            return Err(SyncError::NonCanonical);
+        }
+        if head.snapshot_height.value() >= head.height.value() {
+            return Err(SyncError::HeightMismatch);
+        }
+        Ok(head)
+    }
+
+    fn payload(&self) -> Vec<u8> {
+        let mut writer = Writer::new();
+        writer.push_bytes(HEAD_MAGIC);
+        self.version.encode(&mut writer);
+        self.chain_id.encode(&mut writer);
+        self.height.encode(&mut writer);
+        self.state_root.encode(&mut writer);
+        self.snapshot_height.encode(&mut writer);
+        self.snapshot_root.encode(&mut writer);
+        writer.into_bytes()
+    }
+}
+
+impl SyncDelta {
+    /// Canonical wire bytes: `payload || sha256(S5_DELTA_CONTEXT || payload)`.
+    pub fn to_bytes(&self) -> Vec<u8> {
+        framed(self.payload(), S5_DELTA_CONTEXT)
+    }
+
+    /// Strict canonical decode: checksum, magic, version, minimal varints,
+    /// ascending changes, caps, no trailing bytes, byte-identical
+    /// re-encoding.
+    pub fn from_canonical_bytes(bytes: &[u8]) -> Result<Self, SyncError> {
+        let payload = split_framed(bytes, S5_DELTA_CONTEXT)?;
+        let mut reader = Reader::new(payload);
+        let magic = reader.read_exact(4).map_err(SyncError::Decode)?;
+        if magic != DELTA_MAGIC {
+            return Err(SyncError::BadMagic);
+        }
+        let version = u32::decode(&mut reader).map_err(SyncError::Decode)?;
+        if version != SYNC_VERSION {
+            return Err(SyncError::UnsupportedVersion(SYNC_VERSION, version));
+        }
+        let from_height = u64::decode(&mut reader).map_err(SyncError::Decode)?;
+        let to_height = u64::decode(&mut reader).map_err(SyncError::Decode)?;
+        let change_count = u32::decode(&mut reader).map_err(SyncError::Decode)?;
+        if from_height >= to_height {
+            return Err(SyncError::HeightMismatch);
+        }
+        if change_count > MAX_DELTA_CHANGES {
+            return Err(SyncError::TooManyChanges(change_count as usize));
+        }
+        let mut changes = Vec::with_capacity(change_count as usize);
+        for _ in 0..change_count {
+            let key_len = read_varint(&mut reader).map_err(SyncError::Decode)?;
+            if key_len > MAX_KEY_BYTES {
+                return Err(SyncError::KeyTooLarge(key_len as usize));
+            }
+            let key = reader
+                .read_exact(key_len as usize)
+                .map_err(SyncError::Decode)?
+                .to_vec();
+            if changes.last().is_some_and(|(previous, _)| previous >= &key) {
+                return Err(SyncError::UnsortedChanges);
+            }
+            let tag = reader.read_exact(1).map_err(SyncError::Decode)?[0];
+            let value = match tag {
+                0 => None,
+                1 => {
+                    let value_len = read_varint(&mut reader).map_err(SyncError::Decode)?;
+                    if value_len > MAX_VALUE_BYTES {
+                        return Err(SyncError::ValueTooLarge(value_len as usize));
+                    }
+                    Some(
+                        reader
+                            .read_exact(value_len as usize)
+                            .map_err(SyncError::Decode)?
+                            .to_vec(),
+                    )
+                }
+                _ => return Err(SyncError::UnsortedChanges),
+            };
+            changes.push((key, value));
+        }
+        reader.finish().map_err(SyncError::Decode)?;
+        if changes.len() != change_count as usize {
+            return Err(SyncError::ChangeCountMismatch(change_count, changes.len()));
+        }
+        let delta = SyncDelta {
+            version,
+            from_height,
+            to_height,
+            changes,
+        };
+        if delta.to_bytes() != bytes {
+            return Err(SyncError::NonCanonical);
+        }
+        Ok(delta)
+    }
+
+    fn payload(&self) -> Vec<u8> {
+        let mut writer = Writer::new();
+        writer.push_bytes(DELTA_MAGIC);
+        self.version.encode(&mut writer);
+        self.from_height.encode(&mut writer);
+        self.to_height.encode(&mut writer);
+        (self.changes.len() as u32).encode(&mut writer);
+        for (key, value) in &self.changes {
+            write_varint(&mut writer, key.len() as u64);
+            writer.push_bytes(key);
+            match value {
+                Some(bytes) => {
+                    writer.push_bytes(&[1]);
+                    write_varint(&mut writer, bytes.len() as u64);
+                    writer.push_bytes(bytes);
+                }
+                None => writer.push_bytes(&[0]),
+            }
+        }
+        writer.into_bytes()
+    }
+}
+
+impl SyncPackage {
+    /// Canonical wire bytes: `payload || sha256(S5_PACKAGE_CONTEXT || payload)`.
+    pub fn to_bytes(&self) -> Vec<u8> {
+        framed(self.payload(), S5_PACKAGE_CONTEXT)
+    }
+
+    /// Strict canonical decode: checksum, magic, version, quorum size, minimal
+    /// varints, blob caps, no trailing bytes, byte-identical re-encoding.
+    pub fn from_canonical_bytes(bytes: &[u8]) -> Result<Self, SyncError> {
+        let payload = split_framed(bytes, S5_PACKAGE_CONTEXT)?;
+        let mut reader = Reader::new(payload);
+        let magic = reader.read_exact(4).map_err(SyncError::Decode)?;
+        if magic != PACKAGE_MAGIC {
+            return Err(SyncError::BadMagic);
+        }
+        let version = u32::decode(&mut reader).map_err(SyncError::Decode)?;
+        if version != SYNC_VERSION {
+            return Err(SyncError::UnsupportedVersion(SYNC_VERSION, version));
+        }
+        let head_count = u32::decode(&mut reader).map_err(SyncError::Decode)? as usize;
+        if head_count != SYNC_QUORUM {
+            return Err(SyncError::HeadCount(head_count));
+        }
+        let mut heads = Vec::with_capacity(head_count);
+        for _ in 0..head_count {
+            let blob = read_blob(&mut reader)?;
+            heads.push(SyncHead::from_canonical_bytes(&blob)?);
+        }
+        let manifest = read_blob(&mut reader)?;
+        let data = read_blob(&mut reader)?;
+        let delta = read_blob(&mut reader)?;
+        reader.finish().map_err(SyncError::Decode)?;
+        let package = SyncPackage {
+            version,
+            heads,
+            manifest,
+            data,
+            delta,
+        };
+        if package.to_bytes() != bytes {
+            return Err(SyncError::NonCanonical);
+        }
+        Ok(package)
+    }
+
+    /// Verify the quorum, import the S4 snapshot, apply the compact delta and
+    /// recompute the S1 state root. Never downloads block history.
+    ///
+    /// NC target: `tools/nc_s5.py` disables the quorum comparison here and
+    /// requires the "3 heads agree" gate to go red.
+    pub fn sync(
+        &self,
+        expected_chain: ChainId,
+        expected_height: Height,
+        expected_snapshot_height: Height,
+        workers: usize,
+        full_history_bytes: u64,
+    ) -> Result<SyncResult, SyncError> {
+        let heads_agree = self.heads.iter().all(|head| head == &self.heads[0]);
+        if !heads_agree {
+            return Err(SyncError::QuorumMismatch);
+        }
+        let head = &self.heads[0];
+        if head.chain_id != expected_chain {
+            return Err(SyncError::WrongChainId);
+        }
+        if head.height != expected_height || head.snapshot_height != expected_snapshot_height {
+            return Err(SyncError::HeightMismatch);
+        }
+
+        let manifest = SnapshotManifest::from_canonical_bytes(&self.manifest)?;
+        if manifest.height != expected_snapshot_height {
+            return Err(SyncError::HeightMismatch);
+        }
+        if manifest.chunk_root != head.snapshot_root {
+            return Err(SyncError::SnapshotRootMismatch);
+        }
+        let entries = import_snapshot(&self.manifest, &self.data, workers)?;
+        let delta = SyncDelta::from_canonical_bytes(&self.delta)?;
+        if delta.from_height != head.snapshot_height.value()
+            || delta.to_height != head.height.value()
+        {
+            return Err(SyncError::HeightMismatch);
+        }
+
+        let mut state: BTreeMap<Vec<u8>, Vec<u8>> = entries.into_iter().collect();
+        for (key, value) in &delta.changes {
+            match value {
+                Some(bytes) => {
+                    state.insert(key.clone(), bytes.clone());
+                }
+                None => {
+                    state.remove(key);
+                }
+            }
+        }
+        let final_entries: crate::snapshot::StateEntries = state.into_iter().collect();
+        let computed_root = state_root(&final_entries)?;
+        if computed_root != head.state_root {
+            return Err(SyncError::RootMismatch);
+        }
+
+        let downloaded_bytes = self.to_bytes().len() as u64;
+        Ok(SyncResult {
+            height: head.height,
+            state_root: computed_root,
+            entries: final_entries,
+            downloaded_bytes,
+            history_bytes_saved: full_history_bytes.saturating_sub(downloaded_bytes),
+        })
+    }
+
+    fn payload(&self) -> Vec<u8> {
+        let mut writer = Writer::new();
+        writer.push_bytes(PACKAGE_MAGIC);
+        self.version.encode(&mut writer);
+        (self.heads.len() as u32).encode(&mut writer);
+        for head in &self.heads {
+            let blob = head.to_bytes();
+            write_varint(&mut writer, blob.len() as u64);
+            writer.push_bytes(&blob);
+        }
+        for blob in [&self.manifest, &self.data, &self.delta] {
+            write_varint(&mut writer, blob.len() as u64);
+            writer.push_bytes(blob);
+        }
+        writer.into_bytes()
+    }
+}
