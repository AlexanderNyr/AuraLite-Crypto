diff --git a/crates/aura-block/src/block.rs b/crates/aura-block/src/block.rs
new file mode 100644
index 0000000..f88b24c
--- /dev/null
+++ b/crates/aura-block/src/block.rs
@@ -0,0 +1,121 @@
+//! Complete block: header plus body, hashing and validation.
+
+use aura_codec::{CodecError, Decode, Encode, Reader, Writer, decode_canonical, encode_to_bytes};
+use aura_types::{Hash, PROTOCOL_VERSION};
+
+use crate::body::{Body, MAX_BLOCK_TXS};
+use crate::error::BlockError;
+use crate::header::{Header, HeaderParams, MAX_QC_BYTES};
+
+/// A complete block. Header order, then body order, is the wire order.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Block {
+    /// Header (commits to the body via `tx_root`).
+    pub header: Header,
+    /// Canonically sorted transactions.
+    pub body: Body,
+}
+
+impl Block {
+    /// Build a block: sort the body, compute `tx_root`, then assemble.
+    ///
+    /// The caller cannot supply `tx_root`, so a freshly built block always
+    /// has a correct root. Tests and NCs mutate the public fields directly
+    /// to construct invalid blocks.
+    pub fn new(params: HeaderParams, txs: Vec<aura_tx::Tx>) -> Result<Self, BlockError> {
+        let body = Body::new(txs)?;
+        let tx_root = body.tx_root();
+        Ok(Block {
+            header: Header::from_params(params, tx_root),
+            body,
+        })
+    }
+
+    /// The block id: hash of the header (see [`Header::block_hash`]).
+    pub fn block_hash(&self) -> Hash {
+        self.header.block_hash()
+    }
+
+    /// Canonical wire bytes.
+    pub fn to_bytes(&self) -> Vec<u8> {
+        encode_to_bytes(self)
+    }
+
+    /// Decode with full C2 canonicality (no trailing bytes, no non-minimal
+    /// varints, re-encode must reproduce the input).
+    pub fn from_canonical_bytes(bytes: &[u8]) -> Result<Self, BlockError> {
+        Ok(decode_canonical::<Block>(bytes)?)
+    }
+
+    /// Validate block-level invariants for `expected_chain`.
+    ///
+    /// Deliberately does **not** execute or charge gas; transaction signature
+    /// checks are available separately in [`Block::validate_transactions`].
+    ///
+    /// NC targets: `tools/nc_c5.py` disables the canonical-order check and
+    /// the `tx_root` check here, requiring the reorder vectors to go red.
+    pub fn validate(&self, expected_chain: &str) -> Result<(), BlockError> {
+        if self.header.version != PROTOCOL_VERSION {
+            return Err(BlockError::UnsupportedProtocolVersion(
+                PROTOCOL_VERSION,
+                self.header.version,
+            ));
+        }
+        if self.header.chain_id.as_str() != expected_chain {
+            return Err(BlockError::WrongChain(
+                expected_chain.to_owned(),
+                self.header.chain_id.as_str().to_owned(),
+            ));
+        }
+        if self.body.txs.len() > MAX_BLOCK_TXS {
+            return Err(BlockError::TooManyTransactions(self.body.txs.len()));
+        }
+        if let Some(qc) = &self.header.qc
+            && qc.len() > MAX_QC_BYTES
+        {
+            return Err(BlockError::QcTooLarge(qc.len()));
+        }
+        for pair in self.body.txs.windows(2) {
+            let a = (&pair[0].unsigned.signer, &pair[0].unsigned.nonce);
+            let b = (&pair[1].unsigned.signer, &pair[1].unsigned.nonce);
+            if a == b {
+                return Err(BlockError::DuplicateTxKey);
+            }
+            if a > b {
+                return Err(BlockError::UnsortedTransactions);
+            }
+        }
+        let computed_root = self.body.tx_root();
+        if computed_root != self.header.tx_root {
+            return Err(BlockError::TxRootMismatch(
+                computed_root,
+                self.header.tx_root,
+            ));
+        }
+        Ok(())
+    }
+
+    /// Validate every transaction in the body at this block's height.
+    pub fn validate_transactions(&self, expected_chain: &str) -> Result<(), BlockError> {
+        for tx in &self.body.txs {
+            tx.validate(expected_chain, self.header.height)?;
+        }
+        Ok(())
+    }
+}
+
+impl Encode for Block {
+    fn encode(&self, writer: &mut Writer) {
+        self.header.encode(writer);
+        self.body.encode(writer);
+    }
+}
+
+impl Decode for Block {
+    fn decode(reader: &mut Reader<'_>) -> Result<Self, CodecError> {
+        Ok(Block {
+            header: Header::decode(reader)?,
+            body: Body::decode(reader)?,
+        })
+    }
+}
diff --git a/crates/aura-block/src/body.rs b/crates/aura-block/src/body.rs
new file mode 100644
index 0000000..51efb2e
--- /dev/null
+++ b/crates/aura-block/src/body.rs
@@ -0,0 +1,62 @@
+//! Block body: canonically sorted transactions.
+
+use aura_codec::{CodecError, Decode, Encode, Reader, Writer};
+use aura_tx::Tx;
+use aura_types::Hash;
+
+use crate::error::BlockError;
+use crate::merkle::compute_tx_root;
+
+/// Maximum number of transactions in a block. Aligned with `aura-codec`'s
+/// `MAX_ITEMS` so the canonical decoder can always read a valid body.
+pub const MAX_BLOCK_TXS: usize = 65_536;
+
+/// An ordered list of transactions.
+#[derive(Debug, Clone, PartialEq, Eq, Default)]
+pub struct Body {
+    /// Transactions, canonically sorted by `(signer, nonce)`.
+    pub txs: Vec<Tx>,
+}
+
+impl Body {
+    /// Sort by `(signer, nonce)` and reject duplicates.
+    ///
+    /// `Address` and `Nonce` both derive `Ord`, so this is a total,
+    /// platform-independent order — no `HashMap`, no local time.
+    pub fn new(mut txs: Vec<Tx>) -> Result<Self, BlockError> {
+        if txs.len() > MAX_BLOCK_TXS {
+            return Err(BlockError::TooManyTransactions(txs.len()));
+        }
+        txs.sort_by(|left, right| {
+            (left.unsigned.signer, left.unsigned.nonce)
+                .cmp(&(right.unsigned.signer, right.unsigned.nonce))
+        });
+        for pair in txs.windows(2) {
+            let a = (&pair[0].unsigned.signer, &pair[0].unsigned.nonce);
+            let b = (&pair[1].unsigned.signer, &pair[1].unsigned.nonce);
+            if a == b {
+                return Err(BlockError::DuplicateTxKey);
+            }
+        }
+        Ok(Body { txs })
+    }
+
+    /// Recompute the Merkle root of this body (order-sensitive).
+    pub fn tx_root(&self) -> Hash {
+        compute_tx_root(&self.txs)
+    }
+}
+
+impl Encode for Body {
+    fn encode(&self, writer: &mut Writer) {
+        self.txs.encode(writer);
+    }
+}
+
+impl Decode for Body {
+    fn decode(reader: &mut Reader<'_>) -> Result<Self, CodecError> {
+        Ok(Body {
+            txs: Vec::<Tx>::decode(reader)?,
+        })
+    }
+}
diff --git a/crates/aura-block/src/error.rs b/crates/aura-block/src/error.rs
new file mode 100644
index 0000000..a98ef7b
--- /dev/null
+++ b/crates/aura-block/src/error.rs
@@ -0,0 +1,75 @@
+//! Block validation errors.
+
+use std::fmt;
+
+use aura_codec::CodecError;
+use aura_tx::TxError;
+use aura_types::Hash;
+
+/// Every reason a block can be rejected before execution.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum BlockError {
+    /// Header `version` is not [`aura_types::PROTOCOL_VERSION`]. Tuple is
+    /// `(expected, got)`.
+    UnsupportedProtocolVersion(u32, u32),
+    /// The block chain-id does not match the chain we validate for.
+    /// Tuple is `(expected, got)`.
+    WrongChain(String, String),
+    /// Body has more than [`crate::MAX_BLOCK_TXS`] transactions.
+    TooManyTransactions(usize),
+    /// The QC blob exceeds [`crate::MAX_QC_BYTES`].
+    QcTooLarge(usize),
+    /// Two transactions share the same `(signer, nonce)` key.
+    DuplicateTxKey,
+    /// Body is not sorted by `(signer, nonce)`.
+    UnsortedTransactions,
+    /// `tx_root` does not match the Merkle root of the body. Tuple is
+    /// `(computed, declared)`.
+    TxRootMismatch(Hash, Hash),
+    /// A transaction in the body failed validation.
+    InvalidTransaction(TxError),
+    /// Canonical decoding failed (structural).
+    Decode(CodecError),
+}
+
+impl fmt::Display for BlockError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::UnsupportedProtocolVersion(expected, got) => {
+                write!(f, "unsupported protocol version {got}, expected {expected}")
+            }
+            Self::WrongChain(expected, got) => {
+                write!(f, "block chain '{got}' is not '{expected}'")
+            }
+            Self::TooManyTransactions(n) => write!(f, "body has {n} transactions, over the limit"),
+            Self::QcTooLarge(n) => write!(f, "QC blob of {n} bytes exceeds the limit"),
+            Self::DuplicateTxKey => f.write_str("duplicate (signer, nonce) in block body"),
+            Self::UnsortedTransactions => {
+                f.write_str("body is not canonically sorted by (signer, nonce)")
+            }
+            Self::TxRootMismatch(computed, declared) => {
+                write!(
+                    f,
+                    "tx_root mismatch: computed {}, declared {}",
+                    computed, declared
+                )
+            }
+            Self::InvalidTransaction(error) => write!(f, "invalid transaction: {error}"),
+            Self::Decode(error) => write!(f, "canonical decode failed: {error}"),
+        }
+    }
+}
+
+impl std::error::Error for BlockError {}
+
+impl From<CodecError> for BlockError {
+    fn from(error: CodecError) -> Self {
+        BlockError::Decode(error)
+    }
+}
+
+impl From<TxError> for BlockError {
+    fn from(error: TxError) -> Self {
+        BlockError::InvalidTransaction(error)
+    }
+}
diff --git a/crates/aura-block/src/header.rs b/crates/aura-block/src/header.rs
new file mode 100644
index 0000000..bcea3df
--- /dev/null
+++ b/crates/aura-block/src/header.rs
@@ -0,0 +1,144 @@
+//! Block header: fields, encoding and `block_hash`.
+
+use aura_codec::{CodecError, Decode, Encode, Reader, Writer, encode_to_bytes};
+use aura_crypto::hash_domain;
+use aura_types::{Address, Amount, ChainId, Domain, Gas, Hash, Height};
+
+/// Extra context inside the `block_hash` payload, before the header bytes.
+///
+/// NC target: `tools/nc_c5.py` changes this constant and requires the C5
+/// block-hash vectors to go red.
+pub const BLOCK_HASH_PAYLOAD_CONTEXT: &[u8] = b"AuraLite-Crypto/block-hash-v1\x00";
+
+/// Maximum length of the opaque QC blob.
+pub const MAX_QC_BYTES: usize = 65_536;
+
+/// Everything the caller supplies for a header.
+///
+/// `tx_root` is deliberately **absent**: it is always derived from the body
+/// by [`crate::Block::new`], so it cannot be forged at construction time.
+/// `version` is included so a caller can construct a wrong-version header for
+/// tests; real blocks use [`aura_types::PROTOCOL_VERSION`].
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct HeaderParams {
+    /// Protocol version.
+    pub version: u32,
+    /// Chain this block belongs to.
+    pub chain_id: ChainId,
+    /// Block height.
+    pub height: Height,
+    /// Hash of the parent header.
+    pub parent_hash: Hash,
+    /// State root, supplied by the state layer (S1; not yet implemented).
+    pub state_root: Hash,
+    /// Validator-set hash, supplied by consensus (B phases; not yet implemented).
+    pub validator_set_hash: Hash,
+    /// Consensus timestamp in milliseconds — never `SystemTime::now()`.
+    pub timestamp_ms: u64,
+    /// Block proposer.
+    pub proposer: Address,
+    /// Opaque quorum certificate bytes; `None` for genesis-like blocks.
+    pub qc: Option<Vec<u8>>,
+    /// Gas consumed by the block.
+    pub gas_used: Gas,
+    /// Base fee for the block.
+    pub base_fee: Amount,
+}
+
+/// A block header. Field order below **is** the wire order.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Header {
+    /// Protocol version.
+    pub version: u32,
+    /// Chain this block belongs to (block-level replay separation).
+    pub chain_id: ChainId,
+    /// Block height.
+    pub height: Height,
+    /// Hash of the parent header.
+    pub parent_hash: Hash,
+    /// Binary Merkle root of the body's txids.
+    pub tx_root: Hash,
+    /// State root.
+    pub state_root: Hash,
+    /// Validator-set hash.
+    pub validator_set_hash: Hash,
+    /// Consensus timestamp in milliseconds.
+    pub timestamp_ms: u64,
+    /// Block proposer.
+    pub proposer: Address,
+    /// Opaque quorum certificate bytes.
+    pub qc: Option<Vec<u8>>,
+    /// Gas consumed by the block.
+    pub gas_used: Gas,
+    /// Base fee for the block.
+    pub base_fee: Amount,
+}
+
+impl Header {
+    /// Build a header from caller params and a computed `tx_root`.
+    pub fn from_params(params: HeaderParams, tx_root: Hash) -> Self {
+        Header {
+            version: params.version,
+            chain_id: params.chain_id,
+            height: params.height,
+            parent_hash: params.parent_hash,
+            tx_root,
+            state_root: params.state_root,
+            validator_set_hash: params.validator_set_hash,
+            timestamp_ms: params.timestamp_ms,
+            proposer: params.proposer,
+            qc: params.qc,
+            gas_used: params.gas_used,
+            base_fee: params.base_fee,
+        }
+    }
+
+    /// Hash of this header: the block id.
+    ///
+    /// `hash_domain(chain_id, Domain::Block,
+    /// BLOCK_HASH_PAYLOAD_CONTEXT || canonical(header))`. The body is not
+    /// included directly; `tx_root` commits to it.
+    pub fn block_hash(&self) -> Hash {
+        let encoded = encode_to_bytes(self);
+        let mut payload = Vec::with_capacity(BLOCK_HASH_PAYLOAD_CONTEXT.len() + encoded.len());
+        payload.extend_from_slice(BLOCK_HASH_PAYLOAD_CONTEXT);
+        payload.extend_from_slice(&encoded);
+        hash_domain(self.chain_id.as_str(), Domain::Block, &payload)
+    }
+}
+
+impl Encode for Header {
+    fn encode(&self, writer: &mut Writer) {
+        self.version.encode(writer);
+        self.chain_id.encode(writer);
+        self.height.encode(writer);
+        self.parent_hash.encode(writer);
+        self.tx_root.encode(writer);
+        self.state_root.encode(writer);
+        self.validator_set_hash.encode(writer);
+        self.timestamp_ms.encode(writer);
+        self.proposer.encode(writer);
+        self.qc.encode(writer);
+        self.gas_used.encode(writer);
+        self.base_fee.encode(writer);
+    }
+}
+
+impl Decode for Header {
+    fn decode(reader: &mut Reader<'_>) -> Result<Self, CodecError> {
+        Ok(Header {
+            version: u32::decode(reader)?,
+            chain_id: ChainId::decode(reader)?,
+            height: Height::decode(reader)?,
+            parent_hash: Hash::decode(reader)?,
+            tx_root: Hash::decode(reader)?,
+            state_root: Hash::decode(reader)?,
+            validator_set_hash: Hash::decode(reader)?,
+            timestamp_ms: u64::decode(reader)?,
+            proposer: Address::decode(reader)?,
+            qc: Option::<Vec<u8>>::decode(reader)?,
+            gas_used: Gas::decode(reader)?,
+            base_fee: Amount::decode(reader)?,
+        })
+    }
+}
