+/// True when `layer`'s module file exists under `src` and declares public
+/// consensus items. B1's proposer (`proposer.rs`) and block-signature
+/// (`signature.rs`) qualify; B2–B5 layers do not yet.
+fn layer_has_consensus_logic(layer: Layer, src: &Path) -> bool {
+    let module_file = src.join(layer.module_file());
+    let Ok(text) = std::fs::read_to_string(&module_file) else {
+        return false;
+    };
+    text.lines().any(|line| {
+        let trimmed = line.trim_start();
+        !trimmed.is_empty()
+            && !trimmed.starts_with("//")
+            && !trimmed.starts_with('*')
+            && !trimmed.starts_with("/*")
+            && declares_public_item(trimmed)
+    })
+}
