@@ -0,0 +1,430 @@
+//! W7 golden-vector runner — the offline genesis ceremony.
+//!
+//! Executes every case of `fixtures/w7_ceremony_vectors.json` (generated by
+//! `tools/gen_w7_vectors.py`) against `aura_genesis::ceremony::run` and
+//! compares exit code, stdout and stderr **byte-for-byte**. Cases may run a
+//! sequence of commands (setup + observed command) and may apply `mutations`
+//! shell commands between them (tamper injections for the refusal cases).
+//!
+//! NC mapping (`tools/nc_w7.py` runs exactly these test names and expects
+//! `FAILED`): `no_private_key_in_outputs` (named), `shamir_one_share_refused`,
+//! `witness_log_tamper_detected`, `pubkey_set_mismatch_refused`,
+//! `shamir_reconstructs_2_of_3`, `seal_before_shred_refused`.
+#![deny(missing_docs)]
+
+use std::path::PathBuf;
+use std::process::Command;
+use std::sync::Mutex;
+
+/// The W7 golden fixture (regenerate with `tools/gen_w7_vectors.py`).
+const FIXTURE: &str = include_str!("fixtures/w7_ceremony_vectors.json");
+
+// --------------------------------------------------------------------------- mini JSON
+
+/// A parsed JSON value (subset sufficient for the fixture format).
+#[derive(Debug, Clone)]
+enum Json {
+    /// `null` (also used for `true`/`false`, which the fixture omits).
+    Null,
+    /// A number.
+    Num(f64),
+    /// A string.
+    Str(String),
+    /// An array.
+    Arr(Vec<Json>),
+    /// An object with insertion-ordered members.
+    Obj(Vec<(String, Json)>),
+}
+
+/// Recursive-descent parser over the fixture text.
+struct Parser<'a> {
+    /// Raw fixture bytes.
+    input: &'a [u8],
+    /// Current offset.
+    pos: usize,
+}
+
+impl<'a> Parser<'a> {
+    /// Skip ASCII whitespace.
+    fn skip_ws(&mut self) {
+        while self.pos < self.input.len()
+            && matches!(self.input[self.pos], b' ' | b'\t' | b'\n' | b'\r')
+        {
+            self.pos += 1;
+        }
+    }
+
+    /// Consume one literal token (`true`/`false`/`null`).
+    fn expect_lit(&mut self, lit: &str) {
+        assert!(
+            self.input[self.pos..].starts_with(lit.as_bytes()),
+            "bad literal"
+        );
+        self.pos += lit.len();
+    }
+
+    /// Parse one JSON value.
+    fn value(&mut self) -> Json {
+        self.skip_ws();
+        match self.input[self.pos] {
+            b'{' => self.object(),
+            b'[' => self.array(),
+            b'"' => Json::Str(self.string()),
+            b't' => {
+                self.expect_lit("true");
+                Json::Null
+            }
+            b'f' => {
+                self.expect_lit("false");
+                Json::Null
+            }
+            b'n' => {
+                self.expect_lit("null");
+                Json::Null
+            }
+            _ => self.number(),
+        }
+    }
+
+    /// Parse one JSON object.
+    fn object(&mut self) -> Json {
+        self.pos += 1; // '{'
+        let mut members = Vec::new();
+        self.skip_ws();
+        if self.input[self.pos] == b'}' {
+            self.pos += 1;
+            return Json::Obj(members);
+        }
+        loop {
+            self.skip_ws();
+            let key = self.string();
+            self.skip_ws();
+            assert_eq!(self.input[self.pos], b':', "expected ':'");
+            self.pos += 1;
+            let value = self.value();
+            members.push((key, value));
+            self.skip_ws();
+            match self.input[self.pos] {
+                b',' => self.pos += 1,
+                b'}' => {
+                    self.pos += 1;
+                    break;
+                }
+                other => panic!("expected ',' or '}}', got {other}"),
+            }
+        }
+        Json::Obj(members)
+    }
+
+    /// Parse one JSON array.
+    fn array(&mut self) -> Json {
+        self.pos += 1; // '['
+        let mut items = Vec::new();
+        self.skip_ws();
+        if self.input[self.pos] == b']' {
+            self.pos += 1;
+            return Json::Arr(items);
+        }
+        loop {
+            items.push(self.value());
+            self.skip_ws();
+            match self.input[self.pos] {
+                b',' => self.pos += 1,
+                b']' => {
+                    self.pos += 1;
+                    break;
+                }
+                other => panic!("expected ',' or ']', got {other}"),
+            }
+        }
+        Json::Arr(items)
+    }
+
+    /// Parse one JSON string.
+    fn string(&mut self) -> String {
+        assert_eq!(self.input[self.pos], b'"', "expected string");
+        self.pos += 1;
+        let mut out = String::new();
+        while self.input[self.pos] != b'"' {
+            let byte = self.input[self.pos];
+            if byte == b'\\' {
+                self.pos += 1;
+                match self.input[self.pos] {
+                    b'"' => out.push('"'),
+                    b'\\' => out.push('\\'),
+                    b'/' => out.push('/'),
+                    b'n' => out.push('\n'),
+                    b't' => out.push('\t'),
+                    b'r' => out.push('\r'),
+                    b'u' => {
+                        let mut code = 0u32;
+                        for _ in 0..4 {
+                            self.pos += 1;
+                            let digit = (self.input[self.pos] as char)
+                                .to_digit(16)
+                                .expect("bad \\u escape");
+                            code = code * 16 + digit;
+                        }
+                        out.push(char::from_u32(code).expect("bad codepoint"));
+                    }
+                    other => panic!("bad escape {other}"),
+                }
+            } else {
+                out.push(byte as char);
+            }
+            self.pos += 1;
+        }
+        self.pos += 1;
+        out
+    }
+
+    /// Parse one JSON number.
+    fn number(&mut self) -> Json {
+        let start = self.pos;
+        while self.pos < self.input.len()
+            && matches!(
+                self.input[self.pos],
+                b'0'..=b'9' | b'-' | b'+' | b'.' | b'e' | b'E'
+            )
+        {
+            self.pos += 1;
+        }
+        let text = std::str::from_utf8(&self.input[start..self.pos]).expect("bad number");
+        Json::Num(text.parse().expect("bad number"))
+    }
+}
+
+impl Json {
+    /// Object members.
+    fn members(&self) -> &Vec<(String, Json)> {
+        match self {
+            Json::Obj(members) => members,
+            _ => panic!("expected object"),
+        }
+    }
+
+    /// Array items.
+    fn items(&self) -> &Vec<Json> {
+        match self {
+            Json::Arr(items) => items,
+            _ => panic!("expected array"),
+        }
+    }
+
+    /// String value.
+    fn str_value(&self) -> &str {
+        match self {
+            Json::Str(text) => text,
+            _ => panic!("expected string"),
+        }
+    }
+
+    /// Number value.
+    fn num_value(&self) -> f64 {
+        match self {
+            Json::Num(value) => *value,
+            _ => panic!("expected number"),
+        }
+    }
+
+    /// Member lookup by key.
+    fn get(&self, key: &str) -> &Json {
+        self.members()
+            .iter()
+            .find(|(name, _)| name == key)
+            .map(|(_, value)| value)
+            .unwrap_or_else(|| panic!("missing key {key}"))
+    }
+}
+
+/// Parse the whole fixture text.
+fn parse_fixture() -> Json {
+    let mut parser = Parser {
+        input: FIXTURE.as_bytes(),
+        pos: 0,
+    };
+    parser.value()
+}
+
+// --------------------------------------------------------------------------- runner
+
+/// Serializes cases: the ceremony resolves relative paths against the
+/// process CWD, so cases must not run concurrently.
+static CWD_LOCK: Mutex<()> = Mutex::new(());
+
+/// Restores the process CWD on drop (also on panic unwind).
+struct CwdGuard {
+    /// The directory to restore.
+    prev: PathBuf,
+}
+
+impl CwdGuard {
+    /// Enter `dir` as the process CWD.
+    fn enter(dir: &std::path::Path) -> Self {
+        let prev = std::env::current_dir().expect("current dir");
+        std::env::set_current_dir(dir).expect("set current dir");
+        CwdGuard { prev }
+    }
+}
+
+impl Drop for CwdGuard {
+    fn drop(&mut self) {
+        let _ = std::env::set_current_dir(&self.prev);
+    }
+}
+
+/// Run one fixture case end-to-end and assert exit/stdout/stderr exactly.
+fn run_case(name: &str) {
+    let fixture = parse_fixture();
+    let files = fixture.get("files");
+    let cases = fixture.get("cases").items();
+    let case = cases
+        .iter()
+        .find(|item| item.get("name").str_value() == name)
+        .unwrap_or_else(|| panic!("unknown case {name}"));
+
+    let sandbox = case.get("sandbox").str_value();
+    let base = std::env::temp_dir().join(format!("aura-w7-{}-{name}", std::process::id()));
+    let root = if sandbox.is_empty() {
+        base.clone()
+    } else {
+        base.join(sandbox)
+    };
+    std::fs::create_dir_all(&root).expect("sandbox created");
+    for (file_name, content) in files.members() {
+        std::fs::write(root.join(file_name), content.str_value()).expect("fixture file written");
+    }
+
+    let expected_exit = case.get("exit").num_value() as i32;
+    let expected_stdout = case.get("stdout").str_value().to_string();
+    let expected_stderr = case.get("stderr").str_value().to_string();
+    let mutations: Vec<String> = match case.members().iter().find(|(k, _)| k == "mutations") {
+        Some((_, value)) => value
+            .items()
+            .iter()
+            .map(|m| m.str_value().to_string())
+            .collect(),
+        None => Vec::new(),
+    };
+    let commands = case.get("argv").items();
+    let last = commands.len() - 1;
+
+    let mut combined = String::new();
+    {
+        let _lock = CWD_LOCK.lock().unwrap();
+        let _guard = CwdGuard::enter(&root);
+        for (index, command) in commands.iter().enumerate() {
+            let args: Vec<String> = command
+                .items()
+                .iter()
+                .map(|item| item.str_value().to_string())
+                .collect();
+            if index == last {
+                for mutation in &mutations {
+                    let status = Command::new("sh")
+                        .arg("-c")
+                        .arg(mutation)
+                        .status()
+                        .expect("mutation runs");
+                    assert!(status.success(), "mutation failed: {mutation}");
+                }
+            }
+            let mut out: Vec<u8> = Vec::new();
+            let mut err: Vec<u8> = Vec::new();
+            let code = aura_genesis::ceremony::run(&args, &mut out, &mut err);
+            let out_text = String::from_utf8(out).expect("stdout utf8");
+            let err_text = String::from_utf8(err).expect("stderr utf8");
+            if index == last {
+                combined.push_str(&out_text);
+                assert_eq!(
+                    code, expected_exit,
+                    "case {name}: exit mismatch\nstderr: {err_text}"
+                );
+                assert_eq!(err_text, expected_stderr, "case {name}: stderr mismatch");
+            } else {
+                assert_eq!(
+                    code, 0,
+                    "case {name}: setup command #{index} failed\nargs: {args:?}\nstderr: {err_text}"
+                );
+                combined.push_str(&out_text);
+            }
+        }
+    }
+    let _ = std::fs::remove_dir_all(&base);
+    assert_eq!(combined, expected_stdout, "case {name}: stdout mismatch");
+}
+
+/// The full ceremony run: open, generate, split, shred, seal, verify.
+#[test]
+fn ceremony_seals_genesis() {
+    run_case("ceremony_seals_genesis");
+}
+
+/// A manifest doctored after `shred` must not seal (D-W7-5).
+#[test]
+fn pubkey_set_mismatch_refused() {
+    run_case("pubkey_set_mismatch_refused");
+}
+
+/// The named O5 control: after shredding, `verify` finds no private key.
+#[test]
+fn no_private_key_in_outputs() {
+    run_case("no_private_key_in_outputs");
+}
+
+/// Any 2-of-3 shares reconstruct the exact secret commitment (D-W7-2).
+#[test]
+fn shamir_reconstructs_2_of_3() {
+    run_case("shamir_reconstructs_2_of_3");
+}
+
+/// One share must not reach the quorum (D-W7-2).
+#[test]
+fn shamir_one_share_refused() {
+    run_case("shamir_one_share_refused");
+}
+
+/// Repeated share coordinates must be refused (D-W7-2).
+#[test]
+fn shamir_duplicate_share_refused() {
+    run_case("shamir_duplicate_share_refused");
+}
+
+/// Any tampering with `witness.log` breaks the chain (D-W7-3).
+#[test]
+fn witness_log_tamper_detected() {
+    run_case("witness_log_tamper_detected");
+}
+
+/// Sealing with live temporary media is refused (D-W7-4).
+#[test]
+fn seal_before_shred_refused() {
+    run_case("seal_before_shred_refused");
+}
+
+/// An invalid quorum (T > K) is refused at `open`.
+#[test]
+fn split_quorum_invalid_refused() {
+    run_case("split_quorum_invalid_refused");
+}
+
+/// A ceremony that skipped `split` cannot seal (witness log incomplete).
+#[test]
+fn seal_incomplete_witness_refused() {
+    run_case("seal_incomplete_witness_refused");
+}
+
+/// Count guard: the fixture must hold exactly 10 unique scenarios.
+#[test]
+fn vectors_file_has_exactly_10_unique_cases() {
+    let fixture = parse_fixture();
+    let cases = fixture.get("cases").items();
+    assert_eq!(cases.len(), 10, "fixture must hold exactly 10 cases");
+    let mut names: Vec<&str> = cases
+        .iter()
+        .map(|item| item.get("name").str_value())
+        .collect();
+    names.sort_unstable();
+    names.dedup();
+    assert_eq!(names.len(), 10, "case names must be unique");
+}
