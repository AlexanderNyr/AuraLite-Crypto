+            };
+            match key {
+                "capability" => capabilities.push(value.to_string()),
+                "layer" => layers.push(value.to_string()),
+                other => {
+                    singles.insert(other.to_string(), value.to_string());
+                }
+            }
+        }
+        (singles, capabilities, layers)
+    }
+}
