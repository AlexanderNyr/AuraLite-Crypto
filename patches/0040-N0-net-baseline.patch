index 0000000000000000000000000000000000000000..4f403579923a2836b3a6b05c719e369bf0c28d84
--- /dev/null
+++ b/crates/aura-p2p/src/baseline.rs
@@ -0,0 +1,818 @@
+//! N0 baseline — **no P2P network**, and this module measures that claim.
+//!
+//! `aura-p2p` was a C0 placeholder and now contains the N0 baseline
+//! measurement. It has sources and a public `baseline` module, but no network
+//! logic: no libp2p swarm, no Noise/QUIC transport, no gossipsub topics, no
+//! peer discovery, no header/state sync, and no light-client verifier. The
+//! honest artifact is therefore *not* a stub that pretends peers are connected
+//! — it is a measurement of what is missing, a proof that Node B cannot see
+//! Node A's transaction without P2P, and a binary that refuses to claim a
+//! network where none exists.
+//!
+//! # What N0 measures
+//!
+//! [`survey`] measures `crates/aura-p2p/src`: files, non-empty lines, and
+//! public item declarations. All eight `NET_PLAN` components (`transport` N1
+//! through `chaos-harness` N8) measure as [`Presence::Placeholder`] at N0.
+//! [`measure_two_nodes_isolation`] records the two-node baseline gap: a
+//! transaction accepted by Node A over local RPC remains invisible to Node B
+//! because zero peers and zero gossip topics exist.
+
+use std::fmt::Write as _;
+use std::io::Write;
+use std::path::{Path, PathBuf};
+
+/// The phase these numbers belong to.
+pub const PHASE: &str = "N0";
+
+/// Exit code of the refusal: no P2P network exists.
+pub const EXIT_STUB: i32 = 2;
+
+/// Exit code when the baseline is asked about a tree that is not a workspace.
+pub const EXIT_NO_WORKSPACE: i32 = 3;
+
+/// Exit code of a usage error (sysexits `EX_USAGE`).
+pub const EXIT_USAGE: i32 = 64;
+
+/// Documented gap identifier pinned in the N0 fixture and report.
+pub const DOCUMENTED_GAP: &str = "N1-transport+N2-gossipsub-absent:node_b_cannot_see_node_a_tx";
+
+/// One network component that will land in N1–N8.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Layer {
+    /// Component name, e.g. `transport`.
+    pub name: &'static str,
+    /// The phase that lands the real implementation.
+    pub phase: &'static str,
+    /// What the component is responsible for.
+    pub what: &'static str,
+}
+
+/// Every `NET_PLAN` component, in landing order.
+pub const LAYERS: [Layer; 8] = [
+    Layer {
+        name: "transport",
+        phase: "N1",
+        what: "libp2p swarm, Noise/QUIC, identity, handshake, ban list",
+    },
+    Layer {
+        name: "gossipsub",
+        phase: "N2",
+        what: "topics, message signatures, dedup, peer scoring",
+    },
+    Layer {
+        name: "discovery",
+        phase: "N3",
+        what: "Kademlia DHT, bootstrap list, NAT/upnp, relay",
+    },
+    Layer {
+        name: "block-sync",
+        phase: "N4",
+        what: "header-first, QC verification, parallel body download",
+    },
+    Layer {
+        name: "state-sync",
+        phase: "N5",
+        what: "integration with S4: chunks, manifest, root verification",
+    },
+    Layer {
+        name: "dos-defence",
+        phase: "N6",
+        what: "size/rate limits, signature rate limit, equivocation detection",
+    },
+    Layer {
+        name: "light-client",
+        phase: "N7",
+        what: "header+QC proof, finalized checkpoint check, simplified DAS",
+    },
+    Layer {
+        name: "chaos-harness",
+        phase: "N8",
+        what: "latency/loss/partition/eclipse simulation, 100-node stand",
+    },
+];
+
+impl Layer {
+    /// Source file under `crates/aura-p2p/src/` that will implement this layer.
+    pub fn module_file(&self) -> &'static str {
+        match self.name {
+            "transport" => "transport.rs",
+            "gossipsub" => "gossipsub.rs",
+            "discovery" => "discovery.rs",
+            "block-sync" => "block_sync.rs",
+            "state-sync" => "state_sync.rs",
+            "dos-defence" => "dos_defence.rs",
+            "light-client" => "light_client.rs",
+            "chaos-harness" => "chaos.rs",
+            _ => unreachable!("unknown layer: {}", self.name),
+        }
+    }
+
+    /// True when this layer's network implementation has landed.
+    ///
+    /// At N0, all eight layers are placeholders (`false`).
+    pub fn has_network_logic(&self) -> bool {
+        matches!(self.name, "")
+    }
+}
+
+/// One network capability that does not exist yet, and the phase that will add it.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Capability {
+    /// Stable name, used by the gate and the refusal message.
+    pub name: &'static str,
+    /// The phase that lands it.
+    pub phase: &'static str,
+    /// What the capability will do.
+    pub what: &'static str,
+}
+
+/// The eight capabilities N1–N8 will add; none exist at N0.
+pub const MISSING_CAPABILITIES: [Capability; 8] = [
+    Capability {
+        name: "transport",
+        phase: "N1",
+        what: "libp2p swarm, Noise/QUIC, identity, handshake, ban list",
+    },
+    Capability {
+        name: "gossipsub",
+        phase: "N2",
+        what: "topics, message signatures, dedup, peer scoring",
+    },
+    Capability {
+        name: "discovery",
+        phase: "N3",
