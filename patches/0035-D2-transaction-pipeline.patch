+    }
+
+    #[test]
+    fn rejects_nonce_gap() {
+        let tx = signed_transfer(CHAIN, 1, 1, TRANSFER_GAS, 1, 0);
+        let mut accounts = BTreeMap::from([(
+            *sender().as_bytes(),
+            Account::new(
