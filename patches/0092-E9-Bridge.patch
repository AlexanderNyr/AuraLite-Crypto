++    pub fn update(&mut self, header: &Header, commit: &Commit) -> Result<(), E9Error> {
++        if header.height <= self.trusted_height {
++            return Err(E9Error::NotNewer {
++                height: header.height,
++                trusted: self.trusted_height,
