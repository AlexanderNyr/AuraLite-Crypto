++fn signed_commit(signers: &[u32], header: &Header, flip: Option<u32>) -> Commit {
++    let hash = header.hash();
++    let mut commit = Commit::new();
++    for id in signers {
++        let mut sig = sign_raw(&validator_seed(*id), &hash);
++        if Some(*id) == flip {
++            sig[0] ^= 0x01;
++        }
++        commit.push((*id, sig));
++    }
++    commit.sort_by_key(|(id, _)| *id);
++    commit
++}
