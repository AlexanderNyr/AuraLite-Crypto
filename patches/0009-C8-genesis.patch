index 0000000..3584459
--- /dev/null
+++ b/crates/aura-genesis/src/types.rs
@@ -0,0 +1,258 @@
+//! Genesis value types, canonical encoding and commitments.
+
+use aura_block::build_tree_from_leaf_hashes;
+use aura_codec::{CodecError, Decode, Encode, Reader, Writer, decode_canonical, encode_to_bytes};
+use aura_crypto::{blake3_hash, hash_domain};
+use aura_state::{Account, StateKey};
+use aura_types::{Address, Amount, ChainId, Domain, Hash, Nonce, PROTOCOL_VERSION};
+
+use crate::error::GenesisError;
+
+/// Context prefix inside the genesis hash payload.
+///
+/// NC target: `tools/nc_c8.py` changes this constant and requires the C8
+/// golden hash vectors to go red.
+pub const GENESIS_CONTEXT: &[u8] = b"AuraLite-Crypto/genesis-v1\x00";
+
+/// Context prefix for the validator-set commitment.
+///
+/// NC target: `tools/nc_c8.py` changes this constant and requires the C8
+/// validator-set vectors to go red.
+pub const VALIDATOR_SET_CONTEXT: &[u8] = b"AuraLite-Crypto/validator-set-v1\x00";
+
+/// Context prefix for one allocation leaf.
+pub const ALLOCATION_LEAF_CONTEXT: &[u8] = b"AuraLite-Crypto/allocation-leaf-v1\x00";
+
+/// One genesis validator.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Validator {
+    /// 20-byte account address.
+    pub address: Address,
+    /// Voting power, must be non-zero.
+    pub power: u64,
+    /// 32-byte consensus public key (opaque at C8; BLS arrives in B2).
+    pub public_key: [u8; 32],
+}
+
+/// One genesis balance allocation.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Allocation {
+    /// 20-byte account address.
+    pub address: Address,
+    /// Initial balance in smallest units.
+    pub balance: Amount,
+}
+
+/// A deterministic genesis document.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Genesis {
+    /// Chain this genesis starts.
+    pub chain_id: ChainId,
+    /// Protocol version, must equal [`PROTOCOL_VERSION`].
+    pub protocol_version: u32,
+    /// Consensus timestamp in milliseconds — never a local clock.
+    pub genesis_time_ms: u64,
+    /// Validators in **declared order** (order is consensus-significant).
+    pub validators: Vec<Validator>,
+    /// Initial allocations in declared order.
+    pub allocations: Vec<Allocation>,
+}
+
+impl Genesis {
+    /// Build from already-parsed fields and validate all invariants.
+    pub fn new(
+        chain_id: ChainId,
+        protocol_version: u32,
+        genesis_time_ms: u64,
+        validators: Vec<Validator>,
+        allocations: Vec<Allocation>,
+    ) -> Result<Self, GenesisError> {
+        if protocol_version != PROTOCOL_VERSION {
+            return Err(GenesisError::UnsupportedProtocolVersion(protocol_version));
+        }
+        if validators.is_empty() {
+            return Err(GenesisError::EmptyValidatorSet);
+        }
+        let mut seen_validators = std::collections::BTreeSet::new();
+        for validator in &validators {
+            if validator.power == 0 {
+                return Err(GenesisError::ZeroValidatorPower);
+            }
+            if !seen_validators.insert(validator.address) {
+                return Err(GenesisError::DuplicateValidator(
+                    validator.address.to_bech32(),
+                ));
+            }
+        }
+        let mut seen_allocations = std::collections::BTreeSet::new();
+        for allocation in &allocations {
+            if allocation.balance == Amount::ZERO {
+                return Err(GenesisError::ZeroAllocation);
+            }
+            if !seen_allocations.insert(allocation.address) {
+                return Err(GenesisError::DuplicateAllocation(
+                    allocation.address.to_bech32(),
+                ));
+            }
+        }
+        let genesis = Genesis {
+            chain_id,
+            protocol_version,
+            genesis_time_ms,
+            validators,
+            allocations,
+        };
+        genesis.total_supply()?;
+        Ok(genesis)
+    }
+
+    /// Canonical binary bytes (C2 encoding, no JSON).
+    pub fn canonical_bytes(&self) -> Vec<u8> {
+        encode_to_bytes(self)
+    }
+
+    /// Decode canonical binary bytes with full C2 strictness, then re-check
+    /// every structural invariant (a canonical byte string is not
+    /// automatically a valid genesis).
+    pub fn from_canonical_bytes(bytes: &[u8]) -> Result<Self, GenesisError> {
+        let decoded = decode_canonical::<Genesis>(bytes)?;
+        Genesis::new(
+            decoded.chain_id,
+            decoded.protocol_version,
+            decoded.genesis_time_ms,
+            decoded.validators,
+            decoded.allocations,
+        )
+    }
+
+    /// The genesis id.
+    pub fn hash(&self) -> Hash {
+        let mut payload = Vec::with_capacity(GENESIS_CONTEXT.len() + 256);
+        payload.extend_from_slice(GENESIS_CONTEXT);
+        payload.extend_from_slice(&self.canonical_bytes());
+        hash_domain(self.chain_id.as_str(), Domain::Genesis, &payload)
+    }
+
+    /// Commitment to the ordered validator set (fills C5's header field).
+    pub fn validator_set_hash(&self) -> Hash {
+        let mut writer = Writer::new();
+        self.validators.encode(&mut writer);
+        let mut input = Vec::with_capacity(VALIDATOR_SET_CONTEXT.len() + writer.as_slice().len());
+        input.extend_from_slice(VALIDATOR_SET_CONTEXT);
+        input.extend_from_slice(writer.as_slice());
+        blake3_hash(&input)
+    }
+
+    /// Merkle commitment over initial accounts (C7 keys/values, C6 tree).
+    ///
+    /// State is a set, so allocations are sorted by address first — JSON
+    /// array order cannot change this root. This is **not** the JMT
+    /// `state_root` owed by S1.
+    pub fn allocation_root(&self) -> Hash {
+        let mut sorted: Vec<&Allocation> = self.allocations.iter().collect();
+        sorted.sort_by(|left, right| left.address.as_bytes().cmp(right.address.as_bytes()));
+        let leaves: Vec<Hash> = sorted
+            .iter()
+            .map(|allocation| {
+                let key = StateKey::account(&allocation.address);
+                let account = Account::new(
+                    Nonce::new(0),
+                    allocation.balance,
+                    Account::NO_CODE,
+                    Account::EMPTY_STORAGE_ROOT,
+                );
+                let value = account.to_bytes();
+                let mut input =
+                    Vec::with_capacity(ALLOCATION_LEAF_CONTEXT.len() + 32 + 8 + value.len());
+                input.extend_from_slice(ALLOCATION_LEAF_CONTEXT);
+                input.extend_from_slice(key.digest().as_bytes());
+                input.extend_from_slice(&(value.len() as u64).to_le_bytes());
+                input.extend_from_slice(&value);
+                blake3_hash(&input)
+            })
+            .collect();
+        build_tree_from_leaf_hashes(&leaves).root()
+    }
+
+    /// Sum of all allocations with checked `u128` arithmetic.
+    pub fn total_supply(&self) -> Result<Amount, GenesisError> {
+        let mut supply = Amount::ZERO;
+        for allocation in &self.allocations {
+            supply = supply
+                .checked_add(allocation.balance)
+                .ok_or(GenesisError::SupplyOverflow)?;
+        }
+        Ok(supply)
+    }
+
+    /// Number of validators.
+    pub fn validator_count(&self) -> usize {
+        self.validators.len()
+    }
+
+    /// Number of allocations.
+    pub fn allocation_count(&self) -> usize {
+        self.allocations.len()
+    }
+}
+
+impl Encode for Validator {
+    fn encode(&self, writer: &mut Writer) {
+        self.address.encode(writer);
+        self.power.encode(writer);
+        writer.push_bytes(&self.public_key);
+    }
+}
+
+impl Decode for Validator {
+    fn decode(reader: &mut Reader<'_>) -> Result<Self, CodecError> {
+        let address = Address::decode(reader)?;
+        let power = u64::decode(reader)?;
+        let key_bytes = reader.read_exact(32)?;
+        let mut public_key = [0u8; 32];
+        public_key.copy_from_slice(key_bytes);
+        Ok(Validator {
+            address,
+            power,
+            public_key,
+        })
+    }
+}
+
+impl Encode for Allocation {
+    fn encode(&self, writer: &mut Writer) {
+        self.address.encode(writer);
+        self.balance.encode(writer);
+    }
+}
+
+impl Decode for Allocation {
+    fn decode(reader: &mut Reader<'_>) -> Result<Self, CodecError> {
+        Ok(Allocation {
+            address: Address::decode(reader)?,
+            balance: Amount::decode(reader)?,
+        })
+    }
+}
+
+impl Encode for Genesis {
+    fn encode(&self, writer: &mut Writer) {
+        self.chain_id.encode(writer);
+        self.protocol_version.encode(writer);
+        self.genesis_time_ms.encode(writer);
+        self.validators.encode(writer);
+        self.allocations.encode(writer);
+    }
+}
+
+impl Decode for Genesis {
+    fn decode(reader: &mut Reader<'_>) -> Result<Self, CodecError> {
+        Ok(Genesis {
+            chain_id: ChainId::decode(reader)?,
+            protocol_version: u32::decode(reader)?,
+            genesis_time_ms: u64::decode(reader)?,
+            validators: Vec::<Validator>::decode(reader)?,
+            allocations: Vec::<Allocation>::decode(reader)?,
+        })
+    }
+}
diff --git a/crates/aura-genesis/tests/c8_genesis.rs b/crates/aura-genesis/tests/c8_genesis.rs
new file mode 100644
index 0000000..955553d
--- /dev/null
+++ b/crates/aura-genesis/tests/c8_genesis.rs
@@ -0,0 +1,322 @@
+//! C8 gate: deterministic genesis against an independent Python generator.
+//!
+//! `fixtures/c8_golden.txt` comes from `tools/gen_c8_vectors.py`: pure-Python
+//! BLAKE3 (official-vector self-check), independent bech32, and a C8 wire
+//! transcription. JSON documents are hex-encoded UTF-8.
+
+use std::collections::BTreeMap;
+
+use aura_codec::CodecError;
+use aura_genesis::{
+    ALLOCATION_LEAF_CONTEXT, GENESIS_CONTEXT, GenesisError, VALIDATOR_SET_CONTEXT, from_json_str,
+};
+use aura_types::{CHAIN_ID, PROTOCOL_VERSION};
+
+const GOLDEN: &str = include_str!("fixtures/c8_golden.txt");
+const SAMPLE_JSON: &str = include_str!("../../../docs/spec/genesis-testnet.json");
+
+fn parse(text: &str) -> BTreeMap<String, String> {
+    let mut map = BTreeMap::new();
+    for line in text.lines() {
+        let trimmed = line.trim();
+        if trimmed.is_empty() || trimmed.starts_with('#') {
+            continue;
+        }
+        let (key, value) = trimmed
+            .split_once('=')
+            .unwrap_or_else(|| panic!("malformed golden line: {trimmed}"));
+        assert!(
+            map.insert(key.to_owned(), value.to_owned()).is_none(),
+            "duplicate golden key {key}"
+        );
+    }
+    map
+}
+
+fn hx(text: &str) -> Vec<u8> {
+    assert_eq!(text.len() % 2, 0, "even-length hex");
+    text.as_bytes()
+        .chunks(2)
+        .map(|pair| (nibble(pair[0]) << 4) | nibble(pair[1]))
+        .collect()
+}
+
+fn nibble(byte: u8) -> u8 {
+    match byte {
+        b'0'..=b'9' => byte - b'0',
+        b'a'..=b'f' => byte - b'a' + 10,
+        b'A'..=b'F' => byte - b'A' + 10,
+        _ => panic!("invalid hex nibble in fixture"),
+    }
+}
+
+fn json_doc(f: &BTreeMap<String, String>, key: &str) -> String {
+    String::from_utf8(hx(&f[key])).unwrap_or_else(|e| panic!("{key} is not UTF-8: {e}"))
+}
+
+fn to_hex(bytes: &[u8]) -> String {
+    let mut out = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        out.push_str(&format!("{byte:02x}"));
+    }
+    out
+}
+
+fn genesis(f: &BTreeMap<String, String>, key: &str) -> aura_genesis::Genesis {
+    from_json_str(&json_doc(f, key)).unwrap_or_else(|e| panic!("{key} failed: {e}"))
+}
+
+#[test]
+fn constants_are_pinned_by_the_independent_fixture() {
+    let f = parse(GOLDEN);
+    assert_eq!(to_hex(GENESIS_CONTEXT), f["genesis_context"]);
+    assert_eq!(to_hex(VALIDATOR_SET_CONTEXT), f["validator_set_context"]);
+    assert_eq!(
+        to_hex(ALLOCATION_LEAF_CONTEXT),
+        f["allocation_leaf_context"]
+    );
+    assert_eq!(CHAIN_ID, f["chain_id"]);
+    assert_eq!(PROTOCOL_VERSION.to_string(), f["protocol_version"]);
+}
+
+#[test]
+fn same_genesis_same_hash_across_three_hosts() {
+    // C8 DoD: three independent textual representations of the SAME config
+    // (minified, reordered object keys, pretty-printed) must give one hash.
+    let f = parse(GOLDEN);
+    let hosts = ["json_min", "json_keys_reordered", "json_pretty"];
+    let mut hashes = Vec::new();
+    let mut canonical = Vec::new();
+    for key in hosts {
+        let genesis = genesis(&f, key);
+        assert_eq!(genesis.chain_id.as_str(), CHAIN_ID);
+        assert_eq!(
+            genesis.validator_count().to_string(),
+            f["validator_count_1"]
+        );
+        assert_eq!(
+            genesis.allocation_count().to_string(),
+            f["allocation_count_1"]
+        );
+        assert_eq!(
+            genesis.total_supply().unwrap().units().to_string(),
+            f["total_supply_1"]
+        );
+        canonical.push(to_hex(&genesis.canonical_bytes()));
+        hashes.push(genesis.hash().to_hex());
+        assert_eq!(
+            genesis.validator_set_hash().to_hex(),
+            f["validator_set_hash_1"],
+            "{key}"
+        );
+        assert_eq!(
+            genesis.allocation_root().to_hex(),
+            f["allocation_root_1"],
+            "{key}"
+        );
+    }
+    assert!(hashes.iter().all(|hash| hash == &hashes[0]));
+    assert!(canonical.iter().all(|bytes| bytes == &canonical[0]));
+    assert_eq!(hashes[0], f["genesis_1_hash"]);
+    assert_eq!(canonical[0], f["genesis_1_canonical"]);
+    assert_eq!(hashes.len(), 3, "three hosts measured");
+}
+
+#[test]
+fn validator_order_changes_the_hash() {
+    // C8 DoD / NC target: declared validator order is consensus-significant.
+    let f = parse(GOLDEN);
+    let base = genesis(&f, "json_min");
+    let reordered = genesis(&f, "json_validators_reordered");
+    assert_ne!(base.hash(), reordered.hash());
+    assert_ne!(base.validator_set_hash(), reordered.validator_set_hash());
+    assert_eq!(base.validator_count(), reordered.validator_count());
+    assert_eq!(base.allocation_root(), reordered.allocation_root());
+    assert_eq!(base.hash().to_hex(), f["genesis_1_hash"]);
+}
+
+#[test]
+fn canonical_bytes_and_commitments_match_independent_python() {
+    let f = parse(GOLDEN);
+    for (index, key) in [(1, "json_min"), (2, "json_second")] {
+        let genesis = genesis(&f, key);
+        assert_eq!(
+            to_hex(&genesis.canonical_bytes()),
+            f[&format!("genesis_{index}_canonical")]
+        );
+        assert_eq!(genesis.hash().to_hex(), f[&format!("genesis_{index}_hash")]);
+        assert_eq!(
+            genesis.validator_set_hash().to_hex(),
+            f[&format!("validator_set_hash_{index}")]
+        );
+        assert_eq!(
+            genesis.allocation_root().to_hex(),
+            f[&format!("allocation_root_{index}")]
+        );
+        assert_eq!(
+            genesis.total_supply().unwrap().units().to_string(),
+            f[&format!("total_supply_{index}")]
+        );
+        assert_eq!(
+            genesis.validator_count().to_string(),
+            f[&format!("validator_count_{index}")]
+        );
+        assert_eq!(
+            genesis.allocation_count().to_string(),
+            f[&format!("allocation_count_{index}")]
+        );
+
+        let bytes = genesis.canonical_bytes();
+        assert_eq!(
+            aura_genesis::Genesis::from_canonical_bytes(&bytes).unwrap(),
+            genesis
+        );
+    }
+}
+
+#[test]
+fn allocation_root_is_order_independent_but_genesis_hash_is_not() {
+    // State is a set: allocation_root cannot depend on JSON array order.
+    // The genesis document itself does preserve declared order.
+    let f = parse(GOLDEN);
+    let base = genesis(&f, "json_min");
+    let reordered = genesis(&f, "json_allocations_reordered");
+    assert_eq!(base.allocation_root(), reordered.allocation_root());
+    assert_ne!(base.hash(), reordered.hash());
+    assert_eq!(base.allocation_root().to_hex(), f["allocation_root_1"]);
+}
+
+#[test]
+fn shipped_genesis_config_matches_the_golden_hash() {
+    let f = parse(GOLDEN);
+    let genesis = from_json_str(SAMPLE_JSON).expect("shipped genesis config parses");
+    assert_eq!(genesis.hash().to_hex(), f["genesis_1_hash"]);
+    assert_eq!(
+        genesis.validator_set_hash().to_hex(),
+        f["validator_set_hash_1"]
+    );
+    assert_eq!(genesis.allocation_root().to_hex(), f["allocation_root_1"]);
+}
+
+#[test]
+fn every_bad_json_document_is_rejected() {
+    let f = parse(GOLDEN);
+    let bad: Vec<&str> = f
+        .keys()
+        .filter(|key| key.starts_with("json_bad_"))
+        .map(String::as_str)
+        .collect();
+    assert_eq!(bad.len(), 13);
+    for key in bad {
+        assert!(
+            from_json_str(&json_doc(&f, key)).is_err(),
+            "{key} must be rejected"
+        );
+    }
+}
+
+#[test]
+fn bad_json_documents_return_the_specific_error() {
+    let f = parse(GOLDEN);
+    let error = |key: &str| from_json_str(&json_doc(&f, key)).unwrap_err();
+
+    assert_eq!(
+        error("json_bad_unknown_field"),
+        GenesisError::UnknownField("network".to_owned())
+    );
+    assert_eq!(
+        error("json_bad_wrong_chain"),
+        GenesisError::WrongChain("auralite-1".to_owned())
+    );
+    assert_eq!(
+        error("json_bad_version"),
+        GenesisError::UnsupportedProtocolVersion(2)
+    );
+    assert!(matches!(
+        error("json_bad_duplicate_validator"),
+        GenesisError::DuplicateValidator(_)
+    ));
+    assert_eq!(
+        error("json_bad_zero_power"),
+        GenesisError::ZeroValidatorPower
+    );
+    assert_eq!(
+        error("json_bad_float_balance"),
+        GenesisError::WrongType("balance")
+    );
+    assert!(matches!(
+        error("json_bad_address"),
+        GenesisError::InvalidAddress(_)
+    ));
+    assert_eq!(
+        error("json_bad_empty_validators"),
+        GenesisError::EmptyValidatorSet
+    );
+    assert!(matches!(
+        error("json_bad_pubkey"),
+        GenesisError::InvalidPublicKey(_)
+    ));
+    assert_eq!(
+        error("json_bad_supply_overflow"),
+        GenesisError::SupplyOverflow
+    );
+    assert_eq!(
+        error("json_bad_missing_field"),
+        GenesisError::MissingField("chain_id")
+    );
+    assert_eq!(
+        error("json_bad_unknown_validator_field"),
+        GenesisError::UnknownNestedField("name".to_owned())
+    );
+    assert!(matches!(
+        error("json_bad_duplicate_allocation"),
+        GenesisError::DuplicateAllocation(_)
+    ));
+}
+
+#[test]
+fn binary_genesis_is_canonical() {
+    let f = parse(GOLDEN);
+    let bytes = hx(&f["genesis_1_canonical"]);
+    assert_eq!(
+        aura_genesis::Genesis::from_canonical_bytes(&bytes)
+            .unwrap()
+            .canonical_bytes(),
+        bytes
+    );
+    let mut trailing = bytes.clone();
+    trailing.push(0);
+    assert_eq!(
+        aura_genesis::Genesis::from_canonical_bytes(&trailing),
+        Err(GenesisError::Decode(CodecError::TrailingBytes(1)))
+    );
+    assert!(aura_genesis::Genesis::from_canonical_bytes(&bytes[..bytes.len() - 1]).is_err());
+    // Non-minimal chain-id length varint (0x0f -> 0x80 0x00 is a different
+    // value, so use a mutated first byte that keeps the length but adds a
+    // continuation bit).
+    let mut nonminimal = vec![0x8f, 0x00];
+    nonminimal.extend_from_slice(&bytes[1..]);
+    assert!(aura_genesis::Genesis::from_canonical_bytes(&nonminimal).is_err());
+}
+
+#[test]
+fn summary_is_complete_and_deterministic() {
+    let f = parse(GOLDEN);
+    let genesis = genesis(&f, "json_min");
+    let summary = genesis.summary();
+    for key in [
+        "chain_id",
+        "protocol_version",
+        "genesis_time_ms",
+        "validators",
+        "allocations",
+        "total_supply",
+        "genesis_hash",
+        "validator_set_hash",
+        "allocation_root",
+    ] {
+        assert!(summary.contains_key(key), "summary missing {key}");
+    }
+    assert_eq!(summary["genesis_hash"], f["genesis_1_hash"]);
+    assert_eq!(summary, genesis.summary());
+}
