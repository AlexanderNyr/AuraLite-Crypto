+    for vector in &parsed {
+        let (first, a) = run(vector);
+        let (second, b) = run(vector);
+        assert_eq!(
+            first.tree_root(),
+            second.tree_root(),
+            "{}: root",
+            vector.label
+        );
+        assert_eq!(
+            a.receipt.gas_used, b.receipt.gas_used,
+            "{}: gas",
+            vector.label
