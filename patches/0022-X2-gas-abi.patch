+#[test]
+fn status_codes_are_pinned() {
+    let pinned = [
+        (AbiError::OutOfMemory, -1),
+        (AbiError::KeyTooLong, -2),
+        (AbiError::ValueTooLong, -3),
+        (AbiError::TopicTooLong, -4),
+        (AbiError::NotOwned, -5),
+        (AbiError::InsufficientBalance, -6),
+        (AbiError::Overflow, -7),
+        (AbiError::OutOfGas, -8),
+        (AbiError::TooManyEvents, -11),
+    ];
+    for (error, code) in pinned {
