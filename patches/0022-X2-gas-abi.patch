+        let parts: Vec<&str> = rest.split(':').collect();
+        let name = parts[0];
+        let base: u64 = parts[1].parse().expect("base");
+        let per_byte: u64 = parts[2].parse().expect("per byte");
+        let row = GAS_TABLE
