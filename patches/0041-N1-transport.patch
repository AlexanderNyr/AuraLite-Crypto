@@ -0,0 +1,122 @@
+//! Error types for `aura-p2p` transport, identity, handshake, and ban-list checks.
+
+use std::fmt;
+use std::net::IpAddr;
+
+use crate::identity::PeerId;
+
+/// Errors returned by N1 peer identity, handshake, ban list, and encrypted frame operations.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum P2pError {
+    /// Claimed `PeerId` does not equal `blake3_hash(public_key)`.
+    IdentityMismatch {
+        /// The `PeerId` claimed in the handshake frame.
+        claimed: PeerId,
+        /// The `PeerId` derived from the supplied Ed25519 public key.
+        derived: PeerId,
+    },
+    /// Remote peer proved a valid identity, but not the expected target `PeerId`.
+    IdentitySubstitution {
+        /// The `PeerId` the dialer expected at this endpoint.
+        expected: PeerId,
+        /// The `PeerId` presented by the remote peer.
+        actual: PeerId,
+    },
+    /// Peer attempted to establish a connection with its own `PeerId`.
+    SelfConnection(PeerId),
+    /// Remote `PeerId` is currently on the local ban list.
+    PeerBanned {
+        /// Banned peer identifier.
+        peer_id: PeerId,
+        /// Human-readable reason for the ban.
+        reason: String,
+    },
+    /// Remote IP address is currently on the local ban list.
+    IpBanned {
+        /// Banned IP address.
+        ip: IpAddr,
+        /// Human-readable reason for the ban.
+        reason: String,
+    },
+    /// Handshake `protocol_version` did not match the local version.
+    ProtocolVersionMismatch {
+        /// Local supported protocol version.
+        local: u16,
+        /// Remote advertised protocol version.
+        remote: u16,
+    },
+    /// Handshake `chain_id` did not match the local network's `chain_id`.
+    ChainIdMismatch {
+        /// Local expected `chain_id`.
+        expected: String,
+        /// Remote advertised `chain_id`.
+        actual: String,
+    },
+    /// Ed25519 signature over the handshake transcript failed verification.
+    InvalidHandshakeSignature,
+    /// Frame exceeded the bounded N1 maximum frame size.
+    FrameTooLarge {
+        /// Attempted frame length in bytes.
+        size: usize,
+        /// Maximum permitted frame length in bytes.
+        max: usize,
+    },
+    /// Post-handshake encrypted frame failed MAC tag or sequence verification.
+    FrameAuthenticationFailed,
+    /// Swarm connection table is already at its configured `max_peers` bound.
+    MaxPeersReached {
+        /// Configured maximum number of connected peers.
+        max: usize,
+    },
+    /// Canonical binary encoding or decoding failed.
+    Codec(String),
+    /// Underlying socket I/O error.
+    Io(String),
+}
+
+impl fmt::Display for P2pError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::IdentityMismatch { claimed, derived } => write!(
+                f,
+                "peer identity mismatch: claimed {claimed}, derived from pubkey {derived}"
+            ),
+            Self::IdentitySubstitution { expected, actual } => write!(
+                f,
+                "peer identity substitution rejected: expected {expected}, got {actual}"
+            ),
+            Self::SelfConnection(peer_id) => {
+                write!(f, "refusing self-connection for peer {peer_id}")
+            }
+            Self::PeerBanned { peer_id, reason } => {
+                write!(f, "peer {peer_id} is banned: {reason}")
+            }
+            Self::IpBanned { ip, reason } => {
+                write!(f, "ip {ip} is banned: {reason}")
+            }
+            Self::ProtocolVersionMismatch { local, remote } => write!(
+                f,
+                "protocol version mismatch: local={local}, remote={remote}"
+            ),
+            Self::ChainIdMismatch { expected, actual } => {
+                write!(f, "chain_id mismatch: expected {expected}, got {actual}")
+            }
+            Self::InvalidHandshakeSignature => {
+                write!(f, "invalid Ed25519 signature over P2P handshake transcript")
+            }
+            Self::FrameTooLarge { size, max } => {
+                write!(f, "P2P frame size {size} exceeds limit {max}")
+            }
+            Self::FrameAuthenticationFailed => {
+                write!(f, "P2P encrypted frame MAC or sequence verification failed")
+            }
+            Self::MaxPeersReached { max } => {
+                write!(f, "maximum connected peers ({max}) reached")
+            }
+            Self::Codec(msg) => write!(f, "P2P codec error: {msg}"),
+            Self::Io(msg) => write!(f, "P2P I/O error: {msg}"),
+        }
+    }
+}
+
+impl std::error::Error for P2pError {}
