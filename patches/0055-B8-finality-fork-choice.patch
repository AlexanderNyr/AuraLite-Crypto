+#[allow(clippy::too_many_arguments)]
+fn make_signed_block(
+    val: &TestVal,
+    chain_id: &ChainId,
+    height: u64,
+    view: u64,
+    round: u64,
+    parent: &FinalityBlock,
+    justified_qc_view: u64,
+    tx_tag: &[u8],
+) -> SignedForkBlock {
+    let block = if height == 0 {
+        FinalityBlock {
+            view: 0,
+            round: 0,
+            parent_hash: Hash::ZERO,
+            timestamp_ms: 1_000,
