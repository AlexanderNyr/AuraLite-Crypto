diff --git a/Cargo.toml b/Cargo.toml
index 3d2f208..e755ad3 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -66,6 +66,21 @@ rocksdb = { version = "=0.23.0", default-features = false, features = ["bindgen-
 # C9: proptest is a DEV dependency of aura-testkit only. Minimal
 # features (no fork/timeout) to keep the resolved set small.
 proptest = { version = "=1.12.0", default-features = false, features = ["std"] }
+# X1: the default engine is `wasmi`, a deterministic WASM interpreter.
+# `default-features = false` keeps SIMD out of the build (we never enable it);
+# `deterministic` uses the platform-independent float/math path; `validate`
+# enables the validator (and `Config::floats`); `portable-dispatch` selects the
+# portable instruction dispatcher so an x86 node and an ARM node execute the
+# same bytecode the same way. MEASURED: with neither `auto-dispatch` nor
+# `portable-dispatch` selected, the interpreter overflows the native stack on a
+# simple `loop { br 0 }` instead of consuming fuel (wasmi 2.0.0, 2026-10-28) —
+# the X1 fuel gate caught it. Exact pin: fuel costs are version-sensitive, so
+# bumping wasmi is a protocol decision with its own patch.
+wasmi = { version = "=2.0.0", default-features = false, features = ["std", "validate", "deterministic", "portable-dispatch"] }
+# X1: optional JIT backend behind `wasmtime-engine`. Not part of the default
+# build: Cranelift does not compile on a 2 GB machine, so its gate is a
+# separate CI job (see docs/evidence/x1/report.md).
+wasmtime = { version = "=50.0.0" }
 
