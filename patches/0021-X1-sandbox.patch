diff --git a/crates/aura-exec/src/bin/x1-record.rs b/crates/aura-exec/src/bin/x1-record.rs
new file mode 100644
index 0000000..1f75e15
--- /dev/null
+++ b/crates/aura-exec/src/bin/x1-record.rs
@@ -0,0 +1,131 @@
+//! `x1-record` — run the X1 fixture through the real sandbox and pin the
+//! measured block.
+//!
+//! The expectation block of `tests/fixtures/x1_golden.txt` is written by the
+//! independent Python assembler. This binary writes the second block: the exact
+//! `wasmi` fuel and trace length for every program. That is what turns "the
+//! sandbox runs it" into "the sandbox burns exactly this much fuel", so a
+//! dependency bump that changes metering cannot pass unnoticed.
+//!
+//! ```text
+//! cargo run -p aura-exec --bin x1-record
+//! make gen-x1-vectors
+//! ```
+
+use std::collections::BTreeMap;
+use std::path::PathBuf;
+
+use aura_exec::{Engine, Sandbox, SandboxError, SandboxLimits};
+
+const MARKER: &str = "# --- measured by `cargo run -p aura-exec --bin x1-record` ---";
+
+fn fixture_path() -> PathBuf {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures/x1_golden.txt")
+}
+
+fn decode(hex: &str) -> Vec<u8> {
+    (0..hex.len())
+        .step_by(2)
+        .map(|i| u8::from_str_radix(&hex[i..i + 2], 16).expect("valid hex"))
+        .collect()
+}
+
+fn classify(result: Result<aura_exec::Execution, SandboxError>) -> (String, u64, usize) {
+    match result {
+        Ok(execution) => {
+            let outcome = match &execution.outcome {
+                aura_exec::Outcome::Returned(value) => format!("return:{value}"),
+                aura_exec::Outcome::Trap(kind) => format!("trap:{}", kind.code()),
+            };
+            (outcome, execution.fuel_used, execution.trace.len())
+        }
+        Err(SandboxError::Censored(ban)) => (format!("censored:{}", ban.code()), 0, 0),
+        Err(SandboxError::Limit(code)) => (format!("limit:{code}"), 0, 0),
+        Err(SandboxError::ImportsNotAllowed { .. }) => ("imports_not_allowed".to_string(), 0, 0),
+        Err(SandboxError::Instantiate(_)) => ("instantiate".to_string(), 0, 0),
+        Err(SandboxError::Compile(_)) => ("compile".to_string(), 0, 0),
+        Err(SandboxError::EngineUnavailable(_)) => ("engine_unavailable".to_string(), 0, 0),
+        Err(SandboxError::Trap(kind)) => (format!("error:{}", kind.code()), 0, 0),
+    }
+}
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let path = fixture_path();
+    let text = std::fs::read_to_string(&path)?;
+    let header: Vec<&str> = text
+        .lines()
+        .take_while(|line| *line != MARKER)
+        .filter(|line| !line.starts_with('#') && !line.is_empty())
+        .collect();
+
+    let mut programs: BTreeMap<String, (String, Option<i32>)> = BTreeMap::new();
+    for line in header {
+        let Some((key, value)) = line.split_once('=') else {
+            continue;
+        };
+        if let Some(label) = key
+            .strip_prefix("program_")
+            .and_then(|rest| rest.strip_suffix("_hex"))
+        {
+            programs
+                .entry(label.to_string())
+                .or_insert_with(|| (String::new(), None))
+                .0 = value.to_string();
+        } else if let Some(label) = key
+            .strip_prefix("program_")
+            .and_then(|rest| rest.strip_suffix("_input"))
+        {
+            let arg = if value.is_empty() {
+                None
+            } else {
+                Some(value.parse::<i32>()?)
+            };
+            programs
+                .entry(label.to_string())
+                .or_insert_with(|| (String::new(), None))
+                .1 = arg;
+        }
+    }
+
+    let only = std::env::var("AURA_X1_ONLY").ok();
+    let sandbox = Sandbox::new();
+    let mut measured: Vec<String> = Vec::new();
+    for (label, (hex, arg)) in &programs {
+        if let Some(filter) = &only
+            && !label.contains(filter.as_str())
+        {
+            continue;
+        }
+        let wasm = decode(hex);
+        let (outcome, fuel, trace) = classify(sandbox.execute(&wasm, *arg));
+        measured.push(format!("measured_{label}_outcome={outcome}"));
+        measured.push(format!("measured_{label}_fuel={fuel}"));
+        measured.push(format!("measured_{label}_trace={trace}"));
+        println!("{label:<20} {outcome:<26} fuel={fuel:<8} trace={trace}");
+    }
+
+    let mut out: Vec<String> = text
+        .lines()
+        .take_while(|line| *line != MARKER)
+        .map(|line| line.to_string())
+        .collect();
+    out.push(MARKER.to_string());
+    out.extend(measured);
+    std::fs::write(&path, out.join("\n") + "\n")?;
+    println!();
+    println!(
+        "wrote {} ({} programs, engine wasmi {})",
+        path.display(),
+        programs.len(),
+        sandbox.engine().version()
+    );
+    println!(
+        "limits: fuel={} memory_pages={} module_bytes={} stack={} trace={}",
+        sandbox.limits().fuel,
+        sandbox.limits().memory_pages,
+        sandbox.limits().module_bytes,
+        SandboxLimits::restrictive().max_stack_bytes,
+        sandbox.limits().max_trace_events
+    );
+    Ok(())
+}
diff --git a/crates/aura-exec/src/error.rs b/crates/aura-exec/src/error.rs
new file mode 100644
index 0000000..0125c6c
--- /dev/null
+++ b/crates/aura-exec/src/error.rs
@@ -0,0 +1,128 @@
+//! Sandbox errors — one closed set for every engine backend.
+//!
+//! The error type is engine-agnostic on purpose: a caller (X2 gas, X3
+//! lifecycle, X6 calls) must never be able to tell which backend ran the
+//! module. Backend-specific detail is kept in [`SandboxError::detail`] as a
+//! string for logs only; no consensus decision may depend on it.
+
+use core::fmt;
+
+use crate::census::Ban;
+
+/// Everything that can go wrong between "here are bytes" and "here is a
+/// `Trap`".
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum SandboxError {
+    /// The determinism census rejected the module (X0).
+    Censored(Ban),
+    /// The engine refused the module: invalid WASM, unsupported feature,
+    /// too large, too deep.
+    Compile(String),
+    /// Instantiation failed: an import could not be resolved, a limit was
+    /// exceeded, or the module tried to run a start function.
+    Instantiate(String),
+    /// The module declares imports. The sandbox resolves none, so this is a
+    /// policy verdict, not an engine failure.
+    ImportsNotAllowed {
+        /// Number of declared imports.
+        count: usize,
+        /// First offending `module.name`, if the engine exposed one.
+        first: Option<String>,
+    },
+    /// The request violates a published limit (module bytes, memory pages,
+    /// fuel budget, trace recordings).
+    Limit(&'static str),
+    /// The engine is not linked into this build.
+    ///
+    /// This is an honest refusal, not a fake success: `wasmtime` is behind the
+    /// `wasmtime-engine` feature and the default build does not have it.
+    EngineUnavailable(&'static str),
+    /// The module trapped at runtime.
+    Trap(TrapKind),
+}
+
+impl SandboxError {
+    /// Construct a compile error from anything printable.
+    pub fn compile(err: impl fmt::Display) -> Self {
+        Self::Compile(err.to_string())
+    }
+
+    /// Construct an instantiate error from anything printable.
+    pub fn instantiate(err: impl fmt::Display) -> Self {
+        Self::Instantiate(err.to_string())
+    }
+
+    /// A stable, machine-readable code. This is the only string that may
+    /// appear in logs that a comparison depends on.
+    pub fn code(&self) -> &'static str {
+        match self {
+            Self::Censored(_) => "censored",
+            Self::Compile(_) => "compile",
+            Self::Instantiate(_) => "instantiate",
+            Self::ImportsNotAllowed { .. } => "imports_not_allowed",
+            Self::Limit(_) => "limit",
+            Self::EngineUnavailable(_) => "engine_unavailable",
+            Self::Trap(kind) => kind.code(),
+        }
+    }
+}
+
+impl fmt::Display for SandboxError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Censored(ban) => write!(f, "censored: {ban}"),
+            Self::Compile(detail) => write!(f, "compile: {detail}"),
+            Self::Instantiate(detail) => write!(f, "instantiate: {detail}"),
+            Self::ImportsNotAllowed { count, first } => match first {
+                Some(name) => write!(f, "imports_not_allowed: {count} import(s), first {name}"),
+                None => write!(f, "imports_not_allowed: {count} import(s)"),
+            },
+            Self::Limit(what) => write!(f, "limit: {what}"),
+            Self::EngineUnavailable(engine) => write!(f, "engine_unavailable: {engine}"),
+            Self::Trap(kind) => write!(f, "trap: {kind}"),
+        }
+    }
+}
+
+impl std::error::Error for SandboxError {}
+
+/// The subset of traps the sandbox is willing to expose.
+///
+/// The list is closed: a backend trap that does not match one of these becomes
+/// [`TrapKind::Other`] with a detail string, and X7 fails the determinism gate
+/// on any `Other` it has not seen before.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TrapKind {
+    /// Fuel exhausted (X1) — the gas model in X2 maps 1 gas = 1 fuel.
+    OutOfFuel,
+    /// `unreachable` executed.
+    Unreachable,
+    /// Linear-memory access outside the declared bounds.
+    MemoryOutOfBounds,
+    /// Integer division or remainder by zero.
+    IntegerDivideByZero,
+    /// The engine hit its stack / recursion limit.
+    StackExhausted,
+    /// Anything else. Recorded with a detail string, never silently allowed.
+    Other,
+}
+
+impl TrapKind {
+    /// Stable code used in traces and comparisons.
+    pub fn code(self) -> &'static str {
+        match self {
+            Self::OutOfFuel => "trap_out_of_fuel",
+            Self::Unreachable => "trap_unreachable",
+            Self::MemoryOutOfBounds => "trap_memory_oob",
+            Self::IntegerDivideByZero => "trap_div_by_zero",
+            Self::StackExhausted => "trap_stack_exhausted",
+            Self::Other => "trap_other",
+        }
+    }
+}
+
+impl fmt::Display for TrapKind {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(self.code())
+    }
+}
