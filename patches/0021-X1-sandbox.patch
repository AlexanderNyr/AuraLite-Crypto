new file mode 100644
index 0000000..7d74a2a
--- /dev/null
+++ b/tools/nc_x1.py
@@ -0,0 +1,116 @@
+#!/usr/bin/env python3
+"""Negative controls for X1 (sandbox).
+
+Six tamper tests must each turn the X1 gate red:
+
+  NC-1 census bypassed            -> banned modules reach the engine.
+  NC-2 fuel budget ignored        -> the pinned fuel numbers no longer hold.
+  NC-3 memory ceiling removed     -> memory.grow past the ceiling succeeds.
+  NC-4 trap misclassified         -> out-of-fuel is reported as `trap_other`.
+  NC-5 module-size check removed  -> an oversized module is parsed anyway.
+  NC-6 trace cap removed          -> the trace is unbounded.
+
+Rule (CONTRIBUTING.md §1): a gate that cannot go red is not a gate.
+
+Usage:
+    python3 tools/nc_x1.py
+    make nc-x1
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+from datetime import datetime, timezone
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+SANDBOX_RS = REPO / "crates" / "aura-exec" / "src" / "sandbox.rs"
+WASMI_RS = REPO / "crates" / "aura-exec" / "src" / "wasmi_engine.rs"
+
+CARGO_TEST = ["cargo", "test", "-p", "aura-exec", "--test", "x1_sandbox", "--quiet"]
+
+
+def run(cmd: list[str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(cmd, cwd=REPO, capture_output=True, text=True, check=False)
+
+
+def expect_red(label: str, path: Path, old: str, new: str) -> bool:
+    original = path.read_text(encoding="utf-8")
+    if old not in original:
+        print(f"{label}: FAIL — tamper target not found in {path.name}")
+        return False
+    tampered = original.replace(old, new, 1)
+    if tampered == original:
+        print(f"{label}: FAIL — tamper was a no-op")
+        return False
+    try:
+        path.write_text(tampered, encoding="utf-8")
+        os.utime(path, None)
+        result = run(CARGO_TEST)
+        went_red = result.returncode != 0
+        snippet = "\n".join((result.stdout + result.stderr).strip().splitlines()[-3:])
+        print(f"{label}: {'PASS' if went_red else 'FAIL'}")
+        print(
+            f"      cargo test -p aura-exec --test x1_sandbox -> rc={result.returncode} "
+            f"({'RED as expected' if went_red else 'UNEXPECTEDLY GREEN'})"
+        )
+        print(f"      {snippet}")
+        return went_red
+    finally:
+        path.write_text(original, encoding="utf-8")
+        os.utime(path, None)
+
+
+def main() -> int:
+    stamp = datetime.now(timezone.utc).isoformat(timespec="seconds")
+    print(f"X1 NEGATIVE CONTROLS — {stamp}")
+    print("Rule: a gate that cannot go red is not a gate (CONTRIBUTING.md §1).")
+    print()
+
+    results = [
+        expect_red(
+            "NC-1 census bypassed (gate always Ok)",
+            SANDBOX_RS,
+            "        let census_limits = ModuleLimits::restrictive();",
+            "        if true { return Ok(()); }\n        let census_limits = ModuleLimits::restrictive();",
+        ),
+        expect_red(
+            "NC-2 fuel budget ignored (4x the published budget)",
+            WASMI_RS,
+            "        store\n            .set_fuel(limits.fuel)",
+            "        store\n            .set_fuel(limits.fuel * 4)",
+        ),
+        expect_red(
+            "NC-3 memory ceiling removed from the store limiter",
+            WASMI_RS,
+            "                .memory_size(limits.memory_bytes())",
+            "                .memory_size(usize::MAX / 2)",
+        ),
+        expect_red(
+            "NC-4 trap misclassified (out-of-fuel -> other)",
+            WASMI_RS,
+            "        TrapCode::OutOfFuel => TrapKind::OutOfFuel,",
+            "        TrapCode::OutOfFuel => TrapKind::Other,",
+        ),
+        expect_red(
+            "NC-5 module-size check removed",
+            SANDBOX_RS,
+            "        if wasm.len() > self.limits.module_bytes as usize {\n            return Err(SandboxError::Limit(\"module_bytes\"));\n        }",
+            "        if false {\n            return Err(SandboxError::Limit(\"module_bytes\"));\n        }",
+        ),
+        expect_red(
+            "NC-6 trace cap removed",
+            WASMI_RS,
+            "    if state.trace.len() < state.max_trace {",
+            "    if true {",
+        ),
+    ]
+    print()
+    passed = sum(results)
+    print(f"RESULT: {passed}/{len(results)} negative controls PASS")
+    return 0 if passed == len(results) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/record_x1_deps.py b/tools/record_x1_deps.py
new file mode 100644
index 0000000..a5b6122
--- /dev/null
+++ b/tools/record_x1_deps.py
@@ -0,0 +1,93 @@
+#!/usr/bin/env python3
+"""Record the X1 dependency delta (the first engine dependency).
+
+The C3 baseline is frozen historical evidence, and a phase must not add files to
+`docs/spec/` (its index is checksummed C10 evidence), so the delta lands in
+`docs/evidence/x1-dependency-addendum.txt`.
+
+X1 adds two external roots:
+
+  * `wasmi =2.0.0` — the DEFAULT engine (deterministic interpreter, portable
+    dispatcher). Six crates: wasmi, wasmi_core, wasmi_ir, wasmi_collections,
+    wasmparser, spin.
+  * `wasmtime =50.0.0` — the OPTIONAL JIT engine behind the
+    `wasmtime-engine` feature. Cranelift and friends: a large subtree that the
+    default build never compiles, but which `Cargo.lock` must still pin and
+    checksum, so it is recorded here in full.
+
+Usage:
+    python3 tools/record_x1_deps.py
+    make record-x1-deps
+"""
+
+from __future__ import annotations
+
+import tomllib
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+OUT = REPO / "docs" / "evidence" / "x1-dependency-addendum.txt"
+
+HEADER = """# AuraLite-Crypto external dependency addendum (X1).
+# Generated by tools/record_x1_deps.py from Cargo.lock.
+# X1 adds the execution engine. Two roots, both exact-pinned and checksummed:
+#   wasmi    =2.0.0   -> the DEFAULT backend (deterministic interpreter,
+#                        features std + validate + deterministic +
+#                        portable-dispatch; SIMD is not compiled in)
+#   wasmtime =50.0.0  -> the OPTIONAL backend behind `wasmtime-engine`
+#                        (Cranelift JIT; not compiled by the default build)
+# Bumping either engine changes fuel metering, so it is a protocol decision
+# with its own patch, not a `cargo update`.
+# Every crate below is in Cargo.lock with a crates.io source and a sha256.
+"""
+
+MARK_WASMI = "# --- ismi/wasmi subtree (default build) ---".replace("ismi/", "")
+MARK_WASMTIME = "# --- wasmtime / cranelift subtree (feature `wasmtime-engine` only) ---"
+
+
+def read_pairs(path: Path) -> set[tuple[str, str]]:
+    out: set[tuple[str, str]] = set()
+    for line in path.read_text(encoding="utf-8").splitlines():
+        line = line.strip()
+        if line and not line.startswith("#") and "=" in line:
+            name, version = line.split("=", 1)
+            out.add((name, version))
+    return out
+
+
+def known_crates() -> set[tuple[str, str]]:
+    known = read_pairs(REPO / "docs" / "spec" / "c3-dependency-allowlist.txt")
+    for path in (REPO / "docs" / "spec").glob("*-dependency-addendum.txt"):
+        known |= read_pairs(path)
+    for path in (REPO / "docs" / "evidence").glob("*-dependency-addendum.txt"):
+        if path != OUT:
+            known |= read_pairs(path)
+    return known
+
+
+def main() -> int:
+    data = tomllib.loads((REPO / "Cargo.lock").read_text(encoding="utf-8"))
+    current = {
+        (p["name"], p["version"]) for p in data.get("package", []) if "source" in p
+    }
+    new = sorted(current - known_crates())
+
+    wasmi_prefixes = ("wasmi", "wasmparser", "spin", "bitflags", "libm", "smallvec")
+    is_wasmi = lambda name: name.startswith(wasmi_prefixes)  # noqa: E731
+    wasmi_set = [pair for pair in new if is_wasmi(pair[0])]
+    wasmtime_set = [pair for pair in new if pair not in wasmi_set]
+
+    lines = [HEADER.rstrip(), "", MARK_WASMI]
+    lines += [f"{name}={version}" for name, version in wasmi_set]
+    lines += ["", MARK_WASMTIME]
+    lines += [f"{name}={version}" for name, version in wasmtime_set]
+    OUT.parent.mkdir(parents=True, exist_ok=True)
+    OUT.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    print(f"wrote {OUT.relative_to(REPO)} ({len(new)} new crates)")
+    print(f"  wasmi subtree:    {len(wasmi_set)}")
+    print(f"  wasmtime subtree: {len(wasmtime_set)}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
