+#!/usr/bin/env python3
+"""Build the E6 evidence pack (docs/evidence/e6) in the canonical tier
+format: baseline.log, e6-cdp.log, campaign/result.json, gates.txt,
+inventory.txt, nc.log, nc-suite.log, report.md, SHA256SUMS.
