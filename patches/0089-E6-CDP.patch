+        e.deposit(id, 200 * E6_ONE).unwrap();
+        assert_eq!(e.ratio_bps(id), None);
+        e.mint(id, 100 * E6_ONE).unwrap();
+        assert_eq!(e.ratio_bps(id), Some(20_000));
