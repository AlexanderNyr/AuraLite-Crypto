+        e.deposit(id, 200 * E6_ONE).unwrap();
+        e.mint(id, 100 * E6_ONE).unwrap();
+        e.withdraw(id, 50 * E6_ONE).unwrap();
+        assert_eq!(e.ratio_bps(id), Some(15_000));
+        let err = e.withdraw(id, 1).unwrap_err();
+        assert_eq!(
+            err.to_string(),
