+--- /dev/null
++++ b/tools/write_p2_evidence.py
+@@ -0,0 +1,203 @@
++#!/usr/bin/env python3
++"""Build the P2 evidence pack (docs/evidence/p2) in the canonical tier
++format: baseline.log, p2-parallel.log, example.log, campaign/result.json,
