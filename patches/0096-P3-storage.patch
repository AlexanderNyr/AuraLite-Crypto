+++            p50,
+++            p95,
+++            p99,
+++            total,
+++            verify_before: VERIFY_BEFORE,
+++            verify_after: verify_cost_amortized(BATCH_K),
+++            decode_before: decode_cost_before(work.bytes),
+++            decode_after: decode_cost(work.bytes),
+++            agg_k: BATCH_K,
