+++/// Median of a sample (odd or even count; integer arithmetic).
+++fn median_u64(sample: &mut [u64]) -> u64 {
+++    sample.sort_unstable();
+++    let n = sample.len();
+++    if n % 2 == 1 {
+++        sample[n / 2]
+++    } else {
+++        (sample[n / 2 - 1] + sample[n / 2]) / 2
+++    }
+++}
