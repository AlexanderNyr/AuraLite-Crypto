+
+evidence-w6:
+	@$(PYTHON) tools/write_w6_evidence.py
+
+build-aura-keys:
+	@$(PYTHON) tools/build_aura_keys.py
+
 # H0: the threat-model review gate (tools/check_threat_model.py).
 .PHONY: gen-h0-vectors check-h0 nc-h0 evidence-h0
 
