diff --git a/clients/wallet-web/README.md b/clients/wallet-web/README.md
new file mode 100644
index 0000000..11b165e
--- /dev/null
+++ b/clients/wallet-web/README.md
@@ -0,0 +1,39 @@
+# wallet-web — AuraLite browser extension (W6)
+
+**This directory is untrusted glue.** The trusted computing base of the web
+wallet is the `aura-keys` WASM artifact (`clients/aura-keys/`, built from
+`crates/aura-wallet/src/web.rs`); every security decision — the real-tx-field
+confirmation view (D-W6-1), the confirmation binding (D-W6-2), the phishing
+policy (D-W6-3) and the deep-link schema (D-W6-4) — runs inside it. The
+artifact has **zero imports**, so no JavaScript can be called from inside the
+core.
+
+## Layout
+
+- `manifest.json` — Manifest V3 extension (popup, service worker, content
+  script; the WASM artifact is shipped as a web-accessible resource).
+- `content.js` — dApp bridge: forwards `auralite://sign?…` deep links and the
+  true page origin. It never sees keys or transaction fields.
+- `background.js` — relays requests through `aura_keys_deep_link_parse` and
+  `aura_keys_origin_check`.
+- `popup.html` / `popup.js` — the confirmation dialog. It renders **only** the
+  `ui:` lines derived from the transaction bytes by `aura_keys_confirm_view`;
+  a page claim is checked by `aura_keys_claim_check` and a disagreement blocks
+  Confirm. `aura_keys_sign` receives the exact shown text and re-derives the
+  view internally, refusing on any difference.
+
+## Threat model (the three attacks this gates)
+
+1. **display substitution** — the page claims one recipient while the bytes
+   carry another: the dialog shows the bytes (never the claim), the claim is
+   checked against the bytes, and the named control
+   `ui_recipient_substitution` keeps the refusal red.
+2. **blind signing** — any request that skips the rendered view is refused
+   (`aura_keys_sign_without_view` is a tripwire that always refuses).
+3. **phishing origins** — only `https://` official hosts pass; homoglyph
+   lookalikes are refused as `suspicious origin`.
+
+Vectors and mutation controls: `tests/fixtures/w6_web_wallet_vectors.json`
+(`tools/gen_w6_vectors.py`), `tools/nc_w6.py`, gate run via `make test-w6`.
+The WASM build is reproducible and pinned by `tools/build_aura_keys.py`.
+PUBLIC TEST DATA ONLY — never use for funds.
diff --git a/clients/wallet-web/background.js b/clients/wallet-web/background.js
new file mode 100644
index 0000000..4ff19b2
--- /dev/null
+++ b/clients/wallet-web/background.js
@@ -0,0 +1,84 @@
+// background.js — AuraLite wallet service worker (W6).
+//
+// UNTRUSTED GLUE. Every security decision runs inside the aura-keys WASM
+// artifact (crates/aura-wallet/src/web.rs): the phishing policy (D-W6-3),
+// the deep-link schema (D-W6-4), the real-tx-field view (D-W6-1) and the
+// confirmation binding (D-W6-2). This file only relays messages and moves
+// bytes in and out of the artifact's linear memory; it never interprets
+// transaction contents itself.
+//
+// Buffer convention: inputs are copied into the artifact's linear memory at
+// fixed offsets and every export receives (ptr, len) pairs; outputs are read
+// back from the out offset the export was given. The artifact has zero
+// imports, so nothing in this file can be called from inside the core.
+
+const MEM = Object.freeze({
+  URI: 0,        // deep-link text
+  ORIGIN: 8192,  // request origin
+  ENVELOPE: 16384,
+  CHAIN: 32768,
+  VIEW: 40960,   // derived ui: lines (what the human must see)
+  OUT: 49152,    // generic out buffer (16 KiB)
+});
+
+const CODES = Object.freeze({
+  OK: 0,
+  ERR_MALFORMED_DEEP_LINK: -1,
+  ERR_UNKNOWN_PARAMETER: -2,
+  ERR_SUSPICIOUS_ORIGIN: -3,
+  ERR_UNTRUSTED_ORIGIN: -4,
+  ERR_UI_CONFIRMATION_SKIPPED: -5,
+  ERR_SHOWN_VIEW_MISMATCH: -10,
+});
+
+let keysPromise = null;
+
+function loadKeys() {
+  if (!keysPromise) {
+    keysPromise = (async () => {
+      const url = chrome.runtime.getURL("aura_keys.wasm");
+      const bytes = await (await fetch(url)).arrayBuffer();
+      // The artifact is pure WASM with no imports: instantiate directly.
+      const { instance } = await WebAssembly.instantiate(bytes, {});
+      return instance.exports;
+    })();
+  }
+  return keysPromise;
+}
+
+function put(keys, offset, text) {
+  const bytes = new TextEncoder().encode(text);
+  new Uint8Array(keys.memory.buffer).set(bytes, offset);
+  return bytes.length;
+}
+
+function take(keys, offset, length) {
+  return new TextDecoder().decode(
+    new Uint8Array(keys.memory.buffer).subarray(offset, offset + length),
+  );
+}
+
+// Route one deep link through the wasm core: parse (D-W6-4) -> origin check
+// (D-W6-3). The response handed to the popup carries only the raw envelope;
+// the view is derived by `popup.js` via `aura_keys_confirm_view` and is the
+// ONLY text the confirm dialog may render (D-W6-1).
+async function handleDeepLink(uri, origin) {
+  const keys = await loadKeys();
+  const uriLen = put(keys, MEM.URI, uri);
+  const n = keys.aura_keys_deep_link_parse(MEM.URI, uriLen, MEM.ENVELOPE, 16384);
+  if (n < 0) return { ok: false, code: n };
+  const originLen = put(keys, MEM.ORIGIN, origin);
+  const code = keys.aura_keys_origin_check(MEM.ORIGIN, originLen);
+  if (code !== CODES.OK) return { ok: false, code };
+  return { ok: true, envelope: take(keys, MEM.ENVELOPE, n) };
+}
+
+chrome.runtime.onMessage.addListener((message, sender, respond) => {
+  if (message && message.type === "auralite:sign") {
+    handleDeepLink(message.deepLink, message.origin)
+      .then(respond)
+      .catch(() => respond({ ok: false, code: CODES.ERR_MALFORMED_DEEP_LINK }));
+    return true; // async respond
+  }
+  return false;
+});
