--- /dev/null
+++ b/clients/aura-keys/Cargo.toml
@@ -0,0 +1,31 @@
+[package]
+name = "aura-keys"
+description = "W6 WASM key layer of the AuraLite web wallet: real-tx-field confirmation, deep links, phishing protection"
+version = "0.1.0"
+edition = "2024"
+license = "MIT OR Apache-2.0"
+publish = false
+
+# A client artifact is its own workspace: it is built for
+# wasm32-unknown-unknown and it must NOT touch the root Cargo.lock (W6).
+[workspace]
+
+[dependencies]
+aura-types = { path = "../../crates/aura-types" }
+aura-crypto = { path = "../../crates/aura-crypto" }
+aura-tx = { path = "../../crates/aura-tx" }
+
+# Deterministic WASM shim (see `wasm_rng` in src/lib.rs): no JS glue in the
+# artifact, and a future RNG call fails loudly instead of returning zeros.
+[target.'cfg(all(target_arch = "wasm32", target_os = "unknown"))'.dependencies]
+getrandom = { version = "0.2", features = ["custom"] }
+
+[lib]
+crate-type = ["cdylib", "rlib"]
+
+[profile.release]
+opt-level = "z"
+lto = true
+codegen-units = 1
+panic = "abort"
+strip = true
