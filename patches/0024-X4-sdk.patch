@@ -0,0 +1,23 @@
+[package]
+name = "aura-sdk-macros"
+description = "Proc macros for AuraLite-Crypto contracts: #[entrypoint], #[constructor], #[migrate]"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+rust-version.workspace = true
+repository.workspace = true
+publish.workspace = true
+
+[lib]
+proc-macro = true
+
+[dependencies]
+# X4 is the first phase since X1 to add EXTERNAL crates to the default build
+# graph -- but not to the lock: syn/quote/proc-macro2 were already pinned there
+# as dev dependencies of aura-testkit. Writing a token-level attribute macro by
+# hand (as C-macro convention would) is possible, but `syn` is already audited
+# in this lock and hand-rolled parsing of attributes is a source of silent
+# misparses. The pins are exact, like every other dependency (ROADMAP §7).
+syn = { version = "=2.0.119", default-features = false, features = ["full", "parsing", "printing", "proc-macro", "clone-impls"] }
+quote = { version = "=1.0.47", default-features = false }
+proc-macro2 = { version = "=1.0.107", default-features = false }
diff --git a/crates/aura-sdk-macros/src/lib.rs b/crates/aura-sdk-macros/src/lib.rs
new file mode 100644
index 0000000..8a401f2
--- /dev/null
+++ b/crates/aura-sdk-macros/src/lib.rs
@@ -0,0 +1,195 @@
+//! X4 — proc macros for AuraLite-Crypto contracts.
+//!
+//! Three attributes. Each one does exactly one thing: it **renames** the
+//! annotated function and emits an `extern "C"` wrapper with the export name the
+//! X3 lifecycle expects. No code generation beyond that — the body the author
+//! wrote is the body that runs.
+//!
+//! | attribute | export | arity | called by |
+//! |---|---|---|---|
+//! | `#[entrypoint]` | `run` | 0 | `Lifecycle::call_stored` |
+//! | `#[entrypoint(arg)]` | `run` | 1 | `Lifecycle::call_stored` with an argument |
+//! | `#[constructor]` | `init` | 0 | `Lifecycle::deploy` |
+//! | `#[constructor(arg)]` | `init` | 1 | `Lifecycle::deploy` with an argument |
+//! | `#[migrate]` | `migrate` | 2 | `Lifecycle::upgrade` |
+//!
+//! # Why an attribute and not a trait
+//!
+//! The engine calls a WASM export by name and arity ([`Engine::entry_arity`]);
+//! there is no type-level hook to implement. `#[entrypoint]` is the smallest
+//! thing that turns a Rust function into that export, and it can only be used
+//! once per module per name — a second `#[entrypoint]` is a duplicate-symbol
+//! link error, which is the right failure.
+//!
+//! # Return convention
+//!
+//! The wrapped function returns `u32`. The wrapper returns it as `i32` without
+//! interpretation: the ABI's negative codes are reserved for the *host*, so a
+//! contract that wants to signal a refusal calls [`aura_sdk::abort`], which
+//! traps and reverts the call.
+//!
+//! ```ignore
+//! use aura_sdk::prelude::*;
+//!
+//! #[entrypoint]
+//! pub fn run() -> u32 {
+//!     0
+//! }
+//! ```
+
+use proc_macro::TokenStream;
+use quote::quote;
+use syn::parse::{Parse, ParseStream};
+use syn::{ItemFn, LitStr, parse_macro_input};
+
+/// Which export a wrapper produces.
+enum Kind {
+    Run,
+    Init,
+    Migrate,
+}
+
+impl Kind {
+    fn export(&self) -> &'static str {
+        match self {
+            Self::Run => "run",
+            Self::Init => "init",
+            Self::Migrate => "migrate",
+        }
+    }
+}
+
+/// `#[entrypoint]` / `#[entrypoint(arg)]` — an empty or one-argument attribute.
+struct Attribute {
+    arg: bool,
+}
+
+impl Parse for Attribute {
+    fn parse(input: ParseStream) -> syn::Result<Self> {
+        if input.is_empty() {
+            return Ok(Self { arg: false });
+        }
+        let ident: syn::Ident = input.parse()?;
+        if ident != "arg" {
+            return Err(syn::Error::new(
+                ident.span(),
+                "unknown argument: expected `#[entrypoint]`, `#[entrypoint(arg)]` \
+                 or `#[constructor(arg)]`",
+            ));
+        }
+        Ok(Self { arg: true })
+    }
+}
+
+fn expand(kind: Kind, arg: bool, item: ItemFn) -> syn::Result<proc_macro2::TokenStream> {
+    let export = kind.export();
+    let wrapper_ident = syn::Ident::new(export, item.sig.ident.span());
+    let body_ident = syn::Ident::new(&format!("__aura_{export}"), item.sig.ident.span());
+
+    // The body must take exactly the parameters the export will pass, and it
+    // must return `u32`. Both are reported here rather than at link time,
+    // because the message is much better.
+    let expected = match kind {
+        Kind::Migrate => 2,
+        Kind::Run | Kind::Init if arg => 1,
+        Kind::Run | Kind::Init => 0,
+    };
+    let mut body = item.clone();
+    body.sig.ident = body_ident.clone();
+    if body.sig.inputs.len() != expected {
+        return Err(syn::Error::new_spanned(
+            &body.sig.inputs,
+            format!(
+                "`{export}` takes {expected} parameter(s); the function has {}",
+                body.sig.inputs.len()
+            ),
+        ));
+    }
+    match &body.sig.output {
+        syn::ReturnType::Type(_, ty) => match ty.as_ref() {
+            syn::Type::Path(path) if path.path.is_ident("u32") => {}
+            other => {
+                return Err(syn::Error::new_spanned(
+                    other,
+                    "an entry point must return u32 (call aura_sdk::abort to revert)",
+                ));
+            }
+        },
+        syn::ReturnType::Default => {
+            return Err(syn::Error::new_spanned(
+                &body.sig,
+                "an entry point must return u32 (call aura_sdk::abort to revert)",
+            ));
+        }
+    }
+
+    let wrapper = match kind {
+        Kind::Run | Kind::Init if arg => quote! {
+            #[unsafe(no_mangle)]
+            pub extern "C" fn #wrapper_ident(arg: i32) -> i32 {
+                #body_ident(arg) as i32
+            }
+        },
+        Kind::Run | Kind::Init => quote! {
+            #[unsafe(no_mangle)]
+            pub extern "C" fn #wrapper_ident() -> i32 {
+                #body_ident() as i32
+            }
+        },
+        Kind::Migrate => {
+            quote! {
+                #[unsafe(no_mangle)]
+                pub extern "C" fn #wrapper_ident(from: i32, to: i32) -> i32 {
+                    #body_ident(from, to) as i32
+                }
+            }
+        }
+    };
+
+    // A short doc comment lands on the wrapper so `cargo doc` on a contract
+    // shows which export the function became.
+    let note = LitStr::new(
+        &format!("WASM export `{export}` generated by `aura_sdk`."),
+        proc_macro2::Span::call_site(),
+    );
+
+    Ok(quote! {
+        #[doc = #note]
+        #wrapper
+
+        #body
+    })
+}
+
+/// Turn a function into the `run` export the lifecycle calls.
+#[proc_macro_attribute]
+pub fn entrypoint(attr: TokenStream, item: TokenStream) -> TokenStream {
+    let attr = parse_macro_input!(attr as Attribute);
+    let item = parse_macro_input!(item as ItemFn);
+    expand(Kind::Run, attr.arg, item)
+        .unwrap_or_else(syn::Error::into_compile_error)
+        .into()
+}
+
+/// Turn a function into the `init` export `Lifecycle::deploy` calls.
+#[proc_macro_attribute]
+pub fn constructor(attr: TokenStream, item: TokenStream) -> TokenStream {
+    let attr = parse_macro_input!(attr as Attribute);
+    let item = parse_macro_input!(item as ItemFn);
+    expand(Kind::Init, attr.arg, item)
+        .unwrap_or_else(syn::Error::into_compile_error)
+        .into()
+}
+
+/// Turn a function into the `migrate(from, to)` export `Lifecycle::upgrade`
+/// calls.
+#[proc_macro_attribute]
+pub fn migrate(attr: TokenStream, item: TokenStream) -> TokenStream {
+    // `#[migrate]` takes no attribute argument, but `#[migrate(arg)]` is a
+    // common typo for it — reject it loudly instead of ignoring it.
+    let parsed = parse_macro_input!(attr as Attribute);
+    let item = parse_macro_input!(item as ItemFn);
+    expand(Kind::Migrate, parsed.arg, item)
+        .unwrap_or_else(syn::Error::into_compile_error)
+        .into()
+}
diff --git a/crates/aura-sdk/Cargo.toml b/crates/aura-sdk/Cargo.toml
new file mode 100644
index 0000000..4178d9a
--- /dev/null
+++ b/crates/aura-sdk/Cargo.toml
@@ -0,0 +1,35 @@
+[package]
+name = "aura-sdk"
+description = "AuraLite-Crypto contract SDK: ABI v1 bindings, typed storage, events (X4)"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+rust-version.workspace = true
+repository.workspace = true
+publish.workspace = true
+
+# The SDK is TWO crates in one shape: a `no_std` guest library for
+# `wasm32-unknown-unknown` and a host library used by tests. The same source
+# compiles both ways -- the only thing that changes is which backend the
+# `extern "C"` symbols resolve to (the node for wasm, a mock for the host).
+[features]
+# On by default: every real contract uses the three attributes. `macros` stays a
+# feature so the SDK can be built without a proc-macro dependency (a target or a
+# toolchain where proc macros are unavailable), and so the ABI/storage/codec
+# half can be checked on its own:
+#     cargo build -p aura-sdk --no-default-features
+default = ["macros"]
+macros = ["dep:aura-sdk-macros"]
+
+[dependencies]
+aura-sdk-macros = { workspace = true, optional = true }
+
+[lib]
+# A guest contract links this as an rlib; the example crates produce the cdylib.
+crate-type = ["rlib"]
+
+[dev-dependencies]
+# The agreement test compares the SDK's ABI table against the node's, so the
+# contract SDK is tested against the implementation it will talk to. This is a
+# DEV dependency: a contract crate never links the node.
+aura-exec = { path = "../aura-exec" }
diff --git a/crates/aura-sdk/src/abi.rs b/crates/aura-sdk/src/abi.rs
new file mode 100644
index 0000000..d1869e9
--- /dev/null
+++ b/crates/aura-sdk/src/abi.rs
@@ -0,0 +1,609 @@
+//! ABI v1 as a contract sees it: seven functions, typed.
+//!
+//! The host side of this ABI lives in `aura_exec::abi`; the *contract* side is
+//! here. Both list the same seven names because both are checked against the
+//! node's published table by `tests/x4_sdk.rs` — a divergence between the SDK
+//! and the node is a build-time test failure, not a deployed bug.
+//!
+//! # The contract
+//!
+//! Every function takes `(ptr, len)` pairs that must lie inside the contract's
+//! linear memory and returns a status:
+//!
+//! * `>= 0` — success; for `storage_read` this is the number of bytes returned,
+//! * `-1` … `-11` — the closed error set in [`Error`],
+//! * `-9` — `storage_read` only: the key is **absent** (a status, not an error),
+//! * `-10` — `block_ctx` only: unknown field (a status, not an error).
+//!
+//! Nothing panics, nothing allocates: a bad pointer becomes [`Error::OutOfMemory`]
+//! instead of a corrupt read, because the node bounds-checks every access.
+
+/// Module name every ABI import must use (the census enforces it).
+pub const ABI_MODULE: &str = "env";
+
+/// ABI version this SDK speaks.
+pub const ABI_VERSION: u32 = 1;
+
+/// Longest storage key, in bytes.
+pub const MAX_KEY_LEN: usize = 32;
+
+/// Longest storage value the ABI accepts, in bytes.
+pub const MAX_VALUE_LEN: usize = 4096;
+
+/// Longest event topic, in bytes.
+pub const MAX_TOPIC_LEN: usize = 64;
+
+/// Length of an address, in bytes.
+pub const ADDRESS_LEN: usize = 20;
+
+/// Length of an [`Amount`] in bytes (a `u128` of base units).
+pub const AMOUNT_LEN: usize = 16;
+
+/// The seven ABI functions, in the order the node publishes them.
+pub const FUNCTIONS: [&str; 7] = [
+    "storage_read",
+    "storage_write",
+    "balance",
+    "transfer",
+    "emit",
+    "hash",
+    "block_ctx",
+];
+
+/// Arity of each ABI function, in the node's order.
+pub const ARITIES: [usize; 7] = [4, 4, 3, 3, 4, 3, 2];
+
+/// A non-zero ABI status.
+///
+/// `Absent` (-9) and `UnknownField` (-10) are *statuses*, not failures: the SDK
+/// turns them into `Ok(None)`/an error only where that is the honest reading.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Error {
+    /// `-1`: a pointer/length pair pointed outside linear memory.
+    OutOfMemory,
+    /// `-2`: the key is longer than [`MAX_KEY_LEN`].
+    KeyTooLong,
+    /// `-3`: the value is longer than [`MAX_VALUE_LEN`].
+    ValueTooLong,
+    /// `-4`: the topic is longer than [`MAX_TOPIC_LEN`].
+    TopicTooLong,
+    /// `-5`: the contract tried to write outside its own namespace.
+    NotOwned,
+    /// `-6`: not enough balance.
+    InsufficientBalance,
+    /// `-7`: account arithmetic overflowed.
+    Overflow,
+    /// `-8`: the gas budget is exhausted.
+    OutOfGas,
+    /// `-11`: the receipt already holds the maximum number of events.
+    TooManyEvents,
+    /// A status the SDK does not know — the node grew a code and the contract
+    /// was built against an older SDK. Carried verbatim rather than flattened.
+    Unknown(i32),
+}
+
+impl Error {
+    /// Map a raw status code.
+    pub const fn from_code(code: i32) -> Self {
+        match code {
+            -1 => Self::OutOfMemory,
+            -2 => Self::KeyTooLong,
+            -3 => Self::ValueTooLong,
+            -4 => Self::TopicTooLong,
+            -5 => Self::NotOwned,
+            -6 => Self::InsufficientBalance,
+            -7 => Self::Overflow,
+            -8 => Self::OutOfGas,
+            -11 => Self::TooManyEvents,
+            other => Self::Unknown(other),
+        }
+    }
+
+    /// The raw status code.
+    pub const fn code(self) -> i32 {
+        match self {
+            Self::OutOfMemory => -1,
+            Self::KeyTooLong => -2,
+            Self::ValueTooLong => -3,
+            Self::TopicTooLong => -4,
+            Self::NotOwned => -5,
+            Self::InsufficientBalance => -6,
+            Self::Overflow => -7,
+            Self::OutOfGas => -8,
+            Self::TooManyEvents => -11,
+            Self::Unknown(code) => code,
+        }
+    }
+
+    /// Stable name, for logs and for the test vectors.
+    pub const fn name(self) -> &'static str {
+        match self {
+            Self::OutOfMemory => "out_of_memory",
+            Self::KeyTooLong => "key_too_long",
+            Self::ValueTooLong => "value_too_long",
+            Self::TopicTooLong => "topic_too_long",
+            Self::NotOwned => "not_owned",
+            Self::InsufficientBalance => "insufficient_balance",
+            Self::Overflow => "overflow",
+            Self::OutOfGas => "out_of_gas",
+            Self::TooManyEvents => "too_many_events",
+            Self::Unknown(_) => "unknown",
+        }
+    }
+}
+
+/// `-9`: the key is absent. Not an error — the SDK returns `Ok(None)` instead.
+const STATUS_ABSENT: i32 = -9;
+/// `-10`: unknown `block_ctx` field.
+const STATUS_UNKNOWN_FIELD: i32 = -10;
+
+// The raw imports live in one private module so a wrapper can have the same
+// human name as the node's function without colliding with the symbol.
+mod raw {
+    #[cfg(target_arch = "wasm32")]
+    #[link(wasm_import_module = "env")]
+    unsafe extern "C" {
+        pub fn storage_read(key: *const u8, key_len: usize, out: *mut u8, out_len: usize) -> i32;
+        pub fn storage_write(
+            key: *const u8,
+            key_len: usize,
+            value: *const u8,
+            value_len: usize,
+        ) -> i32;
+        pub fn balance(address: *const u8, address_len: usize, out: *mut u8) -> i32;
+        pub fn transfer(address: *const u8, address_len: usize, amount: *const u8) -> i32;
+        pub fn emit(topic: *const u8, topic_len: usize, data: *const u8, data_len: usize) -> i32;
+        pub fn hash(data: *const u8, data_len: usize, out: *mut u8) -> i32;
+        pub fn block_ctx(field: i32, out: *mut u64) -> i32;
+    }
+
+    // The host build resolves the same seven symbols to `super::mock`.
+    #[cfg(not(target_arch = "wasm32"))]
+    unsafe extern "C" {
+        pub fn storage_read(key: *const u8, key_len: usize, out: *mut u8, out_len: usize) -> i32;
+        pub fn storage_write(
+            key: *const u8,
+            key_len: usize,
+            value: *const u8,
+            value_len: usize,
+        ) -> i32;
+        pub fn balance(address: *const u8, address_len: usize, out: *mut u8) -> i32;
+        pub fn transfer(address: *const u8, address_len: usize, amount: *const u8) -> i32;
+        pub fn emit(topic: *const u8, topic_len: usize, data: *const u8, data_len: usize) -> i32;
+        pub fn hash(data: *const u8, data_len: usize, out: *mut u8) -> i32;
+        pub fn block_ctx(field: i32, out: *mut u64) -> i32;
+    }
+}
+
+fn status(code: i32) -> Result<i32, Error> {
+    if code >= 0 {
+        Ok(code)
+    } else {
+        Err(Error::from_code(code))
+    }
+}
+
+/// Read `key` into `out`. `Ok(None)` means the key is absent; `Ok(Some(n))` is
+/// the number of bytes written.
+///
+/// # Safety
+///
+/// `out` is a slice the caller owns; the node bounds-checks both it and `key`
+/// against linear memory, so a buggy pointer becomes `Err(OutOfMemory)`.
+pub fn storage_read(key: &[u8], out: &mut [u8]) -> Result<Option<usize>, Error> {
+    // SAFETY: both ranges come from live slices; the host validates them and
+    // returns -1 rather than writing out of bounds.
+    let code = unsafe { raw::storage_read(key.as_ptr(), key.len(), out.as_mut_ptr(), out.len()) };
+    match code {
+        STATUS_ABSENT => Ok(None),
+        other => status(other).map(|written| Some(written as usize)),
+    }
+}
+
+/// Write `value` under `key`. An empty `value` deletes the slot (the ABI rule).
+pub fn storage_write(key: &[u8], value: &[u8]) -> Result<(), Error> {
+    // SAFETY: as above — pointers come from slices.
+    let code = unsafe { raw::storage_write(key.as_ptr(), key.len(), value.as_ptr(), value.len()) };
+    status(code).map(|_| ())
+}
+
+/// Balance of `address`, in base units.
+pub fn balance(address: &[u8; ADDRESS_LEN]) -> Result<u128, Error> {
+    let mut out = [0u8; AMOUNT_LEN];
+    // SAFETY: the host writes exactly AMOUNT_LEN bytes into `out`.
+    let code = unsafe { raw::balance(address.as_ptr(), ADDRESS_LEN, out.as_mut_ptr()) };
+    status(code).map(|_| u128::from_le_bytes(out))
+}
+
+/// Move `amount` base units from the calling contract to `address`.
+pub fn transfer(address: &[u8; ADDRESS_LEN], amount: u128) -> Result<(), Error> {
+    let encoded = amount.to_le_bytes();
+    // SAFETY: fixed-size buffers, host-checked.
+    let code = unsafe { raw::transfer(address.as_ptr(), ADDRESS_LEN, encoded.as_ptr()) };
+    status(code).map(|_| ())
+}
+
+/// Append an event.
+pub fn emit(topic: &[u8], data: &[u8]) -> Result<(), Error> {
+    // SAFETY: pointers come from live slices; the host bounds-checks.
+    let code = unsafe { raw::emit(topic.as_ptr(), topic.len(), data.as_ptr(), data.len()) };
+    status(code).map(|_| ())
+}
+
+/// BLAKE3 of `data`, computed by the node (contracts have no hash implementation
+/// of their own — X0 bans the instruction mix that would make one portable).
+pub fn hash(data: &[u8]) -> Result<[u8; 32], Error> {
+    let mut out = [0u8; 32];
+    // SAFETY: the host writes exactly 32 bytes into `out`.
+    let code = unsafe { raw::hash(data.as_ptr(), data.len(), out.as_mut_ptr()) };
+    status(code).map(|_| out)
+}
+
+/// `block_ctx` field ids, published so a contract never passes a bare number.
+pub mod field {
+    /// Block height.
+    pub const HEIGHT: i32 = 0;
+    /// Block timestamp, milliseconds since the Unix epoch.
+    pub const TIMESTAMP_MS: i32 = 1;
+    /// ABI version the node speaks.
+    pub const ABI_VERSION: i32 = 2;
+}
+
+fn context(field: i32) -> Result<u64, Error> {
+    let mut out = 0u64;
+    // SAFETY: the host writes exactly 8 bytes into `out`.
+    let code = unsafe { raw::block_ctx(field, &mut out) };
+    match code {
+        STATUS_UNKNOWN_FIELD => Err(Error::Unknown(STATUS_UNKNOWN_FIELD)),
+        other => status(other).map(|_| out),
+    }
+}
+
+/// Height of the block this call runs in.
+///
+/// On the host build the mock returns the height the test set; on wasm it is
+/// consensus data, identical on every node.
+pub fn block_height() -> Result<u64, Error> {
+    context(field::HEIGHT)
+}
+
+/// Block timestamp in milliseconds since the Unix epoch.
+pub fn block_timestamp_ms() -> Result<u64, Error> {
+    context(field::TIMESTAMP_MS)
+}
+
+/// ABI version the node speaks — a contract can assert it was built for it.
+pub fn abi_version() -> Result<u64, Error> {
+    context(field::ABI_VERSION)
+}
+
+/// A backend that behaves like the node, for host tests.
+///
+/// It is not a simulation layer: the mock *is* reachable through the same
+/// `extern "C"` symbols, with the same status codes and the same limits, so the
+/// wrappers above are exercised exactly as they are on chain. What it does not
+/// have is gas — metering is the engine's job (X2), not the SDK's.
+#[cfg(not(target_arch = "wasm32"))]
+pub mod mock {
+    use super::{
+        ADDRESS_LEN, AMOUNT_LEN, Error, MAX_KEY_LEN, MAX_TOPIC_LEN, MAX_VALUE_LEN, STATUS_ABSENT,
+        STATUS_UNKNOWN_FIELD,
+    };
+    use std::cell::RefCell;
+    use std::collections::BTreeMap;
+
+    #[derive(Default)]
+    struct State {
+        storage: BTreeMap<Vec<u8>, Vec<u8>>,
+        balances: BTreeMap<[u8; ADDRESS_LEN], u128>,
+        events: Vec<(Vec<u8>, Vec<u8>)>,
+        height: u64,
+        timestamp_ms: u64,
+        /// The address whose balance `transfer` spends from — the contract.
+        this: [u8; ADDRESS_LEN],
+        /// Number of ABI calls made, so a test can assert "no host call happened".
+        calls: usize,
+    }
+
+    thread_local! {
+        static STATE: RefCell<State> = RefCell::new(State::default());
+    }
+
+    /// Reset the mock and set the block context.
+    pub fn reset(height: u64, timestamp_ms: u64) {
+        STATE.with(|state| {
+            let mut state = state.borrow_mut();
+            *state = State {
+                height,
+                timestamp_ms,
+                ..State::default()
+            };
+        });
+    }
+
+    /// The contract address `transfer` spends from, and `balance` is measured on.
+    pub fn set_this(address: [u8; ADDRESS_LEN]) {
+        STATE.with(|state| state.borrow_mut().this = address);
+    }
+
+    /// Give `address` a balance.
+    pub fn set_balance(address: [u8; ADDRESS_LEN], units: u128) {
+        STATE.with(|state| {
+            state.borrow_mut().balances.insert(address, units);
+        });
+    }
+
+    /// Balance of `address`, as the mock holds it.
+    pub fn balance_of(address: [u8; ADDRESS_LEN]) -> u128 {
+        STATE.with(|state| state.borrow().balances.get(&address).copied().unwrap_or(0))
+    }
+
+    /// Raw storage as the mock holds it.
+    pub fn storage() -> BTreeMap<Vec<u8>, Vec<u8>> {
+        STATE.with(|state| state.borrow().storage.clone())
+    }
+
+    /// Seed a storage slot without going through a contract.
+    pub fn seed(key: &[u8], value: &[u8]) {
+        STATE.with(|state| {
+            state
+                .borrow_mut()
+                .storage
+                .insert(key.to_vec(), value.to_vec());
+        });
+    }
+
+    /// Events emitted so far, in order.
+    pub fn events() -> Vec<(Vec<u8>, Vec<u8>)> {
+        STATE.with(|state| state.borrow().events.clone())
+    }
+
+    /// How many ABI calls the mock has served.
+    pub fn calls() -> usize {
+        STATE.with(|state| state.borrow().calls)
+    }
+
+    fn count() {
+        STATE.with(|state| state.borrow_mut().calls += 1);
+    }
+
+    /// Read `len` bytes through a raw pointer, the way the node reads linear
+    /// memory. Returns `None` for a null/huge range.
+    unsafe fn bytes<'a>(ptr: *const u8, len: usize) -> Option<&'a [u8]> {
+        if len == 0 {
+            return Some(&[]);
+        }
+        if ptr.is_null() || len > MAX_VALUE_LEN * 16 {
+            return None;
+        }
+        // SAFETY: the caller (a wrapper) passes a live slice; the length bound
+        // is the ABI's own buffer cap, mirrored here.
+        Some(unsafe { std::slice::from_raw_parts(ptr, len) })
+    }
+
+    #[unsafe(no_mangle)]
+    /// `env.storage_read`: read the value under a key into `out`.
+    ///
+    /// # Safety
+    ///
+    /// `key_ptr`/`out_ptr` must be valid for `key_len`/`out_len` bytes; the
+    /// SDK wrapper ([`storage_read`]) is the only caller and passes slices.
+    pub unsafe extern "C" fn storage_read(
+        key_ptr: *const u8,
+        key_len: usize,
+        out_ptr: *mut u8,
+        out_len: usize,
+    ) -> i32 {
+        count();
+        let Some(key) = (unsafe { bytes(key_ptr, key_len) }) else {
+            return Error::OutOfMemory.code();
+        };
+        if key.len() > MAX_KEY_LEN {
+            return Error::KeyTooLong.code();
+        }
+        STATE.with(|state| {
+            let state = state.borrow();
+            let Some(value) = state.storage.get(key) else {
+                return STATUS_ABSENT;
+            };
+            let written = value.len().min(out_len);
+            // SAFETY: `out_len` bytes are writable by contract with the caller.
+            unsafe { std::ptr::copy_nonoverlapping(value.as_ptr(), out_ptr, written) };
+            written as i32
+        })
+    }
+
+    #[unsafe(no_mangle)]
+    /// `env.storage_write`: write `value` under `key`; an empty value deletes.
+    ///
+    /// # Safety
+    ///
+    /// Pointers must be valid for their lengths; the wrapper passes slices.
+    pub unsafe extern "C" fn storage_write(
+        key_ptr: *const u8,
+        key_len: usize,
+        value_ptr: *const u8,
+        value_len: usize,
+    ) -> i32 {
+        count();
+        let (Some(key), Some(value)) = (
+            (unsafe { bytes(key_ptr, key_len) }),
+            (unsafe { bytes(value_ptr, value_len) }),
+        ) else {
+            return Error::OutOfMemory.code();
+        };
+        if key.len() > MAX_KEY_LEN {
+            return Error::KeyTooLong.code();
+        }
+        if value.len() > MAX_VALUE_LEN {
+            return Error::ValueTooLong.code();
+        }
+        STATE.with(|state| {
+            let mut state = state.borrow_mut();
+            if value.is_empty() {
+                state.storage.remove(key);
+            } else {
+                state.storage.insert(key.to_vec(), value.to_vec());
+            }
+        });
+        0
+    }
+
+    #[unsafe(no_mangle)]
+    /// `env.balance`: write an account balance into `out`.
+    ///
+    /// # Safety
+    ///
+    /// `out` must be valid for 16 bytes.
+    pub unsafe extern "C" fn balance(address: *const u8, address_len: usize, out: *mut u8) -> i32 {
+        count();
+        let Some(raw) = (unsafe { bytes(address, address_len) }) else {
+            return Error::OutOfMemory.code();
+        };
+        if raw.len() != ADDRESS_LEN {
+            return Error::OutOfMemory.code();
+        }
+        let mut address = [0u8; ADDRESS_LEN];
+        address.copy_from_slice(raw);
+        let units = balance_of(address);
+        // SAFETY: the wrapper passes a 16-byte buffer.
+        unsafe { std::ptr::copy_nonoverlapping(units.to_le_bytes().as_ptr(), out, AMOUNT_LEN) };
+        0
+    }
+
+    #[unsafe(no_mangle)]
+    /// `env.transfer`: move value from the mock's contract address.
+    ///
+    /// # Safety
+    ///
+    /// `address` must be valid for `address_len` bytes and `amount` for 16.
+    pub unsafe extern "C" fn transfer(
+        address: *const u8,
+        address_len: usize,
+        amount: *const u8,
+    ) -> i32 {
+        count();
+        let (Some(raw), Some(raw_amount)) = (
+            (unsafe { bytes(address, address_len) }),
+            (unsafe { bytes(amount, AMOUNT_LEN) }),
+        ) else {
+            return Error::OutOfMemory.code();
+        };
+        if raw.len() != ADDRESS_LEN {
+            return Error::OutOfMemory.code();
+        }
+        let mut to = [0u8; ADDRESS_LEN];
+        to.copy_from_slice(raw);
+        let mut units = [0u8; AMOUNT_LEN];
+        units.copy_from_slice(raw_amount);
+        let units = u128::from_le_bytes(units);
+        STATE.with(|state| {
+            let mut state = state.borrow_mut();
+            let this = state.this;
+            let from_balance = state.balances.get(&this).copied().unwrap_or(0);
+            if from_balance < units {
+                return Error::InsufficientBalance.code();
+            }
+            state.balances.insert(this, from_balance - units);
+            let to_balance = state.balances.get(&to).copied().unwrap_or(0);
+            let Some(next) = to_balance.checked_add(units) else {
+                return Error::Overflow.code();
+            };
+            state.balances.insert(to, next);
+            0
+        })
+    }
+
+    #[unsafe(no_mangle)]
+    /// `env.emit`: append an event.
+    ///
+    /// # Safety
+    ///
+    /// Pointers must be valid for their lengths.
+    pub unsafe extern "C" fn emit(
+        topic: *const u8,
+        topic_len: usize,
+        data: *const u8,
+        data_len: usize,
+    ) -> i32 {
+        count();
+        let (Some(topic), Some(data)) = (
+            (unsafe { bytes(topic, topic_len) }),
+            (unsafe { bytes(data, data_len) }),
+        ) else {
+            return Error::OutOfMemory.code();
+        };
+        if topic.len() > MAX_TOPIC_LEN {
+            return Error::TopicTooLong.code();
+        }
+        if data.len() > MAX_VALUE_LEN {
+            return Error::ValueTooLong.code();
+        }
+        STATE.with(|state| {
+            state
+                .borrow_mut()
+                .events
+                .push((topic.to_vec(), data.to_vec()));
+        });
+        0
+    }
+
+    #[unsafe(no_mangle)]
+    /// `env.hash`: write a stand-in digest into `out`.
+    ///
+    /// # Safety
+    ///
+    /// `out` must be valid for 32 bytes.
+    pub unsafe extern "C" fn hash(data: *const u8, data_len: usize, out: *mut u8) -> i32 {
+        count();
+        let Some(data) = (unsafe { bytes(data, data_len) }) else {
+            return Error::OutOfMemory.code();
+        };
+        // The node hashes with BLAKE3 (C3); the mock uses a documented stand-in
+        // so the SDK tests do not need the crypto crate. Any test that asserts a
+        // *digest* asserts it through the real engine, not through the mock.
+        let digest = stand_in_digest(data);
+        // SAFETY: the wrapper passes a 32-byte buffer.
+        unsafe { std::ptr::copy_nonoverlapping(digest.as_ptr(), out, 32) };
+        0
+    }
+
+    fn stand_in_digest(data: &[u8]) -> [u8; 32] {
+        let mut out = [0u8; 32];
+        let mut acc: u64 = 0xcbf2_9ce4_8422_2325;
+        for byte in data {
+            acc ^= u64::from(*byte);
+            acc = acc.wrapping_mul(0x0000_0100_0000_01b3);
+        }
+        out[..8].copy_from_slice(&acc.to_le_bytes());
+        out[8..16].copy_from_slice(&(data.len() as u64).to_le_bytes());
+        out
+    }
+
+    #[unsafe(no_mangle)]
+    /// `env.block_ctx`: write a block field into `out`.
+    ///
+    /// # Safety
+    ///
+    /// `out` must be valid and aligned for one `u64`.
+    pub unsafe extern "C" fn block_ctx(field: i32, out: *mut u64) -> i32 {
+        count();
+        let value = STATE.with(|state| {
+            let state = state.borrow();
+            match field {
+                0 => Some(state.height),
+                1 => Some(state.timestamp_ms),
+                2 => Some(u64::from(super::ABI_VERSION)),
+                _ => None,
+            }
+        });
+        match value {
+            Some(value) => {
+                // SAFETY: the wrapper passes a &mut u64.
+                unsafe { *out = value };
+                0
+            }
+            None => STATUS_UNKNOWN_FIELD,
+        }
+    }
+}
diff --git a/crates/aura-sdk/src/codec.rs b/crates/aura-sdk/src/codec.rs
new file mode 100644
index 0000000..959af2d
--- /dev/null
+++ b/crates/aura-sdk/src/codec.rs
@@ -0,0 +1,170 @@
+//! Fixed-layout value encoding for contract storage (X4).
+//!
+//! No serde, no `derive`, no tags: a value **is** its little-endian bytes, and
+//! its length is the type's length. That makes a storage slot readable by
+//! anything — the node's tests, a block explorer, another contract — without
+//! sharing a Rust type, and it makes a wrong read a detectable length error
+//! instead of silently misaligned fields.
+//!
+//! | type | bytes | note |
+//! |---|---|---|
+//! | `u8` | 1 | |
+//! | `bool` | 1 | `0` or `1`; any other byte is a decoding error |
+//! | `u16` | 2 | |
+//! | `u32` | 4 | |
+//! | `u64` | 8 | |
+//! | `u128` | 16 | the width of an `Amount` |
+//! | `i32` | 4 | |
+//! | `i64` | 8 | |
+//! | `[u8; N]` | N | raw, no length prefix |
+//!
+//! Extending this set is a **contract-visible** change: a stored value does not
+//! say which type wrote it, so a new `Codec` impl must use a new key.
+
+use crate::abi::Error;
+
+/// A value that knows its own fixed size and can round-trip through bytes.
+pub trait Codec: Sized + Copy {
+    /// Length in bytes — always this many, never variable.
+    const LEN: usize;
+
+    /// Write the value into `out`. `out.len()` is at least [`Self::LEN`].
+    fn encode_into(self, out: &mut [u8]);
+
+    /// Read the value back. `raw.len()` must be exactly [`Self::LEN`].
+    fn decode_from(raw: &[u8]) -> Result<Self, Error>;
+
+    /// Convenience: encode into a caller-owned buffer and return the prefix.
+    fn encode(self, out: &mut [u8]) -> Result<&[u8], Error> {
+        if out.len() < Self::LEN {
+            return Err(Error::ValueTooLong);
+        }
+        self.encode_into(out);
+        Ok(&out[..Self::LEN])
+    }
+}
+
+fn exact(raw: &[u8], len: usize) -> Result<(), Error> {
+    if raw.len() == len {
+        Ok(())
+    } else {
+        // A shorter or longer value means the slot was written by a different
+        // layout; refusing is the only honest answer.
+        Err(Error::ValueTooLong)
+    }
+}
+
+macro_rules! integer_codec {
+    ($type:ty, $len:expr) => {
+        impl Codec for $type {
+            const LEN: usize = $len;
+
+            fn encode_into(self, out: &mut [u8]) {
+                out[..Self::LEN].copy_from_slice(&self.to_le_bytes());
+            }
+
+            fn decode_from(raw: &[u8]) -> Result<Self, Error> {
+                exact(raw, Self::LEN)?;
+                let mut bytes = [0u8; $len];
+                bytes.copy_from_slice(raw);
+                Ok(<$type>::from_le_bytes(bytes))
+            }
+        }
+    };
+}
+
+integer_codec!(u8, 1);
+integer_codec!(u16, 2);
+integer_codec!(u32, 4);
+integer_codec!(u64, 8);
+integer_codec!(u128, 16);
+integer_codec!(i32, 4);
+integer_codec!(i64, 8);
+
+impl Codec for bool {
+    const LEN: usize = 1;
+
+    fn encode_into(self, out: &mut [u8]) {
+        out[0] = u8::from(self);
+    }
+
+    fn decode_from(raw: &[u8]) -> Result<Self, Error> {
+        exact(raw, 1)?;
+        match raw[0] {
+            0 => Ok(false),
+            1 => Ok(true),
+            // Not "truthy": a byte that is neither 0 nor 1 was not written by
+            // this codec, so it is an error.
+            _ => Err(Error::Unknown(-12)),
+        }
+    }
+}
+
+impl<const N: usize> Codec for [u8; N] {
+    const LEN: usize = N;
+
+    fn encode_into(self, out: &mut [u8]) {
+        out[..N].copy_from_slice(&self);
+    }
+
+    fn decode_from(raw: &[u8]) -> Result<Self, Error> {
+        exact(raw, N)?;
+        let mut bytes = [0u8; N];
+        bytes.copy_from_slice(raw);
+        Ok(bytes)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn integers_round_trip() {
+        let mut buf = [0u8; 16];
+        for value in [0u64, 1, u64::MAX, 0x0123_4567_89ab_cdef] {
+            let raw = value.encode(&mut buf).unwrap();
+            assert_eq!(u64::decode_from(raw), Ok(value));
+        }
+        let value = u128::MAX;
+        let raw = value.encode(&mut buf).unwrap();
+        assert_eq!(u128::decode_from(raw), Ok(value));
+    }
+
+    #[test]
+    fn length_mismatch_is_an_error() {
+        let mut buf = [0u8; 8];
+        let raw = 7u32.encode(&mut buf).unwrap();
+        assert_eq!(u32::decode_from(raw), Ok(7));
+        assert_eq!(u64::decode_from(raw), Err(Error::ValueTooLong));
+        assert_eq!(u32::decode_from(&raw[..2]), Err(Error::ValueTooLong));
+    }
+
+    #[test]
+    fn bool_rejects_non_canonical_bytes() {
+        assert_eq!(bool::decode_from(&[1]), Ok(true));
+        assert_eq!(bool::decode_from(&[0]), Ok(false));
+        assert!(bool::decode_from(&[2]).is_err());
+    }
+
+    #[test]
+    fn arrays_are_raw() {
+        let mut buf = [0u8; 32];
+        let raw = [9u8; 32].encode(&mut buf).unwrap();
+        assert_eq!(raw.len(), 32);
+        assert_eq!(<[u8; 32]>::decode_from(raw), Ok([9u8; 32]));
+    }
+
+    #[test]
+    fn encode_refuses_a_short_buffer() {
+        let mut buf = [0u8; 3];
+        assert_eq!(u64::MIN.encode(&mut buf), Err(Error::ValueTooLong));
+    }
+
+    #[test]
+    fn the_encoding_is_little_endian() {
+        let mut buf = [0u8; 8];
+        let raw = 0x0102_0304u32.encode(&mut buf).unwrap();
+        assert_eq!(raw, &[0x04, 0x03, 0x02, 0x01]);
+    }
+}
