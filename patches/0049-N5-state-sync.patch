+
+
+def refresh_sums() -> None:
+    files = [
+        EVIDENCE / name
+        for name in (
+            "gates.txt",
+            "nc.log",
+            "nc-all.log",
+            "test-n5.log",
+            "make-test.log",
+            "clean-apply.txt",
