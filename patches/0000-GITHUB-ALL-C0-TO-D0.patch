+# X7 determinism scenario — measured, not typed.
+# Written by tools/gen_x7_vectors.py from `x7-run --fixture`.
+#
+# The scenario is a pure function of one constant (`X7_SEED`), so this file is
+# the *whole* input of the gate: 4 deploys, then 1 000 transactions mixing 60%
+# ABI v1 calls, 10% native transfers, 12% ABI v3 calls with a nested call, 3%
+# calls to an address with no code and 2% calls that run out of gas.
+#
+# `expected_*` is what one node measured. The gate then replays the same input in
+# eight separate processes and requires all eight to reproduce these numbers.
+
+scenario_seed=11400714819323198485
+scenario_steps=1004
+scenario_deploys=4
+scenario_contract_calls=905
+scenario_transfers=95
+scenario_vault_calls=104
+scenario_accounts=8
+scenario_gas_limit=1000000
+scenario_starved_gas=4000
+scenario_height=1000
+scenario_timestamp_ms=1700000000000
+code_kv_size=5290
+code_kv_blake3=27e47b71bc8977e57156b9aec25985390e7e333065307b3fe7a4db51a3d361e8
+code_store_size=5187
+code_store_blake3=4daa34dab8574d991c4babcf4bd3286984a93a24545edec2559add3cc6eefc1e
+code_events_size=5033
+code_events_blake3=f968f280eb9ccec9066b5e682a83811397e7e319f0c0fafffeec4c543cda3d0e
