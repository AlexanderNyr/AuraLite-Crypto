diff --git a/standards/arc721/Cargo.toml b/standards/arc721/Cargo.toml
new file mode 100644
index 0000000..9c0fd22
--- /dev/null
+++ b/standards/arc721/Cargo.toml
@@ -0,0 +1,24 @@
+[package]
+name = "aura-standard-arc721"
+description = "ARC-721: the X5 non-fungible token standard"
+version = "0.1.0"
+edition = "2024"
+license = "MIT OR Apache-2.0"
+publish = false
+
+# A contract is its own workspace: it is built for wasm32-unknown-unknown with
+# release + LTO and it must NOT pull the node's dependency graph.
+[workspace]
+
+[dependencies]
+aura-sdk = { path = "../../crates/aura-sdk", features = ["macros"] }
+
+[lib]
+crate-type = ["cdylib", "rlib"]
+
+[profile.release]
+opt-level = "z"
+lto = true
+codegen-units = 1
+panic = "abort"
+strip = true
