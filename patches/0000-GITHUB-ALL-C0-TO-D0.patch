+    memory.extend(leb(1));
+    let mut bytes = valid();
+    bytes.extend(section(5, memory));
+    // The memory section must precede the code section, so build it in order.
+    let ordered = module(vec![
+        types(&[], &[]),
+        section(5, {
+            let mut m = leb(1);
