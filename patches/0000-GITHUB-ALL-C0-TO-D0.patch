+#[test]
+fn code_section_order() {
+    // The export section belongs after the function section; swap them.
+    let bytes = module(vec![
+        types(&[], &[]),
+        exports_run(),
+        functions(1),
+        code(vec![body(&[], &[0x0b])]),
+    ]);
+    assert_eq!(first_code(&bytes), Some("section_order"));
+}
+
+#[test]
+fn code_section_order_on_a_duplicate() {
