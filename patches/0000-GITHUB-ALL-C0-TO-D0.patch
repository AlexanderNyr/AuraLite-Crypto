+
+    /// Rebuild a tree at `version` from an ordered `[(path, value)]` set. Added
+    /// in S3 for overlay commit.
+    pub fn from_entries(version: u64, entries: &[(Hash, Vec<u8>)]) -> Self {
+        let leaves: BTreeMap<Hash, Vec<u8>> = entries
