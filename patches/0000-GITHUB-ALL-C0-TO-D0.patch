@@ -0,0 +1,33 @@
+# D0 baseline: what exists, what a node needs.
+# Written by tools/gen_d0_vectors.py; pinned by tests/d0_baseline.rs.
+phase=D0
+exit_stub=2
+exit_usage=64
+exit_no_workspace=3
+layers=13
+capabilities=9
