+        // SAFETY: the wrapper passes a live slice of at least ADDRESS_LEN bytes.
+        unsafe { std::ptr::copy_nonoverlapping(address.as_ptr(), out, ADDRESS_LEN) };
+        ADDRESS_LEN as i32
+    }
