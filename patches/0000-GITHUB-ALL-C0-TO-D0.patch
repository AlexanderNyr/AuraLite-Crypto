+    ///
+    /// The returned receipt carries the diff to commit on success. On failure
+    /// nothing is committed **and** `view` is rolled back inside the host state,
+    /// so the base tree is untouched either way (a `StateView` never mutates its
+    /// base).
+    /// # Budget
+    ///
+    /// The state view is created here with `min(call.gas_limit, limits.fuel)` so
+    /// the transaction's budget and the node's ceiling cannot disagree, and the
+    /// instruction meter is derived from that one number by the backend.
+    pub fn call(
