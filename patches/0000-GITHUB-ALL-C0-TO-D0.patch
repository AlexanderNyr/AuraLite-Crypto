+    assert_eq!(to_hex(S2_ROOT_CONTEXT), f["root_context"]);
+    assert_eq!(to_hex(S2_KEY_CONTEXT), f["key_context"]);
+    assert_eq!(to_hex(S2_HEAD_CONTEXT), f["head_context"]);
