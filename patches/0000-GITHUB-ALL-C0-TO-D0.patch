-//! `aura-exec` — deterministic WASM execution (X0 onwards).
+//! `aura-exec` — deterministic WASM execution for AuraLite-Crypto.
 //!
-//! X0 lands [`census`]: the determinism census. It parses a WASM binary,
-//! applies the restrictive configuration ([`ModuleLimits::restrictive`]) and
-//! decides whether the module *can* be deterministic — bans floats, imports,
-//! shared memory, the start section, mutable globals, SIMD/atomics/bulk ops and
-//! indirect calls, with a fail-closed opcode whitelist.
+//! Two phases live here:
 //!
-//! There is deliberately **no engine here yet**: X0 makes no runtime claim and
-//! links no VM. `wasmtime` is pinned in X1 together with fuel metering, memory
-//! ceilings and the zero-import sandbox, because fuel semantics are
-//! version-sensitive. An empty engine with a fake `Ok(())` is exactly what
-//! CONTRIBUTING.md forbids.
+//! * **X0 — [`census`]:** the static determinism census. It parses a WASM
+//!   binary, applies the restrictive configuration
+//!   ([`ModuleLimits::restrictive`]) and decides whether a module *can* be
+//!   deterministic: floats, imports, the start section, shared memory, mutable
+//!   globals, SIMD/atomics/bulk ops and indirect calls are banned, with a
+//!   fail-closed opcode whitelist.
+//! * **X1 — [`sandbox`]:** the runtime half. A module that survives the census
+//!   is compiled and instantiated by an engine with a fuel budget, a memory
+//!   ceiling, a stack ceiling and **zero host imports**, then `run` is called
+//!   once and the trap is classified into a closed set.
 //!
-//! Golden vectors: `tools/gen_x0_vectors.py` (independent Python assembler).
-//! Report: `docs/evidence/x0/report.md`.
+//! The engine is behind the [`sandbox::Engine`] trait. The default build links
+//! `wasmi` ([`wasmi_engine`]), a deterministic interpreter that builds and runs
+//! everywhere; `wasmtime` is behind the `wasmtime-engine` feature
+//! ([`wasmtime_engine`]) and is gated by its own CI job. Both are configured
+//! from the same [`SandboxLimits`], which is what makes the X7 cross-engine
+//! determinism gate meaningful.
+//!
+//! Golden vectors: `tools/gen_x0_vectors.py`, `tools/gen_x1_vectors.py`
+//! (independent Python assembler — the crate never builds its own inputs).
+//! Reports: `docs/evidence/x0/report.md`, `docs/evidence/x1/report.md`.
 
 #![forbid(unsafe_code)]
 #![deny(missing_docs)]
 
 pub mod census;
+pub mod error;
+pub mod limits;
+pub mod sandbox;
+pub mod wasmi_engine;
+
+#[cfg(feature = "wasmtime-engine")]
+pub mod wasmtime_engine;
 
 pub use census::{
     Ban, CENSUS, CensusReport, CensusRow, MAX_MEMORY_PAGES, MAX_MODULE_BYTES, MAX_TABLE_ENTRIES,
     ModuleLimits, Policy, Verdict, WASM_MAGIC, WASM_VERSION, census,
 };
+pub use error::{SandboxError, TrapKind};
+pub use limits::{DEFAULT_FUEL, DEFAULT_MAX_STACK_BYTES, DEFAULT_MAX_TRACE_EVENTS, SandboxLimits};
+pub use sandbox::{Engine, Event, Execution, Outcome, Sandbox, run, run_with_arg};
+pub use wasmi_engine::WasmiEngine;
diff --git a/crates/aura-exec/src/limits.rs b/crates/aura-exec/src/limits.rs
new file mode 100644
index 0000000..e9507ba
--- /dev/null
+++ b/crates/aura-exec/src/limits.rs
@@ -0,0 +1,97 @@
+//! Published sandbox limits and the fuel budget.
+//!
+//! These numbers are a **protocol parameter**, not a configuration knob: two
+//! nodes that disagree about the fuel budget disagree about the block. They are
+//! pinned here once, published in `docs/spec/` by the report, and any change is
+//! a phase-level decision with its own patch.
+//!
+//! [`SandboxLimits::restrictive`] is deliberately *not* derived from engine
+//! defaults — the engine is configured from these values, never the reverse.
+
+use crate::census::{MAX_MEMORY_PAGES, MAX_MODULE_BYTES, MAX_TABLE_ENTRIES};
+
+/// Fuel granted to one contract invocation in Stage 1.
+///
+/// Calibrated on the X1 fixture set: the heaviest allowed program
+/// (`sum_to_n(1000)`) consumes **13,246** fuel, so 1,000,000 leaves a 75x
+/// margin while still making an infinite loop terminate (measured: the `spin`
+/// fixture burns the whole budget and traps `out_of_fuel`).
+pub const DEFAULT_FUEL: u64 = 1_000_000;
+
+/// Engine stack ceiling in bytes. Deep recursion must trap
+/// (`trap_stack_exhausted`), not crash the node process.
+pub const DEFAULT_MAX_STACK_BYTES: usize = 512 * 1024;
+
+/// Maximum number of trace events recorded for one invocation.
+///
+/// A trace is an audit artefact, not consensus state; the cap keeps a hostile
+/// contract from allocating unbounded memory in the observer.
+pub const DEFAULT_MAX_TRACE_EVENTS: usize = 4096;
+
+/// The complete sandbox configuration.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SandboxLimits {
+    /// Fuel for one invocation (1 fuel = 1 gas until X2 refines the model).
+    pub fuel: u64,
+    /// Maximum linear-memory pages (64 KiB each).
+    pub memory_pages: u32,
+    /// Maximum table entries.
+    pub table_entries: u32,
+    /// Maximum module size in bytes (checked before the engine sees it).
+    pub module_bytes: u32,
+    /// Engine stack ceiling in bytes.
+    pub max_stack_bytes: usize,
+    /// Maximum recorded trace events.
+    pub max_trace_events: usize,
+}
+
+impl SandboxLimits {
+    /// The Stage 1 configuration. Every field is the restrictive value the X0
+    /// census already publishes, so the static gate and the runtime sandbox
+    /// cannot drift apart.
+    pub const fn restrictive() -> Self {
+        Self {
+            fuel: DEFAULT_FUEL,
+            memory_pages: MAX_MEMORY_PAGES,
+            table_entries: MAX_TABLE_ENTRIES,
+            module_bytes: MAX_MODULE_BYTES as u32,
+            max_stack_bytes: DEFAULT_MAX_STACK_BYTES,
+            max_trace_events: DEFAULT_MAX_TRACE_EVENTS,
+        }
+    }
+
+    /// Bytes of linear memory allowed (`pages * 64 KiB`).
+    pub const fn memory_bytes(&self) -> usize {
+        self.memory_pages as usize * 65_536
+    }
+
+    /// Reject configurations that are looser than the published ceiling.
+    ///
+    /// The census is the authority: a caller may tighten a limit for a test,
+    /// but a limit above `MAX_MEMORY_PAGES` / `MAX_MODULE_BYTES` would let a
+    /// module pass X0 and then be executed under a different rule.
+    pub fn validate(&self) -> Result<(), &'static str> {
+        if self.module_bytes as usize > MAX_MODULE_BYTES {
+            return Err("module_bytes above the census ceiling");
+        }
+        if self.memory_pages > MAX_MEMORY_PAGES {
+            return Err("memory_pages above the census ceiling");
+        }
+        if self.table_entries > MAX_TABLE_ENTRIES {
+            return Err("table_entries above the census ceiling");
+        }
+        if self.fuel == 0 {
+            return Err("fuel budget must be positive");
+        }
+        if self.max_stack_bytes == 0 {
+            return Err("stack ceiling must be positive");
+        }
+        Ok(())
+    }
+}
+
+impl Default for SandboxLimits {
+    fn default() -> Self {
+        Self::restrictive()
+    }
+}
diff --git a/crates/aura-exec/src/sandbox.rs b/crates/aura-exec/src/sandbox.rs
