@@ -0,0 +1,74 @@
+#!/usr/bin/env python3
+"""Record the S2 dependency delta (RocksDB + bindgen toolchain).
+
+The C3 baseline is frozen historical evidence. C8/C9 addenda live in
+`docs/spec/` and are indexed by the frozen FORMAT_INDEX.md — S2 must not add a
+file there (that would break the C10 checksum). S2 records its delta in
+`docs/evidence/s2-dependency-addendum.txt`; `tools/check_deps.py` reads both
+locations.
+
+Usage:
+    python3 tools/record_s2_deps.py
+    make record-s2-deps
+"""
+
+from __future__ import annotations
+
+import tomllib
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+LOCK = REPO / "Cargo.lock"
+OUT = REPO / "docs" / "evidence" / "s2-dependency-addendum.txt"
+
+HEADER = [
+    "# AuraLite-Crypto external dependency addendum (S2).",
+    "# Generated by tools/record_s2_deps.py from Cargo.lock.",
+    "# RocksDB is OPTIONAL (feature `rocksdb`); the default build is pure Rust.",
+    "# These crates enter Cargo.lock because of the optional dep and are",
+    "# recorded here so check_deps.py can verify exact pins + checksums.",
+    "# Native build requires the system librocksdb-dev + clang/libclang.",
+]
+
+
+def read_pairs(path: Path) -> set[tuple[str, str]]:
+    result = set()
+    for line in path.read_text(encoding="utf-8").splitlines():
+        line = line.strip()
+        if line and not line.startswith("#") and "=" in line:
+            name, version = line.split("=", 1)
+            result.add((name, version))
+    return result
+
+
+def main() -> int:
+    data = tomllib.loads(LOCK.read_text(encoding="utf-8"))
+    current = {
+        (package["name"], package["version"])
+        for package in data.get("package", [])
+        if "source" in package
+    }
+    known = read_pairs(REPO / "docs" / "spec" / "c3-dependency-allowlist.txt")
+    for path in (REPO / "docs" / "spec").glob("*-dependency-addendum.txt"):
+        known |= read_pairs(path)
+    for path in (REPO / "docs" / "evidence").glob("*-dependency-addendum.txt"):
+        if path != OUT:
+            known |= read_pairs(path)
+
+    removed = sorted(known - current)
+    if removed:
+        print(f"ERROR: allowlisted crates disappeared: {removed}")
+        return 1
+    added = sorted(current - known)
+    OUT.write_text(
+        "\n".join(HEADER + [f"{name}={version}" for name, version in added]) + "\n",
+        encoding="utf-8",
+    )
+    print(f"wrote {OUT.relative_to(REPO)} ({len(added)} crates added since S1)")
+    for name, version in added:
+        print(f"  + {name}={version}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/s2_native_env.sh b/tools/s2_native_env.sh
new file mode 100644
index 0000000..9e61b46
--- /dev/null
+++ b/tools/s2_native_env.sh
@@ -0,0 +1,33 @@
+#!/bin/sh
+# Print shell `export` lines for the OPTIONAL native RocksDB backend.
+# Sourced with eval by `make test-s2-native`. Fails loudly when the system
+# librocksdb-dev / libclang are absent instead of silently building the C++
+# library (which needs GB of RAM and is not reproducible in CI).
+set -e
+
+find_first() {
+    find /usr/lib /usr/local/lib /usr/lib/x86_64-linux-gnu -name "$1" -print -quit 2>/dev/null || true
+}
+
+rocksdb_so=$(find_first 'librocksdb.so*')
+if [ -z "$rocksdb_so" ]; then
+    echo "ERROR: librocksdb.so not found. Install librocksdb-dev (>= 9.x) and clang/libclang-dev." >&2
+    exit 1
+fi
+
+clang_so=$(find_first 'libclang.so*')
+if [ -z "$clang_so" ]; then
+    echo "ERROR: libclang.so not found. Install clang/libclang-dev." >&2
+    exit 1
+fi
+
+rocksdb_dir=$(dirname "$rocksdb_so")
+clang_dir=$(dirname "$clang_so")
+tmpdir="${TMPDIR:-/tmp}"
+
+printf 'export ROCKSDB_LIB_DIR=%s\n' "$rocksdb_dir"
+printf 'export LIBCLANG_PATH=%s\n' "$clang_dir"
+printf 'export ROCKSDB_INCLUDE_DIR=/usr/include\n'
+printf 'export LD_LIBRARY_PATH=%s${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\n' "$rocksdb_dir"
+printf 'export TMPDIR=%s\n' "$tmpdir"
+printf 'export CARGO_BUILD_JOBS=1\n'
