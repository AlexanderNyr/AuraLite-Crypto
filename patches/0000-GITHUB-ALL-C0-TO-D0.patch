+                    ExecStatus::Returned(value),
+                    Some(diff),
+                    host.view.events().to_vec(),
+                    host.writes,
+                    execution.fuel_used,
+                    host.host_gas,
+                )
+            }
+            Outcome::Returned(_) => {
+                host.rollback();
+                (
+                    ExecStatus::OutOfGas,
+                    None,
+                    host.view.events().to_vec(),
+                    host.writes,
+                    execution.fuel_used,
+                    host.host_gas,
