+code_vault_blake3=11f8fb2cce7aacff8f73c337ab66ce6160e6735468554b521e2cbaae1854c711
+expected_committed=890
+expected_refused=60
+expected_failed=54
+expected_gas=46375290
+expected_version=890
+expected_state_root=efca4222d37347ffbc3416b4bbef06eaa02fb930115c6c611a4351fad77312cb
+expected_tree_root=813b06ee47a144ca646fb4368823420cf03965d5a4d8af4ed61463e0d89d13f0
+expected_events_root=8b8e9255ec30e3c51571655514ffa21212fad98f1e4685aba9732ef89888eb60
