index 0000000..377dd55
--- /dev/null
+++ b/crates/aura-exec/src/sandbox.rs
@@ -0,0 +1,199 @@
+//! The engine-agnostic sandbox: census → compile → instantiate → run → trace.
+//!
+//! # Design
+//!
+//! The sandbox is a **pipeline with a fixed order**, and every step can only
+//! reject:
+//!
+//! 1. size check against [`SandboxLimits::module_bytes`] (before any parser);
+//! 2. the X0 determinism census (`census::census`) — floats, imports, start
+//!    section, shared memory, mutable globals, SIMD/atomics/bulk ops, indirect
+//!    calls are already gone at this point;
+//! 3. engine compile with the restrictive feature set;
+//! 4. **zero imports** — the sandbox resolves nothing, so a module that
+//!    declares any import fails here even if the census were bypassed;
+//! 5. instantiate with the store limiter and the fuel budget;
+//! 6. call `run` and convert the engine trap into the closed [`TrapKind`];
+//! 7. return an [`Execution`] with the outcome, the fuel used and the trace.
+//!
+//! # Backends
+//!
+//! [`Engine`] is a trait so that the rest of the stack never names a specific
+//! VM. The default build links **wasmi** (`wasmi_engine::WasmiEngine`), a
+//! deterministic interpreter: it builds and runs in every CI runner and on a
+//! 2 GB laptop, and it gives typed `TrapCode(OutOfFuel)` plus a call hook.
+//! `wasmtime` is available behind the `wasmtime-engine` feature
+//! (`wasmtime_engine::WasmtimeEngine`); it needs Cranelift, which does not build
+//! in 2 GB of RAM, so it is exercised by a separate CI job and by the
+//! `wasmtime_backend_agrees_on_outcomes` test (which needs swap to compile).
+//! Both backends are configured from the SAME [`SandboxLimits`] and produce the
+//! SAME [`Execution`] shape, which is what makes the X7 cross-engine
+//! determinism gate possible.
+//!
+//! # What is a claim and what is not
+//!
+//! X1 claims: a listed module runs and returns a value; an infinite loop traps
+//! `out_of_fuel`; a module with imports is refused; memory growth past the
+//! ceiling is refused; the engine does not accept floats. It does **not**
+//! claim gas prices (X2), storage ABI (X2), lifecycle (X3) or cross-engine
+//! byte-identical state roots (X7).
+
+use crate::census::{self, MAX_MODULE_BYTES, ModuleLimits};
+use crate::error::{SandboxError, TrapKind};
+use crate::limits::SandboxLimits;
+
+/// One entry in the invocation trace.
+///
+/// The trace is deterministic given (module, limit, input) for a fixed backend,
+/// which is what the X1 replay gate measures. Records are intentionally small
+/// and content-free: an event is a call into or out of WASM plus the module
+/// function index, so a divergence shows up as a differing event stream. A host
+/// call would add its own codes in X2 — in X1 there are none, by construction.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Event {
+    /// `enter` when WASM is entered, `exit` when it returns.
+    pub code: &'static str,
+    /// Module function index the engine reported.
+    pub func_index: u32,
+}
+
+/// What an invocation produced.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Outcome {
+    /// `run` returned this value.
+    Returned(i64),
+    /// `run` trapped.
+    Trap(TrapKind),
+}
+
+/// The result of one invocation.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Execution {
+    /// Return value or trap.
+    pub outcome: Outcome,
+    /// Fuel consumed (`limits.fuel - remaining`).
+    pub fuel_used: u64,
+    /// The trace, capped at `limits.max_trace_events`.
+    pub trace: Vec<Event>,
+    /// Exports of the module as `name` (sorted, deduplicated).
+    pub exports: Vec<String>,
+}
+
+impl Execution {
+    /// True when the call returned normally.
+    pub fn returned(&self, value: i64) -> bool {
+        self.outcome == Outcome::Returned(value)
+    }
+
+    /// True when the call trapped with `kind`.
+    pub fn trapped(&self, kind: TrapKind) -> bool {
+        self.outcome == Outcome::Trap(kind)
+    }
+}
+
+/// A WASM engine backend.
+pub trait Engine: core::fmt::Debug {
+    /// Identifier used in evidence (`wasmi`, `wasmtime`).
+    fn name(&self) -> &'static str;
+
+    /// Exact crate version compiled into this build.
+    fn version(&self) -> &'static str;
+
+    /// Whether this backend reports a per-call fuel/depth trace.
+    fn traces(&self) -> bool;
+
+    /// Run `wasm` under `limits`. The caller has already run the census.
+    ///
+    /// `arg` is passed to a `(i32) -> i32` `run` export; `None` selects a
+    /// `() -> i32` export. The export type decides, so a wrong call shape is an
+    /// instantiate error rather than a silent zero.
+    fn execute(
+        &self,
+        wasm: &[u8],
+        limits: &SandboxLimits,
+        arg: Option<i32>,
+    ) -> Result<Execution, SandboxError>;
+}
+
+/// A sandbox bound to one engine implementation.
+pub struct Sandbox<E: Engine = crate::wasmi_engine::WasmiEngine> {
+    limits: SandboxLimits,
+    engine: E,
+}
+
+impl Sandbox<crate::wasmi_engine::WasmiEngine> {
+    /// The default sandbox: Stage 1 limits on the default (wasmi) backend.
+    pub fn new() -> Self {
+        Self::with_limits(SandboxLimits::restrictive())
+            .expect("SandboxLimits::restrictive() is valid by construction")
+    }
+
+    /// The default backend with explicit limits (tests tighten one limit).
+    pub fn with_limits(limits: SandboxLimits) -> Result<Self, SandboxError> {
+        Self::with(limits, crate::wasmi_engine::WasmiEngine)
+    }
+}
+
+impl Default for Sandbox<crate::wasmi_engine::WasmiEngine> {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl<E: Engine> Sandbox<E> {
+    /// Build a sandbox with explicit limits and an explicit backend.
+    pub fn with(limits: SandboxLimits, engine: E) -> Result<Self, SandboxError> {
+        limits.validate().map_err(SandboxError::Limit)?;
+        Ok(Self { limits, engine })
+    }
+
+    /// The limits in force.
+    pub fn limits(&self) -> &SandboxLimits {
+        &self.limits
+    }
+
+    /// The backend in force.
+    pub fn engine(&self) -> &E {
+        &self.engine
+    }
+
+    /// Full pipeline: size → census → compile → imports → run.
+    ///
+    /// `arg` is passed to an exported `run` of type `(i32) -> i32`; pass
+    /// `None` for a `() -> i32` entry point. Which one is used is decided by
+    /// the module's actual export type, not by a flag, so a wrong call shape
+    /// cannot be silently accepted.
+    pub fn execute(&self, wasm: &[u8], arg: Option<i32>) -> Result<Execution, SandboxError> {
+        self.gate(wasm)?;
+        self.engine.execute(wasm, &self.limits, arg)
+    }
+
+    /// The static half of the pipeline, exposed so that a deploy path (X3) can
+    /// validate without executing.
+    pub fn gate(&self, wasm: &[u8]) -> Result<(), SandboxError> {
+        if wasm.len() > self.limits.module_bytes as usize {
+            return Err(SandboxError::Limit("module_bytes"));
+        }
+        if wasm.len() > MAX_MODULE_BYTES {
+            return Err(SandboxError::Censored(census::Ban::ModuleTooLarge(
+                wasm.len(),
+            )));
+        }
+        let census_limits = ModuleLimits::restrictive();
+        let report = census::census(wasm, &census_limits);
+        if let Some(ban) = report.ban() {
+            return Err(SandboxError::Censored(ban.clone()));
+        }
+        Ok(())
+    }
+}
+
+/// Run `wasm` once with the Stage 1 configuration on the default backend.
+pub fn run(wasm: &[u8]) -> Result<Execution, SandboxError> {
+    Sandbox::new().execute(wasm, None)
+}
+
+/// Run `wasm` once with an `i32` argument on the default backend.
+pub fn run_with_arg(wasm: &[u8], arg: i32) -> Result<Execution, SandboxError> {
+    Sandbox::new().execute(wasm, Some(arg))
+}
diff --git a/crates/aura-exec/src/wasmi_engine.rs b/crates/aura-exec/src/wasmi_engine.rs
new file mode 100644
index 0000000..5f3ac15
--- /dev/null
+++ b/crates/aura-exec/src/wasmi_engine.rs
@@ -0,0 +1,227 @@
+//! wasmi backend — the default engine.
+//!
+//! `wasmi` is a deterministic interpreter, and that is the point: the same
+//! bytes produce the same result on every OS and CPU, with no JIT, no signal
+//! handlers and no address-space tricks. It also builds in ~20 s, so every gate
+//! in `make test` really runs the sandbox instead of skipping it (measured on
+//! this repository: `wasmtime`'s Cranelift codegen does not fit in a 2 GB
+//! sandbox and is a separate CI job).
+//!
+//! The configuration below mirrors [`crate::census::CENSUS`] one row at a time:
+//! floats off, mutable globals off, bulk memory off, reference types off, tail
+//! calls off, multi-memory off, start functions off, strict enforced limits,
+//! fuel on. The feature is enabled with `default-features = false` +
+//! `deterministic` + `std` (see `Cargo.toml`), so SIMD is not even compiled in.
+
+use wasmi::{
+    CallHook, Config, EnforcedLimits, Engine as WasmiCore, Instance, Linker, Module, Store,
+    StoreLimits, StoreLimitsBuilder, TrapCode,
+};
+
+use crate::error::{SandboxError, TrapKind};
+use crate::limits::SandboxLimits;
+use crate::sandbox::{Engine, Event, Execution, Outcome};
+
+/// Exact `wasmi` version pinned in `Cargo.lock`.
+pub const WASMI_VERSION: &str = "2.0.0";
+
+/// Store data: the resource limiter plus the trace buffer.
+struct State {
+    limits: StoreLimits,
+    fuel_total: u64,
+    max_trace: usize,
+    trace: Vec<Event>,
+}
+
+impl State {
+    fn new(limits: &SandboxLimits) -> Self {
+        Self {
+            limits: StoreLimitsBuilder::new()
+                .memory_size(limits.memory_bytes())
+                .table_elements(limits.table_entries as usize)
+                .instances(1)
+                .memories(1)
+                .tables(1)
+                .trap_on_grow_failure(true)
+                .build(),
+            fuel_total: limits.fuel,
+            max_trace: limits.max_trace_events,
+            trace: Vec::new(),
+        }
+    }
+}
+
+fn record(state: &mut State, code: &'static str, func_index: u32) {
+    if state.trace.len() < state.max_trace {
+        state.trace.push(Event { code, func_index });
+    }
+}
+
+fn map_trap(code: TrapCode) -> TrapKind {
+    match code {
+        TrapCode::OutOfFuel => TrapKind::OutOfFuel,
+        TrapCode::UnreachableCodeReached => TrapKind::Unreachable,
+        TrapCode::MemoryOutOfBounds => TrapKind::MemoryOutOfBounds,
+        TrapCode::IntegerDivisionByZero | TrapCode::IntegerOverflow => {
+            TrapKind::IntegerDivideByZero
+        }
+        TrapCode::StackOverflow => TrapKind::StackExhausted,
+        _ => TrapKind::Other,
+    }
+}
+
+fn engine_config(limits: &SandboxLimits) -> Config {
+    let mut config = Config::default();
+    config
+        // determinism: no floats anywhere, no threads, no bulk helpers
+        .floats(false)
+        .wasm_mutable_global(false)
+        .wasm_bulk_memory(false)
+        .wasm_reference_types(false)
+        .wasm_tail_call(false)
+        .wasm_multi_memory(false)
+        .wasm_extended_const(false)
+        .wasm_sign_extension(true)
+        .wasm_saturating_float_to_int(false)
+        .wasm_multi_value(true)
+        // no implicit execution: a start function is a census ban anyway
+        .allow_start_fn(false)
+        // strict engine-side limits, plus our own numbers
+        .enforced_limits(EnforcedLimits::strict())
+        .consume_fuel(true)
+        .set_max_stack_height(limits.max_stack_bytes.max(64 * 1024));
+    config
+}
+
+/// The default backend.
+#[derive(Debug, Default, Clone, Copy)]
+pub struct WasmiEngine;
+
+impl WasmiEngine {
+    /// Build the engine for `limits` (validated by the sandbox before this).
+    pub fn new() -> Self {
+        Self
+    }
+}
+
+impl Engine for WasmiEngine {
+    fn name(&self) -> &'static str {
+        "wasmi"
+    }
+
+    fn version(&self) -> &'static str {
+        WASMI_VERSION
+    }
+
+    fn traces(&self) -> bool {
+        true
+    }
+
+    fn execute(
+        &self,
+        wasm: &[u8],
+        limits: &SandboxLimits,
+        arg: Option<i32>,
+    ) -> Result<Execution, SandboxError> {
+        let engine = WasmiCore::new(&engine_config(limits));
+        let module = Module::new(&engine, wasm).map_err(SandboxError::compile)?;
+
+        let imports = module.imports().count();
+        if imports > 0 {
+            let first = module
+                .imports()
+                .next()
+                .map(|import| format!("{}.{}", import.module(), import.name()));
+            return Err(SandboxError::ImportsNotAllowed {
+                count: imports,
+                first,
+            });
+        }
+
+        let mut exports: Vec<String> = Vec::new();
+        let mut run_params: Option<usize> = None;
+        for export in module.exports() {
+            exports.push(export.name().to_string());
+            if export.name() == "run"
+                && let wasmi::ExternType::Func(func) = export.ty()
+            {
+                run_params = Some(func.params().len());
+            }
+        }
+        exports.sort();
+        exports.dedup();
+        match run_params {
+            Some(0) | Some(1) => {}
+            Some(_) => return Err(SandboxError::Limit("run_arity")),
+            None => {
+                return Err(SandboxError::instantiate(
+                    "module does not export a `run` function",
+                ));
+            }
+        }
+
+        let mut store = Store::new(&engine, State::new(limits));
+        store.limiter(|state: &mut State| &mut state.limits);
+        store
+            .set_fuel(limits.fuel)
+            .map_err(SandboxError::instantiate)?;
+        store.call_hook(|state: &mut State, hook: CallHook| {
+            // `wasmi` 2.0 reports the *kind* of transition, not the function
+            // index. The sequence is still exact and comparable, which is what
+            // the replay gate needs; X2 adds the host side with its own codes.
+            match hook {
+                CallHook::CallingWasm => record(state, "enter", state.trace.len() as u32),
+                CallHook::ReturningFromWasm => record(state, "exit", state.trace.len() as u32),
+                CallHook::CallingHost | CallHook::ReturningFromHost => {
+                    // Unreachable in X1 (zero imports), kept explicit so a
+                    // future host ABI cannot slip in unnoticed.
+                    record(state, "host", state.trace.len() as u32);
+                }
+            }
+            Ok(())
+        });
+
+        let linker: Linker<State> = Linker::new(&engine);
+        let instance: Instance = linker
+            .instantiate_and_start(&mut store, &module)
+            .map_err(SandboxError::instantiate)?;
+
+        let outcome = match call_entry(&mut store, &instance, arg, run_params == Some(1)) {
+            Ok(value) => Outcome::Returned(i64::from(value)),
+            Err(err) => match err.as_trap_code() {
+                Some(code) => Outcome::Trap(map_trap(code)),
+                None => return Err(SandboxError::instantiate(err)),
+            },
+        };
+
+        let remaining = store.get_fuel().map_err(SandboxError::instantiate)?;
+        let state = store.into_data();
+        let fuel_used = state.fuel_total.saturating_sub(remaining);
+        Ok(Execution {
+            outcome,
+            fuel_used,
+            trace: state.trace,
+            exports,
+        })
+    }
+}
+
+/// Call the module's `run` entry point.
+///
+/// The export type decides the call shape: `(i32) -> i32` when the function
+/// takes a parameter, `() -> i32` otherwise. An export that is missing or has a
+/// different signature is an instantiate error, never a silent success.
+fn call_entry(
+    store: &mut Store<State>,
+    instance: &Instance,
+    arg: Option<i32>,
+    takes_arg: bool,
+) -> Result<i32, wasmi::Error> {
+    if takes_arg {
+        let func = instance.get_typed_func::<i32, i32>(&*store, "run")?;
+        func.call(store, arg.unwrap_or(0))
+    } else {
+        let func = instance.get_typed_func::<(), i32>(&*store, "run")?;
+        func.call(store, ())
+    }
+}
