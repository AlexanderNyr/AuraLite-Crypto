+//! Block validation errors.
+
+use std::fmt;
+
+use aura_codec::CodecError;
+use aura_tx::TxError;
+use aura_types::Hash;
+
+/// Every reason a block can be rejected before execution.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum BlockError {
+    /// Header `version` is not [`aura_types::PROTOCOL_VERSION`]. Tuple is
+    /// `(expected, got)`.
+    UnsupportedProtocolVersion(u32, u32),
+    /// The block chain-id does not match the chain we validate for.
+    /// Tuple is `(expected, got)`.
+    WrongChain(String, String),
+    /// Body has more than [`crate::MAX_BLOCK_TXS`] transactions.
+    TooManyTransactions(usize),
+    /// The QC blob exceeds [`crate::MAX_QC_BYTES`].
+    QcTooLarge(usize),
+    /// Two transactions share the same `(signer, nonce)` key.
+    DuplicateTxKey,
+    /// Body is not sorted by `(signer, nonce)`.
+    UnsortedTransactions,
+    /// `tx_root` does not match the Merkle root of the body. Tuple is
+    /// `(computed, declared)`.
+    TxRootMismatch(Hash, Hash),
+    /// A transaction in the body failed validation.
+    InvalidTransaction(TxError),
+    /// Canonical decoding failed (structural).
+    Decode(CodecError),
+}
+
+impl fmt::Display for BlockError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::UnsupportedProtocolVersion(expected, got) => {
+                write!(f, "unsupported protocol version {got}, expected {expected}")
+            }
+            Self::WrongChain(expected, got) => {
+                write!(f, "block chain '{got}' is not '{expected}'")
+            }
+            Self::TooManyTransactions(n) => write!(f, "body has {n} transactions, over the limit"),
+            Self::QcTooLarge(n) => write!(f, "QC blob of {n} bytes exceeds the limit"),
+            Self::DuplicateTxKey => f.write_str("duplicate (signer, nonce) in block body"),
+            Self::UnsortedTransactions => {
+                f.write_str("body is not canonically sorted by (signer, nonce)")
+            }
+            Self::TxRootMismatch(computed, declared) => {
+                write!(
+                    f,
+                    "tx_root mismatch: computed {}, declared {}",
+                    computed, declared
+                )
+            }
+            Self::InvalidTransaction(error) => write!(f, "invalid transaction: {error}"),
+            Self::Decode(error) => write!(f, "canonical decode failed: {error}"),
+        }
+    }
+}
+
+impl std::error::Error for BlockError {}
+
+impl From<CodecError> for BlockError {
+    fn from(error: CodecError) -> Self {
+        BlockError::Decode(error)
+    }
+}
+
+impl From<TxError> for BlockError {
+    fn from(error: TxError) -> Self {
+        BlockError::InvalidTransaction(error)
+    }
+}
diff --git a/crates/aura-block/src/header.rs b/crates/aura-block/src/header.rs
new file mode 100644
index 0000000..bcea3df
--- /dev/null
+++ b/crates/aura-block/src/header.rs
@@ -0,0 +1,144 @@
+//! Block header: fields, encoding and `block_hash`.
+
+use aura_codec::{CodecError, Decode, Encode, Reader, Writer, encode_to_bytes};
+use aura_crypto::hash_domain;
+use aura_types::{Address, Amount, ChainId, Domain, Gas, Hash, Height};
+
+/// Extra context inside the `block_hash` payload, before the header bytes.
+///
+/// NC target: `tools/nc_c5.py` changes this constant and requires the C5
+/// block-hash vectors to go red.
+pub const BLOCK_HASH_PAYLOAD_CONTEXT: &[u8] = b"AuraLite-Crypto/block-hash-v1\x00";
+
+/// Maximum length of the opaque QC blob.
+pub const MAX_QC_BYTES: usize = 65_536;
+
+/// Everything the caller supplies for a header.
+///
+/// `tx_root` is deliberately **absent**: it is always derived from the body
+/// by [`crate::Block::new`], so it cannot be forged at construction time.
+/// `version` is included so a caller can construct a wrong-version header for
+/// tests; real blocks use [`aura_types::PROTOCOL_VERSION`].
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct HeaderParams {
+    /// Protocol version.
+    pub version: u32,
+    /// Chain this block belongs to.
+    pub chain_id: ChainId,
+    /// Block height.
+    pub height: Height,
+    /// Hash of the parent header.
+    pub parent_hash: Hash,
+    /// State root, supplied by the state layer (S1; not yet implemented).
+    pub state_root: Hash,
+    /// Validator-set hash, supplied by consensus (B phases; not yet implemented).
+    pub validator_set_hash: Hash,
+    /// Consensus timestamp in milliseconds — never `SystemTime::now()`.
+    pub timestamp_ms: u64,
+    /// Block proposer.
+    pub proposer: Address,
+    /// Opaque quorum certificate bytes; `None` for genesis-like blocks.
+    pub qc: Option<Vec<u8>>,
+    /// Gas consumed by the block.
+    pub gas_used: Gas,
+    /// Base fee for the block.
+    pub base_fee: Amount,
+}
+
+/// A block header. Field order below **is** the wire order.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Header {
+    /// Protocol version.
+    pub version: u32,
+    /// Chain this block belongs to (block-level replay separation).
+    pub chain_id: ChainId,
+    /// Block height.
+    pub height: Height,
+    /// Hash of the parent header.
+    pub parent_hash: Hash,
+    /// Binary Merkle root of the body's txids.
+    pub tx_root: Hash,
+    /// State root.
+    pub state_root: Hash,
+    /// Validator-set hash.
+    pub validator_set_hash: Hash,
+    /// Consensus timestamp in milliseconds.
+    pub timestamp_ms: u64,
+    /// Block proposer.
+    pub proposer: Address,
+    /// Opaque quorum certificate bytes.
+    pub qc: Option<Vec<u8>>,
+    /// Gas consumed by the block.
+    pub gas_used: Gas,
+    /// Base fee for the block.
+    pub base_fee: Amount,
+}
+
+impl Header {
+    /// Build a header from caller params and a computed `tx_root`.
+    pub fn from_params(params: HeaderParams, tx_root: Hash) -> Self {
+        Header {
+            version: params.version,
+            chain_id: params.chain_id,
+            height: params.height,
+            parent_hash: params.parent_hash,
+            tx_root,
+            state_root: params.state_root,
+            validator_set_hash: params.validator_set_hash,
+            timestamp_ms: params.timestamp_ms,
+            proposer: params.proposer,
+            qc: params.qc,
+            gas_used: params.gas_used,
+            base_fee: params.base_fee,
+        }
+    }
+
+    /// Hash of this header: the block id.
+    ///
+    /// `hash_domain(chain_id, Domain::Block,
+    /// BLOCK_HASH_PAYLOAD_CONTEXT || canonical(header))`. The body is not
+    /// included directly; `tx_root` commits to it.
+    pub fn block_hash(&self) -> Hash {
+        let encoded = encode_to_bytes(self);
+        let mut payload = Vec::with_capacity(BLOCK_HASH_PAYLOAD_CONTEXT.len() + encoded.len());
+        payload.extend_from_slice(BLOCK_HASH_PAYLOAD_CONTEXT);
+        payload.extend_from_slice(&encoded);
+        hash_domain(self.chain_id.as_str(), Domain::Block, &payload)
+    }
+}
+
+impl Encode for Header {
+    fn encode(&self, writer: &mut Writer) {
+        self.version.encode(writer);
+        self.chain_id.encode(writer);
+        self.height.encode(writer);
+        self.parent_hash.encode(writer);
+        self.tx_root.encode(writer);
+        self.state_root.encode(writer);
+        self.validator_set_hash.encode(writer);
+        self.timestamp_ms.encode(writer);
+        self.proposer.encode(writer);
+        self.qc.encode(writer);
+        self.gas_used.encode(writer);
+        self.base_fee.encode(writer);
+    }
+}
+
+impl Decode for Header {
+    fn decode(reader: &mut Reader<'_>) -> Result<Self, CodecError> {
+        Ok(Header {
+            version: u32::decode(reader)?,
+            chain_id: ChainId::decode(reader)?,
+            height: Height::decode(reader)?,
+            parent_hash: Hash::decode(reader)?,
+            tx_root: Hash::decode(reader)?,
+            state_root: Hash::decode(reader)?,
+            validator_set_hash: Hash::decode(reader)?,
+            timestamp_ms: u64::decode(reader)?,
+            proposer: Address::decode(reader)?,
+            qc: Option::<Vec<u8>>::decode(reader)?,
+            gas_used: Gas::decode(reader)?,
+            base_fee: Amount::decode(reader)?,
+        })
+    }
+}
diff --git a/crates/aura-block/src/lib.rs b/crates/aura-block/src/lib.rs
new file mode 100644
index 0000000..00581f9
--- /dev/null
+++ b/crates/aura-block/src/lib.rs
@@ -0,0 +1,36 @@
+//! AuraLite-Crypto block and header format (C5).
+//!
+//! `Block = Header || Body`. The header carries the protocol version, the
+//! chain-id, the height, the parent hash, three roots (`tx_root`,
+//! `state_root`, `validator_set_hash`), a consensus timestamp, the proposer,
+//! an opaque QC, gas used and the base fee. The body is a canonically sorted
+//! list of [`aura_tx::Tx`].
+//!
+//! [`Block::block_hash`] hashes the **header only** (the `tx_root` commits to
+//! the body), with chain-id and `Domain::Block` separation from C3.
+//! [`compute_tx_root`] is a binary BLAKE3 Merkle root over txids; C6 adds
+//! proofs over exactly this tree.
+//!
+//! `state_root`, `validator_set_hash` and `qc` are **supplied by the caller**
+//! at C5: state (S1), validator sets (B phases) and quorum certificates
+//! (B phase) are not implemented yet. C5 fixes their wire representation and
+//! their validation, not their computation. Honest placeholders, not fake
+//! values.
+//!
+//! Full byte-level specification: `docs/spec/block-format.md`.
+//! Golden vectors: `tools/gen_c5_vectors.py` (independent Python).
+
+#![forbid(unsafe_code)]
+#![deny(missing_docs)]
+
+mod block;
+mod body;
+mod error;
+mod header;
+mod merkle;
+
+pub use block::Block;
+pub use body::{Body, MAX_BLOCK_TXS};
+pub use error::BlockError;
+pub use header::{BLOCK_HASH_PAYLOAD_CONTEXT, Header, HeaderParams, MAX_QC_BYTES};
+pub use merkle::{LEAF_CONTEXT, NODE_CONTEXT, compute_tx_root, leaf_hash, node_hash};
diff --git a/crates/aura-block/src/merkle.rs b/crates/aura-block/src/merkle.rs
new file mode 100644
index 0000000..91defba
--- /dev/null
+++ b/crates/aura-block/src/merkle.rs
@@ -0,0 +1,62 @@
+//! Binary BLAKE3 Merkle root over transaction ids.
+//!
+//! C5 fixes the tree shape; C6 adds proof generation and verification over
+//! exactly these leaves and nodes.
+
+use aura_crypto::blake3_hash;
+use aura_tx::Tx;
+use aura_types::Hash;
+
+/// Domain tag for a leaf hash.
+///
+/// NC target: `tools/nc_c5.py` changes this constant and requires the C5
+/// golden vectors to go red.
+pub const LEAF_CONTEXT: &[u8] = b"AuraLite-Crypto/tx-leaf-v1\x00";
+
+/// Domain tag for an internal node hash.
+///
+/// NC target: `tools/nc_c5.py` changes this constant and requires the C5
+/// golden vectors to go red.
+pub const NODE_CONTEXT: &[u8] = b"AuraLite-Crypto/tx-node-v1\x00";
+
+/// Hash one leaf: `BLAKE3(LEAF_CONTEXT || txid)`.
+pub fn leaf_hash(txid: &Hash) -> Hash {
+    let mut input = Vec::with_capacity(LEAF_CONTEXT.len() + 32);
+    input.extend_from_slice(LEAF_CONTEXT);
+    input.extend_from_slice(txid.as_bytes());
+    blake3_hash(&input)
+}
+
+/// Hash one internal node: `BLAKE3(NODE_CONTEXT || left || right)`.
+pub fn node_hash(left: &Hash, right: &Hash) -> Hash {
+    let mut input = Vec::with_capacity(NODE_CONTEXT.len() + 64);
+    input.extend_from_slice(NODE_CONTEXT);
+    input.extend_from_slice(left.as_bytes());
+    input.extend_from_slice(right.as_bytes());
+    blake3_hash(&input)
+}
+
+/// Compute the `tx_root` for an ordered slice of transactions.
+///
+/// Rules: an empty body yields [`Hash::ZERO`]; a single leaf is the root; at
+/// each level an odd final node is duplicated before pairing. The result is
+/// order-sensitive — that is the C5 DoD property.
+pub fn compute_tx_root(txs: &[Tx]) -> Hash {
+    if txs.is_empty() {
+        return Hash::ZERO;
+    }
+    let mut level: Vec<Hash> = txs.iter().map(|tx| leaf_hash(&tx.txid())).collect();
+    while level.len() > 1 {
+        if level.len() % 2 == 1 {
+            let last = *level.last().expect("non-empty level");
+            level.push(last);
+        }
+        level = level
+            .as_chunks::<2>()
+            .0
+            .iter()
+            .map(|pair| node_hash(&pair[0], &pair[1]))
+            .collect();
+    }
+    level[0]
+}
diff --git a/crates/aura-block/tests/c5_block.rs b/crates/aura-block/tests/c5_block.rs
new file mode 100644
index 0000000..120f8a8
--- /dev/null
+++ b/crates/aura-block/tests/c5_block.rs
@@ -0,0 +1,356 @@
+//! C5 gate: block/header format against an independent Python encoder.
+//!
+//! `fixtures/c5_golden.txt` comes from `tools/gen_c5_vectors.py`, which
+//! self-checks pure-Python BLAKE3 against official vectors and reuses the
+//! committed C4 transaction vectors as block bodies.
+
+use std::collections::BTreeMap;
+
+use aura_block::{
+    BLOCK_HASH_PAYLOAD_CONTEXT, Block, BlockError, Body, HeaderParams, LEAF_CONTEXT, MAX_BLOCK_TXS,
+    MAX_QC_BYTES, NODE_CONTEXT, compute_tx_root, leaf_hash, node_hash,
+};
+use aura_codec::{CodecError, encode_to_bytes};
+use aura_tx::Tx;
+use aura_types::{Address, Amount, CHAIN_ID, ChainId, Gas, Hash, Height, PROTOCOL_VERSION};
+
+const GOLDEN: &str = include_str!("fixtures/c5_golden.txt");
+const C4_GOLDEN: &str = include_str!("../../aura-tx/tests/fixtures/c4_golden.txt");
+
+fn parse(text: &str) -> BTreeMap<String, String> {
+    let mut map = BTreeMap::new();
+    for line in text.lines() {
+        let trimmed = line.trim();
+        if trimmed.is_empty() || trimmed.starts_with('#') {
+            continue;
+        }
+        let (key, value) = trimmed
+            .split_once('=')
+            .unwrap_or_else(|| panic!("malformed golden line: {trimmed}"));
+        assert!(
+            map.insert(key.to_owned(), value.to_owned()).is_none(),
+            "duplicate golden key {key}"
+        );
+    }
+    map
+}
+
+fn hx(text: &str) -> Vec<u8> {
+    assert_eq!(text.len() % 2, 0, "even-length hex");
+    text.as_bytes()
+        .chunks(2)
+        .map(|pair| (nibble(pair[0]) << 4) | nibble(pair[1]))
+        .collect()
+}
+
+fn nibble(byte: u8) -> u8 {
+    match byte {
+        b'0'..=b'9' => byte - b'0',
+        b'a'..=b'f' => byte - b'a' + 10,
+        _ => panic!("invalid hex nibble in fixture"),
+    }
+}
+
+fn to_hex(bytes: &[u8]) -> String {
+    let mut out = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        out.push_str(&format!("{byte:02x}"));
+    }
+    out
+}
+
+fn hash32(text: &str) -> Hash {
+    Hash::from_slice(&hx(text)).expect("32-byte hash")
+}
+
+fn c4_tx(index: usize) -> Tx {
+    let f = parse(C4_GOLDEN);
+    Tx::from_canonical_bytes(&hx(&f[&format!("tx{index}_bytes")]))
+        .unwrap_or_else(|e| panic!("tx{index} decode: {e}"))
+}
+
+fn header_params(g: &BTreeMap<String, String>, index: usize) -> HeaderParams {
+    let k = |key: &str| g[&format!("b{index}_{key}")].clone();
+    let qc = if k("qc_present") == "1" {
+        Some(hx(&k("qc")))
+    } else {
+        None
+    };
+    HeaderParams {
+        version: k("version").parse().expect("u32"),
+        chain_id: ChainId::new(&k("chain")).expect("valid chain-id"),
+        height: Height::new(k("height").parse().expect("u64")),
+        parent_hash: hash32(&k("parent")),
+        state_root: hash32(&k("state_root")),
+        validator_set_hash: hash32(&k("validator_set_hash")),
+        timestamp_ms: k("timestamp_ms").parse().expect("u64"),
+        proposer: Address::from_slice(&hx(&k("proposer"))).expect("20-byte address"),
+        qc,
+        gas_used: Gas::new(k("gas_used").parse().expect("u64")),
+        base_fee: Amount::from_units(k("base_fee").parse().expect("u128")),
+    }
+}
+
+fn build(g: &BTreeMap<String, String>, index: usize) -> Block {
+    let ids: Vec<usize> = g[&format!("b{index}_tx_ids")]
+        .split(',')
+        .filter(|item| !item.is_empty())
+        .map(|item| item.parse().expect("tx index"))
+        .collect();
+    let txs: Vec<Tx> = ids.into_iter().map(c4_tx).collect();
+    Block::new(header_params(g, index), txs).expect("valid block")
+}
+
+#[test]
+fn constants_are_pinned_by_the_independent_fixture() {
+    let f = parse(GOLDEN);
+    assert_eq!(to_hex(LEAF_CONTEXT), f["leaf_context"]);
+    assert_eq!(to_hex(NODE_CONTEXT), f["node_context"]);
+    assert_eq!(
+        to_hex(BLOCK_HASH_PAYLOAD_CONTEXT),
+        f["block_hash_payload_context"]
+    );
+    assert_eq!(MAX_BLOCK_TXS.to_string(), f["max_block_txs"]);
+    assert_eq!(MAX_QC_BYTES.to_string(), f["max_qc_bytes"]);
+    assert_eq!(PROTOCOL_VERSION.to_string(), f["protocol_version"]);
+    assert_eq!(CHAIN_ID, f["chain_id"]);
+}
+
+#[test]
+fn golden_blocks_match_the_independent_encoder() {
+    let f = parse(GOLDEN);
+    for index in 1..=4 {
+        let block = build(&f, index);
+        assert_eq!(
+            to_hex(&encode_to_bytes(&block.header)),
+            f[&format!("b{index}_header")]
+        );
+        assert_eq!(
+            to_hex(&encode_to_bytes(&block.body)),
+            f[&format!("b{index}_body")]
+        );
+        assert_eq!(to_hex(&block.to_bytes()), f[&format!("b{index}_bytes")]);
+        assert_eq!(
+            block.header.tx_root.to_hex(),
+            f[&format!("b{index}_tx_root")]
+        );
+        assert_eq!(
+            block.body.tx_root().to_hex(),
+            f[&format!("b{index}_tx_root")]
+        );
+        assert_eq!(
+            block.block_hash().to_hex(),
+            f[&format!("b{index}_block_hash")]
+        );
+
+        let decoded = Block::from_canonical_bytes(&hx(&f[&format!("b{index}_bytes")]))
+            .unwrap_or_else(|e| panic!("b{index} decode: {e}"));
+        assert_eq!(decoded, block, "b{index} canonical round-trip");
+        assert_eq!(
+            decoded.block_hash().to_hex(),
+            f[&format!("b{index}_block_hash")]
+        );
+        assert!(block.validate(CHAIN_ID).is_ok(), "b{index} validates");
+    }
+    // b2 really is the child of b1.
+    assert_eq!(f["b2_parent"], f["b1_block_hash"]);
+}
+
+#[test]
+fn changing_tx_order_changes_tx_root() {
+    let f = parse(GOLDEN);
+    assert_ne!(f["tx_root_forward"], f["tx_root_backward"]);
+    let first = c4_tx(1);
+    let second = c4_tx(2);
+    let forward = compute_tx_root(&[first.clone(), second.clone()]);
+    let backward = compute_tx_root(&[second, first]);
+    assert_eq!(forward.to_hex(), f["tx_root_forward"]);
+    assert_eq!(backward.to_hex(), f["tx_root_backward"]);
+    assert_ne!(forward, backward);
+}
+
+#[test]
+fn merkle_tree_shape_is_pinned() {
+    assert_eq!(compute_tx_root(&[]), Hash::ZERO, "empty body -> zero root");
+
+    let single = c4_tx(4);
+    assert_eq!(
+        compute_tx_root(std::slice::from_ref(&single)),
+        leaf_hash(&single.txid()),
+        "one leaf is the root"
+    );
+
+    // Three leaves: odd final node is duplicated at the second level.
+    let a = c4_tx(1);
+    let b = c4_tx(2);
+    let c = c4_tx(5);
+    let la = leaf_hash(&a.txid());
+    let lb = leaf_hash(&b.txid());
+    let lc = leaf_hash(&c.txid());
+    let expected = node_hash(&node_hash(&la, &lb), &node_hash(&lc, &lc));
+    assert_eq!(compute_tx_root(&[a, b, c]), expected);
+}
+
+#[test]
+fn block_hash_covers_the_whole_header_and_the_chain() {
+    let f = parse(GOLDEN);
+    let block = build(&f, 1);
+    let original = block.block_hash();
+
+    let mut cases: Vec<(&str, Block)> = Vec::new();
+    let mut t = block.clone();
+    t.header.timestamp_ms += 1;
+    cases.push(("timestamp_ms", t));
+    let mut t = block.clone();
+    t.header.parent_hash = Hash::ZERO;
+    cases.push(("parent_hash", t));
+    let mut t = block.clone();
+    t.header.state_root = Hash::ZERO;
+    cases.push(("state_root", t));
+    let mut t = block.clone();
+    t.header.chain_id = ChainId::new("auralite-9").unwrap();
+    cases.push(("chain_id", t));
+    let mut t = block.clone();
+    t.header.version += 1;
+    cases.push(("version", t));
+
+    for (name, mutated) in cases {
+        assert_ne!(
+            mutated.block_hash(),
+            original,
+            "changing {name} must change block_hash"
+        );
+    }
+    assert_eq!(block.block_hash(), original, "block_hash is deterministic");
+}
+
+#[test]
+fn every_bad_vector_is_rejected() {
+    let f = parse(GOLDEN);
+    const BAD: [&str; 9] = [
+        "bad_trailing",
+        "bad_truncated",
+        "bad_version",
+        "bad_root",
+        "bad_reordered",
+        "bad_unsorted_with_root",
+        "bad_duplicate",
+        "bad_qc_tag",
+        "bad_nonminimal_count",
+    ];
+    for key in BAD {
+        let bytes = hx(&f[key]);
+        let rejected = match Block::from_canonical_bytes(&bytes) {
+            Err(_) => true,
+            Ok(block) => block.validate(CHAIN_ID).is_err(),
+        };
+        assert!(rejected, "{key} must be rejected");
+    }
+}
+
+#[test]
+fn bad_vectors_return_the_specific_error() {
+    let f = parse(GOLDEN);
+    let decode = |key: &str| Block::from_canonical_bytes(&hx(&f[key]));
+
+    assert_eq!(
+        decode("bad_trailing"),
+        Err(BlockError::Decode(CodecError::TrailingBytes(1)))
+    );
+    assert!(decode("bad_truncated").is_err());
+    assert_eq!(
+        decode("bad_qc_tag"),
+        Err(BlockError::Decode(CodecError::InvalidOptionTag(2)))
+    );
+    assert_eq!(
+        decode("bad_nonminimal_count"),
+        Err(BlockError::Decode(CodecError::NonCanonicalVarint))
+    );
+    assert_eq!(
+        decode("bad_version").unwrap().validate(CHAIN_ID),
+        Err(BlockError::UnsupportedProtocolVersion(1, 2))
+    );
+    let bad_root = decode("bad_root").unwrap();
+    assert!(matches!(
+        bad_root.validate(CHAIN_ID),
+        Err(BlockError::TxRootMismatch(_, _))
+    ));
+    assert_eq!(
+        decode("bad_reordered").unwrap().validate(CHAIN_ID),
+        Err(BlockError::UnsortedTransactions)
+    );
+    assert_eq!(
+        decode("bad_unsorted_with_root").unwrap().validate(CHAIN_ID),
+        Err(BlockError::UnsortedTransactions)
+    );
+    assert_eq!(
+        decode("bad_duplicate").unwrap().validate(CHAIN_ID),
+        Err(BlockError::DuplicateTxKey)
+    );
+}
+
+#[test]
+fn reorder_without_recomputing_the_root_is_rejected() {
+    let f = parse(GOLDEN);
+    let mut block = build(&f, 1);
+    assert!(block.validate(CHAIN_ID).is_ok());
+    block.body.txs.reverse();
+    assert!(
+        block.validate(CHAIN_ID).is_err(),
+        "NC target: reorder -> red"
+    );
+    assert_ne!(block.body.tx_root(), block.header.tx_root);
+}
+
+#[test]
+fn body_rejects_duplicate_keys_at_construction() {
+    let first = c4_tx(1);
+    assert_eq!(
+        Body::new(vec![first.clone(), first]).err(),
+        Some(BlockError::DuplicateTxKey)
+    );
+}
+
+#[test]
+fn wrong_chain_and_size_limits_are_enforced() {
+    let f = parse(GOLDEN);
+    let block = build(&f, 1);
+    assert_eq!(
+        block.validate("auralite-1"),
+        Err(BlockError::WrongChain(
+            "auralite-1".to_owned(),
+            CHAIN_ID.to_owned()
+        ))
+    );
+
+    let mut big_qc = build(&f, 4);
+    big_qc.header.qc = Some(vec![0u8; MAX_QC_BYTES + 1]);
+    assert_eq!(
+        big_qc.validate(CHAIN_ID),
+        Err(BlockError::QcTooLarge(MAX_QC_BYTES + 1))
+    );
+}
+
+#[test]
+fn transaction_validation_is_separate_from_block_validation() {
+    let f = parse(GOLDEN);
+    let mut block = build(&f, 1);
+    assert!(block.validate(CHAIN_ID).is_ok());
+    assert!(block.validate_transactions(CHAIN_ID).is_ok());
+
+    // Break a signature, recompute the root so block-level validation still
+    // passes: only full transaction validation can catch this.
+    block.body.txs[0].sig.bytes[0] ^= 0x01;
+    block.header.tx_root = block.body.tx_root();
+    assert!(block.validate(CHAIN_ID).is_ok());
+    assert!(matches!(
+        block.validate_transactions(CHAIN_ID),
+        Err(BlockError::InvalidTransaction(_))
+    ));
+
+    // A height past a tx's expiry is also a transaction-level failure.
+    let mut expired = build(&f, 1);
+    expired.header.height = Height::new(2_000);
+    assert!(expired.validate(CHAIN_ID).is_ok());
+    assert!(expired.validate_transactions(CHAIN_ID).is_err());
+}
