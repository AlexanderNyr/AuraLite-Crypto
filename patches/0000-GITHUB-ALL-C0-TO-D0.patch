+    imports.extend(b"env");
+    imports.extend(leb(9));
+    imports.extend(b"not_in_abi");
+    imports.push(0x00); // function
+    imports.push(0x00); // type 0
+    let bytes = module(vec![
+        types(&[], &[]),
+        section(2, imports),
+        functions(1),
+        exports_run(),
+        code(vec![body(&[], &[0x0b])]),
