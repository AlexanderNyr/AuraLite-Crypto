@@ -0,0 +1,122 @@
+//! H4 model-based VM tests (docs/h4-property-plan.md §2, D-H4-2).
+//!
+//! A reference model of the transfer semantics in `detcheck::run` predicts
+//! committed/refused/gas for generated scenarios; the production runner must
+//! match exactly. The node label must not influence execution at all.
+//! `tools/nc_h4.py` NC-4 makes the transfer path refuse amount 7 and this
+//! model must notice (`H4: model/VM divergence`).
+
+use aura_exec::detcheck::{self, Op, Prng, Step, X7_ACCOUNTS, X7_START_BALANCE, X7_TRANSFER_GAS};
+
+/// Transfer-only scenario: distinct accounts, amounts 1..=100_000, with a
+/// guaranteed amount-7 step so the NC-4 mutation trigger fires.
+fn transfer_scenario(seed: u64, steps: usize) -> Vec<Step> {
+    let mut prng = Prng::new(seed);
+    let mut out = Vec::with_capacity(steps);
+    for index in 0..steps {
+        let amount = if index == 0 {
+            7u128
+        } else {
+            (1 + prng.below(100_000)) as u128
+        };
+        let from = prng.below(X7_ACCOUNTS as u64) as usize;
+        let mut to = prng.below(X7_ACCOUNTS as u64) as usize;
+        if to == from {
+            to = (to + 1) % X7_ACCOUNTS;
+        }
+        out.push(Step {
+            index,
+            op: Op::Transfer {
+                from: detcheck::account_address(from),
+                to: detcheck::account_address(to),
+                amount,
+            },
+        });
+    }
+    out
+}
+
+/// Independent model of `Node::transfer` bookkeeping: accept = debit+credit+
+/// nonce bump commit together; overdraft = refused with gas still billed.
+fn model(steps: &[Step]) -> (usize, usize, u64) {
+    let mut balances = [X7_START_BALANCE; X7_ACCOUNTS];
+    let mut committed = 0usize;
+    let mut refused = 0usize;
+    for step in steps {
+        let (from, to, amount) = match step.op {
+            Op::Transfer { from, to, amount } => (from, to, amount),
+            _ => panic!("h4 model only covers transfer scenarios"),
+        };
+        let from_index = from[19] as usize;
+        let to_index = to[19] as usize;
+        if balances[from_index] >= amount {
+            balances[from_index] -= amount;
+            balances[to_index] += amount;
+            committed += 1;
+        } else {
+            refused += 1;
+        }
+    }
+    (committed, refused, (steps.len() as u64) * X7_TRANSFER_GAS)
+}
+
+#[test]
+fn h4_model_vm() {
+    for seed in [20261180u64, 7, 42, 0x9E37_79B9_7F4A_7C15] {
+        let steps = transfer_scenario(seed, 64);
+        let (committed, refused, gas) = model(&steps);
+        assert_eq!(committed + refused, steps.len());
+        let report = detcheck::run(&steps, 0);
+        assert_eq!(
+            report.committed, committed,
+            "H4: model/VM divergence (seed {seed})"
+        );
+        assert_eq!(
+            report.refused, refused,
+            "H4: model/VM divergence (seed {seed})"
+        );
+        assert_eq!(
+            report.gas_total, gas,
+            "H4: model/VM divergence (seed {seed})"
+        );
+        assert_eq!(
+            report.committed + report.refused + report.failed,
+            steps.len(),
+            "H4: model/VM divergence (seed {seed})"
+        );
+
+        // Node-label independence: the label is not an input.
+        let other = detcheck::run(&steps, 5);
+        assert_eq!(
+            other.digest, report.digest,
+            "H4: model/VM divergence (seed {seed})"
+        );
+        assert_eq!(
+            other.state_root, report.state_root,
+            "H4: model/VM divergence (seed {seed})"
+        );
+        assert_eq!(
+            other.tree_root, report.tree_root,
+            "H4: model/VM divergence (seed {seed})"
+        );
+        assert_eq!(
+            other.gas_total, report.gas_total,
+            "H4: model/VM divergence (seed {seed})"
+        );
+    }
+
+    // A targeted scenario of one amount-7 transfer: the model predicts commit.
+    let steps = vec![Step {
+        index: 0,
+        op: Op::Transfer {
+            from: detcheck::account_address(0),
+            to: detcheck::account_address(1),
+            amount: 7,
+        },
+    }];
+    let (committed, refused, _) = model(&steps);
+    assert_eq!((committed, refused), (1, 0));
+    let report = detcheck::run(&steps, 0);
+    assert_eq!(report.committed, 1, "H4: model/VM divergence");
+    assert_eq!(report.refused, 0, "H4: model/VM divergence");
+}
diff --git a/crates/aura-state/tests/h4_tree.rs b/crates/aura-state/tests/h4_tree.rs
new file mode 100644
index 0000000..088350c
--- /dev/null
+++ b/crates/aura-state/tests/h4_tree.rs
@@ -0,0 +1,126 @@
+//! H4 tree differential (docs/h4-property-plan.md §2, D-H4-1).
+//!
+//! An independent re-implementation of the S1 sparse merkle rules (hash
+//! layouts assembled here from the constants, not by calling the production
+//! helpers) must agree with `MerkleTree` over generated key/value sets.
+//! `tools/nc_h4.py` NC-5 swaps left/right in `node_hash` and this reference
+//! must notice (`H4: tree differential mismatch`). The cross-language half of
+//! the differential lives in `tools/h4_reference.py`.
+
+use aura_crypto::blake3_hash;
+use aura_state::{MerkleTree, StateKey};
+use aura_types::Hash;
+
+const S1_EMPTY_CONTEXT: &[u8] = b"AuraLite-Crypto/s1-empty-v1\0";
+const S1_LEAF_CONTEXT: &[u8] = b"AuraLite-Crypto/s1-leaf-v1\0";
+const S1_NODE_CONTEXT: &[u8] = b"AuraLite-Crypto/s1-node-v1\0";
+
+fn ref_empty(depth: u16) -> Hash {
+    let mut input = Vec::new();
+    input.extend_from_slice(S1_EMPTY_CONTEXT);
+    input.extend_from_slice(&depth.to_le_bytes());
+    blake3_hash(&input)
+}
+
+fn ref_leaf(depth: u16, key: &Hash, value: &[u8]) -> Hash {
+    let mut input = Vec::new();
+    input.extend_from_slice(S1_LEAF_CONTEXT);
+    input.extend_from_slice(&depth.to_le_bytes());
+    input.extend_from_slice(key.as_bytes());
+    input.extend_from_slice(&(value.len() as u64).to_le_bytes());
+    input.extend_from_slice(value);
+    blake3_hash(&input)
+}
+
+fn ref_node(left: &Hash, right: &Hash) -> Hash {
+    let mut input = Vec::new();
+    input.extend_from_slice(S1_NODE_CONTEXT);
+    input.extend_from_slice(left.as_bytes());
+    input.extend_from_slice(right.as_bytes());
+    blake3_hash(&input)
+}
+
+fn key_bit(key: &Hash, depth: u16) -> u8 {
+    let byte = key.as_bytes()[(depth / 8) as usize];
+    (byte >> (7 - depth % 8)) & 1
+}
+
+/// Naive recursive sparse-tree root: empty subtree → empty_hash(depth); a
+/// single leaf is compressed into leaf_hash(depth, key, value); otherwise the
+/// set splits on the key bit at `depth`.
+fn ref_root(entries: &mut [(Hash, Vec<u8>)], depth: u16) -> Hash {
+    if entries.is_empty() {
+        return ref_empty(depth);
+    }
+    if entries.len() == 1 {
+        let (key, value) = &entries[0];
+        return ref_leaf(depth, key, value);
+    }
+    let split = entries
+        .iter()
+        .position(|(key, _)| key_bit(key, depth) == 1)
+        .unwrap_or(entries.len());
+    let (low, high) = entries.split_at_mut(split);
+    ref_node(&ref_root(low, depth + 1), &ref_root(high, depth + 1))
+}
+
+fn case(entries: &[(u64, Vec<u8>)]) {
+    let mut prepared: Vec<(Hash, Vec<u8>)> = entries
+        .iter()
+        .map(|(index, value)| {
+            (
+                StateKey::account(&aura_types::Address::from_bytes([*index as u8; 20])).digest(),
+                value.clone(),
+            )
+        })
+        .collect();
+    prepared.sort_by(|a, b| a.0.as_bytes().cmp(b.0.as_bytes()));
+    let expected = ref_root(&mut prepared, 0);
+
+    let mut tree = MerkleTree::new();
+    for (index, value) in entries {
+        let key = StateKey::account(&aura_types::Address::from_bytes([*index as u8; 20]));
+        tree.insert(&key, value.clone());
+    }
+    assert_eq!(tree.tree_root(), expected, "H4: tree differential mismatch");
+}
+
+#[test]
+fn h4_tree_differential() {
+    // Deterministic sweep: k entries for k = 1..=16 with fixed values.
+    for count in 1u64..=16 {
+        let entries: Vec<(u64, Vec<u8>)> = (0..count)
+            .map(|index| (index, vec![index as u8; 3 + (index as usize % 5)]))
+            .collect();
+        case(&entries);
+    }
+    // Sparse sets: far-apart keys and a single leaf.
+    case(&[(0, vec![1]), (255, vec![2])]);
+    case(&[(7, vec![7; 32])]);
+    case(&[(1, vec![]), (2, vec![0]), (3, vec![0, 0])]);
+    // Deterministic pseudo-random sets (SplitMix64 inline).
+    let mut state = 20261180u64;
+    let mut next = || {
+        state = state.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = state;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^ (z >> 31)
+    };
+    for round in 0..32u64 {
+        let count = 1 + next() % 12;
+        let entries: Vec<(u64, Vec<u8>)> = (0..count)
+            .map(|_| {
+                let key = next() % 256;
+                let len = (next() % 24) as usize;
+                let value = (0..len).map(|_| next() as u8).collect();
+                (key, value)
+            })
+            .collect();
+        let mut unique = entries.clone();
+        unique.sort_by_key(|(key, _)| *key);
+        unique.dedup_by_key(|(key, _)| *key);
+        case(&unique);
+        let _ = round;
+    }
+}
diff --git a/crates/aura-testkit/src/bin/h4-properties.rs b/crates/aura-testkit/src/bin/h4-properties.rs
new file mode 100644
index 0000000..e41611e
--- /dev/null
+++ b/crates/aura-testkit/src/bin/h4-properties.rs
@@ -0,0 +1,276 @@
+//! H4 property campaign binary (docs/h4-property-plan.md §1, D-H4-4).
+//!
+//! Generates `--txs` deterministic transfer transactions (Lcg seeds from
+//! 20261180), each fully signed and verified and canonically round-tripped,
+//! then applied through the production `Account::{credit,debit}` ops on
+//! copies that commit together or not at all. After EVERY transaction the
+//! invariant `sum(balances) == accounts × start` is checked.
+//!
+//! `--dump-vectors PATH` writes cross-language differential cases (tx byte
+//! layouts and S1 merkle roots) for `tools/h4_reference.py check`.
+//! `--differential PATH` verifies cases generated by `tools/h4_reference.py
+//! gen`. The line format is stable and versioned with `h4-diff-v1`.
+
+use std::fmt::Write as _;
+use std::path::PathBuf;
+
+use aura_crypto::{blake3_hash, ed25519_public_key};
+use aura_state::{Account, MerkleTree};
+use aura_testkit::Lcg;
+use aura_tx::{Tx, TxKind, TxParams, UnsignedTx};
+use aura_types::{Amount, ChainId, Gas, Hash, Height, Nonce};
+
+const START: u128 = 1_000_000;
+const ACCOUNTS: usize = 16;
+
+fn account_seed(index: usize) -> [u8; 32] {
+    let mut seed = [0u8; 32];
+    seed[0] = index as u8;
+    seed[31] = (index as u8).wrapping_add(0x5a);
+    seed[15] = 0xc0;
+    seed
+}
+
+fn signed_tx(index: usize, nonce: u64, amount: u128) -> Tx {
+    let seed = account_seed(index);
+    let pk = ed25519_public_key(&seed);
+    let params = TxParams {
+        chain_id: ChainId::new("h4-chain").unwrap(),
+        signer: aura_tx::signer_address(&pk),
+        nonce: Nonce::new(nonce),
+        kind: TxKind::Transfer,
+        payload: amount.to_le_bytes().to_vec(),
+        gas_limit: Gas::new(1_000),
+        max_fee: Amount::from_units(10),
+        tip: Amount::from_units(1),
+        expiry: Height::new(100),
+    };
+    UnsignedTx::new(params).unwrap().sign(&seed).unwrap()
+}
+
+fn apply_transfer(accounts: &mut [Account], from: usize, to: usize, amount: u128) -> bool {
+    let mut payer = accounts[from];
+    let mut payee = accounts[to];
+    let ok = payer
+        .debit(Amount::from_units(amount))
+        .and_then(|()| payee.credit(Amount::from_units(amount)))
+        .is_ok()
+        && payer.bump_nonce().is_ok();
+    if ok {
+        accounts[from] = payer;
+        accounts[to] = payee;
+    }
+    ok
+}
+
+fn tree_case_root(entries: &[(Hash, Vec<u8>)]) -> Hash {
+    let mut tree = MerkleTree::new();
+    for (path, value) in entries {
+        tree.insert_digest(*path, value.clone());
+    }
+    tree.tree_root()
+}
+
+/// Deterministic case paths: the 32-byte LE encoding of the case number.
+fn case_path(i: u64) -> Hash {
+    let mut bytes = [0u8; 32];
+    bytes[..8].copy_from_slice(&i.to_le_bytes());
+    Hash::from_bytes(bytes)
+}
+
+fn dump_vectors(path: &PathBuf) -> Result<(), String> {
+    let mut out = String::new();
+    out.push_str("h4-diff-v1\n");
+    for case in 0..64u64 {
+        let tx = signed_tx(case as usize % ACCOUNTS, case, (case + 1) as u128);
+        let _ = writeln!(
+            out,
+            "tx {case} {} {} {} {}",
+            case as usize % ACCOUNTS,
+            case,
+            case + 1,
+            hex(&tx.to_bytes())
+        );
+    }
+    for case in 0..32u64 {
+        let count = 1 + case % 8;
+        let entries: Vec<(Hash, Vec<u8>)> = (0..count)
+            .map(|j| {
+                let value_len = (case + j) % 24;
+                let value: Vec<u8> = (0..value_len).map(|k| (case + j + k) as u8).collect();
+                (case_path(case * 32 + j), value)
+            })
+            .collect();
+        let mut rendered = Vec::new();
+        for (path, value) in &entries {
+            rendered.push(format!("{}:{}", hex(path.as_bytes()), hex(value)));
+        }
+        let root = tree_case_root(&entries);
+        let _ = writeln!(
+            out,
+            "tree {case} {} {}",
+            rendered.join(","),
+            hex(root.as_bytes())
+        );
+    }
+    std::fs::write(path, out).map_err(|e| format!("write {path:?}: {e}"))
+}
+
+fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+fn unhex(text: &str) -> Result<Vec<u8>, String> {
+    if !text.len().is_multiple_of(2) {
+        return Err(format!("odd hex length: {text}"));
+    }
+    (0..text.len())
+        .step_by(2)
+        .map(|i| u8::from_str_radix(&text[i..i + 2], 16).map_err(|e| e.to_string()))
+        .collect()
+}
+
+fn check_differential(path: &PathBuf) -> Result<(), String> {
+    let text = std::fs::read_to_string(path).map_err(|e| format!("read {path:?}: {e}"))?;
+    let mut checked = 0usize;
+    for (lineno, line) in text.lines().enumerate() {
+        if line.is_empty() || line.starts_with("h4-diff-v1") {
+            continue;
+        }
+        let fields: Vec<&str> = line.split(' ').collect();
+        match fields.as_slice() {
+            ["tx", _case, index, nonce, amount, bytes] => {
+                let tx = signed_tx(
+                    index.parse().map_err(|e| format!("line {lineno}: {e}"))?,
+                    nonce.parse().map_err(|e| format!("line {lineno}: {e}"))?,
+                    amount.parse().map_err(|e| format!("line {lineno}: {e}"))?,
+                );
+                let expected = unhex(bytes)?;
+                if tx.to_bytes() != expected {
+                    return Err(format!(
+                        "H4: canonical roundtrip violated (line {lineno}: rust bytes differ from reference)"
+                    ));
+                }
+                checked += 1;
+            }
+            ["tree", _case, entries, root] => {
+                let mut parsed = Vec::new();
+                for item in entries.split(',') {
+                    let (path_hex, value_hex) = item
+                        .split_once(':')
+                        .ok_or_else(|| format!("line {lineno}: bad entry"))?;
+                    let path = unhex(path_hex)?;
+                    let path = Hash::from_bytes(path.as_slice().try_into().unwrap());
+                    parsed.push((path, unhex(value_hex)?));
+                }
+                let expected = unhex(root)?;
+                if tree_case_root(&parsed).as_bytes() != expected.as_slice() {
+                    return Err(format!("H4: tree differential mismatch (line {lineno})"));
+                }
+                checked += 1;
+            }
+            _ => return Err(format!("line {lineno}: unknown case")),
+        }
+    }
+    println!("differential_check=ok cases={checked}");
+    Ok(())
+}
+
+fn main() -> Result<(), String> {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let option = |name: &str| -> Option<String> {
+        args.iter()
+            .position(|arg| arg == name)
+            .and_then(|index| args.get(index + 1))
+            .cloned()
+    };
+    if let Some(path) = option("--dump-vectors") {
+        return dump_vectors(&PathBuf::from(path));
+    }
+    if let Some(path) = option("--differential") {
+        return check_differential(&PathBuf::from(path));
+    }
+    let txs: u64 = option("--txs")
+        .ok_or("usage: h4-properties --txs N [--seed S]")?
+        .parse()
+        .map_err(|e| format!("--txs: {e}"))?;
+    let seed: u64 = option("--seed")
+        .map(|value| value.parse().map_err(|e| format!("--seed: {e}")))
+        .transpose()?
+        .unwrap_or(20261180);
+
+    let mut accounts: Vec<Account> = (0..ACCOUNTS)
+        .map(|_| {
+            Account::new(
+                Nonce::new(0),
+                Amount::from_units(START),
+                Hash::ZERO,
+                Hash::ZERO,
+            )
+        })
+        .collect();
+    let mut nonces = [0u64; ACCOUNTS];
+    let total = |accounts: &[Account]| -> u128 {
+        accounts.iter().map(|account| account.balance.units()).sum()
+    };
+    let start_total = total(&accounts);
+
+    let mut lcg = Lcg::new(seed);
+    let mut committed = 0u64;
+    let mut rejected = 0u64;
+    let mut digest = blake3_hash(b"AuraLite-Crypto/h4-tx-digest-v1\0");
+
+    for round in 0..txs {
+        let from = (lcg.next_u64() as usize) % ACCOUNTS;
+        let to = (lcg.next_u64() as usize) % ACCOUNTS;
+        if from == to {
+            continue;
+        }
+        let amount = 1 + (lcg.next_u64() as u128) % 200_000;
+
+        let tx = signed_tx(from, nonces[from], amount);
+        tx.verify_signature()
+            .map_err(|e| format!("round {round}: signature property violated: {e}"))?;
+        let bytes = tx.to_bytes();
+        let parsed = Tx::from_canonical_bytes(&bytes)
+            .map_err(|e| format!("round {round}: canonical roundtrip violated: {e}"))?;
+        if parsed != tx || parsed.to_bytes() != bytes {
+            return Err(format!("round {round}: canonical roundtrip violated"));
+        }
+        let mut chain = digest.as_bytes().to_vec();
+        chain.extend_from_slice(tx.txid().as_bytes());
+        digest = blake3_hash(&chain);
+
+        let before = total(&accounts);
+        if apply_transfer(&mut accounts, from, to, amount) {
+            committed += 1;
+            if total(&accounts) != before {
+                return Err(format!("round {round}: balance conservation violated"));
+            }
+            nonces[from] += 1;
+        } else {
+            rejected += 1;
+            let mut trial = accounts.clone();
+            let _ = apply_transfer(&mut trial, from, to, amount);
+            if trial != accounts {
+                return Err(format!(
+                    "round {round}: rejected transfer must not change state"
+                ));
+            }
+        }
+        if total(&accounts) != start_total {
+            return Err(format!("round {round}: balance conservation violated"));
+        }
+    }
+
+    println!("txs={}", txs);
+    println!("committed={committed}");
+    println!("rejected={rejected}");
+    println!("sum_checks={}", committed + rejected);
+    println!("final_total={}", total(&accounts));
+    println!("start_total={start_total}");
+    println!("digest={}", hex(digest.as_bytes()));
+    println!("seed={seed}");
+    println!("RESULT: balance conservation holds over {txs} generated txs");
+    Ok(())
+}
diff --git a/crates/aura-testkit/tests/h4_properties.rs b/crates/aura-testkit/tests/h4_properties.rs
new file mode 100644
index 0000000..f833f68
--- /dev/null
+++ b/crates/aura-testkit/tests/h4_properties.rs
@@ -0,0 +1,303 @@
+//! H4 properties: balance conservation, canonical round-trip, signature
+//! properties and credit/debit algebra (docs/h4-property-plan.md §2).
+//!
+//! The deterministic part guarantees that every mutation trigger used by
+//! `tools/nc_h4.py` (amounts `0..=64`, notably 7) fires; proptest adds
+//! randomised surface. Every failure carries its named H4 message.
+
+use aura_codec::{decode_canonical, encode_to_bytes};
+use aura_crypto::ed25519_public_key;
+use aura_state::Account;
+use aura_testkit::Lcg;
+use aura_tx::{Tx, TxKind, TxParams, UnsignedTx};
+use aura_types::{Amount, ChainId, Gas, Hash, Height, Nonce};
+use proptest::prelude::*;
+
+const START: u128 = 1_000_000;
+const ACCOUNTS: usize = 8;
+
+fn fresh_accounts() -> Vec<Account> {
+    (0..ACCOUNTS)
+        .map(|_| {
+            Account::new(
+                Nonce::new(0),
+                Amount::from_units(START),
+                Hash::ZERO,
+                Hash::ZERO,
+            )
+        })
+        .collect()
+}
+
+fn total(accounts: &[Account]) -> u128 {
+    accounts.iter().map(|account| account.balance.units()).sum()
+}
+
+/// Mirror of the production transfer semantics (detcheck `Node::transfer`):
+/// debit + credit + nonce bump commit together or not at all.
+fn apply_transfer(accounts: &mut [Account], from: usize, to: usize, amount: u128) -> bool {
+    let mut payer = accounts[from];
+    let mut payee = accounts[to];
+    let ok = payer
+        .debit(Amount::from_units(amount))
+        .and_then(|()| payee.credit(Amount::from_units(amount)))
+        .is_ok()
+        && payer.bump_nonce().is_ok();
+    if ok {
+        accounts[from] = payer;
+        accounts[to] = payee;
+    }
+    ok
+}
+
+#[test]
+fn h4_balance_conservation() {
+    let mut accounts = fresh_accounts();
+    let start_total = total(&accounts);
+    // Deterministic sweep: every amount 0..=64 between distinct accounts, so
+    // any amount-pattern mutation (tools/nc_h4.py NC-1) is guaranteed to fire.
+    for amount in 0u128..=64u128 {
+        let from = (amount as usize) % ACCOUNTS;
+        let to = (amount as usize + 1) % ACCOUNTS;
+        let before = total(&accounts);
+        let ok = apply_transfer(&mut accounts, from, to, amount);
+        assert_eq!(
+            total(&accounts),
+            before,
+            "H4: balance conservation violated"
+        );
+        assert!(ok, "H4: rejected transfer must not change state");
+    }
+    // Deterministic stream, including overdrafts (rejections must not move
+    // the total and must not mutate state).
+    let mut lcg = Lcg::new(20261180);
+    for round in 0..2000u64 {
+        let from = (lcg.next_u64() as usize) % ACCOUNTS;
+        let to = (lcg.next_u64() as usize) % ACCOUNTS;
+        if from == to {
+            continue;
+        }
+        let amount = lcg.next_u64() as u128 % 200_000;
+        let mut trial = accounts.clone();
+        let before = total(&accounts);
+        if apply_transfer(&mut trial, from, to, amount) {
+            assert_eq!(
+                total(&trial),
+                before,
+                "H4: balance conservation violated (round {round})"
+            );
+            accounts = trial;
+        } else {
+            assert_eq!(
+                trial, accounts,
+                "H4: rejected transfer must not change state (round {round})"
+            );
+        }
+        assert_eq!(
+            total(&accounts),
+            start_total,
+            "H4: balance conservation violated (round {round})"
+        );
+    }
+}
+
+proptest! {
+    #![proptest_config(ProptestConfig {
+        cases: 256,
+        failure_persistence: None,
+        .. ProptestConfig::default()
+    })]
+
+    /// Random transfer sequences conserve the total whatever happens.
+    #[test]
+    fn h4_balance_conservation_random(transfers in proptest::collection::vec((0..8usize, 0..8usize, 0..1_000_000u128), 1..64)) {
+        let mut accounts = fresh_accounts();
+        let start_total = total(&accounts);
+        for (from, to, amount) in transfers {
+            if from == to {
+                continue;
+            }
+            let mut trial = accounts.clone();
+            let before = total(&accounts);
+            if apply_transfer(&mut trial, from, to, amount) {
+                prop_assert_eq!(total(&trial), before);
+                accounts = trial;
+            } else {
+                prop_assert_eq!(trial.clone(), accounts.clone());
+            }
+            prop_assert_eq!(total(&accounts), start_total, "H4: balance conservation violated");
+        }
+    }
+}
+
+#[test]
+fn h4_canonical_roundtrip() {
+    // Trailing bytes must be rejected by the canonicality guard — this is the
+    // NC-2 mutation target (tools/nc_h4.py disables the re-encode comparison).
+    let nonce = Nonce::new(7);
+    let mut trailing = encode_to_bytes(&nonce);
+    trailing.push(0x00);
+    assert!(
+        decode_canonical::<Nonce>(&trailing).is_err(),
+        "H4: canonical roundtrip violated"
+    );
+    // Padded varints must be rejected by the varint layer (C9 padding: set
+    // the continuation bit on the last minimal byte and append a zero byte).
+    let padded = [0x87u8, 0x00];
+    let mut reader = aura_codec::Reader::new(&padded);
+    assert!(
+        aura_codec::read_varint(&mut reader).is_err(),
+        "H4: canonical roundtrip violated"
+    );
+    // Round-trip of real transactions over the deterministic sweep.
+    for amount in 0u128..=64u128 {
+        let seed = [amount as u8; 32];
+        let tx = signed_tx(&seed, Nonce::new(amount as u64), amount);
+        let bytes = tx.to_bytes();
+        let parsed = Tx::from_canonical_bytes(&bytes).expect("H4: canonical roundtrip violated");
+        assert_eq!(parsed, tx, "H4: canonical roundtrip violated");
+        assert_eq!(parsed.to_bytes(), bytes, "H4: canonical roundtrip violated");
+    }
+}
+
+proptest! {
+    #![proptest_config(ProptestConfig {
+        cases: 256,
+        failure_persistence: None,
+        .. ProptestConfig::default()
+    })]
+
+    /// Any structurally valid transaction survives a canonical round-trip.
+    #[test]
+    fn h4_canonical_roundtrip_random(nonce in any::<u64>(), payload in proptest::collection::vec(any::<u8>(), 0..64)) {
+        let seed = [0x42u8; 32];
+        let pk = ed25519_public_key(&seed);
+        let params = TxParams {
+            chain_id: ChainId::new("h4-chain").unwrap(),
+            signer: aura_tx::signer_address(&pk),
+            nonce: Nonce::new(nonce),
+            kind: TxKind::Transfer,
+            payload,
+            gas_limit: Gas::new(1_000),
+            max_fee: Amount::from_units(10),
+            tip: Amount::from_units(1),
+            expiry: Height::new(100),
+        };
+        let tx = UnsignedTx::new(params).unwrap().sign(&seed).unwrap();
+        let bytes = tx.to_bytes();
+        let parsed = Tx::from_canonical_bytes(&bytes).expect("H4: canonical roundtrip violated");
+        prop_assert_eq!(parsed.clone(), tx);
+        prop_assert_eq!(parsed.to_bytes(), bytes.clone());
+    }
+}
+
+fn signed_tx(seed: &[u8; 32], nonce: Nonce, amount: u128) -> Tx {
+    let pk = ed25519_public_key(seed);
+    let params = TxParams {
+        chain_id: ChainId::new("h4-chain").unwrap(),
+        signer: aura_tx::signer_address(&pk),
+        nonce,
+        kind: TxKind::Transfer,
+        payload: amount.to_le_bytes().to_vec(),
+        gas_limit: Gas::new(1_000),
+        max_fee: Amount::from_units(10),
+        tip: Amount::from_units(1),
+        expiry: Height::new(100),
+    };
+    UnsignedTx::new(params).unwrap().sign(seed).unwrap()
+}
+
+#[test]
+fn h4_signature_properties() {
+    let seed = [7u8; 32];
+    let tx = signed_tx(&seed, Nonce::new(7), 7);
+    tx.verify_signature()
+        .expect("H4: signature property violated");
+
+    // Flipping any byte of the canonical encoding must break verification:
+    // either the decode fails or the signature check does.
+    let bytes = tx.to_bytes();
+    for index in 0..bytes.len() {
+        let mut bad = bytes.clone();
+        bad[index] ^= 0x01;
+        if let Ok(tampered) = Tx::from_canonical_bytes(&bad) {
+            assert!(
+                tampered.verify_signature().is_err(),
+                "H4: signature property violated (byte {index})"
+            );
+        }
+    }
+
+    // The expiry field is signed: changing it after signing must be rejected.
+    // (tools/nc_h4.py NC-3 drops `expiry` from `signing_bytes` and this case
+    // must go red.)
+    let mut late = tx.clone();
+    late.unsigned.expiry = Height::new(101);
+    assert!(
+        late.verify_signature().is_err(),
+        "H4: signature property violated"
+    );
+
+    // Signer ↔ public-key binding: a foreign key must not verify.
+    let other_seed = [9u8; 32];
+    let other_pk = ed25519_public_key(&other_seed);
+    let mut forged = tx.clone();
+    forged.sig.public_key = other_pk;
+    assert!(
+        forged.verify_signature().is_err(),
+        "H4: signature property violated"
+    );
+}
+
+#[test]
+fn h4_credit_debit_algebra() {
+    // Exact add/subtract identities over 0..=64 (amount 7 is the NC-6 trigger).
+    for amount in 0u128..=64u128 {
+        let mut account = Account::new(
+            Nonce::new(0),
+            Amount::from_units(START),
+            Hash::ZERO,
+            Hash::ZERO,
+        );
+        account
+            .credit(Amount::from_units(amount))
+            .expect("credit within capacity");
+        assert_eq!(
+            account.balance.units(),
+            START + amount,
+            "H4: credit/debit algebra violated"
+        );
+        account
+            .debit(Amount::from_units(amount))
+            .expect("debit within balance");
+        assert_eq!(
+            account.balance.units(),
+            START,
+            "H4: credit/debit algebra violated"
+        );
+        account.bump_nonce().expect("nonce bump");
+        assert_eq!(
+            account.nonce,
+            Nonce::new(1),
+            "H4: credit/debit algebra violated"
+        );
+    }
+    // Overdraft is rejected without mutation.
+    let mut poor = Account::new(Nonce::new(0), Amount::from_units(5), Hash::ZERO, Hash::ZERO);
+    let before = poor;
+    assert!(poor.debit(Amount::from_units(6)).is_err());
+    assert_eq!(poor, before, "H4: credit/debit algebra violated");
+    // Checked arithmetic: credit must not wrap u128.
+    let mut whale = Account::new(
+        Nonce::new(0),
+        Amount::from_units(u128::MAX),
+        Hash::ZERO,
+        Hash::ZERO,
+    );
+    assert!(whale.credit(Amount::from_units(1)).is_err());
+    assert_eq!(
+        whale.balance.units(),
+        u128::MAX,
+        "H4: credit/debit algebra violated"
+    );
+}
