+fn golden_record(f: &BTreeMap<String, String>, index: u64) -> WalRecord {
+    WalRecord {
+        version: index,
+        parent_root: hash32(&f[&format!("commit_{index}_parent")]),
+        state_root: hash32(&f[&format!("commit_{index}_root")]),
+        changes: vector_changes(index),
+    }
+}
