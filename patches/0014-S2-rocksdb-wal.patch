new file mode 100644
index 0000000..9264b1e
--- /dev/null
+++ b/crates/aura-storage/src/bin/s2_writer.rs
@@ -0,0 +1,59 @@
+//! `kill -9` harness for the S2 durability gate.
+//!
+//! Usage:
+//!   s2-writer --dir <path> --commits <n> [--crash-after-wal] [--clean]
+//!
+//! Opens the store, commits `n` deterministic batches, optionally appends one
+//! extra WAL record WITHOUT publishing it, then kills itself with SIGKILL.
+//! The parent test reopens the store and requires head + root to match.
+
+use std::path::PathBuf;
+use std::process::Command;
+
+use aura_storage::{Storage, vector_changes};
+
+fn arg_value(args: &[String], name: &str) -> Option<String> {
+    args.iter()
+        .position(|arg| arg == name)
+        .and_then(|index| args.get(index + 1))
+        .cloned()
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let dir = PathBuf::from(arg_value(&args, "--dir").expect("--dir is required"));
+    let commits: u64 = arg_value(&args, "--commits")
+        .expect("--commits is required")
+        .parse()
+        .expect("commit count must be u64");
+    let crash_after_wal = args.iter().any(|arg| arg == "--crash-after-wal");
+    let clean = args.iter().any(|arg| arg == "--clean");
+
+    let mut storage = Storage::open(&dir).expect("open store");
+    for index in 1..=commits {
+        let receipt = storage
+            .commit(vector_changes(index))
+            .unwrap_or_else(|error| panic!("commit {index}: {error}"));
+        assert_eq!(receipt.version, index, "commit version");
+    }
+    if crash_after_wal {
+        storage
+            .append_wal_only(vector_changes(commits + 1))
+            .expect("append WAL only");
+    }
+
+    if clean {
+        println!("CLEAN {}", storage.head().version);
+        return;
+    }
+
+    // Kill -9 via /bin/sh so we do not need a libc dependency.
+    let pid = std::process::id();
+    println!("KILL {pid}");
+    let _ = std::io::Write::flush(&mut std::io::stdout());
+    let _ = Command::new("sh")
+        .args(["-c", &format!("kill -9 {pid}")])
+        .status();
+    // The signal should have terminated us; if not, fail loudly.
+    std::process::exit(70);
+}
diff --git a/crates/aura-storage/src/error.rs b/crates/aura-storage/src/error.rs
new file mode 100644
index 0000000..455891a
--- /dev/null
+++ b/crates/aura-storage/src/error.rs
@@ -0,0 +1,47 @@
+//! Storage errors.
+
+use std::fmt;
+
+/// Every way durable state can fail to open, commit or recover.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum StorageError {
+    /// RocksDB reported an error (message kept opaque).
+    Backend(String),
+    /// A WAL record failed its BLAKE3 checksum.
+    ChecksumMismatch,
+    /// A WAL record has a bad magic prefix or cannot be decoded.
+    CorruptWal,
+    /// WAL versions are not consecutive.
+    NonSequentialWal,
+    /// A recovered record's parent root does not match the current root.
+    ParentRootMismatch,
+    /// Recomputed state root does not match the published root.
+    RootMismatch,
+    /// The WAL contains no record for a published head.
+    MissingWalRecord,
+    /// Filesystem I/O failure.
+    Io(String),
+}
+
+impl fmt::Display for StorageError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Backend(message) => write!(f, "rocksdb: {message}"),
+            Self::ChecksumMismatch => f.write_str("WAL checksum mismatch"),
+            Self::CorruptWal => f.write_str("corrupt WAL record"),
+            Self::NonSequentialWal => f.write_str("WAL versions are not consecutive"),
+            Self::ParentRootMismatch => f.write_str("WAL parent root mismatch"),
+            Self::RootMismatch => f.write_str("state root does not match published root"),
+            Self::MissingWalRecord => f.write_str("head published without a WAL record"),
+            Self::Io(message) => write!(f, "I/O error: {message}"),
+        }
+    }
+}
+
+impl std::error::Error for StorageError {}
+
+impl From<std::io::Error> for StorageError {
+    fn from(error: std::io::Error) -> Self {
+        StorageError::Io(error.to_string())
+    }
+}
