+[package]
+name = "aura-example-recurse"
+description = "X6 reference contract: a contract that calls itself until the node refuses"
+version = "0.1.0"
+edition = "2024"
+license = "MIT OR Apache-2.0"
+publish = false
+
+# A contract is its own workspace: it is built for wasm32-unknown-unknown with
+# release + LTO and it must NOT pull the node's dependency graph.
+[workspace]
+
+[dependencies]
+aura-sdk = { path = "../../crates/aura-sdk", features = ["macros"] }
+
+[lib]
+crate-type = ["cdylib", "rlib"]
+
+[profile.release]
+opt-level = "z"
+lto = true
+codegen-units = 1
+panic = "abort"
+strip = true
