+[package]
+name = "aura-example-vault"
+description = "X6 reference contract: a vault that sends value back to its caller"
+version = "0.1.0"
+edition = "2024"
+license = "MIT OR Apache-2.0"
+publish = false
+
+# A contract is its own workspace: it is built for wasm32-unknown-unknown with
+# release + LTO and it must NOT pull the node's dependency graph.
+[workspace]
+
+[dependencies]
+aura-sdk = { path = "../../crates/aura-sdk", features = ["macros"] }
+
+[lib]
+crate-type = ["cdylib", "rlib"]
+
+[profile.release]
+opt-level = "z"
+lto = true
+codegen-units = 1
+panic = "abort"
+strip = true
