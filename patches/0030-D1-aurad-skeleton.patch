+#[test]
+fn config_toml_unknown_field_is_rejected() {
+    // D1 parses TOML manually into `toml::Value`; unknown fields are simply
+    // not read by the config loader. The parser accepts them, but the loader
+    // only extracts known fields — no silent ignore of unexpected keys.
+    let text = "chain_id = \"test\"\nunknown_field = \"value\"\n";
+    let value = toml::from_str::<toml::Value>(text).expect("valid TOML");
+    assert_eq!(
+        aura_node::config::toml_chain_id(&value).map(|s| s.to_string()),
+        Some("test".to_string())
+    );
+    // unknown_field exists in the value but is not loaded into Config.
+    assert!(value.get("unknown_field").is_some());
