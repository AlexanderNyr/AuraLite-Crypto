index 0000000..e7a8110
--- /dev/null
+++ b/crates/aura-tx/src/error.rs
@@ -0,0 +1,60 @@
+//! Transaction validation errors.
+
+use std::fmt;
+
+use aura_codec::CodecError;
+
+/// Every reason a transaction can be rejected before execution.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum TxError {
+    /// `codec_version` is not [`aura_codec::CODEC_VERSION`]. Tuple is
+    /// `(expected, got)`.
+    UnsupportedCodecVersion(u8, u8),
+    /// The tx chain-id does not match the chain we are validating for.
+    /// Tuple is `(expected, got)`.
+    WrongChain(String, String),
+    /// Payload exceeds [`crate::MAX_TX_PAYLOAD`].
+    PayloadTooLarge(usize),
+    /// `gas_limit` is zero.
+    ZeroGasLimit,
+    /// `tip` is greater than `max_fee`.
+    TipExceedsMaxFee,
+    /// The tx has expired. Tuple is `(expiry_height, current_height)`.
+    Expired(u64, u64),
+    /// `signer` does not match the address derived from the public key.
+    SignerMismatch,
+    /// Ed25519 verification failed.
+    InvalidSignature,
+    /// Canonical decoding failed (structural).
+    Decode(CodecError),
+}
+
+impl fmt::Display for TxError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::UnsupportedCodecVersion(expected, got) => {
+                write!(f, "unsupported tx codec version {got}, expected {expected}")
+            }
+            Self::WrongChain(expected, got) => {
+                write!(f, "replay rejected: chain '{got}' is not '{expected}'")
+            }
+            Self::PayloadTooLarge(n) => write!(f, "payload of {n} bytes exceeds the limit"),
+            Self::ZeroGasLimit => f.write_str("gas_limit must be non-zero"),
+            Self::TipExceedsMaxFee => f.write_str("tip exceeds max_fee"),
+            Self::Expired(expiry, height) => {
+                write!(f, "tx expired at height {expiry}, current height {height}")
+            }
+            Self::SignerMismatch => f.write_str("signer does not match the public key"),
+            Self::InvalidSignature => f.write_str("invalid transaction signature"),
+            Self::Decode(error) => write!(f, "canonical decode failed: {error}"),
+        }
+    }
+}
+
+impl std::error::Error for TxError {}
+
+impl From<CodecError> for TxError {
+    fn from(error: CodecError) -> Self {
+        TxError::Decode(error)
+    }
+}
diff --git a/crates/aura-tx/src/kind.rs b/crates/aura-tx/src/kind.rs
new file mode 100644
index 0000000..aa36cd4
--- /dev/null
+++ b/crates/aura-tx/src/kind.rs
@@ -0,0 +1,69 @@
+//! Transaction kind tags.
+
+use aura_codec::{CodecError, Decode, Encode, Reader, Writer};
+
+/// What the transaction asks the chain to do.
+///
+/// Tags are protocol constants. Unknown tags are rejected at decode time;
+/// adding a kind requires a new phase, a `CODEC_VERSION` bump and a migration
+/// test.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum TxKind {
+    /// Native asset transfer.
+    Transfer,
+    /// Publish WASM bytecode.
+    Deploy,
+    /// Invoke a contract.
+    Call,
+    /// Delegate stake to a validator.
+    Delegate,
+    /// Withdraw delegated stake.
+    Undelegate,
+}
+
+impl TxKind {
+    /// All kinds, in tag order.
+    pub const ALL: [TxKind; 5] = [
+        TxKind::Transfer,
+        TxKind::Deploy,
+        TxKind::Call,
+        TxKind::Delegate,
+        TxKind::Undelegate,
+    ];
+
+    /// Stable protocol tag.
+    pub const fn tag(self) -> u8 {
+        match self {
+            TxKind::Transfer => 0,
+            TxKind::Deploy => 1,
+            TxKind::Call => 2,
+            TxKind::Delegate => 3,
+            TxKind::Undelegate => 4,
+        }
+    }
+
+    /// Parse a protocol tag, rejecting unknown values.
+    pub const fn from_tag(tag: u8) -> Option<TxKind> {
+        match tag {
+            0 => Some(TxKind::Transfer),
+            1 => Some(TxKind::Deploy),
+            2 => Some(TxKind::Call),
+            3 => Some(TxKind::Delegate),
+            4 => Some(TxKind::Undelegate),
+            _ => None,
+        }
+    }
+}
+
+impl Encode for TxKind {
+    fn encode(&self, writer: &mut Writer) {
+        writer.push_byte(self.tag());
+    }
+}
+
+impl Decode for TxKind {
+    fn decode(reader: &mut Reader<'_>) -> Result<Self, CodecError> {
+        let tag = u8::decode(reader)?;
+        TxKind::from_tag(tag).ok_or(CodecError::InvalidEnumTag("TxKind", tag))
+    }
+}
diff --git a/crates/aura-tx/src/lib.rs b/crates/aura-tx/src/lib.rs
new file mode 100644
index 0000000..930ed2a
--- /dev/null
+++ b/crates/aura-tx/src/lib.rs
@@ -0,0 +1,43 @@
+//! AuraLite-Crypto canonical transaction format (C4).
+//!
+//! A transaction is `Tx = UnsignedTx || Signature`. The unsigned part carries
+//! the ten protocol fields from `CORE_PLAN.md` C4 plus a `codec_version` from
+//! `ARCHITECTURE.md`:
+//!
+//! ```text
+//! codec_version, chain_id, signer, nonce, kind, payload,
+//! gas_limit, max_fee, tip, expiry
+//! ```
+//!
+//! The signature is an **envelope**, not a bare 64-byte value: it also carries
+//! the algorithm tag and the 32-byte public key. Ed25519 cannot recover a
+//! public key from a signature, so the key must travel with the transaction;
+//! [`signer_address`] binds that key to the 20-byte `signer` field.
+//!
+//! Invariants:
+//! * one value → one byte string (C2 [`aura_codec::decode_canonical`]);
+//! * `signing_bytes()` = `SIGNING_CONTEXT || canonical(UnsignedTx)`, signed
+//!   through C3's domain-separated `aura_crypto::sign(Domain::Tx, chain_id)`;
+//! * replay protection: `validate()` takes the expected chain-id and rejects
+//!   a transaction minted for `auralite-1` on `auralite-test-1`;
+//! * no clock, no randomness, no floating point — `expiry` and `height` are
+//!   consensus heights supplied by the caller.
+//!
+//! Full field/wire specification: `docs/spec/tx-format.md`.
+//! Golden vectors: `tools/gen_c4_vectors.py` (independent Python).
+
+#![forbid(unsafe_code)]
+#![deny(missing_docs)]
+
+mod error;
+mod kind;
+mod signature;
+mod tx;
+
+pub use error::TxError;
+pub use kind::TxKind;
+pub use signature::{SIG_ALGO_ED25519, Signature, SignatureAlgo};
+pub use tx::{
+    ADDRESS_CONTEXT, MAX_TX_PAYLOAD, SIGNING_CONTEXT, TXID_CONTEXT, Tx, TxParams, UnsignedTx,
+    signer_address,
+};
diff --git a/crates/aura-tx/src/signature.rs b/crates/aura-tx/src/signature.rs
new file mode 100644
index 0000000..eb5d5e4
--- /dev/null
+++ b/crates/aura-tx/src/signature.rs
@@ -0,0 +1,83 @@
+//! Signature envelope: algorithm tag + public key + 64-byte signature.
+
+use aura_codec::{CodecError, Decode, Encode, Reader, Writer};
+
+/// Ed25519 algorithm tag. Other tag values are reserved (secp256k1 = 1 is
+/// intentionally **not** accepted in the Stage 1 tx format; PQ tags will live
+/// in a separate range).
+pub const SIG_ALGO_ED25519: u8 = 0;
+
+/// Signature algorithm. Stage 1 accepts Ed25519 only.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum SignatureAlgo {
+    /// Ed25519 (RFC 8032), verified through `aura-crypto`.
+    Ed25519,
+}
+
+impl SignatureAlgo {
+    /// Stable protocol tag.
+    pub const fn tag(self) -> u8 {
+        SIG_ALGO_ED25519
+    }
+
+    /// Parse a protocol tag. Unknown algorithms are rejected.
+    pub const fn from_tag(tag: u8) -> Option<SignatureAlgo> {
+        match tag {
+            SIG_ALGO_ED25519 => Some(SignatureAlgo::Ed25519),
+            _ => None,
+        }
+    }
+}
+
+/// The signature attached to a [`crate::Tx`].
+///
+/// Ed25519 cannot recover the public key from a signature, so the key is part
+/// of the wire format. [`crate::signer_address`] derives the 20-byte signer
+/// from it and validation requires an exact match.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Signature {
+    /// Signature algorithm.
+    pub algo: SignatureAlgo,
+    /// 32-byte Ed25519 public key.
+    pub public_key: [u8; 32],
+    /// 64-byte Ed25519 signature.
+    pub bytes: [u8; 64],
+}
+
+impl Signature {
+    /// Construct an Ed25519 signature envelope.
+    pub fn ed25519(public_key: [u8; 32], bytes: [u8; 64]) -> Self {
+        Signature {
+            algo: SignatureAlgo::Ed25519,
+            public_key,
+            bytes,
+        }
+    }
+}
+
+impl Encode for Signature {
+    fn encode(&self, writer: &mut Writer) {
+        writer.push_byte(self.algo.tag());
+        writer.push_bytes(&self.public_key);
+        writer.push_bytes(&self.bytes);
+    }
+}
+
+impl Decode for Signature {
+    fn decode(reader: &mut Reader<'_>) -> Result<Self, CodecError> {
+        let tag = u8::decode(reader)?;
+        let algo =
+            SignatureAlgo::from_tag(tag).ok_or(CodecError::InvalidEnumTag("SignatureAlgo", tag))?;
+        let key_bytes = reader.read_exact(32)?;
+        let mut public_key = [0u8; 32];
+        public_key.copy_from_slice(key_bytes);
+        let sig_bytes = reader.read_exact(64)?;
+        let mut bytes = [0u8; 64];
+        bytes.copy_from_slice(sig_bytes);
+        Ok(Signature {
+            algo,
+            public_key,
+            bytes,
+        })
+    }
+}
diff --git a/crates/aura-tx/src/tx.rs b/crates/aura-tx/src/tx.rs
new file mode 100644
index 0000000..3d26213
--- /dev/null
+++ b/crates/aura-tx/src/tx.rs
@@ -0,0 +1,294 @@
+//! Canonical transaction, signing bytes, txid and validation.
+
+use aura_codec::{
+    CODEC_VERSION, CodecError, Decode, Encode, Reader, Writer, decode_canonical, encode_to_bytes,
+};
+use aura_crypto::{blake3_hash, ed25519_public_key};
+use aura_types::{ADDRESS_LEN, Address, Amount, ChainId, Domain, Gas, Hash, Height, Nonce};
+
+use crate::error::TxError;
+use crate::kind::TxKind;
+use crate::signature::Signature;
+
+/// Prefix of the bytes that are signed for a transaction.
+///
+/// NC target: `tools/nc_c4.py` changes this constant and requires the C4
+/// golden vectors to go red. A change here invalidates every existing
+/// signature and requires a protocol version bump.
+pub const SIGNING_CONTEXT: &[u8] = b"AuraLite-Crypto/tx-signing-v1\x00";
+
+/// Prefix of the bytes hashed to produce a transaction id.
+///
+/// NC target: `tools/nc_c4.py` changes this constant and requires the txid
+/// golden vectors to go red.
+pub const TXID_CONTEXT: &[u8] = b"AuraLite-Crypto/txid-v1\x00";
+
+/// Prefix for deriving a 20-byte account address from a 32-byte public key.
+pub const ADDRESS_CONTEXT: &[u8] = b"AuraLite-Crypto/address-v1\x00";
+
+/// Maximum payload size. Aligned with `aura-codec`'s `MAX_ITEMS` so a decoded
+/// payload can never exceed what the canonical decoder accepts.
+pub const MAX_TX_PAYLOAD: usize = 65_536;
+
+/// Derive the canonical 20-byte address for an Ed25519 public key.
+///
+/// `address = BLAKE3(ADDRESS_CONTEXT || public_key)[0..20]`. The binding is
+/// checked on every verification, so a transaction cannot claim someone
+/// else's `signer`.
+pub fn signer_address(public_key: &[u8; 32]) -> Address {
+    let mut input = Vec::with_capacity(ADDRESS_CONTEXT.len() + 32);
+    input.extend_from_slice(ADDRESS_CONTEXT);
+    input.extend_from_slice(public_key);
+    let digest = blake3_hash(&input);
+    let mut bytes = [0u8; ADDRESS_LEN];
+    bytes.copy_from_slice(&digest.as_bytes()[..ADDRESS_LEN]);
+    Address::from_bytes(bytes)
+}
+
+/// Construction parameters for [`UnsignedTx::new`].
+///
+/// A transaction genuinely has nine unsigned protocol fields. Grouping them
+/// keeps the constructor readable and satisfies `clippy::too_many_arguments`
+/// without suppressing the lint. `codec_version` is added by the constructor.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct TxParams {
+    /// Chain this transaction is valid on (replay protection).
+    pub chain_id: ChainId,
+    /// 20-byte account address derived from the signer's public key.
+    pub signer: Address,
+    /// Per-account sequence number.
+    pub nonce: Nonce,
+    /// What the transaction does.
+    pub kind: TxKind,
+    /// Opaque, length-prefixed call data.
+    pub payload: Vec<u8>,
+    /// Maximum gas the sender will buy.
+    pub gas_limit: Gas,
+    /// Maximum total fee the sender will pay.
+    pub max_fee: Amount,
+    /// Priority tip, must not exceed `max_fee`.
+    pub tip: Amount,
+    /// Last consensus height at which the transaction may be included.
+    pub expiry: Height,
+}
+
+/// The unsigned part of a transaction. Field order is the wire order.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct UnsignedTx {
+    /// Wire format version, must equal [`CODEC_VERSION`].
+    pub codec_version: u8,
+    /// Chain this transaction is valid on (replay protection).
+    pub chain_id: ChainId,
+    /// 20-byte account address derived from the signer's public key.
+    pub signer: Address,
+    /// Per-account sequence number.
+    pub nonce: Nonce,
+    /// What the transaction does.
+    pub kind: TxKind,
+    /// Opaque, length-prefixed call data.
+    pub payload: Vec<u8>,
+    /// Maximum gas the sender will buy.
+    pub gas_limit: Gas,
+    /// Maximum total fee the sender will pay.
+    pub max_fee: Amount,
+    /// Priority tip, must not exceed `max_fee`.
+    pub tip: Amount,
+    /// Last consensus height at which the transaction may be included.
+    pub expiry: Height,
+}
+
+impl UnsignedTx {
+    /// Construct and structurally validate an unsigned transaction.
+    pub fn new(params: TxParams) -> Result<Self, TxError> {
+        if params.payload.len() > MAX_TX_PAYLOAD {
+            return Err(TxError::PayloadTooLarge(params.payload.len()));
+        }
+        if params.gas_limit.value() == 0 {
+            return Err(TxError::ZeroGasLimit);
+        }
+        if params.tip > params.max_fee {
+            return Err(TxError::TipExceedsMaxFee);
+        }
+        Ok(UnsignedTx {
+            codec_version: CODEC_VERSION,
+            chain_id: params.chain_id,
+            signer: params.signer,
+            nonce: params.nonce,
+            kind: params.kind,
+            payload: params.payload,
+            gas_limit: params.gas_limit,
+            max_fee: params.max_fee,
+            tip: params.tip,
+            expiry: params.expiry,
+        })
+    }
+
+    /// The exact bytes that are signed: context plus the canonical encoding
+    /// of every unsigned field. The signature is **not** included.
+    pub fn signing_bytes(&self) -> Vec<u8> {
+        let mut writer = Writer::new();
+        writer.push_bytes(SIGNING_CONTEXT);
+        self.encode(&mut writer);
+        writer.into_bytes()
+    }
+
+    /// Sign with a seed. The seed's public key must derive to `self.signer`.
+    pub fn sign(&self, seed: &[u8; 32]) -> Result<Tx, TxError> {
+        let public_key = ed25519_public_key(seed);
+        if signer_address(&public_key) != self.signer {
+            return Err(TxError::SignerMismatch);
+        }
+        let signature = aura_crypto::sign(
+            seed,
+            self.chain_id.as_str(),
+            Domain::Tx,
+            &self.signing_bytes(),
+        );
+        Ok(Tx {
+            unsigned: self.clone(),
+            sig: Signature::ed25519(public_key, signature),
+        })
+    }
+}
+
+impl Encode for UnsignedTx {
+    fn encode(&self, writer: &mut Writer) {
+        self.codec_version.encode(writer);
+        self.chain_id.encode(writer);
+        self.signer.encode(writer);
+        self.nonce.encode(writer);
+        self.kind.encode(writer);
+        self.payload.encode(writer);
+        self.gas_limit.encode(writer);
+        self.max_fee.encode(writer);
+        self.tip.encode(writer);
+        self.expiry.encode(writer);
+    }
+}
+
+impl Decode for UnsignedTx {
+    fn decode(reader: &mut Reader<'_>) -> Result<Self, CodecError> {
+        let version = u8::decode(reader)?;
+        if version != CODEC_VERSION {
+            return Err(CodecError::UnsupportedVersion(CODEC_VERSION, version));
+        }
+        Ok(UnsignedTx {
+            codec_version: version,
+            chain_id: ChainId::decode(reader)?,
+            signer: Address::decode(reader)?,
+            nonce: Nonce::decode(reader)?,
+            kind: TxKind::decode(reader)?,
+            payload: Vec::<u8>::decode(reader)?,
+            gas_limit: Gas::decode(reader)?,
+            max_fee: Amount::decode(reader)?,
+            tip: Amount::decode(reader)?,
+            expiry: Height::decode(reader)?,
+        })
+    }
+}
+
+/// A complete transaction: unsigned fields plus the signature envelope.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Tx {
+    /// All unsigned fields, in canonical order.
+    pub unsigned: UnsignedTx,
+    /// Algorithm tag, public key and 64-byte signature.
+    pub sig: Signature,
+}
+
+fn verify_ed25519(pk: &[u8; 32], chain: &str, msg: &[u8], sig: &[u8; 64]) -> Result<(), TxError> {
+    aura_crypto::verify(pk, chain, Domain::Tx, msg, sig).map_err(|_| TxError::InvalidSignature)
+}
+
+impl Tx {
+    /// Bytes that are signed (delegates to [`UnsignedTx::signing_bytes`]).
+    pub fn signing_bytes(&self) -> Vec<u8> {
+        self.unsigned.signing_bytes()
+    }
+
+    /// Canonical wire bytes.
+    pub fn to_bytes(&self) -> Vec<u8> {
+        encode_to_bytes(self)
+    }
+
+    /// Transaction id: `BLAKE3(TXID_CONTEXT || canonical_bytes)`.
+    ///
+    /// Includes the signature, so two different signatures over the same
+    /// unsigned payload have different ids.
+    pub fn txid(&self) -> Hash {
+        let encoded = self.to_bytes();
+        let mut input = Vec::with_capacity(TXID_CONTEXT.len() + encoded.len());
+        input.extend_from_slice(TXID_CONTEXT);
+        input.extend_from_slice(&encoded);
+        blake3_hash(&input)
+    }
+
+    /// Decode with full C2 canonicality: no trailing bytes, no non-minimal
+    /// varints, field order fixed, re-encode must reproduce the input.
+    pub fn from_canonical_bytes(bytes: &[u8]) -> Result<Self, TxError> {
+        Ok(decode_canonical::<Tx>(bytes)?)
+    }
+
+    /// Verify the Ed25519 signature and the signer↔public-key binding.
+    ///
+    /// NC target: `tools/nc_c4.py` disables the binding check and requires
+    /// the signer-mismatch test to go red.
+    pub fn verify_signature(&self) -> Result<(), TxError> {
+        if signer_address(&self.sig.public_key) != self.unsigned.signer {
+            return Err(TxError::SignerMismatch);
+        }
+        let message = self.signing_bytes();
+        let chain = self.unsigned.chain_id.as_str();
+        verify_ed25519(&self.sig.public_key, chain, &message, &self.sig.bytes)
+    }
+
+    /// Full pre-execution validation for `expected_chain` at `height`.
+    ///
+    /// NC target: `tools/nc_c4.py` disables the chain check and requires the
+    /// replay test to go red.
+    pub fn validate(&self, expected_chain: &str, height: Height) -> Result<(), TxError> {
+        if self.unsigned.codec_version != CODEC_VERSION {
+            return Err(TxError::UnsupportedCodecVersion(
+                CODEC_VERSION,
+                self.unsigned.codec_version,
+            ));
+        }
+        if self.unsigned.chain_id.as_str() != expected_chain {
+            return Err(TxError::WrongChain(
+                expected_chain.to_owned(),
+                self.unsigned.chain_id.as_str().to_owned(),
+            ));
+        }
+        if self.unsigned.payload.len() > MAX_TX_PAYLOAD {
+            return Err(TxError::PayloadTooLarge(self.unsigned.payload.len()));
+        }
+        if self.unsigned.gas_limit.value() == 0 {
+            return Err(TxError::ZeroGasLimit);
+        }
+        if self.unsigned.tip > self.unsigned.max_fee {
+            return Err(TxError::TipExceedsMaxFee);
+        }
+        if height.value() > self.unsigned.expiry.value() {
+            return Err(TxError::Expired(
+                self.unsigned.expiry.value(),
+                height.value(),
+            ));
+        }
+        self.verify_signature()
+    }
+}
+
+impl Encode for Tx {
+    fn encode(&self, writer: &mut Writer) {
+        self.unsigned.encode(writer);
+        self.sig.encode(writer);
+    }
+}
+
+impl Decode for Tx {
+    fn decode(reader: &mut Reader<'_>) -> Result<Self, CodecError> {
+        let unsigned = UnsignedTx::decode(reader)?;
+        let sig = Signature::decode(reader)?;
+        Ok(Tx { unsigned, sig })
+    }
+}
diff --git a/crates/aura-tx/tests/c4_tx.rs b/crates/aura-tx/tests/c4_tx.rs
new file mode 100644
index 0000000..d70423e
--- /dev/null
+++ b/crates/aura-tx/tests/c4_tx.rs
@@ -0,0 +1,410 @@
+//! C4 gate: transaction format against an independent Python encoder.
+//!
+//! `fixtures/c4_golden.txt` is produced by `tools/gen_c4_vectors.py`, which
+//! self-checks pure-Python BLAKE3 and pure-Python Ed25519 against official
+//! BLAKE3 vectors and RFC 8032 before emitting anything.
+
+use std::collections::BTreeMap;
+
+use aura_codec::{CodecError, encode_to_bytes};
+use aura_crypto::{ed25519_public_key, hash_domain};
+use aura_tx::{
+    ADDRESS_CONTEXT, MAX_TX_PAYLOAD, SIGNING_CONTEXT, SignatureAlgo, TXID_CONTEXT, Tx, TxError,
+    TxKind, TxParams, UnsignedTx, signer_address,
+};
+use aura_types::{
+    Address, Amount, CHAIN_ID, ChainId, Domain, Gas, Height, MAINNET_CHAIN_ID, Nonce,
+};
+
+const GOLDEN: &str = include_str!("fixtures/c4_golden.txt");
+
+fn fixtures() -> BTreeMap<String, String> {
+    let mut map = BTreeMap::new();
+    for line in GOLDEN.lines() {
+        let trimmed = line.trim();
+        if trimmed.is_empty() || trimmed.starts_with('#') {
+            continue;
+        }
+        let (key, value) = trimmed
+            .split_once('=')
+            .unwrap_or_else(|| panic!("malformed golden line: {trimmed}"));
+        assert!(
+            map.insert(key.to_owned(), value.to_owned()).is_none(),
+            "duplicate golden key {key}"
+        );
+    }
+    map
+}
+
+fn hx(text: &str) -> Vec<u8> {
+    assert_eq!(text.len() % 2, 0, "even-length hex");
+    text.as_bytes()
+        .chunks(2)
+        .map(|pair| (nibble(pair[0]) << 4) | nibble(pair[1]))
+        .collect()
+}
+
+fn nibble(byte: u8) -> u8 {
+    match byte {
+        b'0'..=b'9' => byte - b'0',
+        b'a'..=b'f' => byte - b'a' + 10,
+        _ => panic!("invalid hex nibble in fixture"),
+    }
+}
+
+fn arr32(text: &str) -> [u8; 32] {
+    hx(text).try_into().expect("expected 32 bytes")
+}
+
+fn to_hex(bytes: &[u8]) -> String {
+    let mut out = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        out.push_str(&format!("{byte:02x}"));
+    }
+    out
+}
+
+fn get(f: &BTreeMap<String, String>, index: usize, key: &str) -> String {
+    f[&format!("tx{index}_{key}")].clone()
+}
+
+fn build(f: &BTreeMap<String, String>, index: usize) -> (UnsignedTx, [u8; 32]) {
+    let unsigned = UnsignedTx::new(TxParams {
+        chain_id: ChainId::new(&get(f, index, "chain")).expect("valid chain-id"),
+        signer: Address::from_slice(&hx(&get(f, index, "address"))).expect("20-byte address"),
+        nonce: Nonce::new(get(f, index, "nonce").parse().expect("u64")),
+        kind: TxKind::from_tag(get(f, index, "kind").parse().expect("u8 tag")).expect("known kind"),
+        payload: hx(&get(f, index, "payload")),
+        gas_limit: Gas::new(get(f, index, "gas").parse().expect("u64")),
+        max_fee: Amount::from_units(get(f, index, "max_fee").parse().expect("u128")),
+        tip: Amount::from_units(get(f, index, "tip").parse().expect("u128")),
+        expiry: Height::new(get(f, index, "expiry").parse().expect("u64")),
+    })
+    .expect("structurally valid");
+    (unsigned, arr32(&get(f, index, "seed")))
+}
+
+#[test]
+fn constants_are_pinned_by_the_independent_fixture() {
+    let f = fixtures();
+    assert_eq!(to_hex(SIGNING_CONTEXT), f["signing_context"]);
+    assert_eq!(to_hex(TXID_CONTEXT), f["txid_context"]);
+    assert_eq!(to_hex(ADDRESS_CONTEXT), f["address_context"]);
+    assert_eq!(MAX_TX_PAYLOAD.to_string(), f["max_tx_payload"]);
+    assert_eq!(aura_codec::CODEC_VERSION.to_string(), f["codec_version"]);
+}
+
+#[test]
+fn golden_transactions_match_the_independent_encoder() {
+    let f = fixtures();
+    for index in 1..=5 {
+        let (unsigned, seed) = build(&f, index);
+
+        assert_eq!(
+            to_hex(&encode_to_bytes(&unsigned)),
+            get(&f, index, "unsigned")
+        );
+        let signing = unsigned.signing_bytes();
+        assert_eq!(to_hex(&signing), get(&f, index, "signing_bytes"));
+
+        let digest = hash_domain(unsigned.chain_id.as_str(), Domain::Tx, &signing);
+        assert_eq!(digest.to_hex(), get(&f, index, "signing_hash"));
+
+        let public_key = ed25519_public_key(&seed);
+        assert_eq!(to_hex(&public_key), get(&f, index, "public_key"));
+        assert_eq!(
+            to_hex(signer_address(&public_key).as_bytes()),
+            get(&f, index, "address"),
+            "tx{index} signer derivation"
+        );
+
+        let tx = unsigned.sign(&seed).expect("signer matches key");
+        assert_eq!(to_hex(&tx.sig.bytes), get(&f, index, "signature"));
+        assert_eq!(to_hex(&tx.to_bytes()), get(&f, index, "bytes"));
+        assert_eq!(tx.txid().to_hex(), get(&f, index, "txid"));
+        assert_eq!(tx.signing_bytes(), signing);
+
+        let decoded = Tx::from_canonical_bytes(&hx(&get(&f, index, "bytes")))
+            .unwrap_or_else(|e| panic!("tx{index} decode: {e}"));
+        assert_eq!(decoded, tx, "tx{index} canonical round-trip");
+        assert_eq!(
+            decoded.txid().to_hex(),
+            get(&f, index, "txid"),
+            "tx{index} decoded txid"
+        );
+        assert!(
+            tx.validate(&get(&f, index, "chain"), Height::new(0))
+                .is_ok(),
+            "tx{index} validates on its own chain"
+        );
+    }
+}
+
+#[test]
+fn replay_across_chains_is_rejected() {
+    // tx3 is minted for the reserved mainnet chain-id.
+    let f = fixtures();
+    let (unsigned, seed) = build(&f, 3);
+    assert_eq!(unsigned.chain_id.as_str(), MAINNET_CHAIN_ID);
+    let tx = unsigned.sign(&seed).unwrap();
+
+    assert!(tx.validate(MAINNET_CHAIN_ID, Height::new(0)).is_ok());
+    assert_eq!(
+        tx.validate(CHAIN_ID, Height::new(0)),
+        Err(TxError::WrongChain(
+            CHAIN_ID.to_owned(),
+            MAINNET_CHAIN_ID.to_owned()
+        ))
+    );
+
+    // Rewriting the chain-id after signing cannot rescue it: chain-id is
+    // inside both signing_bytes and the C3 domain prefix.
+    let mut rewritten = tx.clone();
+    rewritten.unsigned.chain_id = ChainId::stage1();
+    assert!(rewritten.verify_signature().is_err());
+
+    // Same unsigned payload, different chain => different signature.
+    let mut other = unsigned.clone();
+    other.chain_id = ChainId::stage1();
+    // `signer` stays bound to the same key; only the chain changes.
+    let other_tx = other.sign(&seed).unwrap();
+    assert_ne!(tx.sig.bytes, other_tx.sig.bytes);
+    assert_ne!(tx.signing_bytes(), other_tx.signing_bytes());
+}
+
+#[test]
+fn signing_requires_the_matching_key() {
+    let f = fixtures();
+    let (unsigned, _) = build(&f, 1);
+    let wrong_seed = [0x66u8; 32];
+    assert_eq!(
+        unsigned.sign(&wrong_seed).err(),
+        Some(TxError::SignerMismatch)
+    );
+}
+
+#[test]
+fn every_mutation_breaks_the_signature() {
+    let f = fixtures();
+    let (unsigned, seed) = build(&f, 2);
+    let tx = unsigned.sign(&seed).unwrap();
+    assert!(tx.verify_signature().is_ok());
+
+    let mut cases: Vec<(&str, Tx)> = Vec::new();
+
+    let mut t = tx.clone();
+    t.unsigned.codec_version = 2;
+    cases.push(("codec_version", t));
+
+    let mut t = tx.clone();
+    t.unsigned.chain_id = ChainId::new("auralite-9").unwrap();
+    cases.push(("chain_id", t));
+
+    let mut t = tx.clone();
+    let mut addr = *t.unsigned.signer.as_bytes();
+    addr[0] ^= 0x01;
+    t.unsigned.signer = Address::from_bytes(addr);
+    cases.push(("signer", t));
+
+    let mut t = tx.clone();
+    t.unsigned.nonce = Nonce::new(999);
+    cases.push(("nonce", t));
+
+    let mut t = tx.clone();
+    t.unsigned.kind = TxKind::Deploy;
+    cases.push(("kind", t));
+
+    let mut t = tx.clone();
+    t.unsigned.payload.push(0x00);
+    cases.push(("payload", t));
+
+    let mut t = tx.clone();
+    t.unsigned.gas_limit = Gas::new(1);
+    cases.push(("gas_limit", t));
+
+    let mut t = tx.clone();
+    t.unsigned.max_fee = Amount::from_units(1);
+    cases.push(("max_fee", t));
+
+    let mut t = tx.clone();
+    t.unsigned.tip = Amount::from_units(1);
+    cases.push(("tip", t));
+
+    let mut t = tx.clone();
+    t.unsigned.expiry = Height::new(1);
+    cases.push(("expiry", t));
+
+    let mut t = tx.clone();
+    t.sig.public_key[0] ^= 0x01;
+    cases.push(("public_key", t));
+
+    let mut t = tx.clone();
+    t.sig.bytes[0] ^= 0x01;
+    cases.push(("signature_bytes", t));
+
+    for (name, mutated) in cases {
+        assert!(
+            mutated.verify_signature().is_err(),
+            "changing {name} must invalidate the signature"
+        );
+    }
+}
+
+#[test]
+fn every_bad_vector_is_rejected() {
+    let f = fixtures();
+    const BAD: [&str; 9] = [
+        "bad_trailing",
+        "bad_truncated",
+        "bad_version",
+        "bad_kind_tag",
+        "bad_algo_tag",
+        "bad_signer",
+        "bad_signature",
+        "bad_chain_len",
+        "bad_payload_len",
+    ];
+    for key in BAD {
+        let bytes = hx(&f[key]);
+        let rejected = match Tx::from_canonical_bytes(&bytes) {
+            Err(_) => true,
+            Ok(tx) => tx.validate(CHAIN_ID, Height::new(0)).is_err(),
+        };
+        assert!(rejected, "{key} must be rejected");
+    }
+}
+
+#[test]
+fn bad_vectors_return_the_specific_error() {
+    let f = fixtures();
+    let check = |key: &str, expected: CodecError| {
+        assert_eq!(
+            Tx::from_canonical_bytes(&hx(&f[key])),
+            Err(TxError::Decode(expected)),
+            "{key} error kind"
+        );
+    };
+    check("bad_trailing", CodecError::TrailingBytes(1));
+    check("bad_version", CodecError::UnsupportedVersion(1, 2));
+    check("bad_kind_tag", CodecError::InvalidEnumTag("TxKind", 9));
+    check(
+        "bad_algo_tag",
+        CodecError::InvalidEnumTag("SignatureAlgo", 1),
+    );
+    check("bad_chain_len", CodecError::NonCanonicalVarint);
+    check("bad_payload_len", CodecError::NonCanonicalVarint);
+    assert_eq!(
+        Tx::from_canonical_bytes(&hx(&f["bad_signer"]))
+            .unwrap()
+            .verify_signature(),
+        Err(TxError::SignerMismatch)
+    );
+    assert_eq!(
+        Tx::from_canonical_bytes(&hx(&f["bad_signature"]))
+            .unwrap()
+            .verify_signature(),
+        Err(TxError::InvalidSignature)
+    );
+}
+
+#[test]
+fn structural_validation_rules_are_enforced() {
+    let f = fixtures();
+    let (unsigned, seed) = build(&f, 1);
+    let tx = unsigned.sign(&seed).unwrap();
+
+    assert_eq!(
+        tx.validate(CHAIN_ID, Height::new(1001)),
+        Err(TxError::Expired(1000, 1001))
+    );
+    assert!(tx.validate(CHAIN_ID, Height::new(1000)).is_ok());
+
+    let mut wrong_version = tx.clone();
+    wrong_version.unsigned.codec_version = 2;
+    assert_eq!(
+        wrong_version.validate(CHAIN_ID, Height::new(0)),
+        Err(TxError::UnsupportedCodecVersion(1, 2))
+    );
+
+    let mut oversized = tx.clone();
+    oversized.unsigned.payload = vec![0u8; MAX_TX_PAYLOAD + 1];
+    assert_eq!(
+        oversized.validate(CHAIN_ID, Height::new(0)),
+        Err(TxError::PayloadTooLarge(MAX_TX_PAYLOAD + 1))
+    );
+
+    let mut zero_gas = tx.clone();
+    zero_gas.unsigned.gas_limit = Gas::new(0);
+    assert_eq!(
+        zero_gas.validate(CHAIN_ID, Height::new(0)),
+        Err(TxError::ZeroGasLimit)
+    );
+
+    let mut bad_tip = tx.clone();
+    bad_tip.unsigned.tip = Amount::from_units(1001);
+    bad_tip.unsigned.max_fee = Amount::from_units(1000);
+    assert_eq!(
+        bad_tip.validate(CHAIN_ID, Height::new(0)),
+        Err(TxError::TipExceedsMaxFee)
+    );
+
+    // The constructor refuses the same mistakes before signing exists.
+    assert_eq!(
+        UnsignedTx::new(TxParams {
+            chain_id: ChainId::stage1(),
+            signer: tx.unsigned.signer,
+            nonce: Nonce::new(0),
+            kind: TxKind::Transfer,
+            payload: vec![],
+            gas_limit: Gas::new(0),
+            max_fee: Amount::ZERO,
+            tip: Amount::ZERO,
+            expiry: Height::new(1),
+        })
+        .err(),
+        Some(TxError::ZeroGasLimit)
+    );
+    assert!(
+        UnsignedTx::new(TxParams {
+            chain_id: ChainId::stage1(),
+            signer: tx.unsigned.signer,
+            nonce: Nonce::new(0),
+            kind: TxKind::Transfer,
+            payload: vec![0u8; MAX_TX_PAYLOAD],
+            gas_limit: Gas::new(1),
+            max_fee: Amount::ZERO,
+            tip: Amount::ZERO,
+            expiry: Height::new(1),
+        })
+        .is_ok(),
+        "payload exactly at the limit is allowed"
+    );
+}
+
+#[test]
+fn enum_tags_are_strict() {
+    assert_eq!(TxKind::ALL.map(TxKind::tag), [0, 1, 2, 3, 4]);
+    for tag in 0..=4u8 {
+        assert_eq!(TxKind::from_tag(tag).map(TxKind::tag), Some(tag));
+    }
+    assert_eq!(TxKind::from_tag(5), None);
+    assert_eq!(TxKind::from_tag(255), None);
+    assert_eq!(
+        SignatureAlgo::from_tag(aura_tx::SIG_ALGO_ED25519),
+        Some(SignatureAlgo::Ed25519)
+    );
+    assert_eq!(SignatureAlgo::from_tag(1), None);
+}
+
+#[test]
+fn txid_covers_the_signature_too() {
+    let f = fixtures();
+    let (unsigned, seed) = build(&f, 1);
+    let tx = unsigned.sign(&seed).unwrap();
+
+    let mut other = tx.clone();
+    other.sig.bytes[63] ^= 0x01;
+    assert_ne!(tx.txid(), other.txid(), "signature must affect the txid");
+    assert!(other.verify_signature().is_err());
+    assert_eq!(tx.txid(), tx.txid(), "txid is deterministic");
+}
