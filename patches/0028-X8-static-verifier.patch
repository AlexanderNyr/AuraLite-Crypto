+    exports.extend(b"start");
+    exports.push(0x00);
+    exports.push(0x00);
+    let bytes = module(vec![
+        types(&[], &[]),
+        functions(1),
+        section(7, exports),
+        code(vec![body(&[], &[0x0b])]),
+    ]);
