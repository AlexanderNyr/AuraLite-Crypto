+    let limits = VerifyLimits {
+        max_stack_depth: 1,
+        ..VerifyLimits::hosted()
+    };
+    let bytes = one_function(&[0x41, 0x01, 0x41, 0x02, 0x6a, 0x1a, 0x0b]);
