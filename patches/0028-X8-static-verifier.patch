+    if not rows or not shipped:
+        print("ERROR: x8-verify did not run; fix the tree first")
+        return 1
+
+    if "--report-only" in sys.argv[1:]:
+        REPORT.write_text(build_report(rows, mismatches, shipped, stamp), encoding="utf-8")
