+}
+
+#[test]
+fn every_code_has_a_stable_string() {
+    // The 22 codes are part of the evidence format; a rename is a breaking change.
+    let codes = [
+        Code::BadMagic,
+        Code::BadVersion,
+        Code::ModuleTooLarge,
+        Code::SectionOrder,
+        Code::SectionUnknown,
+        Code::SectionTruncated,
+        Code::FloatType,
+        Code::ImportNotAllowed,
+        Code::GlobalType,
+        Code::MemoryLimits,
+        Code::FunctionCodeMismatch,
+        Code::BodyTruncated,
+        Code::OpcodeBanned,
+        Code::StackUnderflow,
+        Code::StackTooDeep,
+        Code::LabelDepth,
+        Code::LocalIndex,
+        Code::GlobalIndex,
+        Code::CallIndex,
+        Code::OpcodeBudget,
+        Code::LocalsBudget,
+        Code::ExportShape,
+    ];
+    assert_eq!(codes.len(), 22);
+    let mut names: Vec<&str> = codes.iter().map(|code| code.as_str()).collect();
+    names.sort_unstable();
+    names.dedup();
+    assert_eq!(names.len(), 22, "codes must be distinct");
+    for name in names {
+        assert!(
+            name.chars().all(|c| c.is_ascii_lowercase() || c == '_'),
+            "{name} is not a stable identifier"
+        );
+    }
+}
