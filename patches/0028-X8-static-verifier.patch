+
+#[test]
+fn code_locals_budget() {
+    let limits = VerifyLimits {
+        max_locals: 1,
+        ..VerifyLimits::hosted()
+    };
+    let bytes = module(vec![
+        types(&[], &[]),
+        functions(1),
