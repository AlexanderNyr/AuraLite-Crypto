++#[test]
++fn inbound_peer_ban_is_checked_after_valid_signature() {
++    let node = spawn_swarm(58);
++    let banned_peer = spawn_swarm(59);
++    let banned_id = banned_peer.local_peer_id();
++    node.ban_peer(
++        banned_id,
++        BanReason::Manual("test_authenticated_peer_ban".into()),
++        None,
++    );
