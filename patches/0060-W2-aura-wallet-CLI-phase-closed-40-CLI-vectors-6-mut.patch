++        cmd += ["--features", "insecure-test-kdf" if feature is True else feature]
++    if "::" in test:
++        cmd += ["--lib", "--", "--exact", test]
++    else:
++        cmd += ["--test", "w1_keystore", test, "--", "--exact"]
++    return subprocess.run(cmd, cwd=ROOT, text=True, capture_output=True, check=False)
