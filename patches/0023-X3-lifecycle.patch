+#[test]
+fn deploy_stores_code_and_runs_init() {
+    let lifecycle = Lifecycle::new();
+    let base = base(10_000);
+    let code = program("v1");
+    let receipt = lifecycle
+        .deploy(
+            &base,
+            call(1_000_000),
+            code.clone(),
