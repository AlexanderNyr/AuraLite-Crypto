+#!/usr/bin/env python3
+"""Record the X3 dependency delta: none.
+
+X3 is pure Rust inside `aura-exec`: a bytecode record format, a version field, an
+upgrade path and two new entry points. It adds **no dependency at all** — not
+external, not workspace — and it does not change the engine pins.
+
+This addendum exists to make that statement checkable: it records the counts
+before and after, and the size of the default `aura-exec` build graph, which is
+what a node actually compiles.
+
+Usage:
+    python3 tools/record_x2_deps.py
+    make record-x3-deps
+"""
+
+from __future__ import annotations
+
+import subprocess
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+OUT = REPO / "docs" / "evidence" / "x3-dependency-addendum.txt"
+
+WORKSPACE_DEPS: list[str] = []
+
+
+def sh(command: str) -> str:
+    result = subprocess.run(
+        command, shell=True, cwd=REPO, capture_output=True, text=True, check=False
+    )
+    return (result.stdout + result.stderr).strip()
+
+
+def main() -> int:
+    external = sh("grep -c '^source = ' Cargo.lock")
+    default_graph = sh("cargo tree -p aura-exec --edges normal -q | sort -u | wc -l")
+    workspace_graph = sh("cargo tree -p aura-exec --edges normal -q | wc -l")
+    deps = "\n".join(f"#   aura-exec -> {name}" for name in WORKSPACE_DEPS) or "#   (none)"
+    text = f"""# AuraLite-Crypto external dependency addendum (X3).
+# Generated by tools/record_x3_deps.py from Cargo.lock.
+#
+# X3 adds NO dependency at all: no external crate and no new workspace edge.
+# This file therefore contains no `name=version` lines: it is a statement that
+# the allowlist is unchanged, and the dependency gate still validates it against
+# Cargo.lock.
+#
+# No timestamp: this file is checksummed in docs/evidence/x3/SHA256SUMS, so
+# regenerating it must reproduce it byte for byte.
+# External crates in Cargo.lock: {external} (unchanged since X1)
+# New external crates in X3: 0
+#
+# New WORKSPACE dependencies of aura-exec:
+{deps}
+#
+# Why: the lifecycle lives entirely inside aura-exec — the bytecode record
+# (CodeRecord), the version counter, the upgrade rule and the two extra entry
+# points (init, migrate) reuse the X2 session, the X0 census and the S3 overlay
+# that the crate already depends on.
+#
+# Build graph for `cargo tree -p aura-exec --edges normal`:
+#   unique lines: {default_graph}   (X1 baseline: 10, X2: 93)
+#   total lines:  {workspace_graph}
+# The growth is the C1/C3/C6/C7 stack that aura-exec now links against instead
+# of only mentioning it in comments. It is compiled into every node already.
+#
+# Engine pins unchanged: wasmi =2.0.0 (default), wasmtime =50.0.0 (feature
+# wasmtime-engine). X3 adds `Engine::entry_arity`, so a backend must be able to
+# answer "does this module export init/migrate, and with what arity" — wasmi
+# does; the wasmtime backend still refuses hosted execution with
+# SandboxError::EngineUnavailable (see docs/evidence/x3/report.md).
+"""
+    OUT.write_text(text, encoding="utf-8")
+    print(f"wrote {OUT.relative_to(REPO)}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
