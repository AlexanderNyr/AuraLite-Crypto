@@ -0,0 +1,39 @@
+name: CI
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+# C0 baseline: one honest shard. The 10 shards listed in CONTRIBUTING.md
+# (core, state, exec, consensus, net, node, wallet, ecosystem, security,
+# perf) are added by O0 as the crates that need them actually appear.
+jobs:
+  core:
+    name: core (C0 gate)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Install pinned toolchain
+        uses: dtolnay/rust-toolchain@master
+        with:
+          toolchain: 1.99.1
+          components: rustfmt, clippy
+
+      - name: deps-check
+        run: make deps-check
+
+      - name: make test
+        run: make test
+
+      - name: negative controls (C0)
+        run: make nc-c0
+
+      - name: Upload evidence
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: c0-evidence
+          path: docs/evidence/c0/
+          if-no-files-found: ignore
