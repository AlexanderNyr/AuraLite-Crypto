++    let _ = writeln!(out, "multisig_id={}", hex::encode(proposal.contract));
++    let _ = writeln!(out, "proposal_id={}", proposal.id);
++    let _ = writeln!(out, "signatures={collected}");
++    let _ = writeln!(out, "threshold={}", descriptor.threshold);
++    Ok(())
++}
