@@ -0,0 +1,86 @@
+//! H5 consensus safety gates (docs/h5-consensus-plan.md §2).
+//!
+//! The executable model must prove safety for f < n/3 and — the phase gate —
+//! must FIND the counterexample the moment the 2f+1 quorum is removed. The
+//! TLA+ spec must not drift from the pinned source.
+//! `tools/nc_h5.py` injects the bugs these tests must catch.
+
+use aura_consensus::safety_model::{
+    BftModelConfig, BftSafetyModelChecker, ModelCheckResult, TLA_SPEC_SOURCE,
+};
+
+const SPEC_FILE: &str = include_str!("../../../docs/evidence/b10/HotStuff3ChainSafety.tla");
+const MC_SPEC_FILE: &str = include_str!("../../../docs/h5/HotStuff3ChainSafetyMC.tla");
+
+#[test]
+fn h5_model_safety_and_counterexample() {
+    // Safety for f < n/3 across the validator-set table (B10 table).
+    for (n, f) in [(4u64, 1u64), (7, 2), (10, 3), (13, 4), (31, 10), (100, 33)] {
+        let config = BftModelConfig::new(n, f, 3);
+        match BftSafetyModelChecker::check(&config) {
+            ModelCheckResult::Safe {
+                min_honest_quorum_overlap,
+                ..
+            } => {
+                assert!(
+                    min_honest_quorum_overlap >= 1,
+                    "H5: safety must hold for f < n/3 ({n},{f})"
+                );
+            }
+            ModelCheckResult::Counterexample(trace) => {
+                panic!("H5: safety must hold for f < n/3 ({n},{f}): {trace:?}")
+            }
+        }
+    }
+
+    // THE GATE: remove the 2f+1 quorum check — the model must find a
+    // counterexample and name the double-signing offenders.
+    for (n, f) in [(4u64, 1u64), (7, 2), (10, 3)] {
+        let mut config = BftModelConfig::new(n, f, 3);
+        config.enforce_quorum_check = false;
+        match BftSafetyModelChecker::check(&config) {
+            ModelCheckResult::Counterexample(trace) => {
+                assert!(
+                    !trace.equivocating_validators.is_empty(),
+                    "H5: accountable safety extraction must name offenders"
+                );
+                let offenders = BftSafetyModelChecker::extract_conflicting_qc_offenders(
+                    &trace.quorum_branch_a,
+                    &trace.quorum_branch_b,
+                );
+                assert!(
+                    !offenders.is_empty(),
+                    "H5: accountable safety extraction must name offenders"
+                );
+            }
+            ModelCheckResult::Safe { .. } => {
+                panic!("H5: model must find a counterexample when 2f+1 is removed ({n},{f})")
+            }
+        }
+    }
+}
+
+#[test]
+fn h5_tla_spec_integrity() {
+    // The executable spec file and the pinned source must stay identical.
+    assert_eq!(SPEC_FILE, TLA_SPEC_SOURCE, "H5: TLA spec drift");
+    // The 2f+1 threshold and the accountable-safety invariant stay in the spec.
+    assert!(
+        TLA_SPEC_SOURCE.contains("QuorumThreshold == 2 * F + 1"),
+        "H5: TLA spec drift"
+    );
+    assert!(
+        TLA_SPEC_SOURCE.contains("AccountableSafetyInvariant"),
+        "H5: TLA spec drift"
+    );
+    // The model-checkable spec keeps both threshold shapes wired to the
+    // WeakenQuorum switch.
+    assert!(
+        MC_SPEC_FILE.contains("IF WeakenQuorum THEN F + 1 ELSE 2 * F + 1"),
+        "H5: TLA spec drift"
+    );
+    assert!(
+        MC_SPEC_FILE.contains("AccountableSafety"),
+        "H5: TLA spec drift"
+    );
+}
diff --git a/crates/aura-p2p/tests/h5_jepsen.rs b/crates/aura-p2p/tests/h5_jepsen.rs
new file mode 100644
index 0000000..5a170c3
--- /dev/null
+++ b/crates/aura-p2p/tests/h5_jepsen.rs
@@ -0,0 +1,80 @@
+//! H5 Jepsen-like runs (docs/h5-consensus-plan.md §2, D-H5-4).
+//!
+//! The N8 chaos matrix (20 scenarios × 3 runs: latency/loss/partition/
+//! eclipse) must show zero finalized-head divergence, and the divergence
+//! monitor must actually fire on a crafted divergent cluster — a monitor
+//! that never rejects is not a monitor.
+//! `tools/nc_h5.py` NC-5 disables the monitor; NC-6 truncates the matrix.
+
+use aura_p2p::chaos::{
+    ChaosNodeState, DEFAULT_STAND_NODES, canonical_20_scenarios, run_chaos_matrix,
+    verify_cluster_convergence,
+};
+use aura_p2p::dos_defence::{DosDefenceEngine, DosDefenceLimits};
+use aura_p2p::identity::PeerId;
+
+fn crafted_node(index: usize, height: u64, block: [u8; 32], root: [u8; 32]) -> ChaosNodeState {
+    let mut key = [0u8; 32];
+    key[0] = index as u8 + 1;
+    ChaosNodeState {
+        index,
+        peer_id: PeerId::from_public_key(&key),
+        is_byzantine: false,
+        finalized_height: height,
+        finalized_block_hash: block,
+        finalized_state_root: root,
+        dos_engine: DosDefenceEngine::new("h5-chain", DosDefenceLimits::default()),
+        packets_dropped: 0,
+        heights_synced_on_heal: 0,
+        eclipse_headers_rejected: 0,
+    }
+}
+
+#[test]
+fn h5_chaos_campaign_zero_divergence() {
+    let scenarios = canonical_20_scenarios();
+    assert_eq!(
+        scenarios.len(),
+        20,
+        "H5: chaos campaign must cover 20 scenarios"
+    );
+    let summary = run_chaos_matrix("h5-chain", &scenarios, 3)
+        .expect("H5: chaos campaign must cover 20 scenarios");
+    assert_eq!(
+        summary.total_runs, 60,
+        "H5: chaos campaign must cover 20 scenarios"
+    );
+    assert_eq!(
+        summary.scenarios_count * summary.runs_per_scenario,
+        summary.total_runs,
+        "H5: chaos campaign must cover 20 scenarios"
+    );
+    assert_eq!(
+        summary.divergent_runs, 0,
+        "H5: zero finalized-head divergence required"
+    );
+}
+
+#[test]
+fn h5_divergence_monitor_fires() {
+    let _ = DEFAULT_STAND_NODES;
+    // A crafted cluster where two honest nodes finalize different heads at
+    // the same height must be rejected.
+    let nodes = vec![
+        crafted_node(0, 10, [1u8; 32], [2u8; 32]),
+        crafted_node(1, 10, [9u8; 32], [2u8; 32]),
+    ];
+    assert!(
+        verify_cluster_convergence("h5-crafted", &nodes, 10).is_err(),
+        "H5: divergence monitor must fire"
+    );
+    // Sensitivity both ways: a convergent cluster must pass.
+    let converged = vec![
+        crafted_node(0, 10, [1u8; 32], [2u8; 32]),
+        crafted_node(1, 10, [1u8; 32], [2u8; 32]),
+    ];
+    assert!(
+        verify_cluster_convergence("h5-converged", &converged, 10).is_ok(),
+        "H5: divergence monitor must fire"
+    );
+}
