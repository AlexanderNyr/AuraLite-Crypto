+        ("seed_phrase_kv_24_words", "kv_quote", "seed_phrase", "words", 24, 1, "mnemonic_in_log", "ci-and-repository-fixtures"),
+        ("recovery_phrase_kv_12_words", "kv_quote", "recovery_phrase", "words", 12, 1, "mnemonic_in_log", "plaintext-disk-files"),
+        ("recovery_phrase_json_24_words", "json", "recovery_phrase", "words", 24, 1, "mnemonic_in_log", "online-hot-machine-signing"),
+        ("mnemonic_short_4_words_clean", "kv_quote", "mnemonic", "words", 4, 0, "none", "logs-and-tracing"),
+        ("mnemonic_short_8_words_clean", "kv_quote", "mnemonic", "words", 8, 0, "none", "logs-and-tracing"),
+        ("seed_phrase_short_6_words_clean", "json", "seed_phrase", "words", 6, 0, "none", "logs-and-tracing"),
+        # 29..36: PEM private-key headers vs public certificate headers
+        ("pem_pkcs8_private_key", "pem_priv", "PRIVATE", "pem", 1, 1, "pem_private_key", "plaintext-disk-files"),
+        ("pem_ed25519_private_key", "pem_priv", "ED25519 PRIVATE", "pem", 1, 1, "pem_private_key", "ci-and-repository-fixtures"),
+        ("pem_ec_private_key", "pem_priv", "EC PRIVATE", "pem", 1, 1, "pem_private_key", "plaintext-disk-files"),
+        ("pem_openssh_private_key", "pem_priv", "OPENSSH PRIVATE", "pem", 1, 1, "pem_private_key", "cli-argv-and-env"),
