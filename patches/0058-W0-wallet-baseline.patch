+        ("bip39_seed_kv_128_hex", "kv", "bip39_seed", "hex_repeat", 128, 1, "raw_seed_in_log", "process-memory-and-core-dumps"),
+        ("bip39_seed_json_128_hex", "json", "bip39_seed", "hex_repeat", 128, 1, "raw_seed_in_log", "ci-and-repository-fixtures"),
+        ("raw_seed_short_16_hex_clean", "kv", "raw_seed", "hex_repeat", 16, 0, "none", "logs-and-tracing"),
+        ("master_seed_short_8_hex_clean", "json", "master_seed", "hex_repeat", 8, 0, "none", "logs-and-tracing"),
+        # 49..64: Clean public identifiers in daemon/consensus/RPC logs
+        ("clean_public_key_kv_64_hex", "kv", "public_key", "hex_repeat", 64, 0, "none", "logs-and-tracing"),
+        ("clean_public_key_json_64_hex", "json", "public_key", "hex_repeat", 64, 0, "none", "logs-and-tracing"),
+        ("clean_pubkey_kv_64_hex", "kv", "pubkey", "hex_repeat", 64, 0, "none", "logs-and-tracing"),
+        ("clean_pubkey_json_64_hex", "json", "pubkey", "hex_repeat", 64, 0, "none", "logs-and-tracing"),
+        ("clean_block_hash_kv_64_hex", "kv", "block_hash", "hex_repeat", 64, 0, "none", "logs-and-tracing"),
+        ("clean_block_hash_json_64_hex", "json", "block_hash", "hex_repeat", 64, 0, "none", "logs-and-tracing"),
+        ("clean_state_root_kv_64_hex", "kv", "state_root", "hex_repeat", 64, 0, "none", "logs-and-tracing"),
+        ("clean_state_root_json_64_hex", "json", "state_root", "hex_repeat", 64, 0, "none", "logs-and-tracing"),
+        ("clean_tx_hash_kv_64_hex", "kv", "tx_hash", "hex_repeat", 64, 0, "none", "rpc-and-network-frames"),
+        ("clean_tx_hash_json_64_hex", "json", "tx_hash", "hex_repeat", 64, 0, "none", "rpc-and-network-frames"),
+        ("clean_txid_kv_64_hex", "kv", "txid", "hex_repeat", 64, 0, "none", "rpc-and-network-frames"),
+        ("clean_signature_kv_128_hex", "kv", "signature", "hex_repeat", 128, 0, "none", "rpc-and-network-frames"),
+        ("clean_signature_json_128_hex", "json", "signature", "hex_repeat", 128, 0, "none", "rpc-and-network-frames"),
+        ("clean_qc_hash_kv_64_hex", "kv", "qc_hash", "hex_repeat", 64, 0, "none", "logs-and-tracing"),
+        ("clean_peer_id_kv_64_hex", "kv", "peer_id", "hex_repeat", 64, 0, "none", "logs-and-tracing"),
+        ("clean_code_hash_kv_64_hex", "kv", "code_hash", "hex_repeat", 64, 0, "none", "logs-and-tracing"),
