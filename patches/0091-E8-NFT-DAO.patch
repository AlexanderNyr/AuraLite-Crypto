@@ -0,0 +1,897 @@
+//! E8 NFT + names + identity: ARC-721 single tokens, ARC-1155 multi
+//! tokens, the `.aura` name service and on-chain identity records
+//! (ECOSYSTEM_PLAN E8).
+//!
+//! The model mirrors the pinned golden suite
+//! `tests/fixtures/e8-standards.txt` (50 vectors, generated by
+//! `tools/gen_e8_vectors.py`) and is cross-run against the independent
+//! Python model `tools/e8_nft_check.py`.
+//!
+//! # ARC-721 (per `standards/arc721`, X5)
+//!
+//! A token exists exactly when its owner slot is present — a burned id
+//! may be minted again. Every transfer (owner or approved spender)
+//! deletes the approval slot: keeping it would let a spender move the
+//! token after the owner handed it to someone else (the classic
+//! stale-approval bug). Balances are per-account counters.
+//!
+//! # ARC-1155
+//!
+//! One contract, many ids; each id has its own supply (supply 1 = NFT
+//! semantics, supply > 1 = fungible). A holder may grant an **operator**
+//! (`set_operator`) the right to move any of their ids; batch transfers
+//! are all-or-nothing and check every leg before applying any.
+//!
+//! # `.aura` names (ENS-shaped)
+//!
+//! Registry records: owner, target (resolution address) and expiry.
+//! A registration lasts [`TERM_DAYS`]; after expiry the name stays
+//! resolvable for [`GRACE_DAYS`] (anyone may renew), then resolution
+//! fails with `E8: name expired` and the name can be registered again.
+//! Transfer clears the old owner's primary name. Identity records bind
+//! a metadata digest to a live name; only the name owner may set them.
+
+use std::collections::BTreeMap;
+use std::fmt;
+
+/// Registration / renewal term in days.
+pub const TERM_DAYS: u64 = 365;
+
+/// Grace period after expiry during which the name still resolves.
+pub const GRACE_DAYS: u64 = 90;
+
+/// Errors carry the exact `E8: …` named messages pinned by the suite.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum E8Error {
+    /// Only the collection owner may mint or set URIs.
+    NotCollectionOwner {
+        /// Offending actor.
+        actor: String,
+    },
+    /// Mint over an existing token id.
+    TokenExists {
+        /// Duplicate token id.
+        id: u64,
+    },
+    /// Operation on a token that does not exist.
+    TokenMissing {
+        /// Unknown token id.
+        id: u64,
+    },
+    /// Caller is not the token owner.
+    NotTokenOwner {
+        /// Offending actor.
+        actor: String,
+        /// Token id.
+        id: u64,
+    },
+    /// Caller is neither owner nor approved operator.
+    NotApproved {
+        /// Offending actor.
+        actor: String,
+        /// Token id.
+        id: u64,
+    },
+    /// The zero address is never a valid party.
+    ZeroAddress,
+    /// Amounts must be positive.
+    ZeroAmount,
+    /// Balance below the requested amount.
+    Insufficient {
+        /// Holding account.
+        actor: String,
+        /// Token id.
+        id: u64,
+        /// Actual balance.
+        have: u128,
+        /// Requested amount.
+        need: u128,
+    },
+    /// Batch ids and amounts must line up.
+    BatchLen {
+        /// Number of ids.
+        ids: usize,
+        /// Number of amounts.
+        amounts: usize,
+    },
+    /// Name taken while live (or in grace).
+    NameTaken {
+        /// Contested name.
+        name: String,
+    },
+    /// Unknown name.
+    NameMissing {
+        /// Unknown name.
+        name: String,
+    },
+    /// Name failed validation.
+    InvalidName {
+        /// Rejected name.
+        name: String,
+    },
+    /// Name past expiry + grace.
+    NameExpired {
+        /// Expired name.
+        name: String,
+    },
+    /// Caller does not own the name.
+    NotNameOwner {
+        /// Offending actor.
+        actor: String,
+        /// Name in question.
+        name: String,
+    },
+    /// No identity record for the name.
+    NoIdentity {
+        /// Name without an identity record.
+        name: String,
+    },
+    /// Unknown proposal id.
+    ProposalMissing {
+        /// Unknown proposal id.
+        id: u32,
+    },
+    /// Proposer stake below the threshold.
+    BelowProposalThreshold {
+        /// Proposer voter id.
+        proposer: u32,
+    },
+    /// The UI rejects a second vote by the same voter.
+    VoteCast {
+        /// Proposal in question.
+        proposal: u32,
+        /// Voter in question.
+        voter: u32,
+    },
+    /// Snapshot voting power is zero.
+    NoVotingPower {
+        /// Voter with zero snapshot power.
+        voter: u32,
+    },
+    /// Vote after the voting period closed.
+    VotingClosed {
+        /// Proposal in question.
+        proposal: u32,
+    },
+    /// Finalize before the voting period closed.
+    VotingStillOpen {
+        /// Proposal in question.
+        proposal: u32,
+    },
+    /// Finalize on an already final proposal.
+    AlreadyFinalized {
+        /// Proposal in question.
+        proposal: u32,
+    },
+    /// Execute or veto a proposal that did not pass.
+    NotPassed {
+        /// Proposal in question.
+        proposal: u32,
+    },
+    /// Execute before the timelock elapsed.
+    TimelockNotReached {
+        /// Proposal in question.
+        proposal: u32,
+    },
+    /// Execute twice.
+    AlreadyExecuted {
+        /// Proposal in question.
+        proposal: u32,
+    },
+    /// Veto after the sunset block.
+    VetoSunset,
+}
+
+impl fmt::Display for E8Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::NotCollectionOwner { actor } => {
+                write!(f, "E8: not collection owner ({actor})")
+            }
+            Self::TokenExists { id } => write!(f, "E8: token already exists ({id})"),
+            Self::TokenMissing { id } => write!(f, "E8: token does not exist ({id})"),
+            Self::NotTokenOwner { actor, id } => {
+                write!(f, "E8: not token owner ({actor}/{id})")
+            }
+            Self::NotApproved { actor, id } => {
+                write!(f, "E8: not approved ({actor}/{id})")
+            }
+            Self::ZeroAddress => write!(f, "E8: zero address"),
+            Self::ZeroAmount => write!(f, "E8: amount must be positive"),
+            Self::Insufficient {
+                actor,
+                id,
+                have,
+                need,
+            } => write!(f, "E8: insufficient balance ({actor}/{id}/{have}/{need})"),
+            Self::BatchLen { ids, amounts } => {
+                write!(f, "E8: batch length mismatch ({ids}/{amounts})")
+            }
+            Self::NameTaken { name } => {
+                write!(f, "E8: name already registered ({name})")
+            }
+            Self::NameMissing { name } => {
+                write!(f, "E8: name not registered ({name})")
+            }
+            Self::InvalidName { name } => write!(f, "E8: invalid name ({name})"),
+            Self::NameExpired { name } => write!(f, "E8: name expired ({name})"),
+            Self::NotNameOwner { actor, name } => {
+                write!(f, "E8: not name owner ({actor}/{name})")
+            }
+            Self::NoIdentity { name } => {
+                write!(f, "E8: no identity record ({name})")
+            }
+            Self::ProposalMissing { id } => {
+                write!(f, "E8: proposal not found ({id})")
+            }
+            Self::BelowProposalThreshold { proposer } => {
+                write!(f, "E8: below proposal threshold ({proposer})")
+            }
+            Self::VoteCast { proposal, voter } => {
+                write!(f, "E8: vote already cast ({proposal}/{voter})")
+            }
+            Self::NoVotingPower { voter } => {
+                write!(f, "E8: no voting power ({voter})")
+            }
+            Self::VotingClosed { proposal } => {
+                write!(f, "E8: voting closed ({proposal})")
+            }
+            Self::VotingStillOpen { proposal } => {
+                write!(f, "E8: voting still open ({proposal})")
+            }
+            Self::AlreadyFinalized { proposal } => {
+                write!(f, "E8: proposal already finalized ({proposal})")
+            }
+            Self::NotPassed { proposal } => write!(f, "E8: not passed ({proposal})"),
+            Self::TimelockNotReached { proposal } => {
+                write!(f, "E8: timelock not reached ({proposal})")
+            }
+            Self::AlreadyExecuted { proposal } => {
+                write!(f, "E8: already executed ({proposal})")
+            }
+            Self::VetoSunset => write!(f, "E8: veto power has sunset"),
+        }
+    }
+}
+
+impl std::error::Error for E8Error {}
+
+/// One `.aura` name record.
+#[derive(Debug, Clone)]
+struct NameRecord {
+    owner: String,
+    target: String,
+    expiry: u64,
+}
+
+/// The deterministic E8 model: ARC-721 + ARC-1155 + names + identity.
+#[derive(Debug, Clone, Default)]
+pub struct NftWorld {
+    owner721: BTreeMap<u64, String>,
+    approved: BTreeMap<u64, String>,
+    bal721: BTreeMap<String, u128>,
+    supply721: u128,
+    bal1155: BTreeMap<(String, u64), u128>,
+    supply1155: BTreeMap<u64, u128>,
+    uri1155: BTreeMap<u64, String>,
+    operator: BTreeMap<(String, String), bool>,
+    names: BTreeMap<String, NameRecord>,
+    primary: BTreeMap<String, String>,
+    identity: BTreeMap<String, String>,
+    day: u64,
+}
+
+impl NftWorld {
+    /// Fresh empty world.
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    fn bal721_of(&self, who: &str) -> u128 {
+        self.bal721.get(who).copied().unwrap_or(0)
+    }
+
+    fn bal1155_of(&self, who: &str, id: u64) -> u128 {
+        self.bal1155
+            .get(&(String::from(who), id))
+            .copied()
+            .unwrap_or(0)
+    }
+
+    // ------------------------------------------------------------ 721
+
+    /// Mint a fresh token id to `to`; collection owner only.
+    pub fn mint721(&mut self, by: &str, to: &str, id: u64) -> Result<(), E8Error> {
+        if by != "root" {
+            return Err(E8Error::NotCollectionOwner {
+                actor: String::from(by),
+            });
+        }
+        if to == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        if self.owner721.contains_key(&id) {
+            return Err(E8Error::TokenExists { id });
+        }
+        self.owner721.insert(id, String::from(to));
+        *self.bal721.entry(String::from(to)).or_insert(0) += 1;
+        self.supply721 += 1;
+        Ok(())
+    }
+
+    /// Transfer a token the caller owns; clears the approval slot.
+    pub fn transfer721(&mut self, by: &str, id: u64, to: &str) -> Result<(), E8Error> {
+        match self.owner721.get(&id) {
+            None => return Err(E8Error::TokenMissing { id }),
+            Some(owner) if owner != by => {
+                return Err(E8Error::NotTokenOwner {
+                    actor: String::from(by),
+                    id,
+                });
+            }
+            Some(_) => {}
+        }
+        if to == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        *self.bal721.entry(String::from(by)).or_insert(0) -= 1;
+        *self.bal721.entry(String::from(to)).or_insert(0) += 1;
+        self.owner721.insert(id, String::from(to));
+        self.approved.remove(&id);
+        Ok(())
+    }
+
+    /// Approve a spender for one token (owner only).
+    pub fn approve721(&mut self, by: &str, id: u64, spender: &str) -> Result<(), E8Error> {
+        match self.owner721.get(&id) {
+            None => return Err(E8Error::TokenMissing { id }),
+            Some(owner) if owner != by => {
+                return Err(E8Error::NotTokenOwner {
+                    actor: String::from(by),
+                    id,
+                });
+            }
+            Some(_) => {}
+        }
+        if spender == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        self.approved.insert(id, String::from(spender));
+        Ok(())
+    }
+
+    /// Move a token on behalf of its owner (approved spender only);
+    /// clears the approval slot exactly like an owner transfer.
+    pub fn transfer_from721(&mut self, by: &str, id: u64, to: &str) -> Result<(), E8Error> {
+        if !self.owner721.contains_key(&id) {
+            return Err(E8Error::TokenMissing { id });
+        }
+        if to == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        if self.approved.get(&id).map(String::as_str) != Some(by) {
+            return Err(E8Error::NotApproved {
+                actor: String::from(by),
+                id,
+            });
+        }
+        let from = self.owner721.get(&id).cloned().expect("checked");
+        *self.bal721.entry(from).or_insert(0) -= 1;
+        *self.bal721.entry(String::from(to)).or_insert(0) += 1;
+        self.owner721.insert(id, String::from(to));
+        self.approved.remove(&id);
+        Ok(())
+    }
+
+    /// Destroy a token the caller owns; the id may be minted again.
+    pub fn burn721(&mut self, by: &str, id: u64) -> Result<(), E8Error> {
+        match self.owner721.get(&id) {
+            None => return Err(E8Error::TokenMissing { id }),
+            Some(owner) if owner != by => {
+                return Err(E8Error::NotTokenOwner {
+                    actor: String::from(by),
+                    id,
+                });
+            }
+            Some(_) => {}
+        }
+        self.owner721.remove(&id);
+        self.approved.remove(&id);
+        *self.bal721.entry(String::from(by)).or_insert(0) -= 1;
+        self.supply721 -= 1;
+        Ok(())
+    }
+
+    /// Owner of a token (fails if absent).
+    pub fn owner_of(&self, id: u64) -> Result<&str, E8Error> {
+        self.owner721
+            .get(&id)
+            .map(String::as_str)
+            .ok_or(E8Error::TokenMissing { id })
+    }
+
+    /// Approved spender of a token (`"none"` when unset).
+    pub fn get_approved(&self, id: u64) -> &str {
+        self.approved.get(&id).map(String::as_str).unwrap_or("none")
+    }
+
+    /// How many 721 tokens `who` holds.
+    pub fn balance721(&self, who: &str) -> u128 {
+        self.bal721_of(who)
+    }
+
+    /// How many 721 tokens exist.
+    pub fn supply721(&self) -> u128 {
+        self.supply721
+    }
+
+    /// Resolve one fixture read key (`owner_of:1`, `balance721:alice`,
+    /// `supply721`, `approved:1`, `balance1155:alice:100`,
+    /// `supply1155:100`, `uri:100`, `resolve:alice.aura`,
+    /// `name_owner:alice.aura`, `expiry:alice.aura`, `reverse:bob`,
+    /// `identity:alice.aura`) to its exact value string. Absent values
+    /// read `"none"`.
+    pub fn query(&self, key: &str) -> String {
+        let (head, rest) = key.split_once(':').unwrap_or((key, ""));
+        match head {
+            "owner_of" => {
+                let id: u64 = rest.parse().expect("owner_of id");
+                self.owner721
+                    .get(&id)
+                    .cloned()
+                    .unwrap_or_else(|| String::from("none"))
+            }
+            "approved" => {
+                let id: u64 = rest.parse().expect("approved id");
+                String::from(self.get_approved(id))
+            }
+            "supply721" => self.supply721.to_string(),
+            "balance721" => self.bal721_of(rest).to_string(),
+            "balance1155" => {
+                let (who, id) = rest.rsplit_once(':').expect("balance1155 who:id");
+                let id: u64 = id.parse().expect("balance1155 id");
+                self.bal1155_of(who, id).to_string()
+            }
+            "supply1155" => {
+                let id: u64 = rest.parse().expect("supply1155 id");
+                self.supply1155(id).to_string()
+            }
+            "uri" => {
+                let id: u64 = rest.parse().expect("uri id");
+                String::from(self.uri(id))
+            }
+            "resolve" => self.resolve(rest, self.day).unwrap_or("none").to_string(),
+            "name_owner" => self.name_owner(rest).unwrap_or("none").to_string(),
+            "expiry" => self
+                .name_expiry(rest)
+                .map(|d| d.to_string())
+                .unwrap_or_else(|_| String::from("none")),
+            "reverse" => String::from(self.reverse(rest)),
+            "identity" => self.identity(rest).unwrap_or("none").to_string(),
+            "day" => self.day.to_string(),
+            "operator" => {
+                let (holder, op) = rest.rsplit_once(':').expect("operator holder:op");
+                let on = self
+                    .operator
+                    .get(&(String::from(holder), String::from(op)))
+                    .copied()
+                    .unwrap_or(false);
+                String::from(if on { "true" } else { "false" })
+            }
+            other => panic!("unknown read key: {other}"),
+        }
+    }
+
+    // ----------------------------------------------------------- 1155
+
+    /// Mint `amount` of id `to`; collection owner only.
+    pub fn mint1155(&mut self, by: &str, to: &str, id: u64, amount: u128) -> Result<(), E8Error> {
+        if by != "root" {
+            return Err(E8Error::NotCollectionOwner {
+                actor: String::from(by),
+            });
+        }
+        if to == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        if amount == 0 {
+            return Err(E8Error::ZeroAmount);
+        }
+        *self.bal1155.entry((String::from(to), id)).or_insert(0) += amount;
+        *self.supply1155.entry(id).or_insert(0) += amount;
+        Ok(())
+    }
+
+    /// Move `amount` of id from `frm` to `to`; `by` must be `frm` or its
+    /// operator.
+    pub fn transfer1155(
+        &mut self,
+        frm: &str,
+        by: &str,
+        id: u64,
+        to: &str,
+        amount: u128,
+    ) -> Result<(), E8Error> {
+        if to == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        if amount == 0 {
+            return Err(E8Error::ZeroAmount);
+        }
+        let approved = by == frm
+            || self
+                .operator
+                .get(&(String::from(frm), String::from(by)))
+                .copied()
+                .unwrap_or(false);
+        if !approved {
+            return Err(E8Error::NotApproved {
+                actor: String::from(by),
+                id,
+            });
+        }
+        let have = self.bal1155_of(frm, id);
+        if have < amount {
+            return Err(E8Error::Insufficient {
+                actor: String::from(frm),
+                id,
+                have,
+                need: amount,
+            });
+        }
+        self.bal1155.insert((String::from(frm), id), have - amount);
+        *self.bal1155.entry((String::from(to), id)).or_insert(0) += amount;
+        Ok(())
+    }
+
+    /// Grant or revoke `operator` over the caller's 1155 balances.
+    pub fn set_operator(
+        &mut self,
+        by: &str,
+        operator: &str,
+        approved: bool,
+    ) -> Result<(), E8Error> {
+        if operator == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        self.operator
+            .insert((String::from(by), String::from(operator)), approved);
+        Ok(())
+    }
+
+    /// All-or-nothing batch move; every leg is checked before any is
+    /// applied.
+    pub fn transfer_batch1155(
+        &mut self,
+        frm: &str,
+        by: &str,
+        to: &str,
+        ids: &[u64],
+        amounts: &[u128],
+    ) -> Result<(), E8Error> {
+        if ids.len() != amounts.len() {
+            return Err(E8Error::BatchLen {
+                ids: ids.len(),
+                amounts: amounts.len(),
+            });
+        }
+        if to == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        let approved = by == frm
+            || self
+                .operator
+                .get(&(String::from(frm), String::from(by)))
+                .copied()
+                .unwrap_or(false);
+        if !approved {
+            return Err(E8Error::NotApproved {
+                actor: String::from(by),
+                id: ids[0],
+            });
+        }
+        for (id, amount) in ids.iter().zip(amounts) {
+            if *amount == 0 {
+                return Err(E8Error::ZeroAmount);
+            }
+            let have = self.bal1155_of(frm, *id);
+            if have < *amount {
+                return Err(E8Error::Insufficient {
+                    actor: String::from(frm),
+                    id: *id,
+                    have,
+                    need: *amount,
+                });
+            }
+        }
+        for (id, amount) in ids.iter().zip(amounts) {
+            let have = self.bal1155_of(frm, *id);
+            self.bal1155.insert((String::from(frm), *id), have - amount);
+            *self.bal1155.entry((String::from(to), *id)).or_insert(0) += amount;
+        }
+        Ok(())
+    }
+
+    /// Set the metadata URI of an id; collection owner only.
+    pub fn set_uri(&mut self, by: &str, id: u64, uri: &str) -> Result<(), E8Error> {
+        if by != "root" {
+            return Err(E8Error::NotCollectionOwner {
+                actor: String::from(by),
+            });
+        }
+        self.uri1155.insert(id, String::from(uri));
+        Ok(())
+    }
+
+    /// URI of an id (`"none"` when unset).
+    pub fn uri(&self, id: u64) -> &str {
+        self.uri1155.get(&id).map(String::as_str).unwrap_or("none")
+    }
+
+    /// How much of id `who` holds.
+    pub fn balance1155(&self, who: &str, id: u64) -> u128 {
+        self.bal1155_of(who, id)
+    }
+
+    /// Circulating supply of id.
+    pub fn supply1155(&self, id: u64) -> u128 {
+        self.supply1155.get(&id).copied().unwrap_or(0)
+    }
+
+    // ----------------------------------------------------------- names
+
+    /// A `.aura` name: lowercase label 1..=32 of `a-z0-9-`, alphanumeric
+    /// at both ends, plus the `.aura` suffix.
+    pub fn valid_name(name: &str) -> bool {
+        let Some(label) = name.strip_suffix(".aura") else {
+            return false;
+        };
+        if label.is_empty() || label.len() > 32 {
+            return false;
+        }
+        let alnum = |c: char| c.is_ascii_lowercase() || c.is_ascii_digit();
+        if !label.chars().all(|c| alnum(c) || c == '-') {
+            return false;
+        }
+        alnum(label.chars().next().expect("non-empty"))
+            && alnum(label.chars().last().expect("non-empty"))
+    }
+
+    /// Register `name` to `by` at `day`; fails while the name is live or
+    /// in grace.
+    pub fn register_name(&mut self, by: &str, name: &str, day: u64) -> Result<(), E8Error> {
+        self.day = day;
+        if !Self::valid_name(name) {
+            return Err(E8Error::InvalidName {
+                name: String::from(name),
+            });
+        }
+        if self
+            .names
+            .get(name)
+            .is_some_and(|rec| day <= rec.expiry + GRACE_DAYS)
+        {
+            return Err(E8Error::NameTaken {
+                name: String::from(name),
+            });
+        }
+        self.names.insert(
+            String::from(name),
+            NameRecord {
+                owner: String::from(by),
+                target: String::from(by),
+                expiry: day + TERM_DAYS,
+            },
+        );
+        Ok(())
+    }
+
+    /// Extend a registration by [`TERM_DAYS`] (anyone may renew).
+    pub fn renew_name(&mut self, name: &str, day: u64) -> Result<(), E8Error> {
+        self.day = day;
+        let rec = self
+            .names
+            .get_mut(name)
+            .ok_or_else(|| E8Error::NameMissing {
+                name: String::from(name),
+            })?;
+        let base = day.max(rec.expiry);
+        rec.expiry = base + TERM_DAYS;
+        Ok(())
+    }
+
+    /// Transfer name ownership; clears the old owner's primary name.
+    pub fn transfer_name(
+        &mut self,
+        by: &str,
+        name: &str,
+        to: &str,
+        day: u64,
+    ) -> Result<(), E8Error> {
+        self.day = day;
+        let rec = self.names.get(name).ok_or_else(|| E8Error::NameMissing {
+            name: String::from(name),
+        })?;
+        if day > rec.expiry + GRACE_DAYS {
+            return Err(E8Error::NameExpired {
+                name: String::from(name),
+            });
+        }
+        if rec.owner != by {
+            return Err(E8Error::NotNameOwner {
+                actor: String::from(by),
+                name: String::from(name),
+            });
+        }
+        if to == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        if self.primary.get(by).map(String::as_str) == Some(name) {
+            self.primary.remove(by);
+        }
+        let rec = self.names.get_mut(name).expect("checked");
+        rec.owner = String::from(to);
+        Ok(())
+    }
+
+    /// Set the resolution target of a name (owner only, name live).
+    pub fn set_target(
+        &mut self,
+        by: &str,
+        name: &str,
+        target: &str,
+        day: u64,
+    ) -> Result<(), E8Error> {
+        self.day = day;
+        let rec = self.names.get(name).ok_or_else(|| E8Error::NameMissing {
+            name: String::from(name),
+        })?;
+        if day > rec.expiry + GRACE_DAYS {
+            return Err(E8Error::NameExpired {
+                name: String::from(name),
+            });
+        }
+        if rec.owner != by {
+            return Err(E8Error::NotNameOwner {
+                actor: String::from(by),
+                name: String::from(name),
+            });
+        }
+        if target == "zero" {
+            return Err(E8Error::ZeroAddress);
+        }
+        let rec = self.names.get_mut(name).expect("checked");
+        rec.target = String::from(target);
+        Ok(())
+    }
+
+    /// Resolve a name to its target; fails when unknown or past expiry +
+    /// grace.
+    pub fn resolve(&self, name: &str, day: u64) -> Result<&str, E8Error> {
+        let rec = self.names.get(name).ok_or_else(|| E8Error::NameMissing {
+            name: String::from(name),
+        })?;
+        if day > rec.expiry + GRACE_DAYS {
+            return Err(E8Error::NameExpired {
+                name: String::from(name),
+            });
+        }
+        Ok(&rec.target)
+    }
+
+    /// Set the caller's primary (reverse) name.
+    pub fn set_primary(&mut self, by: &str, name: &str, day: u64) -> Result<(), E8Error> {
+        self.day = day;
+        let rec = self.names.get(name).ok_or_else(|| E8Error::NameMissing {
+            name: String::from(name),
+        })?;
+        if day > rec.expiry + GRACE_DAYS {
+            return Err(E8Error::NameExpired {
+                name: String::from(name),
+            });
+        }
+        if rec.owner != by {
+            return Err(E8Error::NotNameOwner {
+                actor: String::from(by),
+                name: String::from(name),
+            });
+        }
+        self.primary.insert(String::from(by), String::from(name));
+        Ok(())
+    }
+
+    /// Reverse resolution: the primary name of `who` (`"none"`).
+    pub fn reverse(&self, who: &str) -> &str {
+        self.primary.get(who).map(String::as_str).unwrap_or("none")
+    }
+
+    /// Jump the clock (days are explicit in every name op).
+    pub fn advance_day(&mut self, day: u64) {
+        self.day = day;
+    }
+
+    /// Current day.
+    pub fn day(&self) -> u64 {
+        self.day
+    }
+
+    /// Owner of a registered name.
+    pub fn name_owner(&self, name: &str) -> Result<&str, E8Error> {
+        self.names
+            .get(name)
+            .map(|rec| rec.owner.as_str())
+            .ok_or_else(|| E8Error::NameMissing {
+                name: String::from(name),
+            })
+    }
+
+    /// Expiry day of a registered name.
+    pub fn name_expiry(&self, name: &str) -> Result<u64, E8Error> {
+        self.names
+            .get(name)
+            .map(|rec| rec.expiry)
+            .ok_or_else(|| E8Error::NameMissing {
+                name: String::from(name),
+            })
+    }
+
+    // -------------------------------------------------------- identity
+
+    /// Bind a metadata digest to a live name (owner only).
+    pub fn set_identity(
+        &mut self,
+        by: &str,
+        name: &str,
+        digest: &str,
+        day: u64,
+    ) -> Result<(), E8Error> {
+        self.day = day;
+        let rec = self.names.get(name).ok_or_else(|| E8Error::NameMissing {
+            name: String::from(name),
+        })?;
+        if day > rec.expiry + GRACE_DAYS {
+            return Err(E8Error::NameExpired {
+                name: String::from(name),
+            });
+        }
+        if rec.owner != by {
+            return Err(E8Error::NotNameOwner {
+                actor: String::from(by),
+                name: String::from(name),
+            });
+        }
+        self.identity
+            .insert(String::from(name), String::from(digest));
+        Ok(())
+    }
+
+    /// Remove the identity record (owner only).
+    pub fn clear_identity(&mut self, by: &str, name: &str) -> Result<(), E8Error> {
+        let rec = self.names.get(name).ok_or_else(|| E8Error::NameMissing {
+            name: String::from(name),
+        })?;
+        if rec.owner != by {
+            return Err(E8Error::NotNameOwner {
+                actor: String::from(by),
+                name: String::from(name),
+            });
+        }
+        self.identity.remove(name);
+        Ok(())
+    }
+
+    /// Read the identity digest of a name.
+    pub fn identity(&self, name: &str) -> Result<&str, E8Error> {
+        if !self.names.contains_key(name) {
+            return Err(E8Error::NameMissing {
+                name: String::from(name),
+            });
+        }
+        self.identity
+            .get(name)
+            .map(String::as_str)
+            .ok_or_else(|| E8Error::NoIdentity {
+                name: String::from(name),
+            })
+    }
+}
