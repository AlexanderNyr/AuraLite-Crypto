+// ---------------------------------------------------------- metamorphisms
+
+#[test]
+fn e8_meta_batch_equals_sequential() {
+    let ids = [7u64, 8];
+    let amounts = [5u128, 9];
+    let mut batch = NftWorld::new();
+    let mut seq = NftWorld::new();
+    for w in [&mut batch, &mut seq] {
+        w.mint1155("root", "alice", 7, 5).unwrap();
+        w.mint1155("root", "alice", 8, 9).unwrap();
+    }
+    batch
+        .transfer_batch1155("alice", "alice", "bob", &ids, &amounts)
+        .unwrap();
+    for (id, amount) in ids.iter().zip(amounts) {
+        seq.transfer1155("alice", "alice", *id, "bob", amount)
+            .unwrap();
+    }
+    for (who, id) in [("alice", 7), ("alice", 8), ("bob", 7), ("bob", 8)] {
+        assert_eq!(
+            batch.balance1155(who, id),
+            seq.balance1155(who, id),
+            "{who}/{id}"
+        );
+    }
+}
+
+#[test]
+fn e8_meta_mint_order_independent() {
+    let mut a = NftWorld::new();
+    let mut b = NftWorld::new();
+    for (to, id) in [("alice", 3u64), ("bob", 1), ("carol", 2)] {
+        a.mint721("root", to, id).unwrap();
+    }
+    for (to, id) in [("carol", 2u64), ("bob", 1), ("alice", 3)] {
+        b.mint721("root", to, id).unwrap();
+    }
+    for id in [1u64, 2, 3] {
+        assert_eq!(a.owner_of(id).unwrap(), b.owner_of(id).unwrap());
+    }
+    assert_eq!(a.supply721(), b.supply721());
+}
+
+#[test]
+fn e8_meta_vote_order_independent() {
+    let k = |n: u128| n * ALCRY;
+    let run_votes = |order: [u32; 3]| {
+        let mut ui = DaoUi::new(
+            vec![k(250_000), k(150_000), k(100_000), k(75_000)],
+            ["alice", "bob", "carol", "dave"]
+                .iter()
+                .map(|s| String::from(*s))
+                .collect(),
+        );
+        let id = ui.propose(0, 1000).unwrap();
+        let mut height = 2000;
+        for voter in order {
+            let support = if voter == 3 {
+                Support::No
+            } else {
+                Support::Yes
+            };
+            ui.vote(id, voter, support, height).unwrap();
+            height += 1000;
+        }
+        ui.tally(id)
+    };
+    assert_eq!(run_votes([1, 2, 3]), run_votes([3, 2, 1]));
+}
+
+#[test]
+fn e8_determinism() {
+    let a = run_e8_scenario();
+    let b = run_e8_scenario();
+    assert_eq!(a.steps, b.steps);
+    assert_eq!(scenario_digest(&a.steps), scenario_digest(&b.steps));
+    assert_eq!(a.tally, b.tally);
+}
+
+// ------------------------------------------------------------- unit surface
+
+#[test]
+fn e8_valid_name_rules() {
+    assert!(NftWorld::valid_name("alice.aura"));
+    assert!(NftWorld::valid_name("a1.aura"));
+    assert!(NftWorld::valid_name("a-b-c.aura"));
+    assert!(!NftWorld::valid_name("Alice.aura"));
+    assert!(!NftWorld::valid_name("-alice.aura"));
+    assert!(!NftWorld::valid_name("alice-.aura"));
+    assert!(!NftWorld::valid_name("al..aura"));
+    assert!(!NftWorld::valid_name("alice.eth"));
+    assert!(!NftWorld::valid_name(".aura"));
+    assert!(!NftWorld::valid_name(&format!("{}.aura", "a".repeat(33))));
+    assert!(NftWorld::valid_name(&format!("{}.aura", "a".repeat(32))));
+}
+
+#[test]
+fn e8_uri_and_term_constants() {
+    let mut w = NftWorld::new();
+    assert_eq!(w.uri(5), "none");
+    w.set_uri("root", 5, "ipfs://e8").unwrap();
+    assert_eq!(w.uri(5), "ipfs://e8");
+    assert_eq!(
+        w.set_uri("alice", 5, "ipfs://bad").unwrap_err().to_string(),
+        "E8: not collection owner (alice)"
+    );
+    assert_eq!(TERM_DAYS, 365);
+    assert_eq!(GRACE_DAYS, 90);
+}
+
+#[test]
+fn e8_name_lifecycle_constants() {
+    // Registration -> expiry boundary -> grace -> re-register, pinned.
+    let mut w = NftWorld::new();
+    w.register_name("alice", "alice.aura", 1).unwrap();
+    assert_eq!(w.name_expiry("alice.aura").unwrap(), 1 + TERM_DAYS);
+    assert_eq!(
+        w.resolve("alice.aura", 1 + TERM_DAYS + GRACE_DAYS).unwrap(),
+        "alice"
+    );
+    assert_eq!(
+        w.resolve("alice.aura", 1 + TERM_DAYS + GRACE_DAYS + 1)
+            .unwrap_err()
+            .to_string(),
+        "E8: name expired (alice.aura)"
+    );
+    w.register_name("eve", "alice.aura", 1 + TERM_DAYS + GRACE_DAYS + 1)
+        .unwrap();
+    assert_eq!(w.name_owner("alice.aura").unwrap(), "eve");
+    // ProposalState machine covers the DAO states the page renders.
+    let _ = ProposalState::Voting;
+}
