+#!/usr/bin/env python3
+"""E8 NFT + names + identity + DAO UI deterministic model check
+(ECOSYSTEM_PLAN E8).
+
+Independent Python model for `crates/aura-storage/src/nft.rs` +
+`src/dao_ui.rs`. It re-executes the pinned golden fixture
+`crates/aura-storage/tests/fixtures/e8-standards.txt` (50 standard
+vectors, generated by `tools/gen_e8_vectors.py`), rebuilds the vectors
+digest, replays the DAO scenario (the first vote cast through the UI),
+mirrors the governance UI HTML byte for byte and prints exactly the
+three pinned lines the Rust example
+`crates/aura-storage/examples/e8_nft_example.rs` prints:
+
+    E8-VECTORS-OK 50
+    E8-UI-OK <sha256 of governance-ui.html>
+    E8-SIM-OK {"vectors": 50, ...}
+
+Writes `sim/e8-dao.json` and `sim/e8-governance-ui.html`.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+FIXTURE = REPO / "crates/aura-storage/tests/fixtures/e8-standards.txt"
+
+ALCRY = 10**18
+TERM_DAYS = 365
+GRACE_DAYS = 90
+ZERO = "zero"
+
+VECTORS_DIGEST = "8cb9da945b0eed8f4432d31b71d20fffb72a6317fc90204d1890bd480c062bd3"
+SCENARIO_DIGEST = "17fd44850375c54c9cf9826b8ed55da0faf1855da72514184c83501f07409d71"
+UI_HTML_SHA = "bf1486e2f6475ebaffdc473a75d4fbd39e303869c803269b63c64d1ec851167f"
+SIM_LINE = (
+    '{"vectors": 50, "vectors_ok": true, "first_vote": [1, 1, "yes"], '
+    '"ui_votes": 4, "tally_yes": 250000, "tally_no": 75000, '
+    '"tally_abstain": 25000, "state": "executed"}'
+)
+
+# ------------------------------------------------------------- model
+
+
+class E8Error(Exception):
+    pass
+
+
+class Model:
+    """Semantics mirror of crates/aura-storage/src/nft.rs."""
+
+    def __init__(self) -> None:
+        self.owner721: dict[int, str] = {}
+        self.approved: dict[int, str] = {}
+        self.bal721: dict[str, int] = {}
+        self.supply721 = 0
+        self.bal1155: dict[tuple[str, int], int] = {}
+        self.supply1155: dict[int, int] = {}
+        self.uri1155: dict[int, str] = {}
+        self.operator: dict[tuple[str, str], bool] = {}
+        self.names: dict[str, dict] = {}
+        self.primary: dict[str, str] = {}
+        self.identity: dict[str, str] = {}
+        self.day = 0
+
+    def mint721(self, by, to, id):
+        if by != "root":
+            raise E8Error(f"E8: not collection owner ({by})")
+        if to == ZERO:
+            raise E8Error("E8: zero address")
+        if id in self.owner721:
+            raise E8Error(f"E8: token already exists ({id})")
+        self.owner721[id] = to
+        self.bal721[to] = self.bal721.get(to, 0) + 1
+        self.supply721 += 1
+
+    def transfer721(self, by, id, to):
+        if id not in self.owner721:
+            raise E8Error(f"E8: token does not exist ({id})")
+        if self.owner721[id] != by:
+            raise E8Error(f"E8: not token owner ({by}/{id})")
+        if to == ZERO:
+            raise E8Error("E8: zero address")
+        self.bal721[by] -= 1
+        self.bal721[to] = self.bal721.get(to, 0) + 1
+        self.owner721[id] = to
+        self.approved.pop(id, None)
+
+    def approve721(self, by, id, spender):
+        if id not in self.owner721:
+            raise E8Error(f"E8: token does not exist ({id})")
+        if self.owner721[id] != by:
+            raise E8Error(f"E8: not token owner ({by}/{id})")
+        if spender == ZERO:
+            raise E8Error("E8: zero address")
+        self.approved[id] = spender
+
+    def transfer_from721(self, by, id, to):
+        if id not in self.owner721:
+            raise E8Error(f"E8: token does not exist ({id})")
+        if to == ZERO:
+            raise E8Error("E8: zero address")
+        if self.approved.get(id) != by:
+            raise E8Error(f"E8: not approved ({by}/{id})")
+        frm = self.owner721[id]
+        self.bal721[frm] -= 1
+        self.bal721[to] = self.bal721.get(to, 0) + 1
+        self.owner721[id] = to
+        self.approved.pop(id, None)
+
+    def burn721(self, by, id):
+        if id not in self.owner721:
+            raise E8Error(f"E8: token does not exist ({id})")
+        if self.owner721[id] != by:
+            raise E8Error(f"E8: not token owner ({by}/{id})")
+        del self.owner721[id]
+        self.approved.pop(id, None)
+        self.bal721[by] -= 1
+        self.supply721 -= 1
+
+    def read_owner_of(self, id):
+        if id not in self.owner721:
+            raise E8Error(f"E8: token does not exist ({id})")
+
+    def mint1155(self, by, to, id, amount):
+        if by != "root":
+            raise E8Error(f"E8: not collection owner ({by})")
+        if to == ZERO:
+            raise E8Error("E8: zero address")
+        if amount == 0:
+            raise E8Error("E8: amount must be positive")
+        self.bal1155[(to, id)] = self.bal1155.get((to, id), 0) + amount
+        self.supply1155[id] = self.supply1155.get(id, 0) + amount
+
+    def transfer1155(self, frm, by, id, to, amount):
+        if to == ZERO:
+            raise E8Error("E8: zero address")
+        if amount == 0:
+            raise E8Error("E8: amount must be positive")
+        if by != frm and not self.operator.get((frm, by), False):
+            raise E8Error(f"E8: not approved ({by}/{id})")
+        have = self.bal1155.get((frm, id), 0)
+        if have < amount:
+            raise E8Error(f"E8: insufficient balance ({frm}/{id}/{have}/{amount})")
+        self.bal1155[(frm, id)] = have - amount
+        self.bal1155[(to, id)] = self.bal1155.get((to, id), 0) + amount
+
+    def set_operator(self, by, operator, approved):
+        if operator == ZERO:
+            raise E8Error("E8: zero address")
+        self.operator[(by, operator)] = approved
+
+    def transfer_batch1155(self, frm, by, to, ids, amounts):
+        if len(ids) != len(amounts):
+            raise E8Error(f"E8: batch length mismatch ({len(ids)}/{len(amounts)})")
+        if to == ZERO:
+            raise E8Error("E8: zero address")
+        if by != frm and not self.operator.get((frm, by), False):
+            raise E8Error(f"E8: not approved ({by}/{ids[0]})")
+        for id, amount in zip(ids, amounts):
+            if amount == 0:
+                raise E8Error("E8: amount must be positive")
+            have = self.bal1155.get((frm, id), 0)
+            if have < amount:
+                raise E8Error(f"E8: insufficient balance ({frm}/{id}/{have}/{amount})")
+        for id, amount in zip(ids, amounts):
+            self.bal1155[(frm, id)] -= amount
+            self.bal1155[(to, id)] = self.bal1155.get((to, id), 0) + amount
+
+    def set_uri(self, by, id, uri):
+        if by != "root":
+            raise E8Error(f"E8: not collection owner ({by})")
+        self.uri1155[id] = uri
+
+    @staticmethod
+    def valid_name(name: str) -> bool:
+        if not name.endswith(".aura") or len(name) == len(".aura"):
+            return False
+        label = name[: -len(".aura")]
+        if not (1 <= len(label) <= 32):
+            return False
+        if not all(c.islower() or c.isdigit() or c == "-" for c in label):
+            return False
+        return label[0].isalnum() and label[-1].isalnum()
+
+    def register_name(self, by, name, day):
+        self.day = day
+        if not self.valid_name(name):
+            raise E8Error(f"E8: invalid name ({name})")
+        if name in self.names and day <= self.names[name]["expiry"] + GRACE_DAYS:
+            raise E8Error(f"E8: name already registered ({name})")
+        self.names[name] = {"owner": by, "target": by, "expiry": day + TERM_DAYS}
+
+    def renew_name(self, name, day):
+        self.day = day
+        if name not in self.names:
+            raise E8Error(f"E8: name not registered ({name})")
+        rec = self.names[name]
+        rec["expiry"] = max(day, rec["expiry"]) + TERM_DAYS
+
+    def transfer_name(self, by, name, to, day):
+        self.day = day
+        if name not in self.names:
+            raise E8Error(f"E8: name not registered ({name})")
+        rec = self.names[name]
+        if day > rec["expiry"] + GRACE_DAYS:
+            raise E8Error(f"E8: name expired ({name})")
+        if rec["owner"] != by:
+            raise E8Error(f"E8: not name owner ({by}/{name})")
+        if to == ZERO:
+            raise E8Error("E8: zero address")
+        if self.primary.get(by) == name:
+            del self.primary[by]
+        rec["owner"] = to
+
+    def set_target(self, by, name, target, day):
+        self.day = day
+        if name not in self.names:
+            raise E8Error(f"E8: name not registered ({name})")
+        rec = self.names[name]
+        if day > rec["expiry"] + GRACE_DAYS:
+            raise E8Error(f"E8: name expired ({name})")
+        if rec["owner"] != by:
+            raise E8Error(f"E8: not name owner ({by}/{name})")
+        if target == ZERO:
+            raise E8Error("E8: zero address")
+        rec["target"] = target
+
+    def resolve(self, name, day):
+        self.day = day
+        if name not in self.names:
+            raise E8Error(f"E8: name not registered ({name})")
+        rec = self.names[name]
+        if day > rec["expiry"] + GRACE_DAYS:
+            raise E8Error(f"E8: name expired ({name})")
+        return rec["target"]
+
+    def set_primary(self, by, name, day):
+        self.day = day
+        if name not in self.names:
+            raise E8Error(f"E8: name not registered ({name})")
+        rec = self.names[name]
+        if day > rec["expiry"] + GRACE_DAYS:
+            raise E8Error(f"E8: name expired ({name})")
+        if rec["owner"] != by:
+            raise E8Error(f"E8: not name owner ({by}/{name})")
+        self.primary[by] = name
+
+    def advance_day(self, day):
+        self.day = day
+
+    def set_identity(self, by, name, digest, day):
+        self.day = day
+        if name not in self.names:
+            raise E8Error(f"E8: name not registered ({name})")
+        rec = self.names[name]
+        if day > rec["expiry"] + GRACE_DAYS:
+            raise E8Error(f"E8: name expired ({name})")
+        if rec["owner"] != by:
+            raise E8Error(f"E8: not name owner ({by}/{name})")
+        self.identity[name] = digest
+
+    def clear_identity(self, by, name, day=None):
+        if day is not None:
+            self.day = day
+        if name not in self.names:
+            raise E8Error(f"E8: name not registered ({name})")
+        if self.names[name]["owner"] != by:
+            raise E8Error(f"E8: not name owner ({by}/{name})")
+        self.identity.pop(name, None)
+
+    def read_identity(self, name, day):
+        self.day = day
+        if name not in self.names:
+            raise E8Error(f"E8: name not registered ({name})")
+        if name not in self.identity:
+            raise E8Error(f"E8: no identity record ({name})")
+        return self.identity[name]
+
+    # query(): the fixture read-key grammar.
+    def query(self, key: str) -> str:
+        head, _, rest = key.partition(":")
+        if head == "owner_of":
+            return self.owner721.get(int(rest), "none")
+        if head == "approved":
+            return self.approved.get(int(rest), "none")
+        if head == "supply721":
+            return str(self.supply721)
+        if head == "balance721":
+            return str(self.bal721.get(rest, 0))
+        if head == "balance1155":
+            who, _, id = rest.rpartition(":")
+            return str(self.bal1155.get((who, int(id)), 0))
+        if head == "supply1155":
+            return str(self.supply1155.get(int(rest), 0))
+        if head == "uri":
+            return self.uri1155.get(int(rest), "none")
+        if head == "resolve":
+            try:
+                return self.resolve(rest, self.day)
+            except E8Error:
+                return "none"
+        if head == "name_owner":
+            rec = self.names.get(rest)
+            return rec["owner"] if rec else "none"
+        if head == "expiry":
+            rec = self.names.get(rest)
+            return str(rec["expiry"]) if rec else "none"
+        if head == "reverse":
+            return self.primary.get(rest, "none")
+        if head == "identity":
+            try:
+                return self.read_identity(rest, self.day)
+            except E8Error:
+                return "none"
+        if head == "day":
+            return str(self.day)
+        if head == "operator":
+            holder, _, op = rest.rpartition(":")
+            return "true" if self.operator.get((holder, op), False) else "false"
+        raise AssertionError(f"unknown read key: {key}")
+
+
+OPS = {
+    "mint721": ("by", "to", "id"),
+    "transfer721": ("by", "id", "to"),
+    "approve721": ("by", "id", "spender"),
+    "transfer_from721": ("by", "id", "to"),
+    "burn721": ("by", "id"),
+    "read_owner_of": ("id",),
+    "mint1155": ("by", "to", "id", "amount"),
+    "transfer1155": ("frm", "by", "id", "to", "amount"),
+    "set_operator": ("by", "operator", "approved"),
+    "transfer_batch1155": ("frm", "by", "to", "ids", "amounts"),
+    "register_name": ("by", "name", "day"),
+    "renew_name": ("name", "day"),
+    "transfer_name": ("by", "name", "to", "day"),
+    "set_target": ("by", "name", "target", "day"),
+    "resolve": ("name", "day"),
+    "set_primary": ("by", "name", "day"),
+    "advance_day": ("day",),
+    "set_identity": ("by", "name", "digest", "day"),
+    "clear_identity": ("by", "name"),
+    "read_identity": ("name", "day"),
+}
+
+
+def convert(op: str, key: str, val: str):
+    ints = {"id", "amount", "day"}
+    lists = {"ids", "amounts"}
+    if key in ints:
+        return int(val)
+    if key in lists:
+        return [int(x) for x in val.split(",")]
+    if key == "approved" and op == "set_operator":
+        return val == "true"
+    return val
+
+
+def run_op(m: Model, op: str, args: dict):
+    fn = getattr(m, op)
+    fn(**{k: convert(op, k, v) for k, v in args.items()})
+
+
+# ---------------------------------------------------------- fixture
+
+
+def parse_fixture():
+    digest = None
+    vectors = []
+    cur = None
+    for line in FIXTURE.read_text(encoding="utf-8").splitlines():
+        line = line.strip()
+        if not line or line.startswith("#"):
+            continue
+        k, _, v = line.partition("=")
+        if k == "digest" and cur is None:
+            digest = v
+        elif k == "vector":
+            if cur is not None:
+                vectors.append(cur)
+            cur = {"id": v, "op": None, "args": {}, "status": None,
+                   "err": None, "reads": {}}
+        elif k == "op":
+            cur["op"] = v
+        elif k == "status":
+            cur["status"] = v
+        elif k == "err":
+            cur["err"] = v
+        elif k.startswith("read."):
+            cur["reads"][k[len("read."):]] = v
+        else:
+            cur["args"][k] = v
+    if cur is not None:
+        vectors.append(cur)
+    return digest, vectors
+
+
+def canonical(v) -> str:
+    reads = " ".join(f"{k}={val}" for k, val in sorted(v["reads"].items()))
+    status = v["status"] if v["status"] == "ok" else f"err:{v['err']}"
+    return f"{v['id']}|{v['op']}|{status}|{reads}"
+
+
+def execute_vectors(vectors):
+    m = Model()
+    for v in vectors:
+        try:
+            run_op(m, v["op"], v["args"])
+            got = "ok"
+            err = None
+        except E8Error as e:
+            got = "err"
+            err = str(e)
+        if v["status"] == "ok":
+            assert got == "ok", f"{v['id']}: expected ok, got {err}"
+        else:
+            assert got == "err" and err == v["err"], (
+                f"{v['id']}: expected {v['err']!r}, got {err!r}")
+        for key, want in v["reads"].items():
+            assert m.query(key) == want, f"{v['id']}: read {key}"
+    return m
+
+
+# -------------------------------------------------------- DAO mirror
+
+
+def dao_scenario():
+    stakes = [250_000 * ALCRY, 150_000 * ALCRY, 100_000 * ALCRY,
+              75_000 * ALCRY, 25_000 * ALCRY]
+    labels = ["alice", "bob", "carol", "dave", "eve"]
+    snapshot = list(stakes)
+    votes: list[tuple[int, str, int]] = []   # (voter, support, power)
+    seen: set[int] = set()
+    steps = []
+    steps.append("propose|1|proposer=0|created=1000")
+
+    def cast(voter, support, height):
+        if voter in seen:
+            raise E8Error(f"E8: vote already cast (1/{voter})")
+        power = snapshot[voter]
+        if power == 0:
+            raise E8Error(f"E8: no voting power ({voter})")
+        if height >= 1000 + 120_960:
+            raise E8Error(f"E8: voting closed (1)")
+        seen.add(voter)
+        votes.append((voter, support, power))
+
+    first = None
+    for voter, support, height, word in [
+        (1, "yes", 2000, "yes"), (2, "yes", 3000, "yes"),
+        (3, "no", 4000, "no"), (4, "abstain", 5000, "abstain"),
+    ]:
+        cast(voter, support, height)
+        if first is None:
+            first = (1, voter, support, votes[-1][2])
+        steps.append(f"vote|1|{voter}|{word}|{votes[-1][2]}")
+    try:
+        cast(1, "yes", 6000)
+        raise AssertionError("double vote must fail")
+    except E8Error as e:
+        steps.append(f"vote_err|1|1|{e}")
+
+    yes = sum(p for (_, s, p) in votes if s == "yes")
+    no = sum(p for (_, s, p) in votes if s == "no")
+    abstain = sum(p for (_, s, p) in votes if s == "abstain")
+    total = yes + no + abstain
+    quorum = sum(snapshot) * 2000 // 10_000
+    passed = total >= quorum and yes > no
+    steps.append(f"finalize|1|{'passed' if passed else 'rejected'}")
+    steps.append("execute|1|executed")
+    return {
+        "steps": steps,
+        "first": first,
+        "ui_votes": len(votes),
+        "tally": (yes, no, abstain),
+        "labels": labels,
+        "votes": votes,
+        "snapshot": snapshot,
+        "heights": [2000, 3000, 4000, 5000],
+        "created": 1000,
+    }
+
+
+def render_html(dao) -> str:
+    """Byte-identical mirror of DaoUi::render_html for the scenario."""
+    yes, no, abstain = dao["tally"]
+    total = yes + no + abstain
+    pct = yes * 100 // total if total else 0
+    state = "executed"
+    lines = [
+        "<!doctype html>",
+        '<html lang="en">',
+        "<head>",
+        '<meta charset="utf-8">',
+        "<title>AuraLite DAO — governance UI</title>",
+        "<style>",
+        "body{font-family:sans-serif;background:#0f1220;color:#e8eaf6;margin:2rem;max-width:52rem}",
+        "h1{font-size:1.4rem}",
+        ".card{background:#1a1f36;border-radius:10px;padding:1rem 1.2rem;margin:1rem 0}",
+        ".badge{padding:.15rem .6rem;border-radius:999px;font-size:.8rem;background:#2b3157}",
+        ".passed{background:#1b5e20}.executed{background:#00695c}.rejected{background:#7f1d1d}",
+        "table{width:100%;border-collapse:collapse;font-size:.9rem}",
+        "td,th{padding:.35rem .5rem;text-align:left;border-bottom:1px solid #2b3157}",
+        ".meter{background:#2b3157;border-radius:6px;height:.6rem;margin:.25rem 0}",
+        ".meter i{display:block;height:100%;border-radius:6px;background:#7c86ff}",
+        ".foot{opacity:.7;font-size:.8rem;margin-top:1.5rem}",
+        "</style>",
+        "</head>",
+        "<body>",
+        "<h1>AuraLite DAO — governance UI</h1>",
+        f'<div class="card"><strong>Proposal #1</strong> <span class="badge {state}">{state}</span>',
+        f"<div>proposer: {dao['labels'][0]} &middot; created at block {dao['created']}</div>",
+        f'<div class="meter"><i style="width:{pct}%"></i></div>',
+        "<table><tr><th>yes</th><th>no</th><th>abstain</th></tr>",
+        f"<tr><td>{yes // ALCRY} ALCRY</td><td>{no // ALCRY} ALCRY</td><td>{abstain // ALCRY} ALCRY</td></tr>",
+        "</table></div>",
+        '<div class="card"><strong>Votes through the UI</strong>',
+        "<table><tr><th>#</th><th>proposal</th><th>voter</th><th>support</th><th>power</th></tr>",
+    ]
+    for i, ((voter, support, power), _h) in enumerate(
+        zip(dao["votes"], dao["heights"]), 1
+    ):
+        lines.append(
+            f"<tr><td>{i}</td><td>#1</td><td>{dao['labels'][voter]}</td>"
+            f"<td>{support}</td><td>{power // ALCRY} ALCRY</td></tr>"
+        )
+    lines += [
+        "</table></div>",
+        f'<div class="foot">{len(dao["votes"])} vote receipts &middot; '
+        "rendered by AuraLite governance UI (E8)</div>",
+        "</body>",
+        "</html>",
+    ]
+    return "".join(line + "\n" for line in lines)
+
+
+def main() -> int:
+    digest, vectors = parse_fixture()
+    assert digest == VECTORS_DIGEST, "fixture digest"
+    assert len(vectors) == 50, f"50 vectors, got {len(vectors)}"
+    execute_vectors(vectors)
+    rebuilt = hashlib.sha256(
+        ";".join(canonical(v) for v in vectors).encode()
+    ).hexdigest()
+    assert rebuilt == VECTORS_DIGEST, f"rebuilt digest {rebuilt}"
+
+    dao = dao_scenario()
+    assert dao["steps"][5] == "vote_err|1|1|E8: vote already cast (1/1)"
+    scenario_digest = hashlib.sha256(";".join(dao["steps"]).encode()).hexdigest()
+    assert scenario_digest == SCENARIO_DIGEST, f"scenario {scenario_digest}"
+    assert dao["first"] == (1, 1, "yes", 150_000 * ALCRY)
+    assert dao["ui_votes"] == 4
+    assert dao["tally"] == (
+        250_000 * ALCRY, 75_000 * ALCRY, 25_000 * ALCRY,
+    )
+
+    html = render_html(dao)
+    ui_sha = hashlib.sha256(html.encode()).hexdigest()
+    assert ui_sha == UI_HTML_SHA, f"ui html {ui_sha}"
+
+    # The exact three lines the Rust example prints.
+    print(f"E8-VECTORS-OK {len(vectors)}")
+    print(f"E8-UI-OK {ui_sha}")
+    print(f"E8-SIM-OK {SIM_LINE}")
+
+    sim = {
+        "vectors": 50,
+        "vectors_digest": VECTORS_DIGEST,
+        "scenario_digest": SCENARIO_DIGEST,
+        "aggregate_digest":
+            "39674d6a0813cb9beae5837025e1a8b6c00fb8ebe1bc620a06e844a5829fb313",
+        "ui_html_sha256": ui_sha,
+        "first_vote": [1, 1, "yes"],
+        "ui_votes": 4,
+        "tally": {
+            "yes": 250_000 * ALCRY,
+            "no": 75_000 * ALCRY,
+            "abstain": 25_000 * ALCRY,
+        },
+        "state": "executed",
+        "stakes_alcry": [250_000, 150_000, 100_000, 75_000, 25_000],
+    }
+    (REPO / "sim/e8-dao.json").write_text(
+        json.dumps(sim, indent=2) + "\n", encoding="utf-8"
+    )
+    (REPO / "sim/e8-governance-ui.html").write_text(html, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
