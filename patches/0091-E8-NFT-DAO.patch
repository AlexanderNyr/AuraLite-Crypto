--- /dev/null
+++ b/crates/aura-storage/tests/e8_nft.rs
@@ -0,0 +1,547 @@
+//! E8 gate: 50 standard vectors (ARC-721/1155 + `.aura` names +
+//! identity) and the first DAO vote through the UI (ECOSYSTEM_PLAN E8).
+//!
+//! The fixture `tests/fixtures/e8-standards.txt` is the golden oracle
+//! (generated by `tools/gen_e8_vectors.py`): every vector pins its
+//! status — `ok` or an exact `E8: …` error literal — plus post-state
+//! reads. This test executes all 50 against [`NftWorld`] and rebuilds
+//! the vectors digest; the independent Python model
+//! `tools/e8_nft_check.py` must produce the same digest.
+//!
+//! The DAO gate runs [`run_e8_scenario`]: proposal 1 with the first vote
+//! cast through the UI, a rejected double vote, finalization and
+//! execution after the timelock.
+
+use aura_storage::dao_ui::{DaoUi, run_e8_scenario, scenario_digest};
+use aura_storage::governance::{ProposalState, Support, T6_VETO_SUNSET_BLOCK};
+use aura_storage::issuance::ALCRY;
+use aura_storage::nft::{E8Error, GRACE_DAYS, NftWorld, TERM_DAYS};
+
+const FIXTURE: &str = include_str!("fixtures/e8-standards.txt");
+const VECTORS_DIGEST: &str = "8cb9da945b0eed8f4432d31b71d20fffb72a6317fc90204d1890bd480c062bd3";
+const SCENARIO_DIGEST: &str = "17fd44850375c54c9cf9826b8ed55da0faf1855da72514184c83501f07409d71";
+const AGGREGATE_DIGEST: &str = "39674d6a0813cb9beae5837025e1a8b6c00fb8ebe1bc620a06e844a5829fb313";
+
+/// One parsed fixture block.
+#[derive(Debug, Default)]
+struct Vector {
+    id: String,
+    op: String,
+    args: Vec<(String, String)>,
+    status: String,
+    err: String,
+    reads: Vec<(String, String)>,
+}
+
+fn parse_fixture() -> (String, Vec<Vector>) {
+    let mut digest = String::new();
+    let mut vectors: Vec<Vector> = Vector::default().into_iter_dummy();
+    let mut cur: Option<Vector> = None;
+    for line in FIXTURE.lines() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let (k, v) = line.split_once('=').expect("key=value");
+        match k {
+            "digest" if cur.is_none() => digest = String::from(v),
+            "vector" => {
+                if let Some(done) = cur.take() {
+                    vectors.push(done);
+                }
+                cur = Some(Vector {
+                    id: String::from(v),
+                    ..Vector::default()
+                });
+            }
+            "op" => cur.as_mut().expect("in block").op = String::from(v),
+            "status" => cur.as_mut().expect("in block").status = String::from(v),
+            "err" => cur.as_mut().expect("in block").err = String::from(v),
+            other => {
+                let block = cur.as_mut().expect("in block");
+                if let Some(read) = other.strip_prefix("read.") {
+                    block.reads.push((String::from(read), String::from(v)));
+                } else {
+                    block.args.push((String::from(other), String::from(v)));
+                }
+            }
+        }
+    }
+    if let Some(done) = cur.take() {
+        vectors.push(done);
+    }
+    (digest, vectors)
+}
+
+/// Tiny helper so `Vector::default().into_iter_dummy()` reads well above.
+trait IntoVec {
+    fn into_iter_dummy(self) -> Vec<Vector>;
+}
+impl IntoVec for Vector {
+    fn into_iter_dummy(self) -> Vec<Vector> {
+        Vec::new()
+    }
+}
+
+fn arg<'a>(v: &'a Vector, key: &str) -> &'a str {
+    v.args
+        .iter()
+        .find(|(k, _)| k == key)
+        .map(|(_, val)| val.as_str())
+        .unwrap_or_else(|| panic!("{}: missing arg {key}", v.id))
+}
+
+fn run_vector(world: &mut NftWorld, v: &Vector) -> Result<(), E8Error> {
+    let a = |key: &str| arg(v, key);
+    match v.op.as_str() {
+        "mint721" => world.mint721(a("by"), a("to"), a("id").parse().unwrap()),
+        "transfer721" => world.transfer721(a("by"), a("id").parse().unwrap(), a("to")),
+        "approve721" => world.approve721(a("by"), a("id").parse().unwrap(), a("spender")),
+        "transfer_from721" => world.transfer_from721(a("by"), a("id").parse().unwrap(), a("to")),
+        "burn721" => world.burn721(a("by"), a("id").parse().unwrap()),
+        "read_owner_of" => world.owner_of(a("id").parse().unwrap()).map(|_| ()),
+        "mint1155" => world.mint1155(
+            a("by"),
+            a("to"),
+            a("id").parse().unwrap(),
+            a("amount").parse().unwrap(),
+        ),
+        "transfer1155" => world.transfer1155(
+            a("frm"),
+            a("by"),
+            a("id").parse().unwrap(),
+            a("to"),
+            a("amount").parse().unwrap(),
+        ),
+        "set_operator" => world.set_operator(a("by"), a("operator"), a("approved") == "true"),
+        "transfer_batch1155" => {
+            let ids: Vec<u64> = a("ids").split(',').map(|s| s.parse().unwrap()).collect();
+            let amounts: Vec<u128> = a("amounts")
+                .split(',')
+                .map(|s| s.parse().unwrap())
+                .collect();
+            world.transfer_batch1155(a("frm"), a("by"), a("to"), &ids, &amounts)
+        }
+        "register_name" => world.register_name(a("by"), a("name"), a("day").parse().unwrap()),
+        "renew_name" => world.renew_name(a("name"), a("day").parse().unwrap()),
+        "transfer_name" => {
+            world.transfer_name(a("by"), a("name"), a("to"), a("day").parse().unwrap())
+        }
+        "set_target" => {
+            world.set_target(a("by"), a("name"), a("target"), a("day").parse().unwrap())
+        }
+        "resolve" => world
+            .resolve(a("name"), a("day").parse().unwrap())
+            .map(|_| ()),
+        "set_primary" => world.set_primary(a("by"), a("name"), a("day").parse().unwrap()),
+        "advance_day" => {
+            world.advance_day(a("day").parse().unwrap());
+            Ok(())
+        }
+        "set_identity" => {
+            world.set_identity(a("by"), a("name"), a("digest"), a("day").parse().unwrap())
+        }
+        "clear_identity" => world.clear_identity(a("by"), a("name")),
+        "read_identity" => world.identity(a("name")).map(|_| ()),
+        other => panic!("unknown op {other}"),
+    }
+}
+
+fn vectors_digest(vectors: &[Vector]) -> String {
+    let mut lines = Vec::new();
+    for v in vectors {
+        let mut reads = v.reads.clone();
+        reads.sort();
+        let reads = reads
+            .iter()
+            .map(|(k, val)| format!("{k}={val}"))
+            .collect::<Vec<_>>()
+            .join(" ");
+        let status = if v.status == "ok" {
+            String::from("ok")
+        } else {
+            format!("err:{}", v.err)
+        };
+        lines.push(format!("{}|{}|{status}|{reads}", v.id, v.op));
+    }
+    aura_state::sha256_bytes(lines.join(";").as_bytes()).to_hex()
+}
+
+#[test]
+fn e8_vectors_all_pass() {
+    let (_digest, vectors) = parse_fixture();
+    assert_eq!(vectors.len(), 50, "exactly 50 standard vectors");
+    let mut world = NftWorld::new();
+    for v in &vectors {
+        let result = run_vector(&mut world, v);
+        match v.status.as_str() {
+            "ok" => assert!(
+                result.is_ok(),
+                "{}: expected ok, got {:?}",
+                v.id,
+                result.err()
+            ),
+            "err" => {
+                let err = result
+                    .expect_err(&format!("{}: expected error", v.id))
+                    .to_string();
+                assert_eq!(err, v.err, "{}: exact error literal", v.id);
+            }
+            other => panic!("{}: bad status {other}", v.id),
+        }
+        for (key, want) in &v.reads {
+            assert_eq!(
+                &world.query(key),
+                want,
+                "{}: read {key} after {}",
+                v.id,
+                v.op
+            );
+        }
+    }
+}
+
+#[test]
+fn e8_vectors_digest_matches() {
+    let (fixture_digest, vectors) = parse_fixture();
+    assert_eq!(fixture_digest, VECTORS_DIGEST, "fixture digest pinned");
+    assert_eq!(vectors_digest(&vectors), VECTORS_DIGEST, "rebuilt digest");
+}
+
+#[test]
+fn e8_gate_first_dao_vote_through_ui() {
+    let run = run_e8_scenario();
+    // The first DAO vote was cast through the UI and recorded.
+    assert_eq!(run.first_vote.proposal, 1);
+    assert_eq!(run.first_vote.voter, 1);
+    assert_eq!(run.first_vote.support, Support::Yes);
+    assert_eq!(run.first_vote.power, 150_000 * ALCRY);
+    assert_eq!(run.ui_votes, 4);
+    // Tallies in raw ALCRY units.
+    assert_eq!(run.tally.0, 250_000 * ALCRY, "yes");
+    assert_eq!(run.tally.1, 75_000 * ALCRY, "no");
+    assert_eq!(run.tally.2, 25_000 * ALCRY, "abstain");
+    assert_eq!(run.state, "executed");
+}
+
+#[test]
+fn e8_gate_scenario_steps_and_digest() {
+    let run = run_e8_scenario();
+    let expected = [
+        "propose|1|proposer=0|created=1000",
+        "vote|1|1|yes|150000000000000000000000",
+        "vote|1|2|yes|100000000000000000000000",
+        "vote|1|3|no|75000000000000000000000",
+        "vote|1|4|abstain|25000000000000000000000",
+        "vote_err|1|1|E8: vote already cast (1/1)",
+        "finalize|1|passed",
+        "execute|1|executed",
+    ];
+    assert_eq!(run.steps, expected, "exact scenario step log");
+    assert_eq!(scenario_digest(&run.steps), SCENARIO_DIGEST);
+}
+
+#[test]
+fn e8_gate_aggregate_digest() {
+    // The step log digest is part of the aggregate gate digest.
+    let agg = aura_state::sha256_bytes(
+        format!(
+            "E8|vectors=50|vectors_digest={VECTORS_DIGEST}|\
+             scenario_digest={SCENARIO_DIGEST}|first_vote=1/1/yes|\
+             ui_votes=4|state=executed"
+        )
+        .as_bytes(),
+    )
+    .to_hex();
+    assert_eq!(agg, AGGREGATE_DIGEST);
+}
+
+#[test]
+fn e8_gate_governance_ui_page() {
