+}
+
+// ---------------------------------------------------------- error literals
+
+#[test]
+fn e8_nc_literals() {
+    // The six mutation-control targets, asserted verbatim.
+    let mut w = NftWorld::new();
+    w.mint721("root", "alice", 1).unwrap();
+    assert_eq!(
+        w.mint721("root", "alice", 1).unwrap_err().to_string(),
+        "E8: token already exists (1)"
+    );
+    assert_eq!(
+        w.transfer721("carol", 1, "eve").unwrap_err().to_string(),
+        "E8: not token owner (carol/1)"
+    );
+    assert_eq!(
+        w.transfer_from721("dave", 1, "dave")
+            .unwrap_err()
+            .to_string(),
+        "E8: not approved (dave/1)"
+    );
+    w.register_name("alice", "alice.aura", 1).unwrap();
+    assert_eq!(
+        w.register_name("bob", "alice.aura", 1)
+            .unwrap_err()
+            .to_string(),
+        "E8: name already registered (alice.aura)"
+    );
+    assert_eq!(
+        w.set_identity("bob", "alice.aura", "11", 1)
+            .unwrap_err()
+            .to_string(),
+        "E8: not name owner (bob/alice.aura)"
+    );
+    let run = run_e8_scenario();
+    assert!(
+        run.steps
+            .iter()
+            .any(|s| s == "vote_err|1|1|E8: vote already cast (1/1)"),
+        "double vote literal"
+    );
+}
+
+#[test]
+fn e8_dao_error_messages() {
+    let k = |n: u128| n * ALCRY;
+    // Below threshold.
+    let mut ui = DaoUi::new(
+        vec![k(5_000), k(250_000)],
+        ["alice", "bob"].iter().map(|s| String::from(*s)).collect(),
+    );
+    assert_eq!(
+        ui.propose(0, 1000).unwrap_err().to_string(),
+        "E8: below proposal threshold (0)"
+    );
+    // Unknown proposal.
+    assert_eq!(
+        ui.vote(99, 1, Support::Yes, 1000).unwrap_err().to_string(),
+        "E8: proposal not found (99)"
+    );
+    let id = ui.propose(1, 1000).unwrap();
+    // Zero snapshot power (the flash-stake guard).
+    let mut zero = DaoUi::new(
+        vec![k(250_000), k(0)],
+        ["alice", "bob"].iter().map(|s| String::from(*s)).collect(),
+    );
+    let zid = zero.propose(0, 1000).unwrap();
+    assert_eq!(
+        zero.vote(zid, 1, Support::Yes, 1000)
+            .unwrap_err()
+            .to_string(),
+        "E8: no voting power (1)"
+    );
+    // Voting closed.
+    assert_eq!(
+        ui.vote(id, 1, Support::Yes, 1_000 + 120_960)
+            .unwrap_err()
+            .to_string(),
+        "E8: voting closed (1)"
+    );
+    // Finalize while still open.
+    assert_eq!(
+        ui.finalize(id, 5_000).unwrap_err().to_string(),
+        "E8: voting still open (1)"
+    );
+    ui.vote(id, 1, Support::Yes, 2000).unwrap();
+    ui.vote(id, 0, Support::Yes, 3000).unwrap();
+    ui.finalize(id, 1_000 + 120_960).unwrap();
+    assert_eq!(
+        ui.finalize(id, 1_000 + 120_960).unwrap_err().to_string(),
+        "E8: proposal already finalized (1)"
+    );
+    // Timelock.
+    assert_eq!(
+        ui.execute(id, 1_000 + 120_960).unwrap_err().to_string(),
+        "E8: timelock not reached (1)"
+    );
+    ui.execute(id, 1_000 + 120_960 + 34_560).unwrap();
+    assert_eq!(
+        ui.execute(id, 1_000 + 120_960 + 34_560)
+            .unwrap_err()
+            .to_string(),
+        "E8: already executed (1)"
+    );
+
+    // Not passed (rejection) and veto sunset.
+    let mut ui2 = DaoUi::new(
+        vec![k(250_000), k(150_000)],
+        ["alice", "bob"].iter().map(|s| String::from(*s)).collect(),
+    );
+    let rid = ui2.propose(0, 1000).unwrap();
+    ui2.vote(rid, 1, Support::Yes, 2000).unwrap();
+    ui2.vote(rid, 0, Support::No, 3000).unwrap();
+    ui2.finalize(rid, 1_000 + 120_960).unwrap();
+    assert_eq!(
+        ui2.execute(rid, 1_000 + 120_960 + 34_560)
+            .unwrap_err()
+            .to_string(),
+        "E8: not passed (1)"
+    );
+    // Veto sunsets at T6_VETO_SUNSET_BLOCK (passed proposal required).
+    let mut ui3 = DaoUi::new(
+        vec![k(250_000), k(150_000)],
+        ["alice", "bob"].iter().map(|s| String::from(*s)).collect(),
+    );
+    let gid = ui3.propose(0, 1000).unwrap();
+    ui3.vote(gid, 1, Support::Yes, 2000).unwrap();
+    ui3.vote(gid, 0, Support::Yes, 3000).unwrap();
+    ui3.finalize(gid, 1_000 + 120_960).unwrap();
+    assert_eq!(
+        ui3.veto(gid, T6_VETO_SUNSET_BLOCK).unwrap_err().to_string(),
+        "E8: veto power has sunset"
+    );
+}
