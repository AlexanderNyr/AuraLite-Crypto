+    for line in FIXTURE.read_text(encoding="utf-8").splitlines():
+        if line and not line.startswith("#") and "=" in line:
+            key, value = line.split("=", 1)
+            out[key] = value
+    return out
+
+
+def reset_current_evidence() -> None:
+    EVIDENCE.mkdir(parents=True, exist_ok=True)
