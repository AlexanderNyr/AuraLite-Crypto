-//! `aura-exec` — placeholder crate for deterministic WASM execution engine.
+//! `aura-exec` — deterministic WASM execution (X0 onwards).
 //!
-//! C0 creates the workspace skeleton only. The real API lands in phase X1.
-//! This crate intentionally exposes **no public items**: CONTRIBUTING.md
-//! forbids stubs that silently return success. An empty crate is honest;
-//! a fake `Ok(())` is not.
+//! X0 lands [`census`]: the determinism census. It parses a WASM binary,
+//! applies the restrictive configuration ([`ModuleLimits::restrictive`]) and
+//! decides whether the module *can* be deterministic — bans floats, imports,
+//! shared memory, the start section, mutable globals, SIMD/atomics/bulk ops and
+//! indirect calls, with a fail-closed opcode whitelist.
+//!
+//! There is deliberately **no engine here yet**: X0 makes no runtime claim and
+//! links no VM. `wasmtime` is pinned in X1 together with fuel metering, memory
+//! ceilings and the zero-import sandbox, because fuel semantics are
+//! version-sensitive. An empty engine with a fake `Ok(())` is exactly what
+//! CONTRIBUTING.md forbids.
+//!
+//! Golden vectors: `tools/gen_x0_vectors.py` (independent Python assembler).
+//! Report: `docs/evidence/x0/report.md`.
 
 #![forbid(unsafe_code)]
 #![deny(missing_docs)]
+
+pub mod census;
+
+pub use census::{
+    Ban, CENSUS, CensusReport, CensusRow, MAX_MEMORY_PAGES, MAX_MODULE_BYTES, MAX_TABLE_ENTRIES,
+    ModuleLimits, Policy, Verdict, WASM_MAGIC, WASM_VERSION, census,
+};
