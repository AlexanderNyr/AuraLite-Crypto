+        ("atomics", "0xFE atomic ops, memory.atomic.wait", "BAN", "X0", "exists only to coordinate threads; can block on the clock"),
+        ("simd", "0xFD v128 instructions", "BAN", "X0", "extra divergence surface, unused in Stage 1"),
