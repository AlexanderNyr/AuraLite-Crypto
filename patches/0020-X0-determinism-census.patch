+    ("X0 negative controls (evidence log)", "make nc-x0", 34),
+    ("all negative controls (C0-C10 + S0-S7 + X0)", "make nc-all", 36),
+    ("CORE shard", "make test-core", 12),
+    ("plan<->tree audit", "make audit-closeout", 12),
+    ("full gate", "make test", 10),
