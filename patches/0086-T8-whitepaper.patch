+/// Digest of the scenario step log (sha256, hex).
+pub fn scenario_digest(steps: &[T8Step]) -> String {
+    let mut blob = String::new();
+    for step in steps {
+        blob.push_str(&format!(
+            "{}:{}:{}:{}:{}:{}:{}:{}:{}\n",
+            step.index,
+            step.kind,
+            step.subject,
+            step.day,
+            step.a,
+            step.b,
+            step.c,
+            step.state,
+            step.detail
+        ));
+    }
+    aura_state::sha256_bytes(blob.as_bytes()).to_hex()
+}
