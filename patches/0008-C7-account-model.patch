+//! Account value: nonce, balance, code hash and storage root.
+
+use aura_codec::{Decode, Encode, Reader, Writer, decode_canonical, encode_to_bytes};
+use aura_types::{Amount, Hash, Nonce};
+
+use crate::error::StateError;
+
+/// The canonical account value stored under [`crate::StateKey::account`].
+///
+/// Wire order is fixed: `u64 nonce || u128 balance || 32-byte code_hash ||
+/// 32-byte storage_root` (76 bytes, no length prefixes).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Account {
+    /// Per-account sequence number.
+    pub nonce: Nonce,
+    /// Balance in smallest units (`aalcry`).
+    pub balance: Amount,
+    /// BLAKE3 hash of deployed code, or [`Account::NO_CODE`].
+    pub code_hash: Hash,
+    /// Root of the contract's own storage subtree, or
+    /// [`Account::EMPTY_STORAGE_ROOT`].
+    pub storage_root: Hash,
+}
+
+impl Account {
+    /// Sentinel for an account with no deployed code.
+    pub const NO_CODE: Hash = Hash::ZERO;
+
+    /// Sentinel for an empty contract storage subtree.
+    pub const EMPTY_STORAGE_ROOT: Hash = Hash::ZERO;
+
+    /// A fresh externally owned account: zero nonce, zero balance, no code.
+    pub fn new_empty() -> Self {
+        Account {
+            nonce: Nonce::new(0),
+            balance: Amount::ZERO,
+            code_hash: Account::NO_CODE,
+            storage_root: Account::EMPTY_STORAGE_ROOT,
+        }
+    }
+
+    /// Construct an account from explicit fields.
+    pub fn new(nonce: Nonce, balance: Amount, code_hash: Hash, storage_root: Hash) -> Self {
+        Account {
+            nonce,
+            balance,
+            code_hash,
+            storage_root,
+        }
+    }
+
+    /// True when this account has deployed code.
+    pub fn has_code(&self) -> bool {
+        self.code_hash != Account::NO_CODE
+    }
+
+    /// Checked credit; overflow returns [`StateError::BalanceOverflow`].
+    pub fn credit(&mut self, amount: Amount) -> Result<(), StateError> {
+        self.balance = self
+            .balance
+            .checked_add(amount)
+            .ok_or(StateError::BalanceOverflow)?;
+        Ok(())
+    }
+
+    /// Checked debit; insufficient funds returns
+    /// [`StateError::InsufficientBalance`].
+    pub fn debit(&mut self, amount: Amount) -> Result<(), StateError> {
+        self.balance = self
+            .balance
+            .checked_sub(amount)
+            .ok_or(StateError::InsufficientBalance)?;
+        Ok(())
+    }
+
+    /// Advance the nonce with checked `u64` arithmetic.
+    pub fn bump_nonce(&mut self) -> Result<(), StateError> {
+        self.nonce = self
+            .nonce
+            .checked_next()
+            .map_err(|_| StateError::NonceOverflow)?;
+        Ok(())
+    }
+
+    /// Canonical wire bytes.
+    pub fn to_bytes(&self) -> Vec<u8> {
+        encode_to_bytes(self)
+    }
+
+    /// Decode with full C2 canonicality.
+    pub fn from_canonical_bytes(bytes: &[u8]) -> Result<Self, StateError> {
+        Ok(decode_canonical::<Account>(bytes)?)
+    }
+}
+
+impl Default for Account {
+    fn default() -> Self {
+        Account::new_empty()
+    }
+}
+
+impl Encode for Account {
+    fn encode(&self, writer: &mut Writer) {
+        self.nonce.encode(writer);
+        self.balance.encode(writer);
+        self.code_hash.encode(writer);
+        self.storage_root.encode(writer);
+    }
+}
+
+impl Decode for Account {
+    fn decode(reader: &mut Reader<'_>) -> Result<Self, aura_codec::CodecError> {
+        Ok(Account {
+            nonce: Nonce::decode(reader)?,
+            balance: Amount::decode(reader)?,
+            code_hash: Hash::decode(reader)?,
+            storage_root: Hash::decode(reader)?,
+        })
+    }
+}
diff --git a/crates/aura-state/src/error.rs b/crates/aura-state/src/error.rs
new file mode 100644
index 0000000..322593c
--- /dev/null
+++ b/crates/aura-state/src/error.rs
@@ -0,0 +1,79 @@
+//! State key and account errors.
+
+use std::fmt;
+
+use aura_codec::CodecError;
+
+use crate::key::KeySpace;
+
+/// Every reason a state key or account operation can be rejected.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum StateError {
+    /// The key prefix is not one of the five protocol namespaces.
+    ReservedKeySpace(u8),
+    /// The key has no bytes at all.
+    EmptyKey,
+    /// The key is longer than [`crate::MAX_STATE_KEY_LEN`].
+    KeyTooLong(usize),
+    /// Known prefix but wrong total length for that namespace.
+    InvalidKeyLength {
+        /// Namespace decoded from the prefix.
+        space: KeySpace,
+        /// Required total length, including the prefix byte.
+        expected: usize,
+        /// Actual length.
+        got: usize,
+    },
+    /// A contract tried to write outside its own storage namespace.
+    ForbiddenContractWrite,
+    /// A contract tried to write into another contract's storage.
+    WrongContractStorage,
+    /// Re-encoding a decoded key did not reproduce the input bytes.
+    NonCanonicalKeyEncoding,
+    /// Canonical decoding failed (structural).
+    Decode(CodecError),
+    /// Balance addition overflowed `u128`.
+    BalanceOverflow,
+    /// Balance subtraction would go below zero.
+    InsufficientBalance,
+    /// Nonce increment overflowed `u64`.
+    NonceOverflow,
+}
+
+impl fmt::Display for StateError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::ReservedKeySpace(prefix) => {
+                write!(f, "reserved key space prefix 0x{prefix:02x}")
+            }
+            Self::EmptyKey => f.write_str("empty state key"),
+            Self::KeyTooLong(n) => write!(f, "state key of {n} bytes exceeds the limit"),
+            Self::InvalidKeyLength {
+                space,
+                expected,
+                got,
+            } => write!(f, "{space:?} key must be {expected} bytes, got {got}"),
+            Self::ForbiddenContractWrite => {
+                f.write_str("contract may only write to its own storage namespace")
+            }
+            Self::WrongContractStorage => {
+                f.write_str("contract tried to write another contract's storage")
+            }
+            Self::NonCanonicalKeyEncoding => {
+                f.write_str("re-encoding did not reproduce the key bytes")
+            }
+            Self::Decode(error) => write!(f, "canonical decode failed: {error}"),
+            Self::BalanceOverflow => f.write_str("balance overflow"),
+            Self::InsufficientBalance => f.write_str("insufficient balance"),
+            Self::NonceOverflow => f.write_str("nonce overflow"),
+        }
+    }
+}
+
+impl std::error::Error for StateError {}
+
+impl From<CodecError> for StateError {
+    fn from(error: CodecError) -> Self {
+        StateError::Decode(error)
+    }
+}
diff --git a/crates/aura-state/src/key.rs b/crates/aura-state/src/key.rs
new file mode 100644
index 0000000..fc472d5
--- /dev/null
+++ b/crates/aura-state/src/key.rs
@@ -0,0 +1,215 @@
+//! State key layout: namespaces, reserved prefixes and key digests.
+
+use aura_codec::{Reader, Writer, read_varint, write_varint};
+use aura_crypto::blake3_hash;
+use aura_types::{Address, Hash};
+
+use crate::error::StateError;
+
+/// Domain tag for the JMT path hash of a state key.
+///
+/// NC target: `tools/nc_c7.py` changes this constant and requires the C7
+/// golden digest vectors to go red.
+pub const STATE_KEY_CONTEXT: &[u8] = b"AuraLite-Crypto/state-key-v1\x00";
+
+/// Maximum encoded key length in bytes.
+pub const MAX_STATE_KEY_LEN: usize = 128;
+
+/// A protocol namespace. Tags `0x01`–`0x05` are the only valid ones;
+/// `0x00` and `0x06`–`0xFF` are reserved for future protocol use and must
+/// never be reachable from contract code.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum KeySpace {
+    /// `0x01` — account values.
+    Account,
+    /// `0x02` — contract bytecode.
+    ContractCode,
+    /// `0x03` — contract storage slots.
+    ContractStorage,
+    /// `0x04` — validator / staking metadata.
+    Staking,
+    /// `0x05` — transaction receipts and events.
+    Receipt,
+}
+
+impl KeySpace {
+    /// All known namespaces in tag order.
+    pub const ALL: [KeySpace; 5] = [
+        KeySpace::Account,
+        KeySpace::ContractCode,
+        KeySpace::ContractStorage,
+        KeySpace::Staking,
+        KeySpace::Receipt,
+    ];
+
+    /// Stable protocol tag.
+    pub const fn tag(self) -> u8 {
+        match self {
+            KeySpace::Account => 0x01,
+            KeySpace::ContractCode => 0x02,
+            KeySpace::ContractStorage => 0x03,
+            KeySpace::Staking => 0x04,
+            KeySpace::Receipt => 0x05,
+        }
+    }
+
+    /// Parse a protocol tag.
+    pub const fn from_tag(tag: u8) -> Option<KeySpace> {
+        match tag {
+            0x01 => Some(KeySpace::Account),
+            0x02 => Some(KeySpace::ContractCode),
+            0x03 => Some(KeySpace::ContractStorage),
+            0x04 => Some(KeySpace::Staking),
+            0x05 => Some(KeySpace::Receipt),
+            _ => None,
+        }
+    }
+
+    /// True only for the five protocol namespaces.
+    pub const fn is_known(tag: u8) -> bool {
+        matches!(tag, 0x01..=0x05)
+    }
+
+    /// Required total key length, including the one-byte prefix.
+    pub const fn expected_len(self) -> usize {
+        match self {
+            KeySpace::Account | KeySpace::ContractCode | KeySpace::Staking => 1 + 20,
+            KeySpace::ContractStorage => 1 + 20 + 32,
+            KeySpace::Receipt => 1 + 32,
+        }
+    }
+}
+
+/// A validated state key. Only [`KeySpace`] constructors or
+/// [`StateKey::from_raw`] can produce one.
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+pub struct StateKey(Vec<u8>);
+
+impl StateKey {
+    fn from_parts(prefix: u8, rest: &[&[u8]]) -> Self {
+        let mut raw = Vec::with_capacity(1 + rest.iter().map(|part| part.len()).sum::<usize>());
+        raw.push(prefix);
+        for part in rest {
+            raw.extend_from_slice(part);
+        }
+        StateKey(raw)
+    }
+
+    /// `0x01 || address[20]` — account value.
+    pub fn account(address: &Address) -> Self {
+        StateKey::from_parts(KeySpace::Account.tag(), &[address.as_bytes()])
+    }
+
+    /// `0x02 || address[20]` — contract bytecode.
+    pub fn code(address: &Address) -> Self {
+        StateKey::from_parts(KeySpace::ContractCode.tag(), &[address.as_bytes()])
+    }
+
+    /// `0x03 || contract[20] || slot[32]` — contract storage.
+    pub fn storage(contract: &Address, slot: &[u8; 32]) -> Self {
+        StateKey::from_parts(
+            KeySpace::ContractStorage.tag(),
+            &[contract.as_bytes(), slot],
+        )
+    }
+
+    /// `0x04 || validator[20]` — staking metadata.
+    pub fn staking(validator: &Address) -> Self {
+        StateKey::from_parts(KeySpace::Staking.tag(), &[validator.as_bytes()])
+    }
+
+    /// `0x05 || txid[32]` — receipts and events.
+    pub fn receipt(txid: &Hash) -> Self {
+        StateKey::from_parts(KeySpace::Receipt.tag(), &[txid.as_bytes()])
+    }
+
+    /// Borrow the raw key bytes.
+    pub fn as_bytes(&self) -> &[u8] {
+        &self.0
+    }
+
+    /// Namespace of this key (validated at construction).
+    pub fn space(&self) -> KeySpace {
+        KeySpace::from_tag(self.0[0]).expect("StateKey always has a known prefix")
+    }
+
+    /// Domain-separated digest used as the JMT path in S1.
+    pub fn digest(&self) -> Hash {
+        let mut input = Vec::with_capacity(STATE_KEY_CONTEXT.len() + 8 + self.0.len());
+        input.extend_from_slice(STATE_KEY_CONTEXT);
+        input.extend_from_slice(&(self.0.len() as u64).to_le_bytes());
+        input.extend_from_slice(&self.0);
+        blake3_hash(&input)
+    }
+
+    /// Canonical wire bytes: `varint(len) || raw`.
+    pub fn to_bytes(&self) -> Vec<u8> {
+        let mut writer = Writer::new();
+        write_varint(&mut writer, self.0.len() as u64);
+        writer.push_bytes(&self.0);
+        writer.into_bytes()
+    }
+
+    /// Decode with full canonicality: minimal varint, no trailing bytes,
+    /// known prefix, exact namespace length, and byte-identical re-encoding.
+    pub fn from_bytes(bytes: &[u8]) -> Result<Self, StateError> {
+        let mut reader = Reader::new(bytes);
+        let len = read_varint(&mut reader).map_err(StateError::Decode)?;
+        if len > MAX_STATE_KEY_LEN as u64 {
+            return Err(StateError::KeyTooLong(len as usize));
+        }
+        let raw = reader
+            .read_exact(len as usize)
+            .map_err(StateError::Decode)?;
+        reader.finish().map_err(StateError::Decode)?;
+        let key = StateKey::from_raw(raw)?;
+        if key.to_bytes() != bytes {
+            return Err(StateError::NonCanonicalKeyEncoding);
+        }
+        Ok(key)
+    }
+
+    /// Validate raw key bytes (prefix + namespace-specific length).
+    ///
+    /// NC targets: `tools/nc_c7.py` disables the reserved-prefix check and
+    /// the length check here, requiring the C7 vectors to go red.
+    pub fn from_raw(raw: &[u8]) -> Result<Self, StateError> {
+        if raw.is_empty() {
+            return Err(StateError::EmptyKey);
+        }
+        if raw.len() > MAX_STATE_KEY_LEN {
+            return Err(StateError::KeyTooLong(raw.len()));
+        }
+        let prefix = raw[0];
+        if !KeySpace::is_known(prefix) {
+            return Err(StateError::ReservedKeySpace(prefix));
+        }
+        let space = KeySpace::from_tag(prefix).expect("checked above");
+        if raw.len() != space.expected_len() {
+            return Err(StateError::InvalidKeyLength {
+                space,
+                expected: space.expected_len(),
+                got: raw.len(),
+            });
+        }
+        Ok(StateKey(raw.to_vec()))
+    }
+}
+
+/// Enforce that `contract` may write `key`.
+///
+/// A contract can touch only `0x03 || its_own_address || slot`. It cannot
+/// reach account/code/staking/receipt namespaces, another contract's storage,
+/// or any reserved prefix (those keys cannot even be constructed).
+///
+/// NC targets: `tools/nc_c7.py` disables the namespace check and the
+/// contract-address check here.
+pub fn assert_contract_may_write(contract: &Address, key: &StateKey) -> Result<(), StateError> {
+    if key.space() != KeySpace::ContractStorage {
+        return Err(StateError::ForbiddenContractWrite);
+    }
+    if &key.as_bytes()[1..21] != contract.as_bytes().as_slice() {
+        return Err(StateError::WrongContractStorage);
+    }
+    Ok(())
+}
diff --git a/crates/aura-state/src/lib.rs b/crates/aura-state/src/lib.rs
index 109a548..da9cf0f 100644
--- a/crates/aura-state/src/lib.rs
+++ b/crates/aura-state/src/lib.rs
@@ -1,9 +1,35 @@
-//! `aura-state` — placeholder crate for versioned Merkle state tree.
+//! AuraLite-Crypto account model and state key layout (C7).
 //!
-//! C0 creates the workspace skeleton only. The real API lands in phase S1.
-//! This crate intentionally exposes **no public items**: CONTRIBUTING.md
-//! forbids stubs that silently return success. An empty crate is honest;
-//! a fake `Ok(())` is not.
+//! This is the **first real API** of `aura-state`. It fixes the account value
+//! ([`Account`]) and the byte layout of state keys ([`StateKey`],
+//! [`KeySpace`]); the versioned Merkle tree, proofs and persistence remain the
+//! job of `STATE_PLAN` S1–S7. C7 is deliberately a *layout* phase: no storage
+//! backend, no root computation, no fake `Ok(())`.
+//!
+//! Invariants:
+//! * five known key namespaces (`0x01`–`0x05`); everything else — including
+//!   `0x00` and `0x06`–`0xFF` — is **reserved** and cannot be decoded into a
+//!   [`StateKey`];
+//! * every namespace has one fixed key length, so two accounts can never
+//!   collide and a key cannot alias another namespace;
+//! * a contract may write only under its own `0x03 || contract || slot`
+//!   prefix, checked by [`assert_contract_may_write`];
+//! * [`StateKey::digest`] is domain-separated with an explicit length, ready
+//!   for the JMT path hashing in S1;
+//! * all account arithmetic is checked (`u128` balance, `u64` nonce).
+//!
+//! Full specification: `docs/spec/account-model.md`.
+//! Golden vectors: `tools/gen_c7_vectors.py` (independent Python).
 
 #![forbid(unsafe_code)]
 #![deny(missing_docs)]
+
+mod account;
+mod error;
+mod key;
+
+pub use account::Account;
+pub use error::StateError;
+pub use key::{
+    KeySpace, MAX_STATE_KEY_LEN, STATE_KEY_CONTEXT, StateKey, assert_contract_may_write,
+};
diff --git a/crates/aura-state/tests/c7_state.rs b/crates/aura-state/tests/c7_state.rs
new file mode 100644
index 0000000..1d3dcfe
--- /dev/null
+++ b/crates/aura-state/tests/c7_state.rs
@@ -0,0 +1,422 @@
+//! C7 gate: account model and state key layout against independent Python.
+//!
+//! `fixtures/c7_golden.txt` comes from `tools/gen_c7_vectors.py`, which
+//! self-checks pure-Python BLAKE3 against official vectors before emitting
+//! key bytes, digests, account encodings and rejection vectors.
+
+use std::collections::{BTreeMap, HashSet};
+
+use aura_codec::CodecError;
+use aura_crypto::blake3_hash;
+use aura_state::{
+    Account, KeySpace, MAX_STATE_KEY_LEN, STATE_KEY_CONTEXT, StateError, StateKey,
+    assert_contract_may_write,
+};
+use aura_types::{Address, Amount, Hash, Nonce};
+
+const GOLDEN: &str = include_str!("fixtures/c7_golden.txt");
+
+fn parse(text: &str) -> BTreeMap<String, String> {
+    let mut map = BTreeMap::new();
+    for line in text.lines() {
+        let trimmed = line.trim();
+        if trimmed.is_empty() || trimmed.starts_with('#') {
+            continue;
+        }
+        let (key, value) = trimmed
+            .split_once('=')
+            .unwrap_or_else(|| panic!("malformed golden line: {trimmed}"));
+        assert!(
+            map.insert(key.to_owned(), value.to_owned()).is_none(),
+            "duplicate golden key {key}"
+        );
+    }
+    map
+}
+
+fn hx(text: &str) -> Vec<u8> {
+    assert_eq!(text.len() % 2, 0, "even-length hex");
+    text.as_bytes()
+        .chunks(2)
+        .map(|pair| (nibble(pair[0]) << 4) | nibble(pair[1]))
+        .collect()
+}
+
+fn nibble(byte: u8) -> u8 {
+    match byte {
+        b'0'..=b'9' => byte - b'0',
+        b'a'..=b'f' => byte - b'a' + 10,
+        _ => panic!("invalid hex nibble in fixture"),
+    }
+}
+
+fn to_hex(bytes: &[u8]) -> String {
+    let mut out = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        out.push_str(&format!("{byte:02x}"));
+    }
+    out
+}
+
+fn bytes20(text: &str) -> [u8; 20] {
+    hx(text).try_into().expect("20 bytes")
+}
+
+/// Same trivial deterministic patterns as `tools/gen_c7_vectors.py`.
+fn addr(index: usize) -> Address {
+    let mut bytes = [0u8; 20];
+    bytes[..8].copy_from_slice(&(index as u64).to_le_bytes());
+    for (j, byte) in bytes[8..].iter_mut().enumerate() {
+        *byte = ((index as u64) * 11 + (j as u64) * 29 + 0x3C) as u8;
+    }
+    Address::from_bytes(bytes)
+}
+
+fn slot(index: usize) -> [u8; 32] {
+    let mut bytes = [0u8; 32];
+    bytes[..8].copy_from_slice(&(index as u64).to_le_bytes());
+    for (j, byte) in bytes[8..].iter_mut().enumerate() {
+        *byte = ((index as u64) * 3 + (j as u64) * 17 + 0x77) as u8;
+    }
+    bytes
+}
+
+fn txid(index: usize) -> Hash {
+    let mut bytes = [0u8; 32];
+    bytes[..8].copy_from_slice(&(index as u64).to_le_bytes());
+    for (j, byte) in bytes[8..].iter_mut().enumerate() {
+        *byte = ((index as u64) * 7 + (j as u64) * 13 + 0xAB) as u8;
+    }
+    Hash::from_bytes(bytes)
+}
+
+fn keys_for(index: usize) -> Vec<(&'static str, StateKey)> {
+    vec![
+        ("account", StateKey::account(&addr(index))),
+        ("code", StateKey::code(&addr(index))),
+        ("storage", StateKey::storage(&addr(index), &slot(index))),
+        ("staking", StateKey::staking(&addr(index))),
+        ("receipt", StateKey::receipt(&txid(index))),
+    ]
+}
+
+#[test]
+fn constants_are_pinned_by_the_independent_fixture() {
+    let f = parse(GOLDEN);
+    assert_eq!(to_hex(STATE_KEY_CONTEXT), f["state_key_context"]);
+    assert_eq!(MAX_STATE_KEY_LEN.to_string(), f["max_state_key_len"]);
+    assert_eq!(KeySpace::ALL.map(KeySpace::tag), [1, 2, 3, 4, 5]);
+    assert_eq!(
+        KeySpace::Account.expected_len().to_string(),
+        f["len_account"]
+    );
+    assert_eq!(
+        KeySpace::ContractCode.expected_len().to_string(),
+        f["len_code"]
+    );
+    assert_eq!(
+        KeySpace::ContractStorage.expected_len().to_string(),
+        f["len_storage"]
+    );
+    assert_eq!(
+        KeySpace::Staking.expected_len().to_string(),
+        f["len_staking"]
+    );
+    assert_eq!(
+        KeySpace::Receipt.expected_len().to_string(),
+        f["len_receipt"]
+    );
+}
+
+#[test]
+fn state_keys_and_digests_match_independent_python() {
+    let f = parse(GOLDEN);
+    for index in 0..4 {
+        assert_eq!(to_hex(addr(index).as_bytes()), f[&format!("addr_{index}")]);
+        assert_eq!(to_hex(&slot(index)), f[&format!("slot_{index}")]);
+        assert_eq!(txid(index).to_hex(), f[&format!("txid_{index}")]);
+        for (name, key) in keys_for(index) {
+            assert_eq!(
+                to_hex(key.as_bytes()),
+                f[&format!("key_{name}_{index}")],
+                "key_{name}_{index}"
+            );
+            assert_eq!(
+                to_hex(&key.to_bytes()),
+                f[&format!("encoded_{name}_{index}")],
+                "encoded_{name}_{index}"
+            );
+            assert_eq!(
+                key.digest().to_hex(),
+                f[&format!("digest_{name}_{index}")],
+                "digest_{name}_{index}"
+            );
+            let decoded = StateKey::from_bytes(&hx(&f[&format!("encoded_{name}_{index}")]))
+                .unwrap_or_else(|e| panic!("decode {name}_{index}: {e}"));
+            assert_eq!(decoded, key);
+        }
+    }
+}
+
+#[test]
+fn two_account_keys_never_collide() {
+    // C7 DoD gate: keys of two accounts do not collide.
+    let mut raw_keys: HashSet<Vec<u8>> = HashSet::new();
+    let mut digests: HashSet<Hash> = HashSet::new();
+    for index in 0..1000 {
+        let address = addr(index);
+        let key = StateKey::account(&address);
+        assert_eq!(key.as_bytes().len(), 21);
+        assert!(
+            raw_keys.insert(key.as_bytes().to_vec()),
+            "raw key collision at {index}"
+        );
+        assert!(digests.insert(key.digest()), "digest collision at {index}");
+        // No cross-namespace aliasing for the same address either.
+        for (name, other) in keys_for(index) {
+            if name == "account" {
+                continue;
+            }
+            assert!(
+                raw_keys.insert(other.as_bytes().to_vec()),
+                "{name} aliased account"
+            );
+            assert!(
+                digests.insert(other.digest()),
+                "{name} digest aliased account"
+            );
+        }
+    }
+    assert_eq!(raw_keys.len(), 5000);
+    assert_eq!(digests.len(), 5000);
+}
