+openapi: 3.1.0
+info:
+  title: AuraLite Node REST Gateway
+  version: 1.1.0
+  description: >-
+    Versioned HTTP gateway over the validated D4 JSON-RPC service. v1.1 adds
+    apiVersion to the stable v1 response envelope; existing v1 fields remain.
+servers:
+  - url: /
+paths:
+  /api/v1/balances/{address}:
+    get:
+      operationId: getBalanceV1
+      parameters:
+        - in: path
+          name: address
+          required: true
+          schema: { type: string }
+      responses:
+        '200':
+          description: Account balance and nonce.
+          content:
+            application/json:
+              schema: { $ref: '#/components/schemas/ResponseV1' }
+        '400': { description: Invalid request or unknown field. }
+  /api/v1.1/balances/{address}:
+    get:
+      operationId: getBalanceV11
+      parameters:
+        - in: path
+          name: address
+          required: true
+          schema: { type: string }
+      responses:
+        '200':
+          description: v1-compatible result with additive API version metadata.
+          content:
+            application/json:
+              schema: { $ref: '#/components/schemas/ResponseV11' }
+  /api/v1/transactions:
+    post:
+      operationId: submitTransactionV1
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema: { $ref: '#/components/schemas/SubmitTransactionRequest' }
+      responses:
+        '200': { description: Transaction accepted by the D4 pipeline. }
+        '400': { description: Invalid request or unknown field. }
+  /api/v1.1/transactions:
+    post:
+      operationId: submitTransactionV11
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema: { $ref: '#/components/schemas/SubmitTransactionRequest' }
+      responses:
+        '200': { description: v1-compatible transaction result plus version metadata. }
+  /api/v1/transactions/{transactionHash}:
+    get:
+      operationId: getTransactionV1
+      parameters:
+        - in: path
+          name: transactionHash
+          required: true
+          schema: { type: string }
+      responses:
+        '200': { description: Pending, committed, or not-found transaction result. }
+  /api/v1.1/transactions/{transactionHash}:
+    get:
+      operationId: getTransactionV11
+      parameters:
+        - in: path
+          name: transactionHash
+          required: true
+          schema: { type: string }
+      responses:
+        '200': { description: v1-compatible result with additive version metadata. }
+  /api/v1/blocks/{height}:
+    get:
+      operationId: getBlockV1
+      parameters:
+        - in: path
+          name: height
+          required: true
+          schema: { type: string, pattern: '^(latest|[0-9]+)$' }
+      responses:
+        '200': { description: Committed block summary, or null outside the retention window. }
+  /api/v1.1/blocks/{height}:
+    get:
+      operationId: getBlockV11
+      parameters:
+        - in: path
+          name: height
+          required: true
+          schema: { type: string, pattern: '^(latest|[0-9]+)$' }
+      responses:
+        '200': { description: v1-compatible block result plus version metadata. }
+  /api/v1/gas-estimate:
+    post:
+      operationId: estimateGasV1
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              type: object
+              additionalProperties: false
+              properties:
+                kind: { type: string, enum: [transfer] }
+                tx: { type: string, pattern: '^0x[0-9a-fA-F]+$' }
+      responses:
+        '200': { description: Estimated gas for the supported transfer kind. }
+        '400': { description: Invalid request, unknown field, or unsupported input. }
+  /api/v1.1/gas-estimate:
+    post:
+      operationId: estimateGasV11
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              type: object
+              additionalProperties: false
+              properties:
+                kind: { type: string, enum: [transfer] }
+                tx: { type: string, pattern: '^0x[0-9a-fA-F]+$' }
+      responses:
+        '200': { description: v1-compatible estimate plus version metadata. }
+  /openapi.json:
+    get:
+      operationId: getOpenApiDocument
+      responses:
+        '200': { description: This API document as JSON. }
+  /openapi.yaml:
+    get:
+      operationId: getOpenApiYaml
+      responses:
+        '200': { description: This OpenAPI document as YAML. }
+components:
+  schemas:
+    SubmitTransactionRequest:
+      type: object
+      additionalProperties: false
+      required: [tx]
+      properties:
+        tx: { type: string, pattern: '^0x[0-9a-fA-F]+$' }
+    ResponseV1:
+      type: object
+      additionalProperties: false
+      required: [result]
+      properties:
+        result: {}
+    ResponseV11:
+      type: object
+      additionalProperties: false
+      required: [result, apiVersion]
+      properties:
+        result: {}
+        apiVersion: { type: string, const: '1.1' }
