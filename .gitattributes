# Fuzz seed inputs and compiled wasm fixtures are opaque byte streams; keep
# them out of text diffs so patches stay valid UTF-8 and survive mail/tooling
# transports (git emits full binary hunks with `git format-patch --binary`).
fuzz/corpus/** binary
examples/*/wasm/*.wasm binary
crates/aura-exec/tests/fixtures/x8/*.wasm binary
